---
/**
 * 11 Selected content (Creator Marketing and Partnerships, V1.0): one curated,
 * silent montage from across the three trips (destination films, creator ads,
 * the game show, lifestyle, sponsor integrations, social clips and the crew
 * behind them), landscape only and deliberately smaller than the Trezor film
 * before it. Beside it, the formats it draws on; the one on screen is marked
 * as the reel plays, with where it was filmed (from the cut times in
 * creator.json). The reel plays muted and looped only while it is well in
 * view, never for reduced motion or a data-saving preference, with its own
 * pause control (ev-media.ts, mountLoops); phones get the lighter encode.
 */
import { getImage } from 'astro:assets';
import creator from '@data/creator.json';
import { getAsset, isSlotReady, resolveImage } from '@lib/assets';
import { withBase } from '@lib/paths';
import Icon from '@components/Icon.astro';

const { montage: m } = creator;
const reel = getAsset(m.reel);
if (!isSlotReady(reel)) throw new Error('[creator] the selected-content montage needs an approved file');
const still = resolveImage(reel);
const poster = still ? await getImage({ src: still, width: Math.min(1280, still.width), format: 'webp', quality: 80 }) : null;
const known = new Set(m.formats.map((f) => f.key));
for (const c of m.cuts) if (!known.has(c.format)) throw new Error(`[creator] the montage cut at ${c.at}s names an unknown format "${c.format}"`);
const first = m.cuts[0];
const label = (key: string) => m.formats.find((f) => f.key === key)?.label ?? key;
---

<section class="cmm" data-surface="light-return" aria-labelledby="cm-montage-title" data-cm-montage data-cuts={JSON.stringify(m.cuts)}>
  <div class="container cmm__inner">
    <div class="cmm__words">
      <p class="cmm__kicker">{m.kicker}</p>
      <h2 id="cm-montage-title" class="display cmm__title">{m.headline}</h2>
      <p class="cmm__copy">{m.copy}</p>
      <ul class="cmm__formats" aria-label="Formats in the montage">
        {
          m.formats.map((f) => (
            <li class="cmm__format" data-format={f.key} data-on={f.key === first.format ? '' : undefined}>
              {f.label}
            </li>
          ))
        }
      </ul>
    </div>
    <figure class="cmm__reel">
      <div class="cmm__frame" data-ev-loop data-label="Selected content">
        <video class="cmm__video" muted loop playsinline preload="none" poster={poster?.src} aria-label={reel.alt} data-cmm-video>
          {reel.fileSmall && <source src={withBase(`/media/${reel.fileSmall}`)} type="video/mp4" media="(max-width: 47.99rem)" />}
          <source src={withBase(`/media/${reel.file}`)} type="video/mp4" />
        </video>
        <button type="button" class="cmm__toggle" data-ev-loop-toggle aria-label="Play: Selected content" hidden>
          <span class="cmm__ico cmm__ico--play"><Icon name="play" size={12} /></span>
          <span class="cmm__ico cmm__ico--pause"><Icon name="pause" size={12} /></span>
        </button>
      </div>
      <figcaption class="cmm__now" aria-hidden="true">
        <span class="cmm__now-format" data-cmm-format>{label(first.format)}</span>
        <span class="cmm__now-place" data-cmm-place>{first.place}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .cmm {
    padding-block: calc(var(--section-y) * 0.6) var(--section-y);
    background: var(--bg);
  }

  .cmm__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .cmm__words {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .cmm__kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .cmm__title {
    margin: 0;
    font-size: clamp(2.2rem, 1.3rem + 2.6vw, 3.75rem);
    line-height: 0.98;
  }

  .cmm__copy {
    max-width: 30rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .cmm__formats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cmm__format {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .cmm__format::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background-color 0.3s ease;
  }

  .cmm__format[data-on] {
    border-color: var(--c-teal);
    background: var(--bg-elev);
    color: var(--ink);
  }

  .cmm__format[data-on]::before {
    background: var(--c-teal);
  }

  .cmm__reel {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .cmm__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: #050607;
    box-shadow: 0 30px 60px -32px rgba(13, 15, 16, 0.5);
  }

  .cmm__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cmm__toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(243, 239, 232, 0.4);
    border-radius: 50%;
    background: rgba(8, 15, 20, 0.55);
    color: var(--c-bone);
    backdrop-filter: blur(4px);
  }

  .cmm__toggle:hover {
    background: rgba(8, 15, 20, 0.8);
  }

  .cmm__toggle:focus-visible {
    outline: 2px solid var(--c-teal);
    outline-offset: 2px;
  }

  .cmm__ico {
    display: grid;
    place-items: center;
  }

  .cmm__ico--pause,
  .cmm__toggle[data-state='playing'] .cmm__ico--play {
    display: none;
  }

  .cmm__toggle[data-state='playing'] .cmm__ico--pause {
    display: grid;
  }

  .cmm__frame[data-failed] .cmm__toggle {
    display: none;
  }

  .cmm__now {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: 0.8125rem;
  }

  .cmm__now-format {
    font-weight: 700;
    color: var(--ink);
  }

  .cmm__now-place {
    color: var(--ink-3);
  }

  @media (min-width: 60rem) {
    .cmm__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      column-gap: clamp(3rem, 6vw, 7rem);
    }

    /* Smaller than the Trezor film: about two thirds of the content width. */
    .cmm__reel {
      max-width: 52rem;
      justify-self: end;
      width: 100%;
    }
  }
</style>
