---
/**
 * 08 The testimonial transition (Creator Marketing and Partnerships, V1.0):
 * up to three short creator testimonials, one at a time as the page scrolls,
 * set loosely in the open (no cards, slider or wall): the first rises into
 * view at the lower left, the next at the lower right, the last at the lower
 * left again on the way into the destinations, each with its attribution.
 * The page scrolls on as usual; nothing holds the reader. With reduced motion
 * they are simply there.
 *
 * Each testimonial is an assets.json entry. Until one is approved with a
 * quote it is a labeled placeholder in `npm run dev` only, and a production
 * build leaves this whole section out (the network then leads straight into
 * the atlas). Never on the creator cards, and never Trezor's feedback.
 */
import creator from '@data/creator.json';
import { getAsset, isVisible, SHOW_PLACEHOLDERS } from '@lib/assets';

const { voices } = creator;
const items = voices.items.slice(0, 3).map((it) => {
  const entry = getAsset(it.asset);
  return { ...it, entry, ready: isVisible(entry) && entry.type === 'testimonial' };
});
const shown = items.filter((it) => it.ready || SHOW_PLACEHOLDERS);
---

{
  shown.length > 0 && (
    <section class="cmv" data-surface="light" aria-label="What creators said">
      <div class="container cmv__inner">
        {shown.map((it) => (
          <figure class:list={['cmv__quote', `cmv__quote--${it.side}`, !it.ready && 'cmv__quote--pending']} data-cm-reveal data-asset={it.entry.id}>
            {it.ready ? (
              <>
                <blockquote class="cmv__text">
                  <p>{it.entry.quote}</p>
                </blockquote>
                {it.entry.attribution && <figcaption class="cmv__by">{it.entry.attribution}</figcaption>}
              </>
            ) : (
              <>
                <p class="cmv__kind">Placeholder · Testimonial</p>
                <blockquote class="cmv__text">
                  <p>A one or two sentence creator testimonial goes here, in the creator's own words.</p>
                </blockquote>
                <figcaption class="cmv__by">Creator name, affiliation</figcaption>
              </>
            )}
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .cmv {
    background: var(--bg);
    padding-block: clamp(2rem, 6vh, 5rem) clamp(4rem, 12vh, 9rem);
  }

  .cmv__inner {
    display: grid;
    gap: clamp(5rem, 34vh, 22rem);
  }

  .cmv__quote {
    max-width: 34rem;
    margin: 0;
  }

  .cmv__quote--right {
    justify-self: end;
  }

  .cmv__text {
    margin: 0;
  }

  .cmv__text p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.65rem, 1.1rem + 1.6vw, 2.6rem);
    line-height: 1.08;
    color: var(--heading);
    text-wrap: balance;
  }

  .cmv__text p::before {
    content: '“';
  }

  .cmv__text p::after {
    content: '”';
  }

  .cmv__by {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .cmv__by::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: currentColor;
  }

  /* Authoring only: never in a production build. */
  .cmv__quote--pending {
    padding: 1.25rem 1.4rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: repeating-linear-gradient(135deg, transparent 0 10px, color-mix(in srgb, var(--line) 45%, transparent) 10px 11px);
  }

  .cmv__quote--pending .cmv__text p {
    color: var(--ink-3);
  }

  .cmv__kind {
    margin: 0 0 0.75rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .cmv__quote:not(.is-in) {
      opacity: 0;
      transform: translate3d(0, 2.5rem, 0);
    }

    :global(html.js) .cmv__quote {
      transition:
        opacity 1s ease,
        transform 1.1s cubic-bezier(0.2, 0.75, 0.2, 1);
    }
  }
</style>
