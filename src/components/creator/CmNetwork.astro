---
/**
 * 07 Creator network (Creator Marketing and Partnerships, V1.2): exactly the
 * eight creators John confirmed, their square profile pictures (never a
 * profile screenshot) in one continuous field warped across a broad curve in
 * depth (V1.2, in place of V1.1's ring, its ellipse and the route line that
 * led into it). The field travels one way at a slow, constant pace: each
 * portrait enters from beyond the frame at the far end of the curve, small,
 * turned and a little faint, grows and sharpens as it nears the focal zone,
 * where it is largest and square to the reader, and then drifts back and
 * fades as the next one arrives; after the eighth comes the first again, with
 * no seam. The creator in the focal zone is the one shown.
 *
 * The details (display name, handle and confirmed affiliations, stated
 * plainly: no follower counts, travel history, categories or qualifiers) have
 * an area of their own, beside the field on wider screens and under it on
 * phones, never under a portrait. Every creator's details are stacked in that
 * one place, so it is always as tall as the longest and nothing moves when the
 * creator changes; they sit centered in it.
 *
 * Hovering or keyboard-focusing a creator eases the field to a stop and shows
 * them; selecting one that is still approaching brings them forward to the
 * focal zone (the field never runs backward), and the field sets off again,
 * the same way, once the reader moves on. Every creator is a button in the
 * page's order, so all eight are reachable by keyboard (one out of view is
 * brought forward into it). On touch screens the field follows a sideways
 * swipe and a tap holds a creator for a few seconds. One control pauses and
 * plays the field. Off screen or in a hidden tab it rests.
 *
 * With reduced motion the field is a still gallery, two rows, and a creator
 * is shown by selecting them. Without JavaScript every creator's details show
 * beside their portrait (two across on phones, four across wider). Motion:
 * src/lib/cm-motion.ts (mountNetwork).
 */
import { Image } from 'astro:assets';
import creator from '@data/creator.json';
import { getAsset, resolveImage } from '@lib/assets';
import Icon from '@components/Icon.astro';

const { network: n } = creator;
if (n.creators.length !== 8) throw new Error(`[creator] the network shows exactly eight creators (found ${n.creators.length})`);
for (const c of n.creators) {
  if (!/^@\w+$/.test(c.handle ?? '')) throw new Error(`[creator] ${c.name} needs a handle, written as @handle`);
  if ('category' in c) throw new Error('[creator] the creators carry no category label (V1.2)');
  if (!c.affiliations.length) throw new Error(`[creator] ${c.name} needs their confirmed affiliations`);
}
const cards = n.creators.map((c) => {
  const entry = getAsset(c.asset);
  const image = resolveImage(entry);
  if (!image || entry.permission !== 'approved') throw new Error(`[creator] ${c.name}'s profile picture needs an approved file (${c.asset})`);
  return { ...c, image };
});
---

<section class="cmn" data-surface="light" aria-labelledby="cm-network-title" data-cm-network>
  <div class="container cmn__head">
    <p class="cmn__kicker">{n.kicker}</p>
    <h2 id="cm-network-title" class="display cmn__title">{n.headline}</h2>
    <p class="cmn__sub">{n.sub}</p>
    <p class="cmn__hint">{n.hint}</p>
  </div>

  <div class="cmn__stage" data-cmn-stage>
    {/* The details area: every creator's details in one place, the one shown visible
        (a visual copy: each card names its own details), and the field's pause control. */}
    <div class="cmn__details">
      <div class="cmn__detail-stack" aria-hidden="true">
        {
          cards.map((c, i) => (
            <div class:list={['cmn__detail', i === 0 && 'is-on']} data-cmn-detail={i}>
              <p class="cmn__detail-name">{c.name}</p>
              <p class="cmn__detail-handle">{c.handle}</p>
              <ul class="cmn__detail-aff">
                {c.affiliations.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <button type="button" class="cmn__toggle" data-cmn-toggle aria-label="Pause: creator network" hidden>
        <span class="cmn__ico cmn__ico--play">
          <Icon name="play" size={12} />
        </span>
        <span class="cmn__ico cmn__ico--pause">
          <Icon name="pause" size={12} />
        </span>
        <span class="cmn__toggle-text" data-cmn-toggle-text>Pause</span>
      </button>
    </div>

    <div class="cmn__field" data-cmn-field>
      <ul class="cmn__track" aria-label="Creators" data-cmn-track>
        {
          cards.map((c, i) => (
            <li class="cmn__item" data-cmn-item data-i={i} style={`--i: ${i}`}>
              <button type="button" class="cmn__card" data-cmn-card aria-describedby={`cmn-${c.id}`}>
                <span class="cmn__photo">
                  <Image src={c.image} alt="" width={400} height={400} widths={[200, 320, 400]} sizes="(min-width: 48rem) 21rem, 60vw" loading="lazy" decoding="async" class="cmn__img" />
                </span>
                <span class="cmn__name">{c.name}</span>
              </button>
              <div class="cmn__info" id={`cmn-${c.id}`}>
                <p class="cmn__handle">{c.handle}</p>
                <ul class="cmn__aff">
                  {c.affiliations.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cmn {
    position: relative;
    padding-block: clamp(1rem, 3vw, 2.5rem) clamp(3rem, 6vw, 6rem);
    background: var(--bg);
    overflow: clip;
  }

  /* ---- the heading -------------------------------------------------------------------- */
  .cmn__head {
    margin-bottom: clamp(1.75rem, 3.5vw, 3rem);
  }

  .cmn__kicker {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .cmn__title {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.1rem, 1.2rem + 2.6vw, 3.9rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .cmn__sub {
    max-width: 34rem;
    margin: 0.9rem 0 0;
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .cmn__hint {
    display: none;
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  /* ---- without JavaScript: a plain list, every creator's details showing ------------------ */
  .cmn__details {
    display: none;
  }

  .cmn__track {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1rem;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .cmn__item {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .cmn__card {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    width: 100%;
    padding: 0;
    text-align: left;
    cursor: default;
  }

  .cmn__photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg-sunk);
    box-shadow:
      0 0 0 4px #fbfaf7,
      0 14px 30px -14px rgba(13, 15, 16, 0.45);
  }

  .cmn__photo :global(.cmn__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cmn__name {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: 1.35rem;
    line-height: 1.05;
    color: var(--heading);
  }

  .cmn__handle,
  .cmn__detail-handle {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--c-teal);
    overflow-wrap: anywhere;
  }

  .cmn__aff,
  .cmn__detail-aff {
    display: grid;
    gap: 0.15rem;
    margin: 0.45rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  @media (min-width: 48rem) {
    .cmn__track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
      max-width: var(--container);
      margin-inline: auto;
    }
  }

  /* ---- with JavaScript: the field and its details area ------------------------------------ */
  :global(html.js) .cmn__hint {
    display: block;
  }

  :global(html.js) .cmn__stage {
    /* The content column's left edge, the details area's width and the gap before the field. */
    --edge: calc(max(0px, (100% - var(--container)) / 2) + var(--gutter));
    position: relative;
    display: grid;
  }

  :global(html.js) .cmn__details {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding-inline: var(--gutter);
  }

  /* Every creator's details in one cell: the area is as tall as the longest, so
     nothing below it moves when the creator changes; each sits centered in it. */
  :global(html.js) .cmn__detail-stack {
    display: grid;
  }

  :global(html.js) .cmn__detail {
    grid-area: 1 / 1;
    align-self: center;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 0.5rem, 0);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.2, 0.75, 0.2, 1),
      visibility 0s linear 0.4s;
  }

  :global(html.js) .cmn__detail.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.45s ease 0.08s,
      transform 0.55s cubic-bezier(0.2, 0.75, 0.2, 1) 0.08s,
      visibility 0s;
  }

  :global(html.js) .cmn__detail-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem);
    line-height: 0.98;
    color: var(--heading);
    text-wrap: balance;
  }

  :global(html.js) .cmn__detail-handle {
    margin-top: 0.55rem;
    font-size: var(--text-md);
  }

  :global(html.js) .cmn__detail-aff {
    margin-top: 0.85rem;
    gap: 0.25rem;
    font-size: var(--text-md);
    line-height: 1.45;
  }

  /* The pause control: quiet, under the details. */
  .cmn__toggle {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    transition: color 0.2s ease;
  }

  .cmn__toggle:hover {
    color: var(--ink);
  }

  .cmn__ico {
    display: inline-grid;
  }

  .cmn__toggle[data-state='playing'] .cmn__ico--play,
  .cmn__toggle:not([data-state='playing']) .cmn__ico--pause {
    display: none;
  }

  /* The field: no frame and no panel; the portraits are placed by the script. */
  :global(html.js) .cmn__field {
    position: relative;
    height: min(102vw, 31rem);
    touch-action: pan-y;
  }

  :global(html.js) .cmn__track {
    position: absolute;
    inset: 0;
    display: block;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  :global(html.js) .cmn__item {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    width: var(--card, 14rem);
    height: var(--card, 14rem);
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    will-change: transform, opacity;
  }

  :global(html.js) .cmn__card {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    border-radius: 14px;
  }

  :global(html.js) .cmn__photo {
    height: 100%;
    border-radius: 14px;
    box-shadow:
      0 0 0 3px #fbfaf7,
      0 22px 40px -22px rgba(13, 15, 16, 0.5);
    transition: box-shadow 0.35s ease;
  }

  :global(html.js) .cmn__item[data-active] .cmn__photo {
    box-shadow:
      0 0 0 4px #fbfaf7,
      0 34px 60px -28px rgba(13, 15, 16, 0.55);
  }

  /* The creator the reader points at, focuses or selects: a ring in the accent. */
  :global(html.js) .cmn__item[data-shown] .cmn__photo {
    box-shadow:
      0 0 0 4px #fbfaf7,
      0 0 0 6px var(--c-teal),
      0 34px 60px -28px rgba(13, 15, 16, 0.55);
  }

  :global(html.js) .cmn__card:focus-visible {
    outline: none;
  }

  /* Names and details live in the details area; here they still name each button. */
  :global(html.js) .cmn__name,
  :global(html.js) .cmn__info {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Phones: the field across the whole width, the details under it. */
  @media (max-width: 47.99rem) {
    :global(html.js) .cmn__details {
      order: 2;
      padding-top: 1.25rem;
    }

    :global(html.js) .cmn__field {
      order: 1;
      overflow: hidden;
    }
  }

  /* Wider screens: the details beside the field, centered in its height; the field
     runs from there to the edge of the screen, the portraits fading in from beyond
     it and out before the details. */
  @media (min-width: 48rem) {
    :global(html.js) .cmn__stage {
      --dw: clamp(13.5rem, 25vw, 24rem);
      --dgap: clamp(1rem, 2.5vw, 3rem);
      grid-template-columns: var(--edge) var(--dw) var(--dgap) minmax(0, 1fr);
      height: clamp(26rem, 64vh, 42rem);
    }

    :global(html.js) .cmn__details {
      grid-column: 2;
      grid-row: 1;
      padding: 0;
    }

    :global(html.js) .cmn__field {
      grid-column: 4;
      grid-row: 1;
      height: 100%;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 clamp(1.5rem, 4vw, 3.5rem));
      mask-image: linear-gradient(to right, transparent 0, #000 clamp(1.5rem, 4vw, 3.5rem));
    }
  }

  /* ---- reduced motion: a still gallery, two rows, selected by hand ----------------------- */
  :global(html.js) .cmn.is-still .cmn__track {
    position: static;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    height: 100%;
    padding: 0 var(--gutter) 0 0;
  }

  :global(html.js) .cmn.is-still .cmn__field {
    height: auto;
    -webkit-mask-image: none;
    mask-image: none;
  }

  :global(html.js) .cmn.is-still .cmn__item {
    position: relative;
    width: auto;
    height: auto;
    aspect-ratio: 1;
    transform: none;
    will-change: auto;
  }

  @media (max-width: 47.99rem) {
    :global(html.js) .cmn.is-still .cmn__track {
      padding: 0 var(--gutter);
    }
  }

  @media (min-width: 48rem) {
    :global(html.js) .cmn.is-still .cmn__stage {
      height: auto;
      min-height: clamp(20rem, 46vh, 30rem);
    }

    :global(html.js) .cmn.is-still .cmn__field {
      align-self: center;
    }
  }
</style>
