---
/**
 * 10 Trezor Dare Ad (Creator Marketing and Partnerships, V1.2): led by the
 * final video (Trezor Dare Ad.mp4, with sound, on request), then, in this
 * order and revealed as the reader scrolls: the assignment, the objective and
 * the approach (John's words, V1.2: a lifestyle-led creative idea that
 * connected the device's features with culture and community, not a feature
 * list), three performance highlights and Trezor's feedback (the approved
 * quotation and its attribution).
 *
 * The highlights (V1.1) are the post's results on the creator's own account,
 * against that account's preceding three months: a rate, a multiple and a
 * ranking with its percentile (V1.2: #2 by reach out of 56 posts, never
 * "most-viewed"), never a raw total. A note under the label says what they
 * measure and that they are not Trezor's total campaign performance. Set as a
 * restrained row of figures and words on a hairline, not as dashboard cards.
 *
 * V1.2: four phrases inside the one continuous quotation (creator.json
 * `emphasis`) take the page's accent and a soft underlay that draws in once,
 * as the quotation arrives, then stays; with reduced motion they are simply
 * set. No pull quotes, badges or checklist. The collaboration block that sat
 * under the quotation is gone: John's part is told by the campaign and the
 * page's ownership, and the full record is in the credits; the section now
 * resolves on the quotation into the library that follows.
 */
import creator from '@data/creator.json';
import { getAsset, isVisible, SHOW_PLACEHOLDERS } from '@lib/assets';
import CmFilm from './CmFilm.astro';

const { trezor: t } = creator;
const brief = t.brief.filter((b) => b.text || SHOW_PLACEHOLDERS);
const metrics = t.metrics.map((id) => getAsset(id)).map((e) => ({ e, ready: isVisible(e) && e.type === 'metric' && Boolean(e.value) }));
const shownMetrics = metrics.filter((m) => m.ready || SHOW_PLACEHOLDERS);
const feedback = getAsset(t.feedback);
const quoteReady = isVisible(feedback) && feedback.type === 'testimonial' && Boolean(feedback.quote);
// The quotation as one run of text, the approved phrases marked where they stand (each exactly once).
type Run = { text: string; em: boolean };
let quote: Run[] = [{ text: feedback.quote ?? '', em: false }];
for (const phrase of t.emphasis ?? []) {
  const hits = quote.filter((r) => !r.em && r.text.includes(phrase));
  const total = quote.reduce((n, r) => n + (r.em ? 0 : r.text.split(phrase).length - 1), 0);
  if (hits.length !== 1 || total !== 1) throw new Error(`[creator] the Trezor quotation must contain "${phrase}" exactly once`);
  quote = quote.flatMap((r) => {
    if (r !== hits[0]) return [r];
    const at = r.text.indexOf(phrase);
    return [
      { text: r.text.slice(0, at), em: false },
      { text: phrase, em: true },
      { text: r.text.slice(at + phrase.length), em: false },
    ].filter((x) => x.text);
  });
}
---

<section class="cmz" data-surface="light-return" aria-labelledby="cm-trezor-title">
  <div class="container cmz__inner">
    <header class="cmz__head">
      <p class="cmz__kicker">{t.kicker}</p>
      <h2 id="cm-trezor-title" class="display cmz__title">{t.title}</h2>
      <p class="cmz__deck">{t.deck}</p>
    </header>

    <div class="cmz__film">
      <CmFilm id={t.film} label={t.filmLabel} domId="cm-trezor-film" />
    </div>

    {
      brief.length > 0 && (
        <dl class="cmz__brief">
          {brief.map((b, i) => (
            <div class:list={['cmz__brief-item', !b.text && 'cmz__pending']} data-cm-reveal style={`--k: ${i}`}>
              <dt>{b.label}</dt>
              <dd>{b.text ?? `Placeholder · ${b.label}: two or three sentences from John.`}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      shownMetrics.length > 0 && (
        <div class="cmz__results" data-cm-reveal>
          <div class="cmz__results-head">
            <p class="cmz__label">{t.metricsLabel}</p>
            {t.metricsNote && <p class="cmz__results-note">{t.metricsNote}</p>}
          </div>
          <ul class="cmz__metrics">
            {shownMetrics.map(({ e, ready }) =>
              ready ? (
                <li class="cmz__metric" data-asset={e.id}>
                  <strong class="cmz__value">{e.value}</strong>
                  {e.metricLabel && <span class="cmz__metric-label">{e.metricLabel}</span>}
                  {e.metricNote && <span class="cmz__metric-note">{e.metricNote}</span>}
                </li>
              ) : (
                <li class="cmz__metric cmz__pending" data-asset={e.id} data-pending>
                  <strong class="cmz__value">Placeholder</strong>
                  <span class="cmz__metric-label">{e.label}: an exact, verified figure</span>
                </li>
              ),
            )}
          </ul>
        </div>
      )
    }

    {
      quoteReady && (
        <figure class="cmz__quote" data-cm-reveal>
          <blockquote>
            <p>
              {quote.map((r, i) => (r.em ? <em class="cmz__em" style={`--e: ${quote.slice(0, i).filter((x) => x.em).length}`}>{r.text}</em> : r.text))}
            </p>
          </blockquote>
          {feedback.attribution && <figcaption>{feedback.attribution}</figcaption>}
        </figure>
      )
    }
  </div>
</section>

<style>
  /* V1.2: with the collaboration block gone the section ends on the quotation,
     a little closer to the library it leads into. */
  .cmz {
    padding-block: var(--section-y) calc(var(--section-y) * 0.5);
    background: var(--bg);
  }

  .cmz__inner {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.75rem);
  }

  .cmz__head {
    display: grid;
    gap: 0.9rem;
    max-width: 54rem;
  }

  .cmz__kicker,
  .cmz__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .cmz__title {
    margin: 0;
    font-size: clamp(2.6rem, 1.3rem + 4vw, 5.5rem);
    line-height: 0.95;
  }

  .cmz__deck {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* ---- the brief: assignment, objective, approach --------------------------------- */
  .cmz__brief {
    display: grid;
    gap: 1.75rem;
    margin: 0;
  }

  .cmz__brief-item {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .cmz__brief-item dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cmz__brief-item dd {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (min-width: 56rem) {
    .cmz__brief {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
  }

  /* ---- performance highlights: a restrained row on a hairline, no cards ---------------- */
  .cmz__results {
    display: grid;
    gap: 1.25rem;
  }

  .cmz__results-head {
    display: grid;
    gap: 0.45rem;
  }

  .cmz__results-note {
    max-width: 44rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-3);
  }

  .cmz__metrics {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cmz__metric {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-strong);
  }

  .cmz__value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.375rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }

  .cmz__metric-label {
    font-size: var(--text-md);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .cmz__metric-note {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--ink-3);
  }

  @media (min-width: 56rem) {
    .cmz__metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- Trezor's feedback ------------------------------------------------------------ */
  .cmz__quote {
    display: grid;
    gap: 1.1rem;
    max-width: 62rem;
    margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
  }

  .cmz__quote blockquote {
    margin: 0;
  }

  .cmz__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.6rem, 1.05rem + 1.7vw, 2.75rem);
    line-height: 1.12;
    color: var(--heading);
    text-wrap: pretty;
  }

  .cmz__quote p::before {
    content: '“';
  }

  .cmz__quote p::after {
    content: '”';
  }

  /* The four phrases: the accent, over a soft underlay low on the line (each
     line of a phrase its own). It draws in once as the quotation arrives,
     then stays; nothing repeats. */
  .cmz__em {
    font-style: normal;
    color: var(--c-teal);
    background-image: linear-gradient(rgba(79, 145, 138, 0.2), rgba(79, 145, 138, 0.2));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 0.36em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .cmz__quote figcaption {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .cmz__quote figcaption::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: currentColor;
  }

  /* Authoring only: never in a production build. */
  .cmz__pending {
    padding: 0.75rem 0.9rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: repeating-linear-gradient(135deg, transparent 0 10px, color-mix(in srgb, var(--line) 45%, transparent) 10px 11px);
  }

  .cmz__pending :is(dd, .cmz__value, .cmz__metric-label) {
    color: var(--ink-3);
  }

  .cmz__pending .cmz__value {
    font-size: 1.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .cmz__quote:not(.is-in) .cmz__em {
      color: inherit;
      background-size: 0% 0.36em;
    }

    :global(html.js) .cmz__quote .cmz__em {
      transition:
        color 0.7s ease calc(0.55s + var(--e, 0) * 0.18s),
        background-size 0.9s cubic-bezier(0.45, 0, 0.2, 1) calc(0.55s + var(--e, 0) * 0.18s);
    }

    :global(html.js) .cmz [data-cm-reveal]:not(.is-in) {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }

    :global(html.js) .cmz [data-cm-reveal] {
      transition:
        opacity 0.9s ease calc(var(--k, 0) * 0.12s),
        transform 1s cubic-bezier(0.2, 0.75, 0.2, 1) calc(var(--k, 0) * 0.12s);
    }
  }
</style>
