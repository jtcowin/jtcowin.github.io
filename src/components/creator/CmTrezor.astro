---
/**
 * 10 Trezor Dare Ad (Creator Marketing and Partnerships, V1.4): led by the
 * final video (Trezor Dare Ad.mp4, with sound, on request), then, in this
 * order and revealed as the reader scrolls: the assignment, the objective and
 * the approach (John's words, V1.2: a lifestyle-led creative idea that
 * connected the device's features with culture and community, not a feature
 * list), three performance highlights and Trezor's feedback (the approved
 * quotation and its attribution).
 *
 * The highlights (V1.1) are the post's results on the creator's own account,
 * measured against its preceding 56 posts (V1.4): a rate, a multiple (V1.4:
 * "2.2x", which a screen reader hears as "2.2 times") and a ranking with its
 * percentile (V1.2: #2 by reach out of 56 posts, never "most-viewed"), never
 * a raw total. V1.3 gives them the scale and the
 * centered composition of the results under the Technical Product Marketing
 * film (TpmCampaign.astro), in this page's own palette and type: the label
 * centered above one balanced row of three equal columns (stacked on phones),
 * each a display-scale figure over a short caption, centered, with generous
 * space and nothing around them (no cards, tiles, pills, shadows, lines or
 * dashboard chrome). The percentile and the note on what the figures were
 * measured against follow as quieter centered lines under the row, so the
 * three columns stay even (V1.4: the note is one sentence, "Measured on the
 * creator's account against its preceding 56 posts."; the sentence calling
 * them creator-account results is gone).
 *
 * V1.3: four phrases inside the one continuous quotation (creator.json
 * `emphasis`) are set apart by type alone: the page's deep teal and a
 * slightly heavier weight, the rest of the quotation in its usual dark ink.
 * No marker, underlay, rectangle, underline, shadow, pill or badge. With
 * motion allowed the teal resolves once, as the quotation arrives, and then
 * stays; nothing pulses, sweeps or repeats. No pull quotes or checklist; the
 * collaboration block that sat under the quotation is gone (V1.2): the
 * credits keep that record, and the section resolves on the quotation into
 * the library that follows.
 */
import creator from '@data/creator.json';
import { getAsset, isVisible, SHOW_PLACEHOLDERS } from '@lib/assets';
import CmFilm from './CmFilm.astro';

const { trezor: t } = creator;
const brief = t.brief.filter((b) => b.text || SHOW_PLACEHOLDERS);
const metrics = t.metrics.map((id) => getAsset(id)).map((e) => ({ e, ready: isVisible(e) && e.type === 'metric' && Boolean(e.value) }));
const shownMetrics = metrics.filter((m) => m.ready || SHOW_PLACEHOLDERS);
// A highlight's own note (the ranking's percentile) reads under the row, so the three columns stay even (V1.3).
const metricNotes = shownMetrics.filter((m) => m.ready && m.e.metricNote).map((m) => m.e.metricNote as string);
const feedback = getAsset(t.feedback);
const quoteReady = isVisible(feedback) && feedback.type === 'testimonial' && Boolean(feedback.quote);
// The quotation as one run of text, the approved phrases marked where they stand (each exactly once).
type Run = { text: string; em: boolean };
let quote: Run[] = [{ text: feedback.quote ?? '', em: false }];
for (const phrase of t.emphasis ?? []) {
  const hits = quote.filter((r) => !r.em && r.text.includes(phrase));
  const total = quote.reduce((n, r) => n + (r.em ? 0 : r.text.split(phrase).length - 1), 0);
  if (hits.length !== 1 || total !== 1) throw new Error(`[creator] the Trezor quotation must contain "${phrase}" exactly once`);
  quote = quote.flatMap((r) => {
    if (r !== hits[0]) return [r];
    const at = r.text.indexOf(phrase);
    return [
      { text: r.text.slice(0, at), em: false },
      { text: phrase, em: true },
      { text: r.text.slice(at + phrase.length), em: false },
    ].filter((x) => x.text);
  });
}
---

<section class="cmz" data-surface="light-return" aria-labelledby="cm-trezor-title">
  <div class="container cmz__inner">
    <header class="cmz__head">
      <p class="cmz__kicker">{t.kicker}</p>
      <h2 id="cm-trezor-title" class="display cmz__title">{t.title}</h2>
      <p class="cmz__deck">{t.deck}</p>
    </header>

    <div class="cmz__film">
      <CmFilm id={t.film} label={t.filmLabel} domId="cm-trezor-film" />
    </div>

    {
      brief.length > 0 && (
        <dl class="cmz__brief">
          {brief.map((b, i) => (
            <div class:list={['cmz__brief-item', !b.text && 'cmz__pending']} data-cm-reveal style={`--k: ${i}`}>
              <dt>{b.label}</dt>
              <dd>{b.text ?? `Placeholder · ${b.label}: two or three sentences from John.`}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      shownMetrics.length > 0 && (
        <div class="cmz__results" data-cm-reveal>
          <p class="cmz__label">{t.metricsLabel}</p>
          <ul class="cmz__metrics">
            {shownMetrics.map(({ e, ready }) =>
              ready ? (
                <li class="cmz__metric" data-asset={e.id}>
                  <strong class="cmz__value">
                    {e.metricSpoken ? (
                      <>
                        <span aria-hidden="true">{e.value}</span>
                        <span class="sr-only">{e.metricSpoken}</span>
                      </>
                    ) : (
                      e.value
                    )}
                  </strong>
                  {e.metricLabel && <span class="cmz__metric-label">{e.metricLabel}</span>}
                </li>
              ) : (
                <li class="cmz__metric cmz__pending" data-asset={e.id} data-pending>
                  <strong class="cmz__value">Placeholder</strong>
                  <span class="cmz__metric-label">{e.label}: an exact, verified figure</span>
                </li>
              ),
            )}
          </ul>
          <div class="cmz__results-foot">
            {metricNotes.map((note) => <p class="cmz__results-line">{note}</p>)}
            {t.metricsNote && <p class="cmz__results-note">{t.metricsNote}</p>}
          </div>
        </div>
      )
    }

    {
      quoteReady && (
        <figure class="cmz__quote" data-cm-reveal>
          <blockquote>
            <p>
              {quote.map((r, i) => (r.em ? <em class="cmz__em" style={`--e: ${quote.slice(0, i).filter((x) => x.em).length}`}>{r.text}</em> : r.text))}
            </p>
          </blockquote>
          {feedback.attribution && <figcaption>{feedback.attribution}</figcaption>}
        </figure>
      )
    }
  </div>
</section>

<style>
  /* V1.2: with the collaboration block gone the section ends on the quotation,
     a little closer to the library it leads into. */
  .cmz {
    padding-block: var(--section-y) calc(var(--section-y) * 0.5);
    background: var(--bg);
  }

  .cmz__inner {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.75rem);
  }

  .cmz__head {
    display: grid;
    gap: 0.9rem;
    max-width: 54rem;
  }

  .cmz__kicker,
  .cmz__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-teal);
  }

  .cmz__title {
    margin: 0;
    font-size: clamp(2.6rem, 1.3rem + 4vw, 5.5rem);
    line-height: 0.95;
  }

  .cmz__deck {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* ---- the brief: assignment, objective, approach --------------------------------- */
  .cmz__brief {
    display: grid;
    gap: 1.75rem;
    margin: 0;
  }

  .cmz__brief-item {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .cmz__brief-item dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cmz__brief-item dd {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (min-width: 56rem) {
    .cmz__brief {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
  }

  /* ---- performance highlights (V1.3): the scale and centered composition of the
     results under the Technical Product Marketing film, in this page's palette and
     type: a centered label, one balanced row of three equal columns (stacked on
     phones), display-scale figures over short captions, nothing around them ------ */
  .cmz__results {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    margin-block: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    text-align: center;
  }

  .cmz__metrics {
    display: grid;
    gap: clamp(2rem, 1.25rem + 2.5vw, 3rem);
    width: 100%;
    max-width: 68rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cmz__metric {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.7rem;
  }

  .cmz__value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--heading);
  }

  .cmz__metric-label {
    max-width: 16em;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-2);
    text-wrap: balance;
  }

  .cmz__results-foot {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }

  .cmz__results-line {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--ink-2);
    text-wrap: balance;
  }

  .cmz__results-note {
    max-width: 44rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-3);
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .cmz__metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
  }

  /* ---- Trezor's feedback ------------------------------------------------------------ */
  .cmz__quote {
    display: grid;
    gap: 1.1rem;
    max-width: 62rem;
    margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
  }

  .cmz__quote blockquote {
    margin: 0;
  }

  .cmz__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.6rem, 1.05rem + 1.7vw, 2.75rem);
    line-height: 1.12;
    color: var(--heading);
    text-wrap: pretty;
  }

  .cmz__quote p::before {
    content: '“';
  }

  .cmz__quote p::after {
    content: '”';
  }

  /* The four phrases (V1.3): set apart by type alone, the page's deep teal and a
     slightly heavier weight; no marker, underlay or line. */
  .cmz__em {
    font-style: normal;
    font-weight: 800;
    color: var(--c-teal);
  }

  .cmz__quote figcaption {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .cmz__quote figcaption::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: currentColor;
  }

  /* Authoring only: never in a production build. */
  .cmz__pending {
    padding: 0.75rem 0.9rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: repeating-linear-gradient(135deg, transparent 0 10px, color-mix(in srgb, var(--line) 45%, transparent) 10px 11px);
  }

  .cmz__pending :is(dd, .cmz__value, .cmz__metric-label) {
    color: var(--ink-3);
  }

  .cmz__pending .cmz__value {
    font-size: 1.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The teal resolves once, phrase after phrase, as the quotation arrives. */
    :global(html.js) .cmz__quote:not(.is-in) .cmz__em {
      color: inherit;
    }

    :global(html.js) .cmz__quote .cmz__em {
      transition: color 0.9s ease calc(0.55s + var(--e, 0) * 0.18s);
    }

    :global(html.js) .cmz [data-cm-reveal]:not(.is-in) {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }

    :global(html.js) .cmz [data-cm-reveal] {
      transition:
        opacity 0.9s ease calc(var(--k, 0) * 0.12s),
        transform 1s cubic-bezier(0.2, 0.75, 0.2, 1) calc(var(--k, 0) * 0.12s);
    }
  }
</style>
