---
/**
 * 06 Program context (Creator Marketing and Partnerships, V1.3): no kicker
 * (V1.2), John's headline ("Each destination became a campaign in motion.",
 * its closing phrase in the accent) and one paragraph on what he led and
 * helped plan, naming no collaborators: they are credited once, in the
 * credits. V1.3: beneath the paragraph, one smaller, quieter line on the
 * roster (eight creators, the fields they came from), set apart from the
 * paragraph rather than as a second paragraph of equal weight: no names,
 * handles, pictures, follower counts, categories or travel histories (the
 * creators appear in the credits, by their handles since V1.4). The creator
 * network that followed is gone, so the section leads straight into the campaign atlas. No services
 * grid and no list of roles.
 *
 * V1.4, one centered editorial introduction in place of the split headline and
 * paragraph: the headline at the top center in a narrow measure (16ch, the
 * width at which this face sets it in three balanced lines, "Each destination
 * / became a campaign / in motion.", four on the narrowest phones), "a
 * campaign in motion." still in the teal;
 * the paragraph beneath it at a readable measure (about 46rem); then a short
 * centered rule and, under it, the roster line, smaller and quieter (no card,
 * pill, badge or box). More room above and below than V1.3, so it opens the
 * chapter with confidence, and an ordinary section end straight into Costa
 * Rica. On phones (Mobile Optimization V1) all three stay centered, as one
 * composition, on a slightly wider measure (1rem at the sides); before, the
 * paragraph and the roster line set left there. The headline rises into place first, the paragraph follows with a
 * short upward fade and the roster line comes last; with reduced motion they
 * are simply there.
 *
 * Full Site Iteration V1: the paragraph takes a wider measure (56rem, the same
 * type size), so it sets in fewer, longer lines at desktop sizes and reads as
 * one open supporting block under the headline; it stays centered, with the
 * short rule and the roster line beneath it. One phrase in it, "I led campaign
 * strategy with co-sponsors" (creator.json `emphasis`), carries the site's
 * paragraph emphasis, and the roster line names no count of creators.
 */
import creator from '@data/creator.json';
import { emphasize } from '@lib/tpm-copy';

const { context: c } = creator;
if (!c.roster || /@|\bfollowers?\b|https?:/i.test(c.roster)) throw new Error('[creator] the program context carries one roster line, with no handles, links or follower counts');
const sentences = c.headline.split(/(?<=[.!?])\s+/);
const lines = sentences.map((line) => (line.includes(c.accent) ? emphasize(line, c.accent, 'creator context headline') : [{ text: line, em: false }]));
if (/\b(?:\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\s+creators\b/i.test(c.roster)) throw new Error('[creator] the roster line names no count of creators (Full Site Iteration V1)');
const copy = emphasize(c.copy, c.emphasis, 'creator program paragraph');
// Mobile Optimization V1: "I" never ends a line alone (a no-break space binds it
// to the word after it), which a centered line on a phone would make plain.
const bindI = (text: string) => text.replace(/(^|\s)I (?=\S)/g, '$1I\u00a0');
// On a phone a hyphenated compound ("co-sponsors") is not split across two
// centered lines; elsewhere the span changes nothing.
const parts = (text: string) => bindI(text).split(/(\S+-\S+)/).filter(Boolean).map((t) => ({ t, compound: /^\S+-\S+$/.test(t) }));
---

<section class="cmx" data-surface="light" aria-labelledby="cm-context-title">
  <div class="container cmx__inner">
    <h2 id="cm-context-title" class="display cmx__title" data-cm-reveal>
      {
        lines.map((line, i) => [
          i ? ' ' : '',
          <span class="cm-cut" style={`--k: ${i}`}>
            <span>{line.map(({ text, em }) => (em ? <span class="cmx__accent">{text}</span> : text))}</span>
          </span>,
        ])
      }
    </h2>
    <div class="cmx__words">
      <p class="cmx__copy" data-cm-reveal>
        {
          copy.map(({ text, em }) => {
            const run = parts(text).map((p) => (p.compound ? <span class="cmx__compound">{p.t}</span> : p.t));
            return em ? <strong class="em-key">{run}</strong> : run;
          })
        }
      </p>
      <p class="cmx__roster" data-cm-reveal>{c.roster}</p>
    </div>
  </div>
</section>

<style>
  /* One centered editorial composition (V1.4), with more room around it than V1.3's
     split layout, ending in an ordinary section end straight into the atlas. */
  .cmx {
    position: relative;
    padding-block: calc(var(--section-y) * 1.15) clamp(4rem, 3rem + 4vw, 6.5rem);
    background: var(--bg);
  }

  .cmx__inner {
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 1.2rem + 1.8vw, 3rem);
    text-align: center;
  }

  /* The headline at the top center in a narrow measure, its lines balanced: three
     in this face (four on the narrowest phones). */
  .cmx__title {
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(2.5rem, 1.25rem + 3.9vw, 5.5rem);
    line-height: 0.96;
    text-wrap: balance;
  }

  .cmx__title :global(.cm-cut) {
    display: block;
  }

  .cmx__accent {
    color: var(--c-teal);
  }

  /* Full Site Iteration V1: a wider measure (V1.4's was 46rem), the same type size. */
  .cmx__words {
    display: grid;
    justify-items: center;
    width: 100%;
    max-width: 56rem;
  }

  .cmx__copy {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* The roster line (V1.3): a supporting note under the paragraph, smaller and
     quieter, not a second paragraph of the same weight. V1.4: set apart by a
     short centered rule and a little more space, nothing around it. */
  .cmx__roster {
    display: grid;
    justify-items: center;
    gap: clamp(1.1rem, 0.9rem + 0.6vw, 1.5rem);
    max-width: 34rem;
    margin: clamp(1.75rem, 1.4rem + 1vw, 2.5rem) 0 0;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  .cmx__roster::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  /* Phones (Mobile Optimization V1): the headline, the paragraph and the roster
     line all centered, one composition as on wider screens (the paragraph and
     the roster line set left before), on a slightly wider measure, so the
     centered lines run longer. */
  @media (max-width: 39.99rem) {
    .cmx__inner {
      padding-inline: 1rem;
    }

    .cmx__compound {
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) :is(.cmx__copy, .cmx__roster):not(.is-in) {
      opacity: 0;
      transform: translate3d(0, 0.75rem, 0);
    }

    :global(html.js) .cmx__copy {
      transition:
        opacity 0.8s ease 0.25s,
        transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1) 0.25s;
    }

    :global(html.js) .cmx__roster {
      transition:
        opacity 0.8s ease 0.5s,
        transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1) 0.5s;
    }
  }
</style>
