---
/**
 * 06 Program context (Creator Marketing and Partnerships, V1.2): no kicker
 * (V1.2), John's headline ("Each destination became a campaign in motion.",
 * its closing phrase in the accent) and one paragraph on what he led and
 * helped plan, naming no collaborators: they are credited once, in the
 * credits. No services grid and no list of roles, and no drawn route (V1.2:
 * the network it led into is no longer a ring). The headline rises once into
 * place and the paragraph follows; with reduced motion they are simply there.
 */
import creator from '@data/creator.json';
import { emphasize } from '@lib/tpm-copy';

const { context: c } = creator;
const sentences = c.headline.split(/(?<=[.!?])\s+/);
const lines = sentences.map((line) => (line.includes(c.accent) ? emphasize(line, c.accent, 'creator context headline') : [{ text: line, em: false }]));
---

<section class="cmx" data-surface="light" aria-labelledby="cm-context-title">
  <div class="container cmx__inner">
    <h2 id="cm-context-title" class="display cmx__title" data-cm-reveal>
      {
        lines.map((line, i) => [
          i ? ' ' : '',
          <span class="cm-cut" style={`--k: ${i}`}>
            <span>{line.map(({ text, em }) => (em ? <span class="cmx__accent">{text}</span> : text))}</span>
          </span>,
        ])
      }
    </h2>
    <p class="cmx__copy" data-cm-reveal>{c.copy}</p>
  </div>
</section>

<style>
  .cmx {
    position: relative;
    padding-block: calc(var(--section-y) * 0.9) clamp(2.5rem, 6vw, 4rem);
    background: var(--bg);
  }

  .cmx__inner {
    display: grid;
    gap: clamp(1.25rem, 0.9rem + 1.2vw, 2rem);
  }

  .cmx__title {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.35rem, 1.2rem + 3.6vw, 5rem);
    line-height: 0.98;
  }

  .cmx__title :global(.cm-cut) {
    display: block;
  }

  .cmx__accent {
    color: var(--c-teal);
  }

  .cmx__copy {
    max-width: 44rem;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .cmx__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 7rem);
      align-items: end;
    }

    .cmx__copy {
      padding-bottom: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .cmx__copy:not(.is-in) {
      opacity: 0;
      transform: translate3d(0, 0.75rem, 0);
    }

    :global(html.js) .cmx__copy {
      transition:
        opacity 0.8s ease 0.2s,
        transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1) 0.2s;
    }
  }
</style>
