---
import site from '@data/site.json';
import { withBase } from '@lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__line">{site.footer.line}</p>
    <ul class="site-footer__links">
      <li><a href={withBase('/#work')}>Work</a></li>
      <li><a href={withBase('/#about')}>About</a></li>
      <li><a href={withBase(site.resumePath)} download>Resume</a></li>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
    <p class="site-footer__meta mono">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-7);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
  }

  .site-footer__line {
    color: var(--ink-2);
    font-weight: 500;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .site-footer__links a {
    text-decoration: none;
    color: var(--ink-3);
  }

  .site-footer__links a:hover {
    color: var(--accent-ink);
  }

  .site-footer__meta {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .site-footer__meta {
      grid-column: 1 / -1;
    }
  }
</style>
