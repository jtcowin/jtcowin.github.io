---
import home from '@data/home.json';
import Icon from './Icon.astro';

const { capabilities } = home;
---

<section id="capabilities" class="section capabilities" aria-labelledby="capabilities-heading">
  <div class="container">
    <div class="section-head">
      <h2 id="capabilities-heading" class="display display-lg">{capabilities.heading}</h2>
    </div>
    <ul class="cap__list">
      {
        capabilities.items.map((item) => (
          <li class="cap">
            <span class="cap__icon" aria-hidden="true">
              <Icon name={item.icon as any} size={20} />
            </span>
            <h3 class="cap__title">{item.title}</h3>
            <p class="cap__copy">{item.copy}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .capabilities {
    background: var(--bg-elev);
    border-block: 1px solid var(--line);
  }

  .cap__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-rows: auto auto auto;
  }

  /* Subgrid keeps the icon, headline and copy of every card on the same three
     baselines, so a two-line title never pushes its body copy out of step. */
  .cap {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    gap: var(--space-3);
    padding: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(15, 110, 99, 0.05), rgba(15, 110, 99, 0) 42%),
      var(--bg);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .cap:hover {
    border-color: var(--accent-line);
  }

  .cap__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
  }

  .cap__title {
    align-self: start;
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .cap__copy {
    align-self: start;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .cap__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .cap__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
