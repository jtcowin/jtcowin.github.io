---
/**
 * From positioning to production: what John does, how he works, and the tools
 * he works with, in one section that fits one desktop frame.
 *
 * The upper composition: the headline and the short working-style statement
 * (How I Work) on the left, the four capability groups on the right, their
 * last rule level with the foot of the statement. Then, clearly separated and
 * full width, the Stack: 18 tools in three compact groups. Every tool shows
 * its own brand artwork in the same neutral tile, sized to one optical scale
 * (`scale` in home.json nudges marks that read large or small, and the MDX
 * wordmark is set wide rather than squeezed into a square), with its name
 * beneath. The files are the approved SVGs in src/assets/stack, shown as
 * images, so each keeps its own colors and its internal ids cannot collide.
 *
 * The capability rows respond to the pointer and to keyboard focus: the icon
 * lifts a few pixels, grows very slightly and, where the symbol suits it,
 * tilts a degree or two, while its circle picks up a little more teal. Only
 * the icon moves; the text never shifts. With reduced motion the same state
 * is shown by color alone. Nothing on the rows depends on hover.
 *
 * From 64rem the type and spacing scale with the smaller of the viewport's
 * width and its height (read as a 16:9 frame), as in About, and the Stack's
 * tiles scale with the frame's height, so the section fits one screen from
 * 16:9 laptops to large desktops. Spare height is shared out: a little above
 * the content, a little more between the upper composition and the Stack, the
 * rest below. Phones and tablets stack and scroll.
 */
import { Image } from 'astro:assets';
import home from '@data/home.json';
import { resolveAssetFile } from '@lib/assets';
import Icon from './Icon.astro';

type Tool = { name: string; logo: string; scale?: number; shape?: 'wide' };
const { practice } = home as unknown as {
  practice: {
    heading: string;
    how: { label: string; copy: string };
    capabilities: { label: string; items: { title: string; icon: string; tilt?: number }[] };
    stack: { label: string; groups: { group: string; tools: Tool[] }[] };
  };
};

const groups = practice.stack.groups.map((g) => ({
  ...g,
  cols: Math.ceil(g.tools.length / 2),
  tools: g.tools.map((t) => ({ ...t, img: resolveAssetFile(t.logo) })),
}));
---

<section id="capabilities" class="section practice" aria-labelledby="practice-heading">
  <div class="container practice__frame">
    <div class="practice__top">
      <div class="practice__intro">
        <h2 id="practice-heading" class="display practice__heading">{practice.heading}</h2>
        <h3 class="practice__label">{practice.how.label}</h3>
        <p class="practice__statement">{practice.how.copy}</p>
      </div>

      <div class="practice__caps">
        <h3 class="practice__label">{practice.capabilities.label}</h3>
        <ol class="caps">
          {
            practice.capabilities.items.map((item, i) => (
              <li class="cap" tabindex="0" style={item.tilt ? `--tilt: ${item.tilt}deg` : undefined}>
                <span class="cap__icon" aria-hidden="true">
                  <Icon name={item.icon as any} size={18} />
                </span>
                <span class="cap__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="cap__title">{item.title}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="practice__stack">
      <h3 class="practice__label">{practice.stack.label}</h3>
      <div class="stack">
        {
          groups.map((g) => (
            <div class="stack__group" style={`--cols: ${g.cols}`}>
              <h4 class="stack__name">{g.group}</h4>
              <ul class="stack__tools">
                {g.tools.map((t) => (
                  <li class:list={['tool', t.shape === 'wide' && 'tool--wide']} style={t.scale ? `--s: ${t.scale}` : undefined}>
                    <span class="tool__tile" aria-hidden="true">
                      {t.img && <Image src={t.img} alt="" class="tool__logo" loading="lazy" decoding="async" />}
                    </span>
                    <span class="tool__name">{t.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .practice {
    /* Brand artwork size inside each neutral tile, and the tile around it. */
    --mark: 2.5rem;
    --tile: calc(var(--mark) * 1.4);
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .practice__heading {
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
    font-size: var(--text-2xl);
    max-width: none;
    text-wrap: balance;
  }

  /* Compact metadata labels: How I Work, Capabilities, Stack. */
  .practice__label {
    margin: 0 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .practice__top {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .practice__statement {
    margin: 0;
    max-width: 34em;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---- capabilities ----------------------------------------------------- */
  .caps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    column-gap: var(--space-6);
    border-top: 1px solid var(--line-strong);
  }

  .cap {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.85rem;
    padding-block: clamp(0.9rem, 0.7rem + 0.6vw, 1.25rem);
    border-bottom: 1px solid var(--line-strong);
    border-radius: 2px;
  }

  /* Keyboard focus: the same response as the pointer, plus the site's focus
     ring, set a little wider so the raised icon never touches it. */
  .cap:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .cap__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
    box-shadow: 0 0 0 1px transparent;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cap:focus-visible .cap__icon {
    transform: translateY(-3.5px) scale(1.06) rotate(var(--tilt, 0deg));
    background: color-mix(in srgb, var(--accent) 18%, var(--bg));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Hover only where hover is real, so a tap never leaves a row raised. */
  @media (hover: hover) and (pointer: fine) {
    .cap:hover .cap__icon {
      transform: translateY(-3.5px) scale(1.06) rotate(var(--tilt, 0deg));
      background: color-mix(in srgb, var(--accent) 18%, var(--bg));
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
    }
  }

  .cap__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .cap__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: var(--display-stretch);
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.375rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--heading);
  }

  /* ---- stack ------------------------------------------------------------ */
  .practice__stack {
    margin-top: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }

  .stack {
    display: grid;
    gap: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
  }

  .stack__group {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    min-width: 0;
  }

  .stack__name {
    margin: 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .stack__tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr));
    gap: 1rem 0.5rem;
  }

  .tool {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.45rem;
    min-width: 0;
    text-align: center;
  }

  /* One neutral tile for every tool, whatever the mark's own shape. */
  .tool__tile {
    display: grid;
    place-items: center;
    width: var(--tile);
    height: var(--tile);
    border: 1px solid var(--line);
    border-radius: calc(var(--tile) * 0.24);
    background: color-mix(in srgb, var(--bg-elev) 40%, #ffffff);
  }

  .tool__tile :global(.tool__logo) {
    display: block;
    width: calc(var(--mark) * var(--s, 1));
    height: calc(var(--mark) * var(--s, 1));
    object-fit: contain;
  }

  /* The MDX badge is a wide bar drawn across the middle of a square canvas,
     so its box grows until the bar spans most of the tile's width. */
  .tool--wide .tool__tile :global(.tool__logo) {
    width: calc(var(--mark) * 1.2);
    height: calc(var(--mark) * 1.2);
  }

  .tool__name {
    max-width: 100%;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink-2);
    text-wrap: balance;
  }

  /* ---- desktop: the whole section in one frame ------------------------- */
  @media (min-width: 64rem) {
    .practice {
      --fit: min(1vw, 1.8vh);
      --view-h: 100vh;
      /* Icon artwork: about 42px on a 1280 x 720 frame, 48px at 1440 x 900,
         56px from 1080px tall. */
      --mark: clamp(2.5rem, calc(1rem + 3.6 * var(--view-h) / 100), 3.5rem);
      --tile: calc(var(--mark) * 1.38);
      display: flex;
      flex-direction: column;
      min-height: min(100vh, 62.5vw);
      padding-block: calc(var(--nav-h) + 1.4 * var(--fit)) clamp(1.25rem, calc(3 * var(--view-h) / 100), 3rem);
    }

    @supports (height: 1svh) {
      .practice {
        --fit: min(1vw, 1.8svh);
        --view-h: 100svh;
        min-height: min(100svh, 62.5vw);
      }
    }

    /* Spare height: one part above the content, one more between the upper
       composition and the Stack (at most 2rem of it), two below. A tight
       frame keeps only the Stack's own margin. */
    .practice::before,
    .practice::after {
      content: '';
    }

    .practice::before {
      flex: 1 1 0;
    }

    .practice::after {
      flex: 2 1 0;
    }

    .practice__frame {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
    }

    .practice__heading {
      font-size: min(calc(4.6 * var(--fit)), 5rem);
      line-height: 0.98;
      margin-bottom: calc(2.8 * var(--fit));
    }

    /* The headline and statement on the left; the capabilities on the right,
       their last rule level with the foot of the statement. */
    .practice__top {
      grid-template-columns: minmax(0, 7.6fr) minmax(0, 4.4fr);
      column-gap: min(5 * var(--fit), 5.5rem);
      align-items: end;
    }

    /* A measure wide enough to set the statement in four even lines. */
    .practice__statement {
      max-width: 36em;
      font-size: clamp(1.0625rem, calc(0.35rem + 1.1 * var(--fit)), 1.5rem);
    }

    .caps {
      grid-template-columns: minmax(0, 1fr);
    }

    .cap {
      padding-block: calc(0.95 * var(--fit));
    }

    /* On short windows the icon circles give up a few pixels, so the rows and
       the Stack still fit the browser window of a 1366 x 768 laptop. */
    .cap__icon {
      width: clamp(2rem, calc(4.9 * var(--view-h) / 100), 2.25rem);
      height: clamp(2rem, calc(4.9 * var(--view-h) / 100), 2.25rem);
    }

    .cap__title {
      font-size: clamp(1.1rem, calc(0.35rem + 1.15 * var(--fit)), 1.625rem);
    }

    /* A clear break between the upper composition and the Stack, which
       grows by the Stack's share of any spare height. */
    .practice__stack {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      margin-top: clamp(2.75rem, calc(7 * var(--view-h) / 100), 6rem);
    }

    .practice__stack::before {
      content: '';
      flex: 1 1 0;
      max-height: 2rem;
    }

    /* The groups sit side by side, each two rows deep, so every tile keeps
       the same width across the three groups. */
    .stack {
      grid-template-columns: 3fr 4fr 3fr;
      column-gap: calc(3 * var(--fit));
    }

    .stack__group {
      gap: calc(0.9 * var(--fit));
    }

    .stack__tools {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      gap: calc(1 * var(--fit)) calc(0.5 * var(--fit));
    }

    .tool {
      gap: calc(0.45 * var(--fit));
    }

    .tool__name {
      font-size: clamp(0.75rem, calc(0.9 * var(--fit)), 0.875rem);
    }
  }

  /* Reduced motion: the active row is shown by color alone. */
  @media (prefers-reduced-motion: reduce) {
    .cap__icon {
      transition:
        background-color 220ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .cap:focus-visible .cap__icon,
    .cap:hover .cap__icon {
      transform: none !important;
    }
  }
</style>
