---
/**
 * 06 Flagship animation campaign (Technical Product Marketing, V1.2): the
 * one-minute film that explained the product on Bolt Liquidity's X profile.
 * It keeps the information structure of the Website and Technical
 * documentation chapters (headline, metadata row, one paragraph on John's
 * contribution, centered here, one dominant visual) but no device around the
 * visual: the film plays in a large, nearly full-width 16:9 frame on the dark
 * ground, sized so the whole frame fits the screen, and runs edge to edge on
 * phones. The launch results follow it.
 *
 * The film is the complete approved cut with its music, voiceover and sound
 * effects. It plays silently, once, when the frame is well in view (not for
 * reduced motion or a data-saving preference), pauses when it leaves and
 * holds its final frame; "Play with sound" stays on it until the reader takes
 * it up, then the film starts again from 00:00 with sound and standard
 * controls replace the button (Film, tpm-motion.ts). Every spoken line also
 * appears on screen, so there is no caption track (see the asset's source
 * note). Without JavaScript the film keeps its poster and the browser's own
 * controls.
 */
import { Picture } from 'astro:assets';
import tpm from '@data/tpm.json';
import { getAsset, resolveImage } from '@lib/assets';
import { withBase } from '@lib/paths';
import Icon from '@components/Icon.astro';
import TpmCase from './TpmCase.astro';

const { campaign } = tpm;
const media = getAsset(campaign.media);
const poster = resolveImage(media);
const src = (file: string | null | undefined) => (file ? withBase(`/media/${file}`) : null);
const large = src(media.file);
const small = src(media.fileSmall);
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
// A hyphenated word in a label never breaks at its hyphen.
const words = (text: string) => text.split(/(\s+)/).map((t) => ({ t, keep: t.includes('-') }));
const { results } = campaign;
---

<TpmCase
  id="tpm-campaign-title"
  title={campaign.title}
  meta={campaign.meta}
  contribution={campaign.contribution}
  columns="minmax(0, 1.5fr) minmax(0, 1.2fr) minmax(0, 0.8fr)"
  surface="dark"
  align="center"
  class="tpm-campaign"
>
  <figure class="tpm-film" data-tpm-film data-label={media.label} data-mode="muted" data-state="idle">
    <div class="tpm-film__screen" style={media.plate ? `--plate: ${media.plate}` : undefined}>
      {poster && <Picture src={poster} alt="" widths={[640, 960, 1280, 1600, 1920]} sizes="(min-width: 48rem) min(94vw, 120rem), 100vw" formats={['avif', 'webp']} loading="lazy" class="tpm-film__poster" />}
      <video class="tpm-film__video" muted playsinline preload="none" controls aria-label={media.alt}>
        {small && <source src={small} media="(max-width: 47.99rem)" type="video/mp4" />}
        {large && <source src={large} type="video/mp4" />}
      </video>
    </div>
    <div class="tpm-film__ui">
      <button type="button" class="tpm-film__sound" data-film-sound hidden>
        <Icon name="sound" size={18} />
        <span>Play with sound</span>
      </button>
      <button type="button" class="tpm-film__quiet" data-film-quiet aria-label={`Play video without sound: ${media.label}`} hidden>
        <span class="tpm-film__icon tpm-film__icon--play"><Icon name="play" size={12} /></span>
        <span class="tpm-film__icon tpm-film__icon--pause"><Icon name="pause" size={12} /></span>
        <span class="tpm-film__icon tpm-film__icon--replay"><Icon name="replay" size={15} /></span>
      </button>
      <div class="tpm-film__controls" role="group" aria-label={`Video controls: ${media.label}`} data-film-controls hidden>
        <button type="button" class="tpm-film__control" data-film-mute>
          <span class="tpm-film__icon tpm-film__icon--sound"><Icon name="sound" size={16} /></span>
          <span class="tpm-film__icon tpm-film__icon--muted"><Icon name="muted" size={16} /></span>
          <span data-text>Mute</span>
        </button>
        <button type="button" class="tpm-film__control" data-film-play>
          <span class="tpm-film__icon tpm-film__icon--pause"><Icon name="pause" size={13} /></span>
          <span class="tpm-film__icon tpm-film__icon--play"><Icon name="play" size={13} /></span>
          <span data-text>Pause</span>
        </button>
        <button type="button" class="tpm-film__control" data-film-replay>
          <span class="tpm-film__icon"><Icon name="replay" size={15} /></span>
          <span>Replay</span>
        </button>
      </div>
    </div>
  </figure>

  <div class="container tpm-results">
    <h3 id="tpm-results-title" class="tpm-results__label">{results.label}</h3>
    <ul class="tpm-results__primary">
      {
        results.primary.map((m) => (
          <li class="tpm-results__item">
            <span class="tpm-results__value">
              {m.spoken ? (
                <>
                  <span aria-hidden="true">{m.value}</span>
                  <span class="sr-only">{m.spoken}</span>
                </>
              ) : (
                m.value
              )}
            </span>{' '}
            <span class="tpm-results__what">{words(m.label).map(({ t, keep }) => (keep ? <span class="tpm-results__keep">{t}</span> : t))}</span>
          </li>
        ))
      }
    </ul>
    <ul class="tpm-results__supporting">
      {
        results.supporting.map((line) => (
          <li>{rich(line).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</li>
        ))
      }
    </ul>
  </div>
</TpmCase>

<script>
  import { Film, reducedMotion } from '@lib/tpm-motion';

  const figure = document.querySelector<HTMLElement>('[data-tpm-film]');

  if (figure) {
    new Film(figure, { threshold: 0.5 });

    // A short, restrained rise as the frame comes into view.
    if (!reducedMotion() && 'IntersectionObserver' in window) {
      const rect = figure.getBoundingClientRect();
      if (rect.top > window.innerHeight) {
        figure.classList.add('is-pending');
        const io = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            io.disconnect();
            figure.classList.remove('is-pending');
          },
          { threshold: 0.1 },
        );
        io.observe(figure);
      }
    }
  }
</script>

<style>
  /* ---- the frame: nearly the full width, and all of it on screen at once below
     the header ---------------------------------------------------------------- */
  .tpm-film {
    --film-edge: clamp(0.75rem, 2.5vw, 3rem);

    position: relative;
    width: min(100% - 2 * var(--film-edge), (100vh - var(--header-row) - 2.5rem) * 16 / 9, 120rem);
    margin: clamp(2.5rem, 2rem + 4vw, 6rem) auto 0;
    transition:
      transform 1.1s var(--ease-out),
      opacity 0.9s var(--ease-out);
  }

  @supports (height: 1svh) {
    .tpm-film {
      width: min(100% - 2 * var(--film-edge), (100svh - var(--header-row) - 2.5rem) * 16 / 9, 120rem);
    }
  }

  .tpm-film.is-pending {
    opacity: 0;
    transform: translate3d(0, 40px, 0);
    /* Hidden at once, so it never fades out on its way to the entrance. */
    transition: none;
  }

  .tpm-film__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    background: var(--plate, #0f1213);
  }

  /* Phones: the film edge to edge. */
  @media (max-width: 47.99rem) {
    .tpm-film {
      width: 100%;
    }
  }

  @media (min-width: 48rem) {
    .tpm-film__screen {
      border-radius: clamp(6px, 0.8vw, 12px);
      box-shadow:
        0 0 0 1px rgba(237, 240, 239, 0.09),
        0 40px 90px -50px rgba(0, 0, 0, 0.9);
    }
  }

  .tpm-film__screen :global(picture),
  .tpm-film__poster,
  .tpm-film__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* With scripts, invisible until its first frame is on screen, then over the
     poster for good: when it ends it keeps its last frame. Without them, the
     browser's own controls over the poster. */
  :global(.js) .tpm-film__video {
    opacity: 0;
  }

  :global(.js) .tpm-film__video[data-shown] {
    opacity: 1;
    transition: opacity 0.4s var(--ease-out);
  }

  /* ---- the controls ---------------------------------------------------------------
     On the film, at its lower left; on phones, where the film is small, just
     beneath it, so nothing covers the picture. */
  .tpm-film__ui {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem var(--gutter) 0;
  }

  :global(html:not(.js)) .tpm-film__ui {
    display: none;
  }

  @media (min-width: 48rem) {
    .tpm-film__ui {
      position: absolute;
      left: clamp(0.75rem, 2%, 1.5rem);
      bottom: clamp(0.75rem, 2.6%, 1.5rem);
      z-index: 2;
      max-width: calc(100% - 1.5rem);
      padding: 0;
    }
  }

  /* The call to play with sound: the most prominent thing on the film until it
     is taken up. */
  .tpm-film__sound {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 2.75rem;
    padding: 0.65em 1.15em 0.65em 0.95em;
    border: 0;
    border-radius: 999px;
    background: #f2f1ec;
    color: var(--c-ink);
    font-family: var(--font-sans);
    font-size: clamp(0.875rem, 0.7rem + 0.35vw, 1.125rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    cursor: pointer;
    box-shadow:
      0 0 0 1px rgba(13, 15, 16, 0.1),
      0 12px 26px -12px rgba(0, 0, 0, 0.7);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .tpm-film__sound:hover {
    background: #ffffff;
  }

  .tpm-film__sound:active {
    transform: scale(0.98);
  }

  .tpm-film__sound :global(svg) {
    flex: none;
  }

  /* The small pause, play or replay beside it while the film runs silently. */
  .tpm-film__quiet {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(237, 240, 239, 0.35);
    border-radius: 50%;
    background: rgba(13, 15, 16, 0.62);
    color: #f2f1ec;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .tpm-film__quiet:hover {
    background: rgba(13, 15, 16, 0.85);
  }

  /* With sound: mute or unmute, pause or play, replay. */
  .tpm-film__controls {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.25rem;
    border: 1px solid rgba(237, 240, 239, 0.22);
    border-radius: 999px;
    background: rgba(13, 15, 16, 0.66);
    backdrop-filter: blur(6px);
  }

  .tpm-film__control {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.25rem;
    padding: 0.5em 0.9em;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #f2f1ec;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .tpm-film__control:hover {
    background: rgba(237, 240, 239, 0.14);
  }

  .tpm-film__sound:focus-visible,
  .tpm-film__quiet:focus-visible,
  .tpm-film__control:focus-visible {
    outline: 2px solid #f2f1ec;
    outline-offset: 2px;
  }

  .tpm-film__icon {
    display: grid;
    place-items: center;
  }

  /* The icon that matches the state. */
  .tpm-film__quiet .tpm-film__icon,
  [data-film-play] .tpm-film__icon,
  [data-film-mute] .tpm-film__icon {
    display: none;
  }

  .tpm-film__quiet:not([data-state]) .tpm-film__icon--play,
  .tpm-film__quiet[data-state='idle'] .tpm-film__icon--play,
  .tpm-film__quiet[data-state='paused'] .tpm-film__icon--play,
  .tpm-film__quiet[data-state='playing'] .tpm-film__icon--pause,
  .tpm-film__quiet[data-state='ended'] .tpm-film__icon--replay,
  [data-film-play]:not([data-state='playing']) .tpm-film__icon--play,
  [data-film-play][data-state='playing'] .tpm-film__icon--pause,
  [data-film-mute]:not([data-muted='true']) .tpm-film__icon--sound,
  [data-film-mute][data-muted='true'] .tpm-film__icon--muted {
    display: grid;
  }

  /* ---- the results ---------------------------------------------------------------- */
  .tpm-results {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    margin-top: clamp(3rem, 2.25rem + 3vw, 5.5rem);
    text-align: center;
  }

  .tpm-results__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tpm-results__primary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 1rem + 2.5vw, 3rem) clamp(1rem, 3vw, 3rem);
    width: 100%;
    max-width: 72rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .tpm-results__primary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tpm-results__item {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.6rem;
  }

  .tpm-results__value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }

  .tpm-results__what {
    max-width: 16em;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-2);
    text-wrap: balance;
  }

  .tpm-results__supporting {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--ink-2);
  }

  .tpm-results__supporting li {
    padding-inline: 1.1rem;
  }

  .tpm-results__supporting strong {
    font-weight: 700;
    color: var(--heading);
    white-space: nowrap;
  }

  /* Where there is room, a hyphenated word stays whole. */
  @media (min-width: 30rem) {
    .tpm-results__keep {
      white-space: nowrap;
    }
  }

  /* Side by side, a hairline between them. */
  @media (min-width: 60rem) {
    .tpm-results__supporting li + li {
      border-left: 1px solid var(--line-strong);
    }
  }

  @media (max-width: 59.99rem) {
    .tpm-results__supporting {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tpm-film {
      transition: none;
    }
  }
</style>
