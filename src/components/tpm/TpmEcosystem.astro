---
/**
 * Technical Product Marketing, commercial proof (V1.3; polished in V1.4, October
 * 2026): after the flagship campaign and its first-48-hours results, before the
 * conclusion. The point is the whole of John's product fluency carried into
 * partner and integration work, so it stands as its own section rather than
 * under the website or the documentation.
 *
 * V1.4: centered throughout. V1.5: a centered divider above the narrative
 * (headline and body, no eyebrow) separates it from the campaign's results;
 * then two balanced, centered columns: $300M+ with its label, and one compact
 * stack of the integrations label, the logo row (which names them) and the
 * downstream line, which is never counted. Not a second results panel: no four columns. On the
 * campaign's dark ground, which the conclusion carries on. Copy: tpm.json
 * `ecosystem`; **text** is set in bold.
 */
import tpm from '@data/tpm.json';
import { emphasize } from '@lib/tpm-copy';
import IntegrationLogos from '@components/IntegrationLogos.astro';

const e = tpm.ecosystem;
const headline = emphasize(e.headline, e.accent, 'Ecosystem headline');
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
---

<section class="tpm-eco" data-surface="dark" aria-labelledby="tpm-eco-title" data-tpm-ecosystem>
  <div class="container tpm-eco__inner">
    <div class="tpm-eco__head">
      <h2 id="tpm-eco-title" class="display tpm-eco__title">{headline.map(({ text, em }) => (em ? <span class="tpm-accent">{text}</span> : text))}</h2>
      <p class="tpm-eco__copy">{rich(e.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
    </div>
    <div class="tpm-eco__proof">
      <div class="tpm-eco__volume">
        <span class="tpm-eco__figure">{e.volume.value}</span>
        <span class="tpm-eco__label">{e.volume.label}</span>
      </div>
      <div class="tpm-eco__reach">
        <p class="tpm-eco__label">{e.integrations.label}</p>
        <IntegrationLogos class="tpm-eco__logos" label={e.integrations.label} />
        <p class="tpm-eco__label tpm-eco__down">{e.downstream}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* V1.5: the divider at the top sits close under the campaign's results, so
     it reads as the boundary between the two. */
  .tpm-eco {
    padding-block: 0 clamp(5rem, 3.5rem + 6vw, 9rem);
  }

  .tpm-eco__inner {
    display: grid;
    justify-items: center;
    gap: clamp(2.5rem, 1.75rem + 3vw, 4.5rem);
    text-align: center;
  }

  /* The narrative, centered, under a fine centered divider as wide as it that
     separates it from the campaign's results. */
  .tpm-eco__head {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
    width: min(100%, 53rem);
    padding-top: clamp(3rem, 2rem + 3.5vw, 5rem);
    border-top: 1px solid var(--line-strong);
  }

  .tpm-eco__title {
    font-size: var(--text-2xl);
    text-wrap: balance;
  }

  /* "Product clarity" over "carried into the market.": the highlighted phrase
     always starts its own line, and on the narrowest phones wraps within it
     rather than overflowing. */
  .tpm-eco__title :global(.tpm-accent) {
    display: block;
  }

  /* The same measure as the page's other narrative paragraphs (the case
     contribution and the conclusion, 53rem). */
  .tpm-eco__copy {
    width: 100%;
    max-width: 53rem;
    margin: 0;
    margin-inline: auto;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .tpm-eco__copy strong {
    font-weight: 700;
    color: var(--heading);
  }

  /* Two balanced columns, each centered on its own axis. */
  .tpm-eco__proof {
    display: grid;
    justify-items: center;
    align-items: center;
    gap: clamp(3rem, 2.5rem + 2vw, 4rem) clamp(2rem, 4vw, 5rem);
    width: 100%;
    max-width: 76rem;
  }

  .tpm-eco__volume,
  .tpm-eco__reach {
    display: grid;
    justify-items: center;
  }

  .tpm-eco__volume {
    gap: 1rem;
  }

  .tpm-eco__figure {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(4rem, 2rem + 8vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
  }

  /* The restrained metadata of "First 48 hours after launch". */
  .tpm-eco__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* One compact stack: the label, the marks, the downstream line. */
  .tpm-eco__reach {
    gap: clamp(1.1rem, 0.9rem + 0.6vw, 1.5rem);
    width: min(100%, 36rem);
  }

  .tpm-eco__down {
    color: var(--ink-2);
  }

  /* A step smaller than on the homepage, so the three marks keep one centered
     row within the column (they may wrap on the narrowest phones). */
  .tpm-eco__reach :global(.tpm-eco__logos) {
    --base: clamp(0.95rem, 0.6rem + 0.6vw, 1.2rem);
    --ilogos-col: clamp(1.25rem, 0.75rem + 1.25vw, 2.25rem);
    justify-content: center;
  }

  @media (min-width: 64rem) {
    .tpm-eco__proof {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
