---
/**
 * 08 The conclusion (Technical Product Marketing, V1.3): the case study's
 * closing frame, after Selected Writing and before Contact. A synthesis, not a
 * summary: the headline (each sentence on its own line where there is room,
 * one phrase in the accent), one short paragraph, and beneath it only the way
 * on to the next case study, in the collection's order (as the other case
 * studies have it). No metrics, services, credits or roles are repeated here.
 * On the warm light surface the hero opens on, so the page closes where it
 * began.
 */
import { getCollection } from 'astro:content';
import tpm from '@data/tpm.json';
import { emphasize } from '@lib/tpm-copy';
import { withBase } from '@lib/paths';
import Icon from '@components/Icon.astro';

const { conclusion } = tpm;
// One line per sentence, the accent within whichever sentence carries it.
const sentences = conclusion.headline.split(/(?<=[.!?])\s+/);
const at = sentences.findIndex((line) => line.includes(conclusion.accent));
if (at < 0) throw new Error('[tpm] the conclusion accent must be in its headline');
const lines = sentences.map((line, i) => (i === at ? emphasize(line, conclusion.accent, 'conclusion headline') : [{ text: line, em: false }]));

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === 'technical-marketing');
const next = idx >= 0 && all.length > 1 ? all[(idx + 1) % all.length] : null;
// The arrow never wraps onto a line of its own: it travels with the last word.
const words = next ? next.data.card.title.split(' ') : [];
const last = words.pop() ?? '';
---

<section class="tpm-conclusion" data-surface="light" aria-labelledby="tpm-conclusion-title">
  <div class="container tpm-conclusion__inner">
    <h2 id="tpm-conclusion-title" class="display tpm-conclusion__title">
      {lines.map((line, i) => [i ? ' ' : '', <span>{line.map(({ text, em }) => (em ? <span class="tpm-accent">{text}</span> : text))}</span>])}
    </h2>
    <p class="tpm-conclusion__copy">{conclusion.copy}</p>
    {
      next && (
        <nav class="tpm-next" aria-label="Next case study">
          <a class="tpm-next__link" href={withBase(`/work/${next.id}/`)}>
            <span class="tpm-next__dir">Next case study</span>
            <span class="tpm-next__title">
              {words.join(' ')}{words.length ? ' ' : ''}
              <span class="tpm-next__end">
                {last}
                <Icon name="arrow-right" size="0.7em" class="tpm-next__arrow" />
              </span>
            </span>
          </a>
        </nav>
      )
    }
  </div>
</section>

<style>
  .tpm-conclusion {
    padding-block: calc(var(--section-y) * 1.25) calc(var(--section-y) * 1.1);
  }

  .tpm-conclusion__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .tpm-conclusion__title {
    margin: 0;
    font-size: clamp(2.5rem, 1.2rem + 3.6vw, 5rem);
  }

  @media (min-width: 40rem) {
    .tpm-conclusion__title > span {
      display: block;
    }
  }

  .tpm-conclusion__copy {
    max-width: 46rem;
    margin: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem) 0 0;
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---- the way on: the next case study, and nothing else -------------------------- */
  .tpm-next {
    width: min(100%, 46rem);
    margin-top: clamp(3.5rem, 2.25rem + 4.5vw, 7rem);
    padding-top: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    border-top: 1px solid var(--line-strong);
  }

  .tpm-next__link {
    display: inline-grid;
    justify-items: center;
    gap: 0.7rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius);
    color: var(--heading);
    text-decoration: none;
  }

  .tpm-next__dir {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tpm-next__title {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-xl);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tpm-next__end {
    white-space: nowrap;
  }

  .tpm-next__title :global(.tpm-next__arrow) {
    display: inline-block;
    margin-left: 0.4em;
    vertical-align: -0.02em;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .tpm-next__link:hover .tpm-next__title {
    color: var(--accent-ink);
  }

  .tpm-next__link:hover .tpm-next__title :global(.tpm-next__arrow) {
    transform: translateX(4px);
  }
</style>
