---
/**
 * 07 The conclusion (Technical Product Marketing; V1.3, renumbered and its way
 * on rewritten in V1.4): the case study's closing frame, straight after the
 * flagship campaign and before Contact. A synthesis, not a summary: the
 * headline (each sentence on its own line where there is room, one phrase in
 * the accent), one short paragraph, and then one conversational sentence that
 * closes this story and opens the next. The whole sentence is the link to the
 * next case study, with a small arrow at its end that moves a little on hover;
 * no label, no card, no rule. No metrics, services, credits or roles are
 * repeated here. On the warm light surface the hero opens on, so the page
 * closes where it began.
 *
 * The sentence and the case study it names come from tpm.json (`nextLine`,
 * `next`); the build stops if that case study is missing or is no longer the
 * next one in the collection's order, so the sentence never names one page and
 * leads to another.
 */
import { getCollection } from 'astro:content';
import tpm from '@data/tpm.json';
import { emphasize } from '@lib/tpm-copy';
import { withBase } from '@lib/paths';
import Icon from '@components/Icon.astro';

const { conclusion } = tpm;
// One line per sentence, the accent within whichever sentence carries it.
const sentences = conclusion.headline.split(/(?<=[.!?])\s+/);
const at = sentences.findIndex((line) => line.includes(conclusion.accent));
if (at < 0) throw new Error('[tpm] the conclusion accent must be in its headline');
const lines = sentences.map((line, i) => (i === at ? emphasize(line, conclusion.accent, 'conclusion headline') : [{ text: line, em: false }]));

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === 'technical-marketing');
const following = idx >= 0 && all.length > 1 ? all[(idx + 1) % all.length] : null;
const next = all.find((e) => e.id === conclusion.next);
if (!next) throw new Error(`[tpm] the conclusion's onward sentence leads to "${conclusion.next}", which is not a case study`);
if (following && following.id !== next.id) {
  throw new Error(`[tpm] the conclusion's onward sentence leads to "${next.id}", but the next case study in order is "${following.id}"; update conclusion.next and conclusion.nextLine in tpm.json together`);
}
// The arrow never wraps onto a line of its own: it travels with the last word.
const words = conclusion.nextLine.trim().split(/\s+/);
const last = words.pop() ?? '';
---

<section class="tpm-conclusion" data-surface="light" aria-labelledby="tpm-conclusion-title">
  <div class="container tpm-conclusion__inner">
    <h2 id="tpm-conclusion-title" class="display tpm-conclusion__title">
      {lines.map((line, i) => [i ? ' ' : '', <span>{line.map(({ text, em }) => (em ? <span class="tpm-accent">{text}</span> : text))}</span>])}
    </h2>
    <p class="tpm-conclusion__copy">{conclusion.copy}</p>
    <nav class="tpm-onward" aria-label="Next case study">
      <p class="tpm-onward__line">
        <a class="tpm-onward__link" href={withBase(`/work/${next.id}/`)}>
          {words.join(' ')}{words.length ? ' ' : ''}<span class="tpm-onward__end">{last}<Icon name="arrow-right" size="0.8em" class="tpm-onward__arrow" /></span>
        </a>
      </p>
    </nav>
  </div>
</section>

<style>
  .tpm-conclusion {
    padding-block: calc(var(--section-y) * 1.25) calc(var(--section-y) * 1.1);
  }

  .tpm-conclusion__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .tpm-conclusion__title {
    margin: 0;
    font-size: clamp(2.5rem, 1.2rem + 3.6vw, 5rem);
  }

  @media (min-width: 40rem) {
    .tpm-conclusion__title > span {
      display: block;
    }
  }

  .tpm-conclusion__copy {
    max-width: 46rem;
    margin: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem) 0 0;
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---- the way on: one sentence, the whole of it the link -------------------------- */
  /* The paragraph's own size and column, a step darker and a little heavier,
     set apart by space alone: it reads as the story's last line. */
  .tpm-onward {
    max-width: 46rem;
    margin-top: clamp(2.25rem, 1.6rem + 2.2vw, 3.75rem);
  }

  .tpm-onward__line {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.45;
    text-wrap: balance;
  }

  .tpm-onward__link {
    color: var(--heading);
    text-decoration-line: underline;
    text-decoration-color: var(--accent-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .tpm-onward__end {
    white-space: nowrap;
  }

  .tpm-onward__link :global(.tpm-onward__arrow) {
    display: inline-block;
    margin-left: 0.35em;
    vertical-align: -0.06em;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .tpm-onward__link:hover,
  .tpm-onward__link:focus-visible {
    color: var(--accent-ink);
    text-decoration-color: var(--accent);
  }

  .tpm-onward__link:hover :global(.tpm-onward__arrow),
  .tpm-onward__link:focus-visible :global(.tpm-onward__arrow) {
    transform: translateX(0.25em);
  }
</style>
