---
/**
 * 05 Technical documentation (Technical Product Marketing, V1.1, with the
 * V1.2 delta): the same strategic system carried into product education for
 * technical and developer audiences. It keeps the Website chapter's
 * information structure (name, metadata row of goal, services and credits,
 * one paragraph on John's contribution centered beneath it, one dominant
 * visual) but not its device: the documentation reads inside a large,
 * frameless browser frame, nearly the width of the page, playing the edited
 * walkthrough (about 33 seconds) of the three proof points: the
 * documentation overview, the interactive architecture diagram (the longest
 * moment) and the developer SDK page, ending on a stable code frame.
 *
 * Under the frame, introduced (centered beneath it, V1.3) as selected views
 * from a broader documentation system, the three chapters of the walkthrough
 * each carry one line on what it shows and who did what; the one playing is
 * marked, its line filling as it plays, and each starts the walkthrough from
 * its own point. Nothing is laid over the documentation itself. On phones the
 * frame runs edge to edge, and (Mobile Optimization V1) the selected views
 * and their controls are not shown: the walkthrough plays on its own.
 *
 * V1.3: the walkthrough runs continuously, as the website's does: through to
 * its final page, a moment on the last frame, a fade back to the first (its
 * poster) and again, never cutting from the end to the start. It pauses
 * whenever the frame leaves the viewport. The recording is silent, so there
 * is no sound to keep or lose between loops; nothing in the loop touches its
 * mute state. With reduced motion or a data-saving preference it plays only
 * when asked, once, and holds its last frame.
 */
import tpm from '@data/tpm.json';
import TpmCase from './TpmCase.astro';
import TpmWalkthrough from './TpmWalkthrough.astro';

const { documentation: docs } = tpm;
const chapters = docs.chapters.map((c, i) => ({ ...c, number: String(i + 1).padStart(2, '0'), end: docs.chapters[i + 1]?.start ?? null }));
---

<TpmCase
  id="tpm-docs-title"
  title={docs.title}
  meta={docs.meta}
  contribution={docs.contribution}
  em={docs.em}
  surface="light-return"
  align="center"
  class="tpm-docs"
>
  <div class="container tpm-docs__visual">
    <figure class="tpm-browser" data-tpm-browser>
      <div class="tpm-browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="tpm-browser__screen" data-surface="dark">
        <TpmWalkthrough media={docs.media} widths={[640, 960, 1280, 1600, 1920, 2560]} sizes="(min-width: 48rem) min(92vw, 90rem), 100vw" />
      </div>
    </figure>

    <div class="tpm-chapters__wrap">
      <p id="tpm-chapters-label" class="tpm-chapters__label">{docs.chaptersLabel}</p>
      <ol class="tpm-chapters" aria-labelledby="tpm-chapters-label" data-chapters>
        {
          chapters.map((c) => (
            <li class="tpm-chapter" data-chapter data-start={c.start} data-end={c.end ?? ''}>
              <span class="tpm-chapter__bar" aria-hidden="true">
                <span class="tpm-chapter__fill" />
              </span>
              <span class="tpm-chapter__num" aria-hidden="true">
                {c.number}
              </span>
              <h3 class="tpm-chapter__title">{c.title}</h3>
              <p class="tpm-chapter__note">{c.note}</p>
              <button type="button" class="tpm-chapter__seek" data-seek={c.start} aria-label={`Play from ${c.title}`} hidden />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</TpmCase>

<script>
  import { Walkthrough, addRise } from '@lib/tpm-motion';

  const frame = document.querySelector<HTMLElement>('[data-tpm-browser]');
  const screen = frame?.querySelector<HTMLElement>('.tpm-browser__screen');
  const list = document.querySelector<HTMLElement>('[data-chapters]');

  if (frame && screen) {
    // Continuous (V1.3): 1.2 seconds on the final code frame, then a 0.7
    // second fade back to the documentation home before it plays again.
    const walk = new Walkthrough(screen, { threshold: 0.55, cycle: { hold: 1200, fade: 700 } });

    if (list) {
      const items = Array.from(list.querySelectorAll<HTMLElement>('[data-chapter]'));
      const spans = items.map((li) => ({ li, start: Number(li.dataset.start) || 0, end: li.dataset.end ? Number(li.dataset.end) : Number.NaN }));
      let duration = Number.NaN;
      walk.video.addEventListener('loadedmetadata', () => {
        duration = walk.video.duration;
      });

      // The chapter playing is marked, its line filling as it plays; the
      // chapters before it stay filled once it has passed them.
      walk.onTime((t, state) => {
        const end = (s: (typeof spans)[number]) => (Number.isNaN(s.end) ? duration : s.end);
        // The chapter playing is the last one that has begun; none before
        // the walkthrough has started.
        let current = -1;
        if (t > 0 || state !== 'paused') spans.forEach((s, i) => (t >= s.start ? (current = i) : null));
        spans.forEach((s, i) => {
          const e = end(s);
          const fill = t <= s.start ? 0 : Number.isNaN(e) ? (state === 'ended' ? 1 : 0) : Math.min(1, (t - s.start) / (e - s.start));
          s.li.style.setProperty('--fill', fill.toFixed(4));
          s.li.toggleAttribute('data-active', i === current);
        });
      });

      // Each chapter starts the walkthrough from its own point.
      for (const li of items) {
        const button = li.querySelector<HTMLButtonElement>('[data-seek]');
        if (!button) continue;
        button.hidden = false;
        button.addEventListener('click', () => walk.seek(Number(button.dataset.seek) || 0));
      }
    }

    // A short, restrained rise as the frame comes up the screen, read from the
    // scroll position (Creator Marketing V1.2, Part One: never a timed jump).
    addRise(frame, { distance: 40 });
  }
</script>

<style>
  .tpm-docs__visual {
    display: grid;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    margin-top: clamp(2.5rem, 2rem + 4vw, 6rem);
  }

  /* ---- the browser frame: a slim bar, no hardware ------------------------------- */
  .tpm-browser {
    margin: 0;
  }

  .tpm-browser__bar {
    display: none;
  }

  .tpm-browser__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  /* Phones: the frame runs edge to edge. */
  @media (max-width: 47.99rem) {
    .tpm-browser {
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  @media (min-width: 48rem) {
    .tpm-browser {
      width: 100%;
      max-width: 90rem;
      margin-inline: auto;
      overflow: hidden;
      border-radius: 14px;
      background: #171b1e;
      box-shadow:
        0 0 0 1px rgba(13, 15, 16, 0.14),
        0 40px 80px -46px rgba(13, 15, 16, 0.5),
        0 16px 32px -22px rgba(13, 15, 16, 0.3);
    }

    .tpm-browser__bar {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      height: clamp(1.6rem, 2.2vw, 2.25rem);
      padding-inline: clamp(0.7rem, 1vw, 1rem);
      background: #1c2124;
      border-bottom: 1px solid rgba(237, 240, 239, 0.06);
    }

    .tpm-browser__bar i {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: rgba(237, 240, 239, 0.2);
    }
  }

  /* ---- the chapters --------------------------------------------------------------- */
  .tpm-chapters__wrap {
    display: grid;
    gap: clamp(1rem, 0.75rem + 0.8vw, 1.5rem);
    width: 100%;
    max-width: 90rem;
    margin: 0 auto;
  }

  /* Phones (Mobile Optimization V1): the walkthrough alone, without the selected
     views and their controls beneath it, and without the room they took. */
  @media (max-width: 47.99rem) {
    .tpm-chapters__wrap {
      display: none;
    }
  }

  /* The line that introduces them: selected views from a broader system,
     centered on the frame (V1.3). */
  .tpm-chapters__label {
    margin: 0;
    text-align: center;
    text-wrap: balance;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tpm-chapters {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    width: 100%;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .tpm-chapters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.25rem, 3vw, 3rem);
    }
  }

  .tpm-chapter {
    --fill: 0;
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    gap: 0.35rem 0.75rem;
    padding-top: 1rem;
  }

  /* A hairline that fills as its chapter plays. */
  .tpm-chapter__bar {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    overflow: hidden;
    background: var(--line-strong);
  }

  .tpm-chapter__fill {
    position: absolute;
    inset: 0;
    background: var(--heading);
    transform: scaleX(var(--fill));
    transform-origin: 0 50%;
  }

  .tpm-chapter__num {
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.6rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .tpm-chapter__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-md);
    line-height: 1.6rem;
    color: var(--ink-2);
    transition: color var(--dur) var(--ease-out);
  }

  .tpm-chapter__note {
    grid-column: 2;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-3);
    text-wrap: pretty;
  }

  .tpm-chapter[data-active] .tpm-chapter__title,
  .tpm-chapter[data-active] .tpm-chapter__num {
    color: var(--heading);
  }

  /* The whole chapter is the button that plays from it. */
  .tpm-chapter__seek {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
  }

  .tpm-chapter__seek:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .tpm-chapter:hover .tpm-chapter__title {
      color: var(--heading);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tpm-browser {
      transition: none;
    }
  }
</style>
