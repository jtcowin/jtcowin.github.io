---
/**
 * 01 Hero (Technical Product Marketing, V1.2): the headline, the supporting
 * paragraph and the seven areas of scope, and nothing else: no media. The
 * headline holds the left of the upper area and the paragraph the right,
 * level with its last line, as before; the scope runs as one centered rail in
 * the lower area (two balanced centered lines where it does not fit), with
 * open space all around, in a hero that fills about one viewport.
 *
 * Leaving it (wide, tall-enough screens with motion allowed), over about 0.85
 * of a viewport of scrolling: the hero starts complete and readable. As the
 * visitor scrolls, the headline and paragraph leave with the page, softening
 * as they go, while the scope rail stays where it is and each term, a beat
 * after the one before it, softens and stretches vertically into a thin band
 * (the width of a card's edge) in the accent of the document card it lines up
 * with (the first seven of the Foundation library, in order), so the bands
 * anticipate the cards' colored left edges. The dark ground of the Foundation
 * then rises from below on a soft, eased edge, over the bands, which draw
 * down into it and toward the middle, where the library waits, and fade: the
 * hero ends on the same dark surface the Foundation begins on, and the
 * Foundation's stage rises under the last of it, so the two run together
 * without a cut or an empty screen. Nothing is scrubbed but transforms, opacity and a
 * light softening (3px at most) on seven words; there is no full-screen blur.
 *
 * Everywhere else (phones, tablets, short screens, reduced motion, no
 * JavaScript) the hero is still and the Foundation's opening crossfades in as
 * it arrives (TpmFlow.astro).
 */
import tpm from '@data/tpm.json';

const { hero, foundation } = tpm;
// One band per scope term, in the accents of the first seven document cards,
// in order from the left.
const bands = hero.scope.map((_, i) => foundation.documents[i % foundation.documents.length].color);
---

<section class="tpm-hero" data-surface="light" aria-labelledby="tpm-title" data-tpm-hero>
  <div class="tpm-hero__stage">
    <div class="container tpm-hero__head" data-tpm-hero-copy>
      <h1 id="tpm-title" class="display tpm-hero__title tpm-in" style="--in: 0">{hero.headline}</h1>
      <p class="lede tpm-hero__lede tpm-in" style="--in: 1">{hero.copy}</p>
    </div>

    <div class="container tpm-hero__foot">
      <ul class="tpm-hero__scope tpm-in" style="--in: 2" aria-label="Scope of the work" data-tpm-scope>
        {
          hero.scope.map((item) => (
            <li>
              <span class="tpm-hero__term" data-term>
                {item}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    {/* The dark ground of the Foundation, rising under the bands. The header
        reads it as the surface beneath it from halfway down its soft edge
        (the mark: no paint of its own), so its controls turn where the ground
        does. */}
    <div class="tpm-hero__dusk" aria-hidden="true" data-tpm-dusk>
      <span class="tpm-hero__dusk-edge"></span>
      <span class="tpm-hero__dusk-ground"></span>
      <span class="tpm-hero__dusk-mark" data-surface="dark"></span>
    </div>

    <div class="tpm-hero__bands" aria-hidden="true" data-tpm-bands>
      {bands.map((color) => <span class="tpm-hero__band" style={`--band: ${color}`} data-band />)}
    </div>
  </div>
</section>

<script>
  import { addStage, live, onLiveChange, lerp, span, smooth, easeIn, easeInOut } from '@lib/tpm-motion';

  const hero = document.querySelector<HTMLElement>('[data-tpm-hero]');
  const scope = hero?.querySelector<HTMLElement>('[data-tpm-scope]');

  // The scope line is centered and may wrap into two balanced lines; the dot
  // before an item is hidden where that item opens a line.
  if (scope) {
    const items = Array.from(scope.children) as HTMLElement[];
    const mark = () => {
      let top = Number.NaN;
      for (const li of items) {
        li.classList.toggle('is-line-start', li.offsetTop !== top && !Number.isNaN(top));
        top = li.offsetTop;
      }
    };
    mark();
    document.fonts?.ready.then(mark);
    if ('ResizeObserver' in window) new ResizeObserver(mark).observe(scope);
  }

  if (hero && scope) {
    const stage = hero.firstElementChild as HTMLElement;
    const head = hero.querySelector<HTMLElement>('[data-tpm-hero-copy]') as HTMLElement;
    const terms = Array.from(hero.querySelectorAll<HTMLElement>('[data-term]'));
    const bands = Array.from(hero.querySelectorAll<HTMLElement>('[data-band]'));
    const dusk = hero.querySelector<HTMLElement>('[data-tpm-dusk]') as HTMLElement;

    // ---- geometry ---------------------------------------------------------------
    // Layout offsets relative to the stage, so the transforms written below
    // never feed back into what is measured.
    type Spot = { x: number; y: number; h: number };
    let spots: Spot[] = [];
    // The terms from left to right (the rail may wrap into two lines), and
    // where each band settles: under its own term on one line; evenly spaced
    // across the rail where it wraps, so no two bands run together.
    let order: number[] = [];
    let settle: number[] = [];
    let mid = 0;
    let edge = 0;
    const within = (el: HTMLElement) => {
      let x = 0;
      let y = 0;
      for (let n: HTMLElement | null = el; n && n !== stage; n = n.offsetParent as HTMLElement | null) {
        x += n.offsetLeft;
        y += n.offsetTop;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };
    const measure = () => {
      reset();
      spots = terms.map((t) => {
        const b = within(t);
        return { x: b.x + b.w / 2, y: b.y + b.h / 2, h: b.h };
      });
      order = spots.map((_, i) => i).sort((a, b) => spots[a].x - spots[b].x);
      const wrapped = new Set(spots.map((sp) => Math.round(sp.y))).size > 1;
      const first = spots[order[0]]?.x ?? 0;
      const last = spots[order[order.length - 1]]?.x ?? 0;
      settle = order.map((i, k) => (wrapped && order.length > 1 ? first + ((last - first) * k) / (order.length - 1) : spots[i].x));
      mid = stage.clientWidth / 2;
      edge = (dusk.firstElementChild as HTMLElement).offsetHeight;
    };

    const reset = () => {
      for (const el of [head, scope, dusk, ...terms, ...bands]) {
        el.style.transform = '';
        el.style.opacity = '';
        el.style.filter = '';
        el.style.visibility = '';
      }
      scope.style.removeProperty('--dots');
    };

    // ---- per frame ----------------------------------------------------------------
    // p runs from 0 to 1 over the hero's hold (rect.height - vh of scrolling).
    // At 0 the hero is whole. The headline and paragraph leave with the page
    // as if nothing held them, softening as they go; each term, a beat after
    // the one before it, narrows and stretches into its band, which grows up
    // from the rail; the dark ground rises over the bands on its soft edge;
    // the bands draw down into it and toward the middle, and fade.
    const update = (p: number, rect: DOMRect, vh: number) => {
      const run = Math.max(0, rect.height - vh);
      const soft = smooth(span(p, 0.14, 0.44));
      head.style.transform = p > 0 ? `translate3d(0, ${(-p * run).toFixed(1)}px, 0)` : '';
      head.style.opacity = soft > 0 ? (1 - soft).toFixed(3) : '';
      head.style.visibility = soft >= 0.999 ? 'hidden' : '';
      scope.style.setProperty('--dots', (1 - smooth(span(p, 0.06, 0.22))).toFixed(3));

      // The dark ground: from below the hero to over all of it, its soft top
      // edge ahead of it.
      const rise = smooth(span(p, 0.3, 0.95));
      dusk.style.transform = `translate3d(0, ${lerp(vh, -edge, rise).toFixed(2)}px, 0)`;

      const sink = easeInOut(span(p, 0.55, 1));
      const fade = 1 - smooth(span(p, 0.78, 0.96));
      // Left to right: the k-th term from the left turns into the k-th band,
      // in the k-th card's accent.
      order.forEach((i, k) => {
        const term = terms[i];
        const t = span(p, 0.08 + 0.024 * k, 0.42 + 0.024 * k);
        const e = easeIn(t);
        term.style.transform = t > 0 ? `scale(${lerp(1, 0.06, e).toFixed(4)}, ${lerp(1, 2.4, e).toFixed(4)})` : '';
        term.style.filter = t > 0 ? `blur(${(3 * smooth(t)).toFixed(2)}px)` : '';
        const gone = smooth(span(t, 0.4, 0.85));
        term.style.opacity = gone > 0 ? (1 - gone).toFixed(3) : '';

        const band = bands[k];
        const s = spots[i];
        if (!band || !s) return;
        const grow = smooth(span(t, 0.25, 1));
        const on = smooth(span(t, 0.25, 0.7));
        const length = lerp(s.h * 2, vh * 0.44, grow) * (1 - 0.25 * sink);
        const bottom = s.y + s.h * 0.9 + vh * 0.05 * grow + vh * 0.4 * sink;
        const home = lerp(s.x, settle[k], grow);
        const x = lerp(home, mid + (home - mid) * 0.72, sink);
        const opacity = 0.9 * on * fade;
        band.style.opacity = opacity > 0.001 ? opacity.toFixed(3) : '0';
        band.style.transform = `translate3d(${(x - 2).toFixed(2)}px, ${(bottom - length).toFixed(2)}px, 0) scaleY(${(length / vh).toFixed(4)})`;
      });
    };

    const apply = () => {
      const on = live();
      hero.classList.toggle('is-live', on);
      reset();
      if (on) {
        measure();
        window.dispatchEvent(new Event('scroll'));
      }
    };

    apply();
    document.fonts?.ready.then(() => {
      if (live()) apply();
    });
    addStage(hero, update);
    onLiveChange(apply);
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => {
        if (live()) apply();
      }, 140);
    });
  }
</script>

<style>
  /* ---- the opening screen --------------------------------------------------------- */
  .tpm-hero {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .tpm-hero {
      --view-h: 100svh;
    }
  }

  .tpm-hero__stage {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(3.5rem, 2.5rem + 6vh, 7rem);
    min-height: var(--view-h);
    /* Clear of the header row, which floats over the top of the hero. */
    padding-block: calc(var(--header-row) + clamp(2.5rem, 9vh, 7rem)) clamp(3rem, 9vh, 6.5rem);
  }

  .tpm-hero__head {
    display: grid;
    gap: var(--space-5);
    align-content: center;
  }

  .tpm-hero__title {
    font-size: clamp(2.5rem, 1rem + 3.6vw, 5rem);
    max-width: 13ch;
  }

  .tpm-hero__lede {
    max-width: 34rem;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
  }

  /* Seven areas of work, centered on the page: one rail where they fit, two
     balanced lines where they do not, never smaller type. A middle dot
     (skipped by assistive technology) sits in the space before each item but
     the first, and the script hides it where an item opens a line. */
  .tpm-hero__foot {
    text-align: center;
  }

  .tpm-hero__scope {
    --gap: 2.2em;
    margin: 0;
    padding: 0;
    list-style: none;
    text-wrap: balance;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 2;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .tpm-hero__scope li {
    position: relative;
    display: inline-block;
    margin-inline: calc(var(--gap) / 2);
    white-space: nowrap;
  }

  .tpm-hero__scope li + li::before {
    content: '·';
    content: '·' / '';
    position: absolute;
    right: 100%;
    width: var(--gap);
    letter-spacing: 0;
    text-align: center;
    color: var(--ink-3);
    opacity: var(--dots, 1);
  }

  .tpm-hero__scope li.is-line-start::before {
    visibility: hidden;
  }

  .tpm-hero__term {
    display: inline-block;
    transform-origin: 50% 50%;
  }

  /* The bands and the rising ground exist only for the transition. */
  .tpm-hero__dusk,
  .tpm-hero__bands {
    display: none;
  }

  /* ---- entrance -------------------------------------------------------------------- */
  .tpm-in {
    animation: rise-in 760ms var(--ease-out) both;
    animation-delay: calc(80ms + var(--in, 0) * 90ms);
  }

  /* ---- wide screens: the split opening --------------------------------------------
     The headline holds the left of the upper area and the paragraph the right,
     level with its last line; the scope rail sits low and centered. */
  @media (min-width: 60rem) {
    .tpm-hero__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 6rem);
      align-items: end;
    }

    /* Two balanced lines across the wider column. */
    .tpm-hero__title {
      max-width: none;
    }

    .tpm-hero__lede {
      justify-self: end;
      padding-bottom: 0.35rem;
    }
  }

  /* ---- live: the hero holds while it resolves into the Foundation ------------------- */
  @media (min-width: 60rem) and (min-height: 37.5rem) and (prefers-reduced-motion: no-preference) {
    /* 0.85 of a screen to resolve; the Foundation's dark stage rises under
       the last 0.15 of it, where the hero is already dark, so its opening
       follows without an empty screen between them. */
    .tpm-hero.is-live {
      height: calc(var(--view-h) * 1.85);
      margin-bottom: calc(var(--view-h) * -0.15);
    }

    .tpm-hero.is-live .tpm-hero__stage {
      position: sticky;
      top: 0;
      height: var(--view-h);
      overflow: hidden;
    }

    .tpm-hero.is-live .tpm-hero__dusk {
      position: absolute;
      inset: 0 0 auto;
      z-index: 2;
      display: grid;
      grid-template-rows: auto var(--view-h);
      height: auto;
      pointer-events: none;
      transform: translate3d(0, var(--view-h), 0);
      will-change: transform;
    }

    /* An eased edge (an ease-in-out scrim, not a straight ramp), so the
       light gives way to the dark with no band at either end of it. */
    .tpm-hero.is-live .tpm-hero__dusk-edge {
      display: block;
      height: calc(var(--view-h) * 0.42);
      background: linear-gradient(
        to bottom,
        rgba(13, 15, 16, 0) 0%,
        rgba(13, 15, 16, 0.013) 8.1%,
        rgba(13, 15, 16, 0.049) 15.5%,
        rgba(13, 15, 16, 0.104) 22.5%,
        rgba(13, 15, 16, 0.175) 29%,
        rgba(13, 15, 16, 0.259) 35.3%,
        rgba(13, 15, 16, 0.352) 41.2%,
        rgba(13, 15, 16, 0.45) 47.1%,
        rgba(13, 15, 16, 0.55) 52.9%,
        rgba(13, 15, 16, 0.648) 58.8%,
        rgba(13, 15, 16, 0.741) 64.7%,
        rgba(13, 15, 16, 0.825) 71%,
        rgba(13, 15, 16, 0.896) 77.5%,
        rgba(13, 15, 16, 0.951) 84.5%,
        rgba(13, 15, 16, 0.987) 91.9%,
        var(--c-ink) 100%
      );
    }

    .tpm-hero.is-live .tpm-hero__dusk-ground {
      display: block;
      background: var(--c-ink);
    }

    /* From halfway down the edge to the bottom of the ground: what the header
       reads as the dark surface. Unpainted. */
    .tpm-hero.is-live .tpm-hero__dusk-mark {
      position: absolute;
      inset: calc(var(--view-h) * 0.21) 0 0;
      display: block;
      background: none;
    }

    .tpm-hero.is-live .tpm-hero__bands {
      position: absolute;
      inset: 0;
      z-index: 3;
      display: block;
      pointer-events: none;
    }

    /* Each band is a 4px stroke, the width of a card's left edge, one viewport
       tall and scaled to its length from the top; soft at both ends. */
    .tpm-hero.is-live .tpm-hero__band {
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: var(--view-h);
      opacity: 0;
      background: linear-gradient(to bottom, transparent 0%, var(--band) 16%, var(--band) 74%, transparent 100%);
      transform-origin: 50% 0;
      will-change: transform, opacity;
    }

    .tpm-hero.is-live .tpm-hero__term {
      will-change: transform, opacity, filter;
    }
  }
</style>
