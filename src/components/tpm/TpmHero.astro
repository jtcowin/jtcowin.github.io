---
/**
 * 01 Hero (Technical Product Marketing, V1.6). The section label, the
 * headline (always two lines, sized to its column) and the paragraph on the
 * left; on the right the isometric system; the seven areas of scope in one
 * centered line beneath them, on a fine rule across the hero (wrapping,
 * centered, only where the screen is too narrow). The headline never changes.
 *
 * The system (geometry and timeline: src/lib/tpm-iso.ts; words: tpm.json) is
 * a small designed environment on a faint grid of its own: research and
 * inputs on the left (interviews, product research, foundational documents,
 * each on a stone plinth), the strategic foundation at the center (a deep
 * teal base and deck, a matrix of modular blocks, four fine guides and a
 * glass canopy etched with the shared language), the public-facing
 * expressions on the right (the website, the technical documentation,
 * campaigns and content), joined by conduits set into the floor.
 *
 * - It assembles once (about four seconds): the floor, the base, the inputs,
 *   the foundation's blocks, guides and canopy, the expressions, and then the
 *   connections resolve, a light running once from the inputs through the
 *   foundation to the expressions.
 * - At rest it stays a little alive: one signal at a time crosses from an
 *   input into the foundation, a soft light passes through three of its
 *   blocks and a signal leaves for one expression; the canopy and the
 *   expressions drift by a pixel or two.
 * - Only the pointer over the system itself (never the rest of the hero), a
 *   tap on it, or its control engages it: the layers separate (the canopy
 *   rises on its guides, the blocks lift by their height, every object lifts
 *   off its plinth), the conduits light, signals run faster from all three
 *   inputs and then to all three expressions, and seven short labels arrive
 *   (on the floor, and on the glass for the foundation). Leaving, it settles
 *   back calmly. A touch screen gets a quicker version and a visible control.
 * - Reduced motion shows it complete and still; engaging it shows the labels
 *   and the lit conduits without movement. Without JavaScript it assembles
 *   all the same, and opens on hover or focus within it.
 *
 * Performance: every part is its own HTML box holding its drawing, and every
 * movement (assembly, drift, signals, lights, separation) is transform or
 * opacity on those boxes, which the compositor runs by itself; the one
 * exception is the light's single run along the conduits as it assembles.
 * Off screen, or while the Foundation rises over the hero, it all pauses.
 *
 * Leaving the hero (wide, tall-enough screens with motion allowed, V1.3): it
 * holds for one screen of scrolling while the Foundation's surface rises over
 * it, the hero's content fading and softening a little (TpmFlow.astro reads
 * the values this script hands it); the system rests closed and still.
 */
import tpm from '@data/tpm.json';
import { emphasize, type Part } from '@lib/tpm-copy';
import { isoScene } from '@lib/tpm-iso';

const { hero } = tpm;
const words = hero.system;
// (The scene's own keyframes, its signals and lights, are in the page's head.)

// The headline, its accent, and the break after its first line.
const lines = (() => {
  const parts = emphasize(hero.headline, hero.accent, 'hero headline');
  const at = hero.headline.indexOf(hero.break);
  if (at < 0) throw new Error(`[tpm] the hero's break "${hero.break}" must be in its headline`);
  const end = at + hero.break.length;
  const first: Part[] = [];
  const second: Part[] = [];
  let pos = 0;
  for (const p of parts) {
    const cut = Math.max(0, Math.min(p.text.length, end - pos));
    if (cut > 0) first.push({ text: p.text.slice(0, cut), em: p.em });
    if (cut < p.text.length) second.push({ text: second.length ? p.text.slice(cut) : p.text.slice(cut).replace(/^\s+/, ''), em: p.em });
    pos += p.text.length;
  }
  return [first, second.filter((p) => p.text)];
})();
const copy = emphasize(hero.copy, hero.em, 'hero paragraph');

const scene = isoScene();
const { w: W, h: H, timing: t } = scene;
const pct = (v: number, of: number) => `${+((v / of) * 100).toFixed(3)}%`;
const box = (p: { x: number; y: number; w: number; h: number }) => `left:${pct(p.x, W)};top:${pct(p.y, H)};width:${pct(p.w, W)};height:${pct(p.h, H)}`;
const label = (key: string) => {
  const text = (words.labels as Record<string, string>)[key];
  if (!text) throw new Error(`[tpm] the hero system has no label for "${key}"`);
  return text;
};
const isoVars = [
  `--w:${W}`,
  `--h:${H}`,
  `--idle:${t.idle}s`,
  `--cycle:${t.idleCycle}s`,
  `--hcycle:${t.hoverCycle}s`,
  `--float:${t.float}s`,
  `--breath:${t.breath}s`,
  `--floor-at:${t.floor.at}s`,
  `--floor-dur:${t.floor.dur}s`,
  `--cond-at:${t.conduits.at}s`,
  `--cond-dur:${t.conduits.dur}s`,
  `--lit-at:${t.lit.at}s`,
  `--lit-dur:${t.lit.dur}s`,
  `--lit-run:${t.lit.run}s`,
].join(';');
---

<section class="tpm-hero" data-surface="light" aria-labelledby="tpm-title" data-tpm-hero>
  <div class="tpm-hero__stage" data-tpm-hero-stage>
    <div class="container tpm-hero__grid">
      <div class="tpm-hero__copy" data-tpm-hero-copy>
        <p class="tpm-hero__label tpm-in" style="--in: 0">
          <span class="tpm-hero__tile" aria-hidden="true"></span>
          {hero.label}
        </p>
        <h1 id="tpm-title" class="display tpm-hero__title tpm-in" style="--in: 1">
          {
            lines.map((line, n) => (
              <span class="tpm-hero__line">
                {line.map(({ text, em }) => (em ? <span class="tpm-accent">{text}</span> : text))}
                {n === 0 && ' '}
              </span>
            ))
          }
        </h1>
        <p class="lede tpm-hero__lede tpm-in" style="--in: 2">
          {copy.map(({ text, em }) => (em ? <strong class="tpm-em">{text}</strong> : text))}
        </p>
      </div>

      <div class="tpm-hero__visual" data-tpm-hero-visual>
        <div class="iso" data-iso style={isoVars}>
          <div class="iso__scene" role="img" aria-label={words.description}>
            <div class="iso__layer iso__floor">
              <svg class="iso__art" viewBox={`0 0 ${W} ${H}`} focusable="false">
                <defs set:html={scene.defs} />
                <g set:html={scene.floor.svg} />
              </svg>
            </div>
            <div class="iso__layer iso__conduits">
              <svg class="iso__art" viewBox={`0 0 ${W} ${H}`} focusable="false" set:html={scene.floor.conduits} />
            </div>
            <div class="iso__layer iso__lit">
              <svg class="iso__art" viewBox={`0 0 ${W} ${H}`} focusable="false">
                {scene.floor.lit.map((l) => <path d={l.d} pathLength="1" style={`--d:${l.delay}s`} />)}
              </svg>
            </div>
            {
              (['idle', 'hover'] as const).map((kind) => (
                <div class:list={['iso__pulses', `iso__pulses--${kind}`]}>
                  {scene.pulses.map((p) => (
                    <span class:list={['iso__pulse', `iso__pulse--${p.dir}`]} style={`left:${pct(p.x, W)};top:${pct(p.y, H)};width:${pct(p.len, W)};transform:rotate(${p.angle}deg)`}>
                      <i class="iso__spark" style={`--a:${kind === 'idle' ? p.idle : p.hover}`} />
                    </span>
                  ))}
                </div>
              ))
            }
            {
              scene.parts.map((p) => {
                const vars = [
                  box(p),
                  `--d:${p.delay}s`,
                  `--dur:${p.dur}s`,
                  `--from:${p.from}`,
                  `--lift:${p.lift}`,
                  `--lag:${p.lag}s`,
                  p.float ? `--fl:${p.float};--ph:${p.phase}s` : '',
                  p.foot !== undefined ? `--foot:${(p.foot * 100).toFixed(2)}%;--st:${p.stretch}` : '',
                ]
                  .filter(Boolean)
                  .join(';');
                const view = `${p.x} ${p.y} ${p.w} ${p.h}`;
                // One movement to an element, each on an HTML box, so the
                // compositor runs every one of them: the part rises while
                // engaged, its body assembles, the drift is its idle life; the
                // flash and the light are two copies of its lit top or inlay.
                const art = (
                  <>
                    <svg class="iso__art" viewBox={view} focusable="false" set:html={p.svg} />
                    {p.breath && (
                      <div class="iso__fill iso__breath">
                        <svg class="iso__art" viewBox={view} focusable="false" set:html={p.breath} />
                      </div>
                    )}
                    {p.etch && (
                      <div class="iso__fill iso__etch">
                        <svg class="iso__art" viewBox={view} focusable="false" set:html={p.etch} />
                      </div>
                    )}
                    {p.glow && p.flash !== undefined && (
                      <div class="iso__fill iso__flash" style={`--fx:${p.flash}s`}>
                        <svg class="iso__art" viewBox={view} focusable="false" set:html={p.glow} />
                      </div>
                    )}
                    {p.glow && p.glowAnim && (
                      <div class="iso__fill iso__glow" style={`--g:${p.glowAnim}`}>
                        <svg class="iso__art" viewBox={view} focusable="false" set:html={p.glow} />
                      </div>
                    )}
                  </>
                );
                return (
                  <div class:list={['iso__part', `iso__part--${p.group}`, { 'iso__part--guide': p.grow, 'iso__part--float': p.float > 0 }]} data-part={p.id} style={vars}>
                    <div class="iso__body">{p.float > 0 ? <div class="iso__fill iso__drift">{art}</div> : art}</div>
                  </div>
                );
              })
            }
          </div>

          <ul class="iso__labels" id="tpm-iso-labels" aria-label="The system’s parts" data-iso-labels>
            {
              scene.labels.map((l) => (
                <li
                  class:list={['iso__label', `iso__label--${l.group}`, { 'iso__label--rise': l.dir === '-y', 'iso__label--center': l.align === 'center' }]}
                  style={[`left:${pct(l.x, W)}`, `top:${pct(l.y, H)}`, `--o:${l.order}`, l.lift !== undefined ? `--lift:${l.lift};--lag:${l.lag}s;--fl:${l.float};--ph:${l.phase}s` : ''].filter(Boolean).join(';')}
                >
                  <span class="iso__ride">
                    <span class="iso__word">{label(l.key)}</span>
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="iso__hit" aria-hidden="true" data-iso-hit style={`clip-path: polygon(${scene.hit})`}></div>
        </div>

        <button type="button" class="iso__toggle" aria-expanded="false" aria-controls="tpm-iso-labels tpm-iso-legend" data-iso-toggle>
          <span class="iso__toggle-icon" aria-hidden="true"></span>
          <span data-iso-show>{words.toggle.show}</span>
          <span data-iso-hide hidden>{words.toggle.hide}</span>
        </button>

        {/* On a phone the same words, as a small legend in three columns beneath the system. */}
        <ul class="iso-legend" id="tpm-iso-legend" aria-label="The system’s parts" data-iso-legend>
          {
            scene.labels.map((l) => (
              <li class:list={['iso-legend__item', `iso-legend__item--${l.group}`]}>{label(l.key)}</li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="container tpm-hero__rail tpm-in" style="--in: 3" data-tpm-rail>
      <ul class="tpm-hero__scope" aria-label="Scope of the work" data-tpm-scope>
        {
          hero.scope.map((item) => (
            <li>
              <span class="tpm-hero__term">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import { addStage, live, onLiveChange, reducedMotion, span, smooth, easeOut } from '@lib/tpm-motion';

  const hero = document.querySelector<HTMLElement>('[data-tpm-hero]');
  const scope = hero?.querySelector<HTMLElement>('[data-tpm-scope]');
  const iso = hero?.querySelector<HTMLElement>('[data-iso]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  let inView = true;
  // How far the Foundation has risen over the held hero (live only, 0 to 1).
  let covered = 0;

  // The scope rail wraps only where it must; the dot before an item is hidden
  // where that item opens a line.
  if (scope) {
    const items = Array.from(scope.children) as HTMLElement[];
    const mark = () => {
      let top = Number.NaN;
      for (const li of items) {
        li.classList.toggle('is-line-start', li.offsetTop !== top && !Number.isNaN(top));
        top = li.offsetTop;
      }
    };
    mark();
    document.fonts?.ready.then(mark);
    if ('ResizeObserver' in window) new ResizeObserver(mark).observe(scope);
  }

  // ---- the system: at rest unless engaged directly -------------------------------------------
  const control = (() => {
    const place = hero?.querySelector<HTMLElement>('[data-tpm-hero-visual]');
    if (!iso || !place) return null;
    const hit = iso.querySelector<HTMLElement>('[data-iso-hit]') as HTMLElement;
    const toggle = place.querySelector<HTMLButtonElement>('[data-iso-toggle]') as HTMLButtonElement;
    const showText = toggle.querySelector<HTMLElement>('[data-iso-show]') as HTMLElement;
    const hideText = toggle.querySelector<HTMLElement>('[data-iso-hide]') as HTMLElement;
    let hovered = false;
    let toggled = false;
    let enabled = true;
    let flowTimer = 0;
    let lastX = Number.NaN;
    let lastY = Number.NaN;
    // The pointer engages it once the foundation stands (the canopy has set
    // down); a deliberate tap or the control does at any time.
    let ready = reducedMotion();

    const isOpen = () => iso.classList.contains('is-open');
    const render = (quick = false) => {
      const open = enabled && ((hovered && ready) || toggled);
      if (open === isOpen()) return;
      iso.classList.toggle('is-quick', quick);
      iso.classList.toggle('is-open', open);
      // The faster signals keep running while the system closes, then stop.
      window.clearTimeout(flowTimer);
      if (open) iso.classList.add('is-flow');
      else flowTimer = window.setTimeout(() => iso.classList.remove('is-flow'), 600);
      toggle.setAttribute('aria-expanded', String(open));
      showText.hidden = open;
      hideText.hidden = !open;
    };
    const arrive = () => {
      if (ready) return;
      ready = true;
      render();
    };
    iso.querySelector('[data-part="core-canopy"] .iso__body')?.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'iso-in') arrive();
    });
    window.setTimeout(arrive, 3200);

    // A mouse or pen engages it by moving over the system (a real move: a
    // layout change under a still pointer never does) and lets go by leaving.
    // The area is the outline of the system at rest; while open, its whole box.
    hit.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || !fine.matches) return;
      const moved = Number.isNaN(lastX) || e.clientX !== lastX || e.clientY !== lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      if (moved && !hovered) {
        hovered = true;
        render();
      }
    });
    hit.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'touch') return;
      lastX = Number.NaN;
      hovered = false;
      render();
    });
    // Touch: a tap opens or closes it, quickly; a tap anywhere else closes it.
    hit.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'mouse' && fine.matches) return;
      toggled = !isOpen();
      if (!toggled) hovered = false;
      render(true);
    });
    document.addEventListener('pointerdown', (e) => {
      if (toggled && !place.contains(e.target as Node)) {
        toggled = false;
        render(true);
      }
    });
    // Keyboards, screen readers and the visible control on touch screens.
    toggle.addEventListener('click', (e) => {
      toggled = !isOpen();
      if (!toggled) hovered = false;
      // A click that came from a touch (detail > 0, coarse pointer) is quick.
      render(e.detail > 0 && !fine.matches);
    });
    place.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        toggled = false;
        hovered = false;
        render();
      }
    });

    return {
      // Off screen, or while the Foundation covers the hero, it rests closed.
      enable(on: boolean) {
        if (enabled === on) return;
        enabled = on;
        if (!on) {
          hovered = false;
          toggled = false;
        }
        render();
      },
    };
  })();

  // Off screen: everything paused, the system closed.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      iso?.classList.toggle('is-asleep', !inView);
      control?.enable(inView && covered < 0.15);
    }).observe(hero);
  }

  // ---- leaving the hero: the Foundation rises over it (V1.3) ---------------------------------
  if (hero) {
    const copyBox = hero.querySelector<HTMLElement>('[data-tpm-hero-copy]') as HTMLElement;
    const visual = hero.querySelector<HTMLElement>('[data-tpm-hero-visual]') as HTMLElement;
    const rail = hero.querySelector<HTMLElement>('[data-tpm-rail]');
    const flow = document.querySelector<HTMLElement>('[data-tpm-flow]');
    const fading = [copyBox, visual, rail].filter(Boolean) as HTMLElement[];
    let lastKey = '';

    const reset = () => {
      for (const el of fading) {
        el.style.opacity = '';
        el.style.transform = '';
        el.style.filter = '';
        el.style.willChange = live() ? 'opacity, transform' : '';
      }
      flow?.style.removeProperty('--lead-r');
      flow?.style.removeProperty('--lead-shadow');
      flow?.style.removeProperty('--rise');
      lastKey = '';
    };

    // p runs from 0 to 1 over the one screen the stage holds, which is
    // exactly the Foundation's rise from the bottom of the screen to the top.
    // Creator Marketing V1.2, Part One: the hero answers the very first movement
    // (its lift eases out from p = 0 and its fade starts at once), so no part of
    // the gesture is spent with nothing moving; its layers are promoted once,
    // while the stage is live, not switched on and off as the reader scrolls.
    const update = (p: number) => {
      const fade = span(p, 0.02, 0.95);
      const soft = smooth(span(p, 0.3, 1));
      const lift = easeOut(p);
      const key = `${p.toFixed(4)}`;
      if (key === lastKey) return;
      lastKey = key;
      for (const el of fading) {
        el.style.opacity = fade > 0 ? (1 - 0.8 * fade).toFixed(3) : '';
        el.style.transform = lift > 0 ? `translate3d(0, ${(-32 * lift).toFixed(2)}px, 0) scale(${(1 - 0.02 * lift).toFixed(4)})` : '';
        el.style.filter = soft > 0.002 ? `blur(${(2 * soft).toFixed(2)}px)` : '';
      }
      // The surface's leading edge rounds off its corners until it settles
      // (its shadow only while it rises), and the Foundation's opening fades
      // up into place (32px) as it does.
      flow?.style.setProperty('--lead-r', `${(28 * (1 - smooth(span(p, 0.55, 1)))).toFixed(2)}px`);
      flow?.style.setProperty('--lead-shadow', (smooth(span(p, 0.01, 0.1)) * (1 - smooth(span(p, 0.85, 1)))).toFixed(3));
      flow?.style.setProperty('--rise', smooth(span(p, 0.5, 1)).toFixed(3));
      // Once the Foundation starts to cover it, the system rests closed and
      // its life pauses (nothing moves under the softening).
      covered = p;
      control?.enable(p < 0.15 && inView);
      iso?.classList.toggle('is-held', p > 0);
    };

    const apply = () => {
      const on = live();
      hero.classList.toggle('is-live', on);
      reset();
      if (on) window.dispatchEvent(new Event('scroll'));
      else {
        covered = 0;
        control?.enable(inView);
        iso?.classList.remove('is-held');
      }
    };

    apply();
    addStage(hero, (p) => update(p));
    onLiveChange(apply);
  }
</script>

<style>
  /* ---- the opening screen --------------------------------------------------------- */
  .tpm-hero {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .tpm-hero {
      --view-h: 100svh;
    }
  }

  /* The copy and the system, then the scope line beneath them, the three
     composed as one group in the middle of the screen. Clear of the header
     row, which floats over the top of the hero. */
  .tpm-hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    row-gap: clamp(2.25rem, 6vh, 4.5rem);
    padding-block: calc(var(--header-row) + clamp(1.5rem, 4vh, 3rem)) clamp(1.5rem, 4vh, 2.5rem);
  }

  .tpm-hero__grid {
    display: grid;
    align-self: center;
    gap: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    width: 100%;
  }

  .tpm-hero__copy {
    display: grid;
    align-content: center;
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
    min-width: 0;
    /* The headline is sized to this column. */
    container-type: inline-size;
  }

  /* The section label: the case study's number and name, with a small
     isometric tile, the system's own unit. */
  .tpm-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .tpm-hero__tile {
    flex: none;
    width: 0.8rem;
    aspect-ratio: 1.732;
    background: var(--c-aqua);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  /* Two lines, always: the size is V1.5's, or less where the column is too
     narrow for the first line (about 9.2em in Archivo at its display width,
     so 10.9% of the column). */
  .tpm-hero__title {
    margin: 0;
    font-size: min(clamp(2.5rem, 1rem + 3.6vw, 5rem), 10.9cqi);
  }

  .tpm-hero__line {
    display: block;
    white-space: nowrap;
  }

  .tpm-hero__lede {
    max-width: 34rem;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
  }

  /* ---- the scope line (V1.4): one centered line beneath the split -----------------
     Every item but the first has a middle dot before it (skipped by assistive
     technology); where the line has to wrap, it wraps centered and the script
     hides the dot where an item opens a line. On wide screens a fine rule runs
     out from either end to the edges of the content, the base line the system
     and the copy stand on. */
  .tpm-hero__rail {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .tpm-hero__scope {
    --gap: 1.6em;
    max-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 2.1;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--ink-2);
  }

  /* Half the gap on each side of every term, so a wrapped line is centered on
     its terms and not on a trailing space. */
  .tpm-hero__scope li {
    position: relative;
    display: inline-block;
    margin-inline: calc(var(--gap) / 2);
    white-space: nowrap;
  }

  .tpm-hero__scope li + li::before {
    content: '·';
    content: '·' / '';
    position: absolute;
    right: 100%;
    width: var(--gap);
    letter-spacing: 0;
    text-align: center;
    color: var(--ink-3);
  }

  .tpm-hero__scope li.is-line-start::before {
    visibility: hidden;
  }

  /* ---- the system's place ------------------------------------------------------------ */
  .tpm-hero__visual {
    position: relative;
    display: grid;
    align-content: center;
    min-width: 0;
  }

  /* ---- the system ----------------------------------------------------------------------
     Its box is the drawing's (W by H design units); every part, signal and label
     is placed in percentages of it and moves in cqw, so it all scales with it. */
  .iso {
    --iso-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --iso-open: cubic-bezier(0.22, 0.8, 0.24, 1);
    --iso-close: cubic-bezier(0.55, 0, 0.3, 1);
    /* Words lying on the floor: along +x (down to the right) or along -y (up to the right). */
    --iso-m: matrix(0.866025, 0.5, -0.866025, 0.5, 0, 0);
    --iso-m-rise: matrix(0.866025, -0.5, 0.866025, 0.5, 0, 0);
    --sep: 0.95s;
    --settle: 0.75s;
    position: relative;
    width: 100%;
    aspect-ratio: var(--w) / var(--h);
    container-type: inline-size;
  }

  .iso.is-quick {
    --sep: 0.6s;
    --settle: 0.5s;
  }

  .iso__scene {
    position: absolute;
    inset: 0;
  }

  .iso__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* The grid stays inside the system's box. */
  .iso__floor .iso__art {
    overflow: hidden;
  }

  /* The conduits' light: off at rest, lit while engaged. */
  .iso__lit {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .iso__lit path {
    fill: none;
    stroke: #4f918a;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
  }

  /* ---- parts ------------------------------------------------------------------------- */
  .iso__part {
    position: absolute;
    translate: 0 0;
    pointer-events: none;
    transition: translate var(--settle) var(--iso-close);
  }

  .iso__body,
  .iso__fill,
  .iso__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .iso__art {
    overflow: visible;
  }

  .iso__part--guide,
  .iso__part--guide .iso__body {
    transform-origin: 50% var(--foot);
  }

  .iso__part--guide {
    scale: 1 1;
    transition: scale var(--settle) var(--iso-close);
  }

  .iso__etch {
    transition: opacity 0.4s ease;
  }

  .iso__flash,
  .iso__glow,
  .iso__breath {
    opacity: 0;
  }

  /* ---- signals: a point of light with a short trail, along one stretch of a conduit --- */
  .iso__pulses {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .iso__pulses--hover {
    opacity: 0;
  }

  .iso__pulse {
    position: absolute;
    height: 0;
    transform-origin: 0 0;
    overflow-x: clip;
    overflow-y: visible;
  }

  .iso__spark {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0;
    opacity: 0;
  }

  .iso__spark::before,
  .iso__spark::after {
    content: '';
    position: absolute;
  }

  /* A signal: a point of light and a short trail. Since the Events V1.1
     brief's companion pass a touch larger and brighter at idle, so the flow
     reads at a glance; engaged, larger and brighter again. */
  .iso__spark::before {
    right: 100%;
    top: max(-1px, -0.16cqw);
    width: 6cqw;
    height: min(2px, 0.32cqw);
    border-radius: 1cqw;
    background: linear-gradient(to right, rgba(79, 145, 138, 0), rgba(79, 145, 138, 0.95));
  }

  .iso__spark::after {
    left: -0.95cqw;
    top: -0.95cqw;
    width: 1.9cqw;
    height: 1.9cqw;
    border-radius: 50%;
    background: radial-gradient(closest-side, #ffffff 0 13%, #4f918a 27% 41%, rgba(79, 145, 138, 0.36) 57%, rgba(79, 145, 138, 0) 100%);
  }

  /* Engaged, the signals are a little brighter and their trails longer. */
  .iso__pulses--hover .iso__spark::before {
    width: 8cqw;
    background: linear-gradient(to right, rgba(63, 138, 131, 0), rgba(63, 138, 131, 1));
  }

  .iso__pulses--hover .iso__spark::after {
    left: -1.05cqw;
    top: -1.05cqw;
    width: 2.1cqw;
    height: 2.1cqw;
    background: radial-gradient(closest-side, #ffffff 0 15%, #3f8a83 29% 43%, rgba(79, 145, 138, 0.42) 59%, rgba(79, 145, 138, 0) 100%);
  }

  /* ---- labels: on the floor in front of each plinth, and on the glass ----------------- */
  .iso__labels {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 0.35s;
  }

  .iso__label {
    position: absolute;
    translate: 0 0;
  }

  .iso__ride {
    display: block;
  }

  .iso__word {
    --sx: -0.6em;
    display: block;
    transform-origin: 0 0;
    transform: var(--iso-m) translateX(var(--sx));
    opacity: 0;
    white-space: nowrap;
    font-size: max(0.5rem, 1.32cqw);
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink-3);
