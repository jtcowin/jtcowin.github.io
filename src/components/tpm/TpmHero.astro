  /* An expression's words run up to the right, in front of its lower-right face. */
  .iso__label--rise .iso__word {
    transform: var(--iso-m-rise) translateX(var(--sx));
  }

  /* The foundation's words, centered on its glass, ride with the canopy. */
  .iso__label--core {
    transition: translate var(--settle) var(--iso-close);
  }

  .iso__label--center .iso__word {
    --sx: 0em;
    --sy: 0.5em;
    width: max-content;
    transform: var(--iso-m) translate(-50%, calc(-50% + var(--sy)));
