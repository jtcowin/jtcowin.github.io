---
/**
 * 01 Hero (Technical Product Marketing, V1.5). The headline and paragraph on
 * the left, vertically centered; on the right the Narrative Engine; the seven
 * areas of scope in one centered line at the foot of the hero (wrapping,
 * centered, only where the screen is too narrow); and, behind everything, a
 * faint signal field. The headline never changes.
 *
 * The Narrative Engine (geometry: src/lib/tpm-engine.ts; words: tpm.json) is
 * one central core, a nucleus inside a ring of short radial marks, with a
 * sparse system of faint nodes and connections around it and no words. At
 * rest it has only a little ambient life: a slow breath of light behind the
 * core, an occasional signal passing from an input through the core to an
 * output, and a drift of a pixel and a half. Only the pointer over the
 * engine's own area, a tap on it or its control from the keyboard engages
 * it: the system expands (the marks lengthen into their full pattern from the
 * input side round to the output side, the rings widen, the five named nodes
 * move out), the connections light in sequence, from the two inputs into the
 * core and from the core to the three outputs, and short labels arrive as the
 * light reaches each node. Leaving, the labels go first and the system
 * returns calmly to rest. A touch screen gets a quicker version of the same,
 * and a visible control to open and close it. Reduced motion shows the
 * system composed and complete, still.
 *
 * The signal field (src/lib/tpm-signal.ts) is short marks on a staggered
 * lattice, barely visible, quieter still behind the copy, the scope line and
 * the core. While a fine pointer moves anywhere in the hero, the marks near it
 * turn to run round it and take on the page's teal, in soft rings that travel
 * outward as the pointer travels; it settles once the pointer rests and fades
 * when it leaves or the page scrolls. The engine takes no part in that, and
 * the field answers more quietly while the pointer is over the engine.
 *
 * Performance: the engine's ambient life is opacity and transform on HTML
 * boxes, which the compositor runs on its own; its SVG parts move only while
 * it opens or closes. The field is one canvas, redrawn only where the pointer
 * is acting and only while it acts; nothing runs off screen. Without
 * JavaScript the engine opens on hover or focus within it and the field is
 * absent.
 *
 * Leaving the hero (wide, tall-enough screens with motion allowed, V1.3): it
 * holds for one screen of scrolling while the Foundation's surface rises over
 * it, the hero's content fading and softening a little (TpmFlow.astro reads
 * the values this script hands it); the field fades out over the first half
 * of that rise and the engine rests closed and still.
 */
import tpm from '@data/tpm.json';
import { emphasize } from '@lib/tpm-copy';
import { narrativeEngine, pctX, pctY } from '@lib/tpm-engine';

const { hero } = tpm;
const title = emphasize(hero.headline, hero.accent, 'hero headline');
const copy = emphasize(hero.copy, hero.em, 'hero paragraph');

const words = hero.engine;
const engine = narrativeEngine(
  words.inputs.map((i) => i.label),
  words.outputs.map((o) => o.label),
);
const { c, core } = engine;
const inputs = engine.nodes.filter((n) => n.side === 'in');
const outputs = engine.nodes.filter((n) => n.side === 'out');
// The ambient signal passes from the lower input through the core to the upper output.
const sigFrom = inputs[1].rest;
const sigTo = outputs[0].rest;
---

<section class="tpm-hero" data-surface="light" aria-labelledby="tpm-title" data-tpm-hero>
  <div class="tpm-hero__stage" data-tpm-hero-stage>
    <div class="tpm-signal" aria-hidden="true" data-tpm-field>
      <canvas class="tpm-signal__canvas" data-signal-canvas></canvas>
    </div>

    <div class="container tpm-hero__grid">
      <div class="tpm-hero__copy" data-tpm-hero-copy>
        <h1 id="tpm-title" class="display tpm-hero__title tpm-in" style="--in: 0">
          {title.map(({ text, em }) => (em ? <span class="tpm-accent">{text}</span> : text))}
        </h1>
        <p class="lede tpm-hero__lede tpm-in" style="--in: 1">
          {copy.map(({ text, em }) => (em ? <strong class="tpm-em">{text}</strong> : text))}
        </p>
      </div>

      <div class="tpm-hero__visual" data-tpm-hero-visual>
        <div class="tpm-hero__object tpm-in" style="--in: 2">
          <div class="nx" data-engine>
            <div class="nx__body" aria-hidden="true">
              <div class="nx__glow"></div>
              <svg class="nx__art" viewBox={`0 0 ${engine.w} ${engine.h}`} focusable="false">
                <circle class="nx__orbit" cx={c.x} cy={c.y} r={core.orbit} />
                <g class="nx__sats">
                  {
                    engine.satellites.map((s) => (
                      <>
                        <path class="nx__sat-link" d={s.link} />
                        <circle class="nx__sat" cx={s.x} cy={s.y} r={s.r} />
                      </>
                    ))
                  }
                </g>
                <g class="nx__rest">{engine.restWires.map((w) => <path d={w.d} />)}</g>
                <g class="nx__wires">
                  {engine.wires.map((w) => <path class="nx__wire" d={w.d} />)}
                  {
                    engine.wires.map((w) => (
                      <path class:list={['nx__lit', `nx__lit--${w.side}`]} d={w.d} pathLength="1" style={`--o: ${w.order}`} />
                    ))
                  }
                </g>
                <g class="nx__core">
                  <circle class="nx__ring" cx={c.x} cy={c.y} r={core.ring} />
                  <circle class="nx__ring-open" cx={c.x} cy={c.y} r={core.ringOpen} />
                  <g class="nx__marks">
                    {core.marks.map((m) => <path d={`M${m.x1} ${m.y1}L${m.x2} ${m.y2}`} pathLength="1" style={`--rest: ${m.rest}; --d: ${m.delay}`} />)}
                  </g>
                  <circle class="nx__nucleus" cx={c.x} cy={c.y} r={core.nucleus} />
                  <circle class="nx__inner" cx={c.x} cy={c.y} r={core.inner} />
                  <circle class="nx__spark" cx={c.x} cy={c.y} r={core.spark} />
                </g>
                {
                  engine.nodes.map((n) => (
                    <g class:list={['nx__node', `nx__node--${n.side}`]} style={`--dx: ${n.dx}; --dy: ${n.dy}; --o: ${n.order}`}>
                      <circle class="nx__node-halo" cx={n.rest.x} cy={n.rest.y} r="12.5" />
                      <circle class="nx__node-dot" cx={n.rest.x} cy={n.rest.y} r="5.2" />
                    </g>
                  ))
                }
              </svg>
              <span class="nx__signal nx__signal--in" style={`left: ${pctX(sigFrom.x)}; top: ${pctY(sigFrom.y)}`}></span>
              <span class="nx__signal nx__signal--core" style={`left: ${pctX(c.x)}; top: ${pctY(c.y)}`}></span>
              <span class="nx__signal nx__signal--out" style={`left: ${pctX(sigTo.x)}; top: ${pctY(sigTo.y)}`}></span>
            </div>

            <div class="nx__legend" id="tpm-engine-legend" data-engine-legend>
              <div class="nx__group nx__group--in">
                <p class="nx__caption nx__caption--in" style={`--x: ${pctX(inputs[0].open.x)}; --y: ${pctY(inputs[0].open.y)}`}>{words.captions.inputs}</p>
                <ul class="nx__list">
                  {
                    inputs.map((n) => (
                      <li class:list={['nx__label', 'nx__label--in', `nx__label--${n.key}`]} style={`--x: ${pctX(n.open.x)}; --y: ${pctY(n.open.y)}; --o: ${n.order}`}>
                        {n.label}
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="nx__group nx__group--core" style={`--x: ${pctX(engine.coreLabel.x)}; --y: ${pctY(engine.coreLabel.y)}`}>
                <p class="nx__caption nx__caption--core">{words.captions.core}</p>
                <p class="nx__label nx__label--core">{words.core}</p>
              </div>
              <div class="nx__group nx__group--out">
                <p class="nx__caption nx__caption--out" style={`--x: ${pctX(outputs[0].open.x)}; --y: ${pctY(outputs[0].open.y)}`}>{words.captions.outputs}</p>
                <ul class="nx__list">
                  {
                    outputs.map((n) => (
                      <li class:list={['nx__label', 'nx__label--out', `nx__label--${n.key}`]} style={`--x: ${pctX(n.open.x)}; --y: ${pctY(n.open.y)}; --o: ${n.order}`}>
                        {n.label}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div class="nx__hit" aria-hidden="true" data-engine-hit></div>
            <button type="button" class="nx__toggle" aria-expanded="false" aria-controls="tpm-engine-legend" data-engine-toggle>
              <span class="nx__toggle-icon" aria-hidden="true"></span>
              <span data-engine-show>{words.toggle.show}</span>
              <span data-engine-hide hidden>{words.toggle.hide}</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <ul class="tpm-hero__scope tpm-in" style="--in: 3" aria-label="Scope of the work" data-tpm-scope>
      {
        hero.scope.map((item) => (
          <li>
            <span class="tpm-hero__term">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { addStage, live, onLiveChange, reducedMotion, span, smooth } from '@lib/tpm-motion';
  import { SignalField, type Shelter } from '@lib/tpm-signal';

  const hero = document.querySelector<HTMLElement>('[data-tpm-hero]');
  const stage = hero?.querySelector<HTMLElement>('[data-tpm-hero-stage]');
  const scope = hero?.querySelector<HTMLElement>('[data-tpm-scope]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let inView = true;
  // How far the Foundation has risen over the held hero (live only, 0 to 1).
  let covered = 0;

  // The scope rail wraps only where it must; the dot before an item is hidden
  // where that item opens a line.
  if (scope) {
    const items = Array.from(scope.children) as HTMLElement[];
    const mark = () => {
      let top = Number.NaN;
      for (const li of items) {
        li.classList.toggle('is-line-start', li.offsetTop !== top && !Number.isNaN(top));
        top = li.offsetTop;
      }
    };
    mark();
    document.fonts?.ready.then(mark);
    if ('ResizeObserver' in window) new ResizeObserver(mark).observe(scope);
  }

  // ---- the field ---------------------------------------------------------------------------
  const fieldEl = stage?.querySelector<HTMLElement>('[data-tpm-field]');
  const canvas = fieldEl?.querySelector<HTMLCanvasElement>('[data-signal-canvas]');
  const field = canvas && typeof canvas.getContext === 'function' ? new SignalField(canvas) : null;
  const engineEl = hero?.querySelector<HTMLElement>('[data-engine]');

  if (field && stage && fieldEl && canvas) {
    const copyBox = hero?.querySelector<HTMLElement>('[data-tpm-hero-copy]');
    // The field is quiet behind the copy, the scope line and the core.
    field.shelters = () => {
      const base = canvas.getBoundingClientRect();
      const list: Shelter[] = [];
      const box = (el: Element | null | undefined, level: number, feather: number, pad = 0) => {
        if (!el) return;
        const r = el.getBoundingClientRect();
        if (!r.width) return;
        list.push({ box: { x: r.left - base.left - pad, y: r.top - base.top - pad, w: r.width + 2 * pad, h: r.height + 2 * pad }, level, feather });
      };
      if (copyBox) for (const el of Array.from(copyBox.children)) box(el, 0.22, 110, 10);
      box(scope, 0.3, 40, 6);
      const art = engineEl?.querySelector('.nx__art');
      if (art) {
        const r = art.getBoundingClientRect();
        list.push({ circle: { cx: r.left + r.width / 2 - base.left, cy: r.top + r.height / 2 - base.top, r: r.width * 0.19 }, level: 0.15, feather: r.width * 0.12 });
      }
      // The header row at the top of the hero.
      list.push({ box: { x: -1e4, y: -1e4, w: 3e4, h: 1e4 + 56 }, level: 0, feather: 60 });
      return list;
    };

    let timer = 0;
    const lay = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => field.layout(), 60);
    };
    field.layout();
    document.fonts?.ready.then(() => field.layout());
    if ('ResizeObserver' in window) new ResizeObserver(lay).observe(stage);

    // Only a fine pointer that can hover moves the field, and not for reduced motion.
    let rect: DOMRect | null = null;
    const responsive = () => fine.matches && !reduce.matches && inView;
    stage.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'touch' || !responsive()) return;
        if (!rect) rect = canvas.getBoundingClientRect();
        field.point(e.clientX - rect.left, e.clientY - rect.top);
      },
      { passive: true },
    );
    stage.addEventListener('pointerleave', () => field.release());
    window.addEventListener(
      'scroll',
      () => {
        rect = null;
        field.release(true);
      },
      { passive: true },
    );
    window.addEventListener('resize', () => (rect = null), { passive: true });
  }

  // ---- the Narrative Engine: at rest unless engaged directly ---------------------------------
  const control = (() => {
    if (!engineEl) return null;
    const hit = engineEl.querySelector<HTMLElement>('[data-engine-hit]') as HTMLElement;
    const toggle = engineEl.querySelector<HTMLButtonElement>('[data-engine-toggle]') as HTMLButtonElement;
    const showText = toggle.querySelector<HTMLElement>('[data-engine-show]') as HTMLElement;
    const hideText = toggle.querySelector<HTMLElement>('[data-engine-hide]') as HTMLElement;
    let hovered = false;
    let toggled = false;
    let enabled = true;
    let lastX = Number.NaN;
    let lastY = Number.NaN;

    const isOpen = () => engineEl.classList.contains('is-open');
    const render = (quick = false) => {
      const open = enabled && (hovered || toggled);
      if (open === isOpen()) return;
      engineEl.classList.toggle('is-quick', quick);
      engineEl.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      showText.hidden = open;
      hideText.hidden = !open;
      field?.setDamp(open ? 0.45 : 1);
    };

    // A mouse or pen opens it by moving over its area (a real move: a layout
    // change under a still pointer never does) and closes it by leaving. The
    // area is a circle round the resting system; once open, the whole box.
    hit.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || !fine.matches) return;
      const moved = Number.isNaN(lastX) || e.clientX !== lastX || e.clientY !== lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      if (moved && !hovered) {
        hovered = true;
        render();
      }
    });
    hit.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'touch') return;
      lastX = Number.NaN;
      hovered = false;
      render();
    });
    // Touch: a tap opens or closes it, quickly; a tap anywhere else closes it.
    hit.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'mouse' && fine.matches) return;
      toggled = !isOpen();
      if (!toggled) hovered = false;
      render(true);
    });
    document.addEventListener('pointerdown', (e) => {
      if (toggled && !engineEl.contains(e.target as Node)) {
        toggled = false;
        render(true);
      }
    });
    // Keyboard, screen readers and the visible control on touch screens.
    toggle.addEventListener('click', (e) => {
      toggled = !isOpen();
      if (!toggled) hovered = false;
      // A click that came from a touch (detail > 0, coarse pointer) is quick.
      render(e.detail > 0 && !fine.matches);
    });
    engineEl.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        toggled = false;
        hovered = false;
        render();
      }
    });

    return {
      // Off screen, or while the Foundation covers the hero, it rests closed.
      enable(on: boolean) {
        if (enabled === on) return;
        enabled = on;
        if (!on) {
          hovered = false;
          toggled = false;
        }
        render();
      },
    };
  })();

  // Off screen: no ambient life, the engine closed, the field still.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      engineEl?.classList.toggle('is-asleep', !inView);
      if (inView) field?.wake();
      else field?.sleep();
      control?.enable(inView && covered < 0.15);
    }).observe(hero);
  }

  // ---- leaving the hero: the Foundation rises over it (V1.3) ---------------------------------
  if (hero) {
    const copyBox = hero.querySelector<HTMLElement>('[data-tpm-hero-copy]') as HTMLElement;
    const visual = hero.querySelector<HTMLElement>('[data-tpm-hero-visual]') as HTMLElement;
    const flow = document.querySelector<HTMLElement>('[data-tpm-flow]');
    const fading = [copyBox, visual, scope].filter(Boolean) as HTMLElement[];

    const reset = () => {
      for (const el of fading) {
        el.style.opacity = '';
        el.style.transform = '';
        el.style.filter = '';
        el.style.willChange = '';
      }
      flow?.style.removeProperty('--lead-r');
      flow?.style.removeProperty('--lead-shadow');
      flow?.style.removeProperty('--rise');
      if (fieldEl) {
        fieldEl.style.opacity = '';
        fieldEl.style.willChange = '';
      }
    };

    // p runs from 0 to 1 over the one screen the stage holds, which is
    // exactly the Foundation's rise from the bottom of the screen to the top.
    const update = (p: number) => {
      const fade = smooth(span(p, 0.15, 0.95));
      const soft = smooth(span(p, 0.3, 1));
      const lift = smooth(p);
      for (const el of fading) {
        el.style.willChange = p > 0 && p < 1 ? 'opacity, transform, filter' : '';
        el.style.opacity = fade > 0 ? (1 - 0.8 * fade).toFixed(3) : '';
        el.style.transform = lift > 0 ? `translate3d(0, ${(-26 * lift).toFixed(2)}px, 0) scale(${(1 - 0.02 * lift).toFixed(4)})` : '';
        el.style.filter = soft > 0.002 ? `blur(${(2 * soft).toFixed(2)}px)` : '';
      }
      // The surface's leading edge rounds off its corners until it settles
      // (its shadow only while it rises), and the Foundation's opening fades
      // up into place (32px) as it does.
      flow?.style.setProperty('--lead-r', `${(28 * (1 - smooth(span(p, 0.55, 1)))).toFixed(2)}px`);
      flow?.style.setProperty('--lead-shadow', (smooth(span(p, 0.01, 0.1)) * (1 - smooth(span(p, 0.85, 1)))).toFixed(3));
      flow?.style.setProperty('--rise', smooth(span(p, 0.5, 1)).toFixed(3));
      // The field recedes first, as the surface starts to rise over it.
      if (fieldEl) {
        const gone = smooth(span(p, 0.05, 0.5));
        fieldEl.style.willChange = p > 0 && p < 1 ? 'opacity' : '';
        fieldEl.style.opacity = gone > 0 ? (1 - gone).toFixed(3) : '';
      }
      // Once the Foundation starts to cover it, the engine rests closed and
      // its ambient life stops (nothing moves under the softening).
      covered = p;
      control?.enable(p < 0.15 && inView);
      engineEl?.classList.toggle('is-held', p > 0);
    };

    const apply = () => {
      const on = live();
      hero.classList.toggle('is-live', on);
      reset();
      if (on) window.dispatchEvent(new Event('scroll'));
      else {
        covered = 0;
        control?.enable(inView);
        engineEl?.classList.remove('is-held');
      }
    };

    apply();
    addStage(hero, (p) => update(p));
    onLiveChange(apply);
    // Reduced motion shows the engine composed and still; nothing to engage.
    if (reducedMotion()) control?.enable(false);
  }
</script>

<style>
  /* ---- the opening screen --------------------------------------------------------- */
  .tpm-hero {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .tpm-hero {
      --view-h: 100svh;
    }
  }

  /* The copy and the engine, then the scope line at the foot. Clear of the
     header row, which floats over the top of the hero. */
  .tpm-hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(2.25rem, 5vh, 3.5rem);
    padding-block: calc(var(--header-row) + clamp(2rem, 5vh, 3.5rem)) clamp(1.5rem, 4vh, 2.5rem);
  }

  .tpm-hero__grid {
    display: grid;
    align-self: center;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .tpm-hero__copy {
    display: grid;
    align-content: center;
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .tpm-hero__title {
    font-size: clamp(2.5rem, 1rem + 3.6vw, 5rem);
    max-width: 13ch;
  }

  .tpm-hero__lede {
    max-width: 34rem;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
  }

  /* ---- the scope line (V1.4): one centered line at the foot of the hero ------------
     Every item but the first has a middle dot before it (skipped by assistive
     technology); where the line has to wrap, it wraps centered and the script
     hides the dot where an item opens a line. */
  .tpm-hero__scope {
    --gap: 1.6em;
    justify-self: center;
    max-width: 100%;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 2.1;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--ink-2);
  }

  /* Half the gap on each side of every term, so a wrapped line is centered on
     its terms and not on a trailing space. */
  .tpm-hero__scope li {
    position: relative;
    display: inline-block;
    margin-inline: calc(var(--gap) / 2);
    white-space: nowrap;
  }

  .tpm-hero__scope li + li::before {
    content: '·';
    content: '·' / '';
    position: absolute;
    right: 100%;
    width: var(--gap);
    letter-spacing: 0;
    text-align: center;
    color: var(--ink-3);
  }

  .tpm-hero__scope li.is-line-start::before {
    visibility: hidden;
  }

  /* ---- the signal field (V1.5): one canvas behind the whole stage -------------------- */
  .tpm-signal {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .tpm-signal__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ---- the engine's place ------------------------------------------------------------- */
  .tpm-hero__visual {
    display: grid;
    justify-items: center;
    align-content: center;
    min-width: 0;
  }

  .tpm-hero__object {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  /* ---- the Narrative Engine ------------------------------------------------------------
     Its box is the drawing (600 by 440 units); the labels sit beside their
     nodes inside it, the control just below it. */
  .nx {
    --ease-open: cubic-bezier(0.22, 0.8, 0.24, 1);
    --ease-close: cubic-bezier(0.55, 0, 0.3, 1);
    /* the light's schedule (opening), in seconds */
    --t-in: 0.3;
    --t-core: 0.78;
    --t-out: 0.92;
    --step: 0.075;
    --run: 0.44;
    position: relative;
    width: min(100%, 38rem);
    aspect-ratio: 600 / 470;
    container: nx / inline-size;
  }

  /* On a phone the engine leaves room beside it for the labels. */
  @media (max-width: 31.25rem) {
    .nx {
      width: calc(100% - 3rem);
    }
  }

  .nx.is-quick {
    --t-in: 0.12;
    --t-core: 0.3;
    --t-out: 0.34;
    --step: 0.04;
    --run: 0.3;
  }

  .nx__body {
    position: absolute;
    inset: 0;
  }

  .nx__art {
