---
/**
 * 01 Hero (Technical Product Marketing, V1.1): a pinned hero in two states.
 *
 * Entry: the kicker, the headline and the supporting sentence in the upper
 * area (headline left, sentence right); below them, centered, a smaller 16:9
 * screen playing the opening 22 seconds of Bolt in 60 seconds as a silent
 * loop, about 54% of the screen's width at most and never so tall that it
 * crowds the copy; and the seven areas of scope centered on the page, on one
 * line or two balanced ones, never shrunk. Clear space separates the three.
 * The copy enters first and the screen a moment later; the loop starts once
 * the screen has arrived, and until then (and for reduced motion, data saving
 * or a refused autoplay) the screen shows the designed poster frame.
 *
 * Scroll: on wide, tall-enough screens with motion allowed the hero holds in
 * place while the screen grows until it fills the viewport. The copy and the
 * scope line stay while the screen begins to grow, so the whole entry has
 * been seen, then give way. Nothing is laid over the animation except its own
 * pause and play control. With reduced motion the entry simply stays as it is.
 */
import { Picture } from 'astro:assets';
import tpm from '@data/tpm.json';
import { getAsset, resolveImage } from '@lib/assets';
import { withBase } from '@lib/paths';
import Icon from '@components/Icon.astro';

const { hero } = tpm;
const loop = getAsset(hero.media);
const poster = resolveImage(loop);
const media = (file: string | null | undefined) => (file ? withBase(`/media/${file}`) : null);
const large = media(loop.file);
const small = media(loop.fileSmall);
---

<section class="tpm-hero" data-surface="light" aria-labelledby="tpm-title" data-tpm-hero>
  <div class="tpm-hero__stage">
    <div class="container tpm-hero__head" data-tpm-hero-copy>
      <div class="tpm-hero__lead">
        <p class="eyebrow tpm-hero__kicker tpm-in" style="--in: 0">{hero.kicker}</p>
        <h1 id="tpm-title" class="display tpm-hero__title tpm-in" style="--in: 1">{hero.headline}</h1>
      </div>
      <p class="lede tpm-hero__lede tpm-in" style="--in: 2">{hero.copy}</p>
    </div>

    <div class="tpm-hero__media">
      <div class="tpm-hero__box" data-tpm-box>
        <div class="tpm-screen" data-surface="dark" data-tpm-screen style={loop.plate ? `--plate: ${loop.plate}` : undefined}>
          <div class="tpm-screen__frame">
            {
              poster && (
                <Picture
                  src={poster}
                  alt=""
                  widths={[640, 960, 1280, 1600, 1920]}
                  sizes="(min-width: 60rem) 70vw, calc(100vw - 2.5rem)"
                  formats={['avif', 'webp']}
                  loading="eager"
                  fetchpriority="high"
                  class="tpm-screen__poster"
                />
              )
            }
            <video class="tpm-screen__video" muted loop playsinline preload="none" aria-label={loop.alt}>
              {small && <source src={small} media="(max-width: 47.99rem)" type="video/mp4" />}
              {large && <source src={large} type="video/mp4" />}
            </video>
          </div>
        </div>
        {/* Beside the screen rather than inside it, so it keeps its size while
            the screen grows; the script keeps it in the screen's visible
            lower right corner. */}
        <button type="button" class="tpm-toggle" data-loop-toggle data-label={loop.label} aria-label={`Play video: ${loop.label}`} hidden>
          <span class="tpm-toggle__play"><Icon name="play" size={12} /></span>
          <span class="tpm-toggle__pause"><Icon name="pause" size={12} /></span>
        </button>
      </div>
    </div>

    <div class="container tpm-hero__foot" data-tpm-hero-foot>
      <ul class="tpm-hero__scope tpm-in" style="--in: 3" aria-label="Scope of the work" data-tpm-scope>
        {hero.scope.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  import { Loop, addStage, live, onLiveChange, clamp, lerp, span, easeInOut, smooth } from '@lib/tpm-motion';

  const hero = document.querySelector<HTMLElement>('[data-tpm-hero]');
  const box = hero?.querySelector<HTMLElement>('[data-tpm-box]');
  const screen = hero?.querySelector<HTMLElement>('[data-tpm-screen]');
  const head = hero?.querySelector<HTMLElement>('[data-tpm-hero-copy]');
  const foot = hero?.querySelector<HTMLElement>('[data-tpm-hero-foot]');
  const toggle = hero?.querySelector<HTMLElement>('[data-loop-toggle]');
  const scope = hero?.querySelector<HTMLElement>('[data-tpm-scope]');

  // The scope line is centered and may wrap into two balanced lines; the dot
  // before an item is hidden where that item opens a line.
  if (scope) {
    const items = Array.from(scope.children) as HTMLElement[];
    const mark = () => {
      let top = Number.NaN;
      for (const li of items) {
        li.classList.toggle('is-line-start', li.offsetTop !== top && !Number.isNaN(top));
        top = li.offsetTop;
      }
    };
    mark();
    document.fonts?.ready.then(mark);
    if ('ResizeObserver' in window) new ResizeObserver(mark).observe(scope);
  }

  if (hero && box && screen && head && foot) {
    // ---- the loop ----------------------------------------------------------
    // Fetched at once (it is the page's hero) and started once the screen has
    // arrived, so the designed poster is what the screen first shows.
    const loop = new Loop(box, { eager: true, threshold: 0.15 });
    const ENTRANCE_MS = 1300;
    window.setTimeout(() => loop.want(true), ENTRANCE_MS);

    // ---- the screen grows toward the edges ---------------------------------
    // Uniform scale and translation only (no layout per frame): from the
    // screen's place in the hero to a size that covers the viewport, centered.
    // The visible corner radius eases to nothing as it reaches the edges.
    let rest = { x: 0, y: 0, w: 1, h: 1 };
    let radius = 14;

    // Layout offsets, not client rects, so the screen's own entrance (a short
    // rise) never skews where it rests.
    const stage = hero.firstElementChild as HTMLElement;
    const measure = () => {
      let x = 0;
      let y = 0;
      for (let el: HTMLElement | null = box; el && el !== stage; el = el.offsetParent as HTMLElement | null) {
        x += el.offsetLeft;
        y += el.offsetTop;
      }
      rest = { x, y, w: box.offsetWidth, h: box.offsetHeight };
      radius = parseFloat(getComputedStyle(screen).borderTopLeftRadius) || 14;
    };

    const reset = () => {
      screen.style.transform = '';
      screen.style.borderRadius = '';
      box.style.removeProperty('--lift');
      if (toggle) toggle.style.transform = '';
      for (const el of [head, foot]) {
        el.style.opacity = '';
        el.style.transform = '';
      }
    };

    // The first 80% of the run grows the screen; the rest holds it full.
    const update = (p: number, _rect: DOMRect, vh: number) => {
      const vw = document.documentElement.clientWidth;
      const e = easeInOut(span(p, 0, 0.8));
      const cover = Math.max(vw / rest.w, vh / rest.h);
      const s = lerp(1, cover, e);
      const dx = lerp(0, vw / 2 - (rest.x + rest.w / 2), e);
      const dy = lerp(0, vh / 2 - (rest.y + rest.h / 2), e);
      screen.style.transform = e > 0 ? `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${s.toFixed(4)})` : '';
      screen.style.borderRadius = e > 0 ? `${((radius * (1 - e)) / s).toFixed(3)}px` : '';
      box.style.setProperty('--lift', (1 - clamp(e * 2.2)).toFixed(3));
      // The control stays in the lower right corner of what is visible of the
      // screen: its own corner at first, the viewport's once it covers it.
      if (toggle) {
        const cx = rest.x + rest.w / 2 + dx;
        const cy = rest.y + rest.h / 2 + dy;
        const right = Math.min(cx + (rest.w * s) / 2, vw);
        const bottom = Math.min(cy + (rest.h * s) / 2, vh);
        const tx = right - (rest.x + rest.w);
        const ty = bottom - (rest.y + rest.h);
        toggle.style.transform = e > 0 ? `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0)` : '';
      }
      // The copy above and the scope line below stay while the screen starts
      // to grow, then give way.
      const fade = smooth(span(e, 0.14, 0.48));
      head.style.opacity = fade > 0 ? (1 - fade).toFixed(3) : '';
      head.style.transform = fade > 0 ? `translate3d(0, ${(-40 * fade).toFixed(2)}px, 0)` : '';
      foot.style.opacity = fade > 0 ? (1 - fade).toFixed(3) : '';
      foot.style.transform = fade > 0 ? `translate3d(0, ${(28 * fade).toFixed(2)}px, 0)` : '';
    };

    const apply = () => {
      const on = live();
      hero.classList.toggle('is-live', on);
      reset();
      if (on) measure();
    };

    apply();
    addStage(hero, update);
    onLiveChange(apply);
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => {
        if (!live()) return;
        reset();
        measure();
        window.dispatchEvent(new Event('scroll'));
      }, 120);
    });
  }
</script>

<style>
  /* ---- the opening screen ------------------------------------------------- */
  .tpm-hero {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .tpm-hero {
      --view-h: 100svh;
    }
  }

  .tpm-hero__stage {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    align-content: start;
    min-height: var(--view-h);
    /* Clear of the header row, which floats over the top of the hero. */
    padding-block: calc(var(--header-row) + clamp(1.25rem, 3.5vh, 2.5rem)) clamp(1.5rem, 4vh, 2.5rem);
  }

  .tpm-hero__head {
    display: grid;
    gap: var(--space-5);
  }

  .tpm-hero__lead {
    display: grid;
    gap: clamp(0.9rem, 2vh, 1.25rem);
  }

  .tpm-hero__kicker {
    color: var(--ink-3);
  }

  .tpm-hero__title {
    font-size: clamp(2.5rem, 1rem + 3.6vw, 5rem);
    max-width: 13ch;
  }

  .tpm-hero__lede {
    max-width: 34rem;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
  }

  /* Seven areas of work, centered on the page: one line where they fit, two
     balanced lines where they do not, never smaller type. A middle dot
     (skipped by assistive technology) sits in the space before each item but
     the first, and the script hides it where an item opens a line. */
  .tpm-hero__foot {
    text-align: center;
  }

  .tpm-hero__scope {
    --gap: 2.2em;
    margin: 0;
    padding: 0;
    list-style: none;
    text-wrap: balance;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 2;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .tpm-hero__scope li {
    position: relative;
    display: inline-block;
    margin-inline: calc(var(--gap) / 2);
    white-space: nowrap;
  }

  .tpm-hero__scope li + li::before {
    content: '·';
    content: '·' / '';
    position: absolute;
    right: 100%;
    width: var(--gap);
    letter-spacing: 0;
    text-align: center;
    color: var(--ink-3);
  }

  .tpm-hero__scope li.is-line-start::before {
    visibility: hidden;
  }

  /* ---- the screen ------------------------------------------------------------ */
  .tpm-hero__media {
    min-width: 0;
    padding-inline: var(--gutter);
    animation: tpm-screen-in 1000ms var(--ease-out) 420ms both;
  }

  /* The screen's place and size; the screen inside it is what moves. */
  .tpm-hero__box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-inline: auto;
  }

  .tpm-screen {
    --screen-radius: var(--radius-lg);
    position: absolute;
    inset: 0;
    border-radius: var(--screen-radius);
    overflow: hidden;
    background: var(--plate, #0e1211);
    transform-origin: 50% 50%;
    /* A soft lift off the page, eased away as the screen grows (--lift is
       written by the script; 1 at rest). */
    box-shadow:
      0 36px 72px -40px rgba(13, 15, 16, calc(0.6 * var(--lift, 1))),
      0 14px 28px -18px rgba(13, 15, 16, calc(0.32 * var(--lift, 1)));
  }

  /* A hairline edge, eased away with the shadow as the screen grows. */
  .tpm-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(237, 240, 239, calc(0.06 * var(--lift, 1)));
    pointer-events: none;
  }

  .tpm-screen__frame {
    position: absolute;
    inset: 0;
  }

  .tpm-screen__frame :global(picture),
  .tpm-screen__poster,
  .tpm-screen__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tpm-screen__poster,
  .tpm-screen__video {
    object-fit: cover;
  }

  /* Invisible until its first frame is on screen, then it fades in over the
     poster; the poster stays without JavaScript and if the video fails. */
  .tpm-screen__video {
    opacity: 0;
    background: transparent;
  }

  .tpm-screen__video[data-shown] {
    opacity: 1;
    transition: opacity 0.32s var(--ease-out);
  }

  /* ---- pause and play ---------------------------------------------------------- */
  .tpm-toggle {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid rgba(237, 240, 239, 0.35);
    border-radius: 50%;
    background: rgba(13, 15, 16, 0.62);
    color: var(--c-fog);
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .tpm-toggle:hover {
    background: rgba(13, 15, 16, 0.85);
  }

  .tpm-toggle:focus-visible {
    outline: 2px solid var(--c-fog);
    outline-offset: 2px;
  }

  .tpm-toggle__play,
  .tpm-toggle__pause {
    display: grid;
    place-items: center;
  }

  .tpm-toggle__pause,
  .tpm-toggle[data-state='playing'] .tpm-toggle__play {
    display: none;
  }

  .tpm-toggle[data-state='playing'] .tpm-toggle__pause {
    display: grid;
  }

  /* ---- entrance: the copy first, the screen a moment later --------------------- */
  .tpm-in {
    animation: rise-in 760ms var(--ease-out) both;
    animation-delay: calc(80ms + var(--in, 0) * 90ms);
  }

  @keyframes tpm-screen-in {
    from {
      opacity: 0;
      transform: translate3d(0, 28px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- wide screens: the entry state ---------------------------------------------
     The headline holds the left of the upper area and the sentence the right,
     level with its last line. The screen is centered in the room between the
     copy and the scope line: about 54% of the window's width, no wider than
     60rem, and no taller than that room less clear space above and below it
     (the room is a size container, so the screen can follow its height). */
  @media (min-width: 60rem) {
    .tpm-hero__stage {
      --air: clamp(1rem, 4.5vh, 3rem);
      grid-template-rows: auto minmax(14rem, 1fr) auto;
      gap: clamp(1rem, 2.4vh, 2rem);
    }

    .tpm-hero__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 6rem);
      align-items: end;
    }

    /* Two balanced lines across the wider column. */
    .tpm-hero__title {
      max-width: none;
    }

    .tpm-hero__lede {
      justify-self: end;
      padding-bottom: 0.35rem;
    }

    .tpm-hero__media {
      container-type: size;
      position: relative;
      display: grid;
      place-items: center;
    }

    .tpm-hero__box {
      width: min(54vw, 60rem, (100cqh - 2 * var(--air)) * 16 / 9);
    }
  }

  /* ---- live: the hero holds while the screen fills the viewport ------------------ */
  @media (min-width: 60rem) and (min-height: 37.5rem) and (prefers-reduced-motion: no-preference) {
    .tpm-hero.is-live {
      height: calc(var(--view-h) * 2);
    }

    .tpm-hero.is-live .tpm-hero__stage {
      position: sticky;
      top: 0;
      height: var(--view-h);
      overflow: hidden;
    }

    /* Above the copy it grows over. */
    .tpm-hero.is-live .tpm-hero__media {
      z-index: 1;
    }
  }
</style>
