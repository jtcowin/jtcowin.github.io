---
/**
 * 01 Hero (Technical Product Marketing, V1.4). The headline and paragraph on
 * the left, vertically centered; on the right the narrative-system object;
 * the seven areas of scope in one centered line at the foot of the hero
 * (wrapping, centered, only where the screen is too narrow); and, behind the
 * object, a quiet topographic field. The headline never changes.
 *
 * The object is two states, not a toy that chases the pointer. At rest it is a
 * compact, stable stack of six layers with only a little ambient life: a slow
 * light passing up through the layers and a 1.5px drift. Pointing at the
 * object itself (not the hero around it), tapping it, or pressing its control
 * from the keyboard opens it into an exploded view that settles: the
 * foundation (research and interviews, the shared internal language,
 * positioning and claims) separates, the market expressions it carries (the
 * website, technical documentation, campaigns and content) rise above it and
 * fan out slightly, joined by posts, and short labels appear beside each
 * layer once it has arrived. Leaving, the labels fade first, then the stack
 * closes smoothly. Escape, a second tap or a tap elsewhere closes it too.
 * Geometry: src/lib/tpm-system.ts; layer names: tpm.json.
 *
 * The field (src/lib/tpm-field.ts) is contour lines in very low contrast,
 * concentrated around the object, their fade toward the copy and the edges
 * drawn into the lines (no CSS mask). While a fine pointer moves anywhere in
 * the hero, a soft light follows it across the lines and the map shifts a
 * few pixels; the light dims once the pointer rests or the page scrolls. The
 * object takes no part in that.
 *
 * Performance: SVG and CSS transforms and opacity only (no WebGL); the
 * pointer is read once a frame through requestAnimationFrame and the field
 * moves only by transforms of its own compositor layers (fine pointers only);
 * the drift is a compositor animation of the whole drawing, so at rest the
 * main thread is all but idle; the ambient light and drift pause off screen
 * and while open, and are gone while the Foundation rises over the hero;
 * layout is measured on resize, never per pointer move. Reduced motion: no
 * ambient life and no field response; the object still opens and closes, at
 * once. Without JavaScript the object opens on hover or focus within it.
 *
 * Leaving the hero (wide, tall-enough screens with motion allowed, V1.3): it
 * holds for one screen of scrolling while the Foundation's surface rises over
 * it, the hero's content fading and softening a little (TpmFlow.astro reads
 * the values this script hands it); since V1.4 the field fades out over the
 * first half of that rise and the object rests closed and still.
 */
import tpm from '@data/tpm.json';
import { emphasize } from '@lib/tpm-copy';
import { narrativeSystem } from '@lib/tpm-system';
import { contourField } from '@lib/tpm-field';

const { hero } = tpm;
const title = emphasize(hero.headline, hero.accent, 'hero headline');
const copy = emphasize(hero.copy, hero.em, 'hero paragraph');

const groups = hero.system.groups;
const system = narrativeSystem(groups.map((g) => g.layers));
const vb = system.viewBox;
const field = contourField();
const pct = (v: number) => `${(v * 100).toFixed(2)}%`;
// The silhouettes the pointer has to be over, for the script (units).
const hitData = JSON.stringify({ vb, rest: system.hull.rest.map(([x, y]) => [+x.toFixed(1), +y.toFixed(1)]), open: system.hull.open.map(([x, y]) => [+x.toFixed(1), +y.toFixed(1)]) });
---

<section class="tpm-hero" data-surface="light" aria-labelledby="tpm-title" data-tpm-hero>
  <div class="tpm-hero__stage" data-tpm-hero-stage>
    <div class="tpm-field" aria-hidden="true" data-tpm-field>
      <div class="tpm-field__drift" data-field-drift>
        <svg class="tpm-field__map" viewBox={`0 0 ${field.width} ${field.height}`} width={field.width} height={field.height} focusable="false">
          <g id="tpm-field-lines">{field.paths.map((p) => <path d={p.d} opacity={p.w < 1 ? p.w : undefined} />)}</g>
        </svg>
        <div class="tpm-field__light" data-field-light>
          <div class="tpm-field__lit" data-field-lit>
            <svg class="tpm-field__map" viewBox={`0 0 ${field.width} ${field.height}`} width={field.width} height={field.height} focusable="false">
              <use href="#tpm-field-lines" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <div class="container tpm-hero__grid">
      <div class="tpm-hero__copy" data-tpm-hero-copy>
        <h1 id="tpm-title" class="display tpm-hero__title tpm-in" style="--in: 0">
          {title.map(({ text, em }) => (em ? <span class="tpm-accent">{text}</span> : text))}
        </h1>
        <p class="lede tpm-hero__lede tpm-in" style="--in: 1">
          {copy.map(({ text, em }) => (em ? <strong class="tpm-em">{text}</strong> : text))}
        </p>
      </div>

      <div class="tpm-hero__visual" data-tpm-hero-visual>
        <div class="tpm-hero__object tpm-in" style="--in: 2">
          <div class="tpm-system" style={`aspect-ratio: ${vb.w} / ${vb.h}`} data-tpm-system>
            <button type="button" class="tpm-system__toggle" aria-expanded="false" aria-controls="tpm-system-legend" data-system-toggle>
              {hero.system.toggle}
            </button>
            <svg class="tpm-object" viewBox={`${vb.x} ${vb.y} ${vb.w} ${vb.h}`} aria-hidden="true" focusable="false">
              <polygon class="tpm-object__ring tpm-object__ring--rest" points={system.ring.rest} />
              <polygon class="tpm-object__ring tpm-object__ring--open" points={system.ring.open} />
              <g class="tpm-object__stack">
                {
                  system.layers.map((l) => (
                    <g class:list={['tpm-layer', `tpm-layer--${l.tone}`]} style={`--i: ${l.index}; --dx: ${l.dx}px; --dy: ${l.dy}px`}>
                      {l.posts.length > 0 && (
                        <g class:list={['tpm-layer__posts', l.index === 3 && 'tpm-layer__posts--bridge']}>
                          {l.posts.map((p) => (
                            <>
                              <line x1={p.x1} y1={p.y1} x2={p.x2} y2={p.y2} />
                              <circle cx={p.x2} cy={p.y2} r="2.6" />
                            </>
                          ))}
                        </g>
                      )}
                      <polygon class="tpm-layer__left" points={l.left} />
                      <polygon class="tpm-layer__right" points={l.right} />
                      <polygon class="tpm-layer__top" points={l.top} />
                      {l.marks.map((m) =>
                        m.kind === 'line' ? (
                          <line class="tpm-layer__mark" x1={m.x1} y1={m.y1} x2={m.x2} y2={m.y2} />
                        ) : m.kind === 'dot' ? (
                          <circle class="tpm-layer__dot" cx={m.cx} cy={m.cy} r={m.r} />
                        ) : m.kind === 'ring' ? (
                          <ellipse class="tpm-layer__ring" cx={m.cx} cy={m.cy} rx={m.rx} ry={m.ry} />
                        ) : (
                          <polygon class="tpm-layer__block" points={m.points} />
                        ),
                      )}
                      <g class="tpm-layer__glint">
                        <polygon points={l.left} />
                        <polygon points={l.right} />
                        <polygon class="tpm-layer__glint-top" points={l.top} />
                      </g>
                    </g>
                  ))
                }
              </g>
            </svg>
            <div class="tpm-system__legend" id="tpm-system-legend" data-system-legend>
              {
                groups.map((g, gi) => (
                  <div class="tpm-system__group">
                    <p class="tpm-system__heading" style={`--y: ${pct(system.groupTop[gi])}`}>
                      {g.name}
                    </p>
                    <ol class="tpm-system__layers">
                      {system.layers
                        .filter((l) => l.group === gi)
                        .map((l) => (
                          <li class="tpm-system__layer" style={`--x: ${l.anchor.x}; --y: ${pct(l.anchor.y)}`}>
                            <span class="tpm-system__label" aria-hidden="true">
                              {l.label}
                            </span>
                            <span class="sr-only">{l.name}</span>
                          </li>
                        ))}
                    </ol>
                  </div>
                ))
              }
            </div>
            <div class="tpm-system__hit" aria-hidden="true" data-system-hit data-geometry={hitData}></div>
          </div>
        </div>
      </div>
    </div>

    <ul class="tpm-hero__scope tpm-in" style="--in: 3" aria-label="Scope of the work" data-tpm-scope>
      {
        hero.scope.map((item) => (
          <li>
            <span class="tpm-hero__term">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { addStage, live, onLiveChange, reducedMotion, clamp, span, smooth } from '@lib/tpm-motion';

  const hero = document.querySelector<HTMLElement>('[data-tpm-hero]');
  const stage = hero?.querySelector<HTMLElement>('[data-tpm-hero-stage]');
  const scope = hero?.querySelector<HTMLElement>('[data-tpm-scope]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  let inView = true;
  // How far the Foundation has risen over the held hero (live only, 0 to 1).
  let covered = 0;

  // The scope rail wraps only where it must; the dot before an item is hidden
  // where that item opens a line.
  if (scope) {
    const items = Array.from(scope.children) as HTMLElement[];
    const mark = () => {
      let top = Number.NaN;
      for (const li of items) {
        li.classList.toggle('is-line-start', li.offsetTop !== top && !Number.isNaN(top));
        top = li.offsetTop;
      }
    };
    mark();
    document.fonts?.ready.then(mark);
    if ('ResizeObserver' in window) new ResizeObserver(mark).observe(scope);
  }

  // ---- the narrative system: closed at rest, open while pointed at, tapped or toggled ----
  const system = hero?.querySelector<HTMLElement>('[data-tpm-system]');
  const control = (() => {
    if (!system) return null;
    const hit = system.querySelector<HTMLElement>('[data-system-hit]') as HTMLElement;
    const toggle = system.querySelector<HTMLButtonElement>('[data-system-toggle]') as HTMLButtonElement;
    const geo = JSON.parse(hit.dataset.geometry || '{}') as { vb: { x: number; y: number; w: number; h: number }; rest: number[][]; open: number[][] };
    let hovered = false;
    let toggled = false;
    let enabled = true;
    let lastX = Number.NaN;
    let lastY = Number.NaN;
    const clip = { rest: '', open: '' };

    const isOpen = () => system.classList.contains('is-open');
    const render = () => {
      const open = enabled && (hovered || toggled);
      if (open === isOpen()) return;
      system.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      hit.style.clipPath = open ? clip.open : clip.rest;
    };

    // The pointer counts only over the stack itself: the hit area is clipped
    // to the stack's silhouette, and, once open, to the open stack and its
    // labels. Measured on resize, never per pointer move.
    const hullOf = (pts: number[][]) => {
      const p = [...pts].sort((a, b) => a[0] - b[0] || a[1] - b[1]);
      const cross = (o: number[], a: number[], b: number[]) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
      const lo: number[][] = [];
      for (const q of p) {
        while (lo.length >= 2 && cross(lo[lo.length - 2], lo[lo.length - 1], q) <= 0) lo.pop();
        lo.push(q);
      }
      const up: number[][] = [];
      for (const q of [...p].reverse()) {
        while (up.length >= 2 && cross(up[up.length - 2], up[up.length - 1], q) <= 0) up.pop();
        up.push(q);
      }
      return [...lo.slice(0, -1), ...up.slice(0, -1)];
    };
    const measure = () => {
      const w = system.offsetWidth;
      const h = system.offsetHeight;
      if (!w || !h) return;
      const room = -hit.offsetLeft; // the labels' room, to the left of the box
      const sx = w / geo.vb.w;
      const sy = h / geo.vb.h;
      const toPx = ([x, y]: number[]) => [(x - geo.vb.x) * sx + room, (y - geo.vb.y) * sy];
      const polygon = (pts: number[][]) => `polygon(${pts.map(([x, y]) => `${x.toFixed(1)}px ${y.toFixed(1)}px`).join(', ')})`;
      const openPts = geo.open.map(toPx);
      const top = Math.min(...openPts.map((p) => p[1]));
      const bottom = Math.max(...openPts.map((p) => p[1]));
      clip.rest = polygon(geo.rest.map(toPx));
      clip.open = polygon(hullOf([...openPts, [0, top], [0, bottom]]));
      hit.style.clipPath = isOpen() ? clip.open : clip.rest;
    };
    measure();
    document.fonts?.ready.then(measure);
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(system);

    // A mouse or pen opens it by moving over it (a real move: a layout change
    // under a still pointer never does) and closes it by leaving.
    hit.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || !fine.matches) return;
      const moved = Number.isNaN(lastX) || e.clientX !== lastX || e.clientY !== lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      if (moved && !hovered) {
        hovered = true;
        render();
      }
    });
    hit.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'touch') return;
      lastX = Number.NaN;
      hovered = false;
      render();
    });
    // Touch: a tap toggles it; a tap anywhere else closes it.
    hit.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'mouse' && fine.matches) return;
      toggled = !isOpen();
      if (!toggled) hovered = false;
      render();
    });
    document.addEventListener('pointerdown', (e) => {
      if (toggled && !system.contains(e.target as Node)) {
        toggled = false;
        render();
      }
    });
    // Keyboard and screen readers: the control toggles it; Escape closes it.
    toggle.addEventListener('click', () => {
      toggled = !isOpen();
      if (!toggled) hovered = false;
      render();
    });
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        toggled = false;
        hovered = false;
        render();
      }
    });
    toggle.addEventListener('blur', () => {
      if (toggled) {
        toggled = false;
        render();
      }
    });

    return {
      // Off screen, or while the Foundation covers the hero, it rests closed.
      enable(on: boolean) {
        if (enabled === on) return;
        enabled = on;
        if (!on) {
          hovered = false;
          toggled = false;
        }
        render();
      },
    };
  })();

  // ---- the field: a soft light that follows a fine pointer, and a slight shift ----
  const fieldEl = stage?.querySelector<HTMLElement>('[data-tpm-field]');
  const fieldControl = (() => {
    if (!hero || !stage || !fieldEl) return null;
    const drift = fieldEl.querySelector<HTMLElement>('[data-field-drift]') as HTMLElement;
    const light = fieldEl.querySelector<HTMLElement>('[data-field-light]') as HTMLElement;
    const lit = fieldEl.querySelector<HTMLElement>('[data-field-lit]') as HTMLElement;
    const visual = hero.querySelector<HTMLElement>('[data-tpm-hero-visual]') as HTMLElement;
    const R = 280; // half the light's size
    const REST = 1400; // ms of stillness before the light dims
    let rect: DOMRect | null = null; // the field's box and the stage's, read
    let stageRect: DOMRect | null = null; // once after each scroll or resize
    let raf = 0;
    let then = 0;
    let has = false; // a pointer position to follow
    let dimmed = 0; // when the light last dimmed
    let restTimer = 0;
    let tx = 0;
    let ty = 0; // target light position (field px)
    let lx = 0;
    let ly = 0;
    let ox = 0;
    let oy = 0; // current shift
    let sx = 0;
    let sy = 0; // target shift

    // Center the map on the object (layout read on resize only).
    const place = () => {
      const s = stage.getBoundingClientRect();
      const v = visual.getBoundingClientRect();
      fieldEl.style.setProperty('--fx', `${(v.left + v.width / 2 - s.left).toFixed(1)}px`);
      fieldEl.style.setProperty('--fy', `${(v.top + v.height / 2 - s.top).toFixed(1)}px`);
      rect = null;
      stageRect = null;
    };
    place();
    window.addEventListener('resize', place, { passive: true });

    // The light is for a moving pointer: it dims when the pointer rests, the
    // page scrolls or the pointer leaves, and starts afresh where the pointer
    // next moves once it has faded.
    const dim = () => {
      window.clearTimeout(restTimer);
      if (!fieldEl.classList.contains('is-lit')) return;
      fieldEl.classList.remove('is-lit');
      dimmed = performance.now();
    };
    window.addEventListener(
      'scroll',
      () => {
        rect = null;
        stageRect = null;
        dim();
      },
      { passive: true },
    );

    const draw = () => {
      drift.style.transform = `translate3d(${ox.toFixed(2)}px, ${oy.toFixed(2)}px, 0)`;
      light.style.transform = `translate3d(${(lx - R).toFixed(1)}px, ${(ly - R).toFixed(1)}px, 0)`;
      lit.style.transform = `translate3d(${(R - lx).toFixed(1)}px, ${(R - ly).toFixed(1)}px, 0)`;
    };
    const frame = (now: number) => {
      raf = 0;
      const dt = Math.min(0.05, Math.max(0.001, (now - (then || now)) / 1000));
      then = now;
      const k = 1 - Math.exp(-dt / 0.12);
      const kd = 1 - Math.exp(-dt / 0.4);
      lx += (tx - lx) * k;
      ly += (ty - ly) * k;
      ox += (sx - ox) * kd;
      oy += (sy - oy) * kd;
      // Within a fraction of a pixel of where it is going, it arrives and the
      // loop stops (no invisible tail of sub-pixel frames).
      const settled = Math.abs(tx - lx) < 0.5 && Math.abs(ty - ly) < 0.5 && Math.abs(sx - ox) < 0.2 && Math.abs(sy - oy) < 0.2;
      if (settled) {
        lx = tx;
        ly = ty;
        ox = sx;
        oy = sy;
      }
      draw();
      if (!settled && inView) raf = requestAnimationFrame(frame);
      else then = 0;
    };
    const run = () => {
      if (!raf && inView) raf = requestAnimationFrame(frame);
    };

    stage.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'touch' || !fine.matches || reducedMotion() || !inView) return;
        if (!rect) rect = fieldEl.getBoundingClientRect();
        if (!stageRect) stageRect = stage.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        // The map shifts a few pixels against the pointer, from the hero's middle.
        const s = stageRect;
        sx = -clamp((e.clientX - (s.left + s.width / 2)) / (s.width / 2), -1, 1) * 7;
        sy = -clamp((e.clientY - (s.top + s.height / 2)) / (s.height / 2), -1, 1) * 5;
        tx = x - sx;
        ty = y - sy;
        if (!fieldEl.classList.contains('is-lit')) {
          // first sight, or after it has faded: start the light where the pointer is
          if (!has || performance.now() - dimmed > 650) {
            lx = tx;
            ly = ty;
          }
          has = true;
          fieldEl.classList.add('is-lit');
        }
        window.clearTimeout(restTimer);
        restTimer = window.setTimeout(dim, REST);
        run();
      },
      { passive: true },
    );
    stage.addEventListener('pointerleave', () => {
      has = false;
      dim();
      sx = 0;
      sy = 0;
      run();
    });
    return {
      sleep() {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        then = 0;
      },
      wake: run,
    };
  })();

  // Off screen: no ambient light or drift, the object closed, the field still.
  // Back on screen, the object answers again unless the Foundation covers it.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      system?.classList.toggle('is-asleep', !inView);
      if (inView) fieldControl?.wake();
      else fieldControl?.sleep();
      control?.enable(inView && covered < 0.15);
    }).observe(hero);
  }

  // ---- leaving the hero: the Foundation rises over it (V1.3) ---------------------------
  if (hero) {
    const copyBox = hero.querySelector<HTMLElement>('[data-tpm-hero-copy]') as HTMLElement;
    const visual = hero.querySelector<HTMLElement>('[data-tpm-hero-visual]') as HTMLElement;
    const flow = document.querySelector<HTMLElement>('[data-tpm-flow]');
    const fading = [copyBox, visual, scope].filter(Boolean) as HTMLElement[];

    const reset = () => {
      for (const el of fading) {
        el.style.opacity = '';
        el.style.transform = '';
        el.style.filter = '';
        el.style.willChange = '';
      }
      flow?.style.removeProperty('--lead-r');
      flow?.style.removeProperty('--lead-shadow');
      flow?.style.removeProperty('--rise');
      if (fieldEl) {
        fieldEl.style.opacity = '';
        fieldEl.style.willChange = '';
      }
    };

    // p runs from 0 to 1 over the one screen the stage holds, which is
    // exactly the Foundation's rise from the bottom of the screen to the top.
    const update = (p: number) => {
      const fade = smooth(span(p, 0.15, 0.95));
      const soft = smooth(span(p, 0.3, 1));
      const lift = smooth(p);
      for (const el of fading) {
        el.style.willChange = p > 0 && p < 1 ? 'opacity, transform, filter' : '';
        el.style.opacity = fade > 0 ? (1 - 0.8 * fade).toFixed(3) : '';
        el.style.transform = lift > 0 ? `translate3d(0, ${(-26 * lift).toFixed(2)}px, 0) scale(${(1 - 0.02 * lift).toFixed(4)})` : '';
        el.style.filter = soft > 0.002 ? `blur(${(2 * soft).toFixed(2)}px)` : '';
      }
      // The surface's leading edge rounds off its corners until it settles
      // (its shadow only while it rises), and the Foundation's opening fades
      // up into place (32px) as it does.
      flow?.style.setProperty('--lead-r', `${(28 * (1 - smooth(span(p, 0.55, 1)))).toFixed(2)}px`);
      flow?.style.setProperty('--lead-shadow', (smooth(span(p, 0.01, 0.1)) * (1 - smooth(span(p, 0.85, 1)))).toFixed(3));
      flow?.style.setProperty('--rise', smooth(span(p, 0.5, 1)).toFixed(3));
      // The field recedes first, as the surface starts to rise over it.
      if (fieldEl) {
        const gone = smooth(span(p, 0.05, 0.5));
        fieldEl.style.willChange = p > 0 && p < 1 ? 'opacity' : '';
        fieldEl.style.opacity = gone > 0 ? (1 - gone).toFixed(3) : '';
      }
      // Once the Foundation starts to cover it, the object rests closed and
      // its ambient life stops (nothing moves under the softening).
      covered = p;
      control?.enable(p < 0.15 && inView);
      system?.classList.toggle('is-held', p > 0);
    };

    const apply = () => {
      const on = live();
      hero.classList.toggle('is-live', on);
      reset();
      if (on) window.dispatchEvent(new Event('scroll'));
      else {
        covered = 0;
        control?.enable(inView);
        system?.classList.remove('is-held');
      }
    };

    apply();
    addStage(hero, (p) => update(p));
    onLiveChange(apply);
  }
</script>

<style>
  /* ---- the opening screen --------------------------------------------------------- */
  .tpm-hero {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .tpm-hero {
      --view-h: 100svh;
    }
  }

  /* The copy and the object, then the scope line at the foot. Clear of the
     header row, which floats over the top of the hero. */
  .tpm-hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(2.25rem, 5vh, 3.5rem);
