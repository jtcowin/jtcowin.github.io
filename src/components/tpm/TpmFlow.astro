---
/**
 * 02 Foundation and 03 the transitional statement (Technical Product
 * Marketing, V1.1), one continuous passage on the dark surface.
 *
 * 02 opens centered, unlike the split hero above it: the headline on exactly
 * two lines, the paragraph beneath it at a readable measure, then a generous
 * gap before the documents. It keeps its four parts: the section entry; the
 * featured spread (a compact stack of the first documents that opens across
 * the screen); the full body of work (the library moving right to left as
 * the page scrolls down, two unlabeled neutral covers after the last named
 * document to suggest the library runs deeper); and the exit, where the
 * documents and the opening step back and leave the screen to the statement.
 *
 * Every named document is laid out on the same internal grid: its two-digit
 * number in a fixed row, its title starting at the same height in a title
 * area two lines tall (a longer title wraps into the space below without
 * moving anything), and its subline in a fixed two-line area at the bottom.
 * Each has its own muted accent on its left strip and its faded icon, and its
 * own icon. Nothing of any document's body is shown.
 *
 * 03 is a quiet change of pace: one large block of type and nothing else,
 * revealed word by word as the page scrolls (each word fading in with a
 * slight rise), then held long enough to be read. The Website chapter that
 * follows starts on its own surface.
 *
 * All of it runs in one sticky stage on wide, tall-enough screens with motion
 * allowed (see tpm-motion.ts). Everywhere else, and without JavaScript, the
 * same content reads as a still layout: the opening, the library as a grid
 * and the statement in full.
 */
import tpm from '@data/tpm.json';
import DocIcon, { type DocIconName } from './DocIcon.astro';

const { foundation, statement } = tpm;
const docs = foundation.documents.map((doc) => ({ ...doc, icon: doc.icon as DocIconName }));
const depth = Array.from({ length: foundation.depth }, (_, k) => k);
// Word by word; each sentence but the last ends its line, so the second
// opens a line of its own.
const words = statement.copy.split(' ').map((word, i, all) => ({ word, br: i < all.length - 1 && /[.!?]$/.test(word) }));
---

<div class="tpm-flow" data-surface="dark" data-tpm-flow>
  <div class="tpm-flow__stage">
    <section class="tpm-foundation" aria-labelledby="tpm-foundation-title">
      <div class="container tpm-foundation__head" data-flow-head>
        <h2 id="tpm-foundation-title" class="display tpm-foundation__title">
          {foundation.headline.map((line, i) => (i ? [' ', <span>{line}</span>] : <span>{line}</span>))}
        </h2>
        <p class="tpm-foundation__copy">{foundation.copy}</p>
      </div>

      <div class="container tpm-library">
        <ol class="tpm-library__docs" aria-label="The marketing foundation, document by document">
          {
            docs.map((doc, i) => (
              <li class="tpm-doc" style={`--doc: ${doc.color}; --i: ${i}`} data-doc data-accent={doc.accent}>
                <div class="tpm-doc__card">
                  <span class="tpm-doc__strip" aria-hidden="true" />
                  <span class="tpm-doc__face" aria-hidden="true">
                    <DocIcon name={doc.icon} class="tpm-doc__icon" />
                  </span>
                  <span class="tpm-doc__text">
                    <span class="tpm-doc__num">{doc.number}</span>{' '}
                    <span class="tpm-doc__title">{doc.title}</span>{' '}
                    <span class="tpm-doc__sub">{doc.subline}</span>
                  </span>
                </div>
              </li>
            ))
          }
          {
            depth.map((k) => (
              <li class="tpm-doc tpm-doc--depth" style={`--k: ${k}`} aria-hidden="true" data-doc data-depth>
                <div class="tpm-doc__card" />
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <div class="tpm-statement" data-flow-statement>
      <div class="container tpm-statement__inner">
        <p class="sr-only">{statement.copy}</p>
        <p class="tpm-statement__copy" aria-hidden="true">
          {words.map(({ word, br }, i) => [i && !words[i - 1].br ? ' ' : '', <span class="tpm-word" data-word>{word}</span>, br ? <br /> : ''])}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { addStage, live, onLiveChange, clamp, lerp, span, easeInOut, smooth } from '@lib/tpm-motion';

  type Pt = { x: number; y: number };
  type Box = { x: number; y: number; w: number; h: number };

  const flow = document.querySelector<HTMLElement>('[data-tpm-flow]');

  if (flow) {
    const stage = flow.firstElementChild as HTMLElement;
    const head = flow.querySelector<HTMLElement>('[data-flow-head]') as HTMLElement;
    const docs = Array.from(flow.querySelectorAll<HTMLElement>('[data-doc]'));
    const statement = flow.querySelector<HTMLElement>('[data-flow-statement]') as HTMLElement;
    const words = Array.from(flow.querySelectorAll<HTMLElement>('[data-word]'));

    // ---- the timeline ----------------------------------------------------
    // Lengths in screen heights of scrolling; the stage holds for their sum.
    // 02 runs from the entry to the exit, 03 from its first word to the end of
    // the hold. Each is one number to tune after the browser review.
    const PHASES: Array<[string, number]> = [
      ['settle', 0.15], // the entry and the compact stack
      ['spread', 0.5], // the stack opens: the featured spread
      ['rail', 1.45], // the full library moves right to left
      ['exit', 0.4], // the documents and the opening step back
      ['statement', 0.75], // the statement, word by word
      ['hold', 0.65], // the whole statement, held to be read
    ];
    const RUN = PHASES.reduce((sum, [, v]) => sum + v, 0);
    const windows = new Map<string, [number, number]>();
    {
      let at = 0;
      for (const [name, v] of PHASES) {
        windows.set(name, [at / RUN, (at + v) / RUN]);
        at += v;
      }
    }
    const phase = (p: number, name: string) => {
      const [a, b] = windows.get(name) as [number, number];
      return span(p, a, b);
    };
    flow.style.setProperty('--flow-run', String(RUN));

    // ---- geometry ----------------------------------------------------------
    // Read from layout offsets relative to the stage, so the transforms this
    // script writes never feed back into what it measures.
    const within = (el: HTMLElement): Box => {
      let x = 0;
      let y = 0;
      for (let n: HTMLElement | null = el; n && n !== stage; n = n.offsetParent as HTMLElement | null) {
        x += n.offsetLeft;
        y += n.offsetTop;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };

    let G = { left: 0, right: 0, cardW: 0, cardH: 0, gap: 0, bandY: 0, pile: { x: 0, y: 0 } as Pt, travel: 0 };

    // The compact stack: each card a little offset and turned, the first on top.
    const PILE = [
      { dx: 0, dy: 0, r: -1.5 },
      { dx: 12, dy: -7, r: 2 },
      { dx: -13, dy: -11, r: -3.5 },
      { dx: 20, dy: -16, r: 4 },
      { dx: -22, dy: -20, r: -5.5 },
      { dx: 26, dy: -24, r: 6 },
    ];
    const IN_PILE = PILE.length;
    const slotX = (i: number) => G.left + i * (G.cardW + G.gap);

    const measure = () => {
      reset();
      const vw = stage.clientWidth;
      const vh = stage.clientHeight;
      const headBox = within(head);
      const cs = getComputedStyle(head);
      const left = headBox.x + parseFloat(cs.paddingLeft);
      const right = headBox.x + headBox.w - parseFloat(cs.paddingRight);

      // Cards: sized from the screen, and lowered rather than crowding the
      // opening: never taller than the room left under it after a generous gap.
      let cardW = clamp(vw * 0.158, 196, 268);
      let cardH = cardW * 1.3;
      const bandTop = headBox.y + headBox.h + clamp(vh * 0.075, 32, 88);
      const bandBottom = vh - clamp(vh * 0.06, 24, 64);
      if (cardH > bandBottom - bandTop) {
        cardH = Math.max(168, bandBottom - bandTop);
        cardW = cardH / 1.3;
      }
      const gap = clamp(vw * 0.014, 14, 24);
      flow.style.setProperty('--card-w', `${cardW.toFixed(1)}px`);
      flow.style.setProperty('--card-h', `${cardH.toFixed(1)}px`);
      const lastRight = left + docs.length * (cardW + gap) - gap;
      const travel = Math.max(0, lastRight - right);
      const bandY = bandTop + (bandBottom - bandTop) / 2;
      G = { left, right, cardW, cardH, gap, bandY, pile: { x: (left + right) / 2, y: bandY }, travel };
    };

    // ---- per frame ---------------------------------------------------------
    const update = (p: number) => {
      const { cardW, cardH, bandY } = G;
      const tSpread = phase(p, 'spread');
      const tRail = phase(p, 'rail');
      const tExit = phase(p, 'exit');
      const tWords = phase(p, 'statement');

      // The opening steps back with the documents.
      const headOut = smooth(span(tExit, 0, 0.7));
      head.style.opacity = headOut > 0 ? (1 - headOut).toFixed(3) : '';
      head.style.transform = headOut > 0 ? `translate3d(0, ${(-28 * headOut).toFixed(2)}px, 0)` : '';
      head.style.visibility = headOut >= 0.999 ? 'hidden' : '';

      // The library.
      const offset = -smooth(tRail) * G.travel;
      const top = bandY - cardH / 2;
      docs.forEach((doc, i) => {
        const sx = slotX(i);
        let x = sx + offset;
        let y = top;
        let rot = 0;
        let opacity = 1;
        if (i < IN_PILE) {
          const pose = PILE[i];
          const q = easeInOut(clamp((tSpread - i * 0.07) / (1 - (IN_PILE - 1) * 0.07)));
          x = lerp(G.pile.x - cardW / 2 + pose.dx, sx, q) + offset;
          y = lerp(top + pose.dy, top, q);
          rot = lerp(pose.r, 0, q);
        } else {
          opacity = smooth(span(tSpread, 0.8, 1));
        }
        // The exit: each card on screen sinks a little and fades, left to
        // right, a beat apart.
        if (tExit > 0) {
          const on = Math.max(0, Math.min(1, (x - G.left) / Math.max(1, G.right - G.left)));
          const q = smooth(span(tExit, on * 0.3, 0.55 + on * 0.3));
          y += 22 * q;
          opacity *= 1 - q;
        }
        doc.style.zIndex = i < IN_PILE && tSpread < 1 ? String(100 - i) : '';
        doc.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)${rot ? ` rotate(${rot.toFixed(3)}deg)` : ''}`;
        doc.style.opacity = opacity < 1 ? opacity.toFixed(3) : '';
        doc.style.visibility = opacity <= 0.001 ? 'hidden' : '';
      });

      // The statement, one word after another, each fading in with a slight
      // rise; complete by the end of its phase, then held.
      const n = words.length;
      const each = 0.22;
      statement.style.visibility = tWords > 0 ? 'visible' : 'hidden';
      words.forEach((w, i) => {
        const start = (i / Math.max(1, n - 1)) * (1 - each);
        const q = smooth(span(tWords, start, start + each));
        w.style.opacity = q.toFixed(3);
        w.style.transform = q < 1 ? `translate3d(0, ${(0.28 * (1 - q)).toFixed(3)}em, 0)` : '';
      });
    };

    const reset = () => {
      for (const el of [head, statement, ...docs, ...words]) {
        el.style.transform = '';
        el.style.opacity = '';
        el.style.visibility = '';
        el.style.zIndex = '';
      }
    };

    const apply = () => {
      const on = live();
      flow.classList.toggle('is-live', on);
      if (on) {
        measure();
        update(0);
        window.dispatchEvent(new Event('scroll'));
      } else {
        reset();
      }
    };

    apply();
    document.fonts?.ready.then(() => {
      if (live()) apply();
    });
    addStage(flow, (p) => update(p));
    onLiveChange(apply);
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => {
        if (live()) apply();
      }, 140);
    });
  }
</script>

<style>
  /* ---- the passage ----------------------------------------------------------- */
  .tpm-flow {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .tpm-flow {
      --view-h: 100svh;
    }
  }

  /* ---- 02 the opening, centered ------------------------------------------------ */
  .tpm-foundation {
    padding-block: var(--section-y) calc(var(--section-y) * 0.6);
  }

  .tpm-foundation__head {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
    text-align: center;
  }

  /* Exactly two lines, broken where the brief breaks it. */
  .tpm-foundation__title {
    font-size: var(--text-2xl);
  }

  .tpm-foundation__title span {
    display: block;
    white-space: nowrap;
  }

  .tpm-foundation__copy {
    max-width: 38rem;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---- 02 the library (still layout) ------------------------------------------------ */
  .tpm-library__docs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tpm-doc {
    aspect-ratio: 10 / 13;
    min-height: 0;
  }

  .tpm-doc__card {
    position: relative;
    height: 100%;
    padding: 1rem 1rem 1rem 1.35rem;
    overflow: hidden;
    border-radius: 12px;
    background: #13171a;
    box-shadow: inset 0 0 0 1px rgba(237, 240, 239, 0.08);
    transition: transform var(--dur) var(--ease-out);
  }

  .tpm-doc__strip {
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 1;
    width: 4px;
    background: var(--doc);
  }

  .tpm-doc__face {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* One visual zone for every icon: large, faded, at the right between the
     title and the subline, partly off the card. */
  .tpm-doc__face :global(.tpm-doc__icon) {
    position: absolute;
    right: -11%;
    top: 31%;
    width: 66%;
    height: auto;
    color: var(--doc);
    stroke-width: 1.5px;
    /* Faded through the stroke rather than the element's opacity, so no
       layer edge ever shows around the icon. */
    stroke-opacity: 0.17;
    transition: stroke-opacity var(--dur) var(--ease-out);
  }

  /* The card's grid: the number in a fixed row (so every number sits on the
     same baseline), the title from the same height in an area two lines
     tall (a third line wraps into the space below without moving anything),
     open space, then the subline in a fixed two-line area at the bottom. */
  .tpm-doc__text {
    --sub-line: 1.4;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 1.25rem auto 1fr calc(2 * var(--sub-line) * 0.6875rem);
    row-gap: 0.55rem;
    height: 100%;
  }

  .tpm-doc__num {
    align-self: start;
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.25rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .tpm-doc__title {
    min-height: calc(2 * 1.08em);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.125rem, 0.95rem + 0.55vw, 1.4rem);
    line-height: 1.08;
    letter-spacing: -0.005em;
    color: var(--heading);
    text-wrap: balance;
  }

  .tpm-doc__sub {
    grid-row: 4;
    align-self: start;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: var(--sub-line);
    text-transform: uppercase;
    color: var(--ink-3);
    text-wrap: balance;
  }

  /* The unlabeled covers: neutral, quieter with depth, no text or icon. */
  .tpm-doc--depth .tpm-doc__card {
    background: #161a1d;
    box-shadow: inset 0 0 0 1px rgba(237, 240, 239, 0.06);
    opacity: calc(0.62 - var(--k, 0) * 0.24);
  }

  .tpm-doc--depth .tpm-doc__card::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 4px;
    background: rgba(237, 240, 239, 0.16);
  }

  /* A slight lift, and the faded icon a little clearer. */
  @media (hover: hover) and (pointer: fine) {
    .tpm-doc:not(.tpm-doc--depth):hover .tpm-doc__card {
      transform: translate3d(0, -6px, 0);
    }

    .tpm-doc:hover :global(.tpm-doc__icon) {
      stroke-opacity: 0.27;
    }
  }

  /* ---- 03 the statement (still layout) ------------------------------------------ */
  .tpm-statement {
    padding-block: calc(var(--section-y) * 0.9) calc(var(--section-y) * 1.4);
  }

  .tpm-statement__copy {
    max-width: 19em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 650;
    font-stretch: var(--display-stretch);
    font-size: clamp(1.875rem, 0.9rem + 2.9vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
    color: var(--heading);
    text-wrap: pretty;
  }

  .tpm-word {
    display: inline-block;
  }

  /* ---- live: one sticky stage ------------------------------------------------------ */
  @media (min-width: 60rem) and (min-height: 37.5rem) and (prefers-reduced-motion: no-preference) {
    .tpm-flow.is-live {
      height: calc(var(--view-h) * (1 + var(--flow-run, 3.9)));
    }

    .tpm-flow.is-live .tpm-flow__stage {
      position: sticky;
      top: 0;
      height: var(--view-h);
      overflow: hidden;
    }

    .tpm-flow.is-live .tpm-foundation,
    .tpm-flow.is-live .tpm-statement {
      position: absolute;
      inset: 0;
      padding: 0;
    }

    .tpm-flow.is-live .tpm-foundation__head {
      position: absolute;
      top: calc(var(--header-row) + clamp(1.25rem, 5vh, 3.5rem));
      inset-inline: 0;
      margin: 0 auto;
    }

    .tpm-flow.is-live .tpm-library {
      position: absolute;
      inset: 0;
      max-width: none;
      padding: 0;
    }

    .tpm-flow.is-live .tpm-library__docs {
      position: absolute;
      inset: 0;
      display: block;
    }

    .tpm-flow.is-live .tpm-doc {
      position: absolute;
      top: 0;
      left: 0;
      width: var(--card-w, 15rem);
      height: var(--card-h, 19.5rem);
      aspect-ratio: auto;
    }

    .tpm-flow.is-live .tpm-doc__card {
      padding: clamp(0.9rem, 1.4vw, 1.25rem) clamp(0.9rem, 1.4vw, 1.25rem) clamp(0.9rem, 1.4vw, 1.25rem) clamp(1.15rem, 1.7vw, 1.55rem);
    }

    .tpm-flow.is-live .tpm-doc__title {
      font-size: clamp(1.2rem, 0.75rem + 0.8vw, 1.6rem);
    }

    /* The statement, centered in the height of the stage. */
    .tpm-flow.is-live .tpm-statement {
      display: grid;
      align-items: center;
      visibility: hidden;
      pointer-events: none;
    }

    .tpm-flow.is-live .tpm-word {
      opacity: 0;
    }
  }
</style>
