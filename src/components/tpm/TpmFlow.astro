---
/**
 * 02 Foundation and 03 the transitional statement (Technical Product
 * Marketing, V1.1, with the V1.2 delta's copy, icons and pacing), one
 * continuous passage on the dark surface.
 *
 * 02 opens centered, unlike the split hero above it: the headline on exactly
 * two lines, the paragraph beneath it at a readable measure, then a generous
 * gap before the documents. It keeps its four parts: the section entry; the
 * featured spread (a compact stack of the first documents that opens across
 * the screen); the full body of work (the library moving right to left as
 * the page scrolls down, two unlabeled neutral covers after the last named
 * document to suggest the library runs deeper); and the exit, where the
 * documents and the opening step back and leave the screen to the statement.
 *
 * Every named document is laid out on the same internal grid: its two-digit
 * number in a fixed row, its title starting at the same height in a title
 * area two lines tall (a longer title wraps into the space below without
 * moving anything), and its subline in a fixed two-line area at the bottom.
 * Each has its own muted accent on its left strip and its faded icon, and its
 * own icon, all twelve from one family (DocIcon.astro). Nothing of any
 * document's body is shown.
 *
 * 03 is a quiet change of pace: one large block of type and nothing else, one
 * continuous sentence revealed word by word as the page scrolls (each word
 * fading in with a slight rise), then held long enough to be read. Once it is
 * complete, the page's one animated highlight (V1.3) sweeps a translucent teal
 * behind the clause that says how the shared language guides every
 * expression. The Website chapter that follows starts on its own surface.
 *
 * All of it runs in one sticky stage on wide, tall-enough screens with motion
 * allowed (see tpm-motion.ts). Arriving (V1.3), the whole dark surface rises
 * over the held hero from the bottom of the screen, its leading corners
 * rounded until it settles, and the opening fades up 32px into place: the
 * hero's script (TpmHero.astro) sets --lead-r and --rise here as it goes.
 * Everywhere else, and without JavaScript, the same content reads as a still
 * layout: the opening, the library as a grid and the statement in full, and
 * (with scripts) the Foundation crossfades in as it arrives; the highlight
 * sweeps in once the statement is in view, or simply stands with reduced
 * motion.
 */
import tpm from '@data/tpm.json';
import { emphasize } from '@lib/tpm-copy';
import DocIcon, { type DocIconName } from './DocIcon.astro';

const { foundation, statement } = tpm;
const docs = foundation.documents.map((doc) => ({ ...doc, icon: doc.icon as DocIconName }));
const depth = Array.from({ length: foundation.depth }, (_, k) => k);
// The headline's accent sits in whichever line carries it.
const accentLine = foundation.headline.findIndex((line) => line.includes(foundation.accent));
if (accentLine < 0) throw new Error('[tpm] the Foundation accent must be in its headline');
const titleLines = foundation.headline.map((line, i) => (i === accentLine ? emphasize(line, foundation.accent, 'Foundation headline') : [{ text: line, em: false }]));
// Two paragraphs: the first sentence on its own (it carries the emphasis), then the rest.
const [leadCopy, restCopy] = foundation.copy;
const copy = emphasize(leadCopy, foundation.em, 'Foundation paragraph');

// Word by word, as one continuous statement; were there a second sentence it
// would open a line of its own. The highlighted clause (V1.3) must start on a
// word; where it ends inside a word (before its colon), the rest of that word
// is its own piece, revealed with it.
const at = statement.copy.indexOf(statement.highlight);
if (at < 0 || (at > 0 && statement.copy[at - 1] !== ' ')) throw new Error('[tpm] the statement highlight must start on a word of the statement');
const end = at + statement.highlight.length;
type Piece = { text: string; br: boolean; mark: boolean; tail: boolean; space: boolean };
const pieces: Piece[] = [];
{
  let pos = 0;
  const all = statement.copy.split(' ');
  all.forEach((word, i) => {
    const from = pos;
    const to = pos + word.length;
    const br = i < all.length - 1 && /[.!?]$/.test(word);
    const space = i > 0 && !all[i - 1].match(/[.!?]$/);
    if (from >= at && to <= end) pieces.push({ text: word, br, mark: true, tail: false, space });
    else if (from >= at && from < end && to > end) {
      pieces.push({ text: word.slice(0, end - from), br: false, mark: true, tail: false, space });
      pieces.push({ text: word.slice(end - from), br, mark: false, tail: true, space: false });
    } else pieces.push({ text: word, br, mark: false, tail: false, space });
    pos = to + 1;
  });
}
const before = pieces.filter((p, i) => !p.mark && i < pieces.findIndex((q) => q.mark));
const inside = pieces.filter((p) => p.mark);
const after = pieces.slice(pieces.findIndex((q) => q.mark) + inside.length);
---

<div class="tpm-flow" data-surface="dark" data-tpm-flow>
  <div class="tpm-flow__stage">
    <section class="tpm-foundation" aria-labelledby="tpm-foundation-title" data-tpm-foundation>
      <div class="container tpm-foundation__head" data-flow-head>
        <h2 id="tpm-foundation-title" class="display tpm-foundation__title">
          {titleLines.map((line, i) => [i ? ' ' : '', <span>{line.map(({ text, em }) => (em ? <span class="tpm-accent">{text}</span> : text))}</span>])}
        </h2>
        <div class="tpm-foundation__copies">
          <p class="tpm-foundation__copy">{copy.map(({ text, em }) => (em ? <strong class="tpm-em">{text}</strong> : text))}</p>
          <p class="tpm-foundation__copy">{restCopy}</p>
        </div>
      </div>

      <div class="container tpm-library">
        <ol class="tpm-library__docs" aria-label="The marketing foundation, document by document">
          {
            docs.map((doc, i) => (
              <li class="tpm-doc" style={`--doc: ${doc.color}; --i: ${i}`} data-doc data-accent={doc.accent}>
                <div class="tpm-doc__card">
                  <span class="tpm-doc__strip" aria-hidden="true" />
                  <span class="tpm-doc__face" aria-hidden="true">
                    <DocIcon name={doc.icon} class="tpm-doc__icon" />
                  </span>
                  <span class="tpm-doc__text">
                    <span class="tpm-doc__num">{doc.number}</span>{' '}
                    <span class="tpm-doc__title">{doc.title}</span>{' '}
                    <span class="tpm-doc__sub">{doc.subline}</span>
                  </span>
                </div>
              </li>
            ))
          }
          {
            depth.map((k) => (
              <li class="tpm-doc tpm-doc--depth" style={`--k: ${k}`} aria-hidden="true" data-doc data-depth>
                <div class="tpm-doc__card" />
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <div class="tpm-statement" data-flow-statement>
      <div class="container tpm-statement__inner">
        <p class="sr-only">{statement.copy}</p>
        <p class="tpm-statement__copy" aria-hidden="true">
          {before.map((p) => [p.space ? ' ' : '', <span class="tpm-word" data-word>{p.text}</span>, p.br ? <br /> : ''])}
          {inside[0]?.space ? ' ' : ''}
          <span class="tpm-mark" data-mark>
            {inside.map((p, i) => [i && p.space ? ' ' : '', <span class="tpm-word" data-word>{p.text}</span>])}
          </span>
          {after.map((p) => [p.space ? ' ' : '', <span class="tpm-word" data-word data-with-previous={p.tail ? '' : undefined}>{p.text}</span>, p.br ? <br /> : ''])}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { addStage, live, onLiveChange, reducedMotion, clamp, lerp, span, easeOut, smooth } from '@lib/tpm-motion';

  type Pt = { x: number; y: number };
  type Box = { x: number; y: number; w: number; h: number };

  const flow = document.querySelector<HTMLElement>('[data-tpm-flow]');

  if (flow) {
    const stage = flow.firstElementChild as HTMLElement;
    const head = flow.querySelector<HTMLElement>('[data-flow-head]') as HTMLElement;
    const docs = Array.from(flow.querySelectorAll<HTMLElement>('[data-doc]'));
    const statement = flow.querySelector<HTMLElement>('[data-flow-statement]') as HTMLElement;
    const words = Array.from(flow.querySelectorAll<HTMLElement>('[data-word]'));
    const mark = flow.querySelector<HTMLElement>('[data-mark]');
    // A piece split off a word (the colon after the highlighted clause)
    // appears with that word.
    let slot = -1;
    const slots = words.map((w) => (w.hasAttribute('data-with-previous') ? slot : ++slot));
    const slotCount = slot + 1;

    // ---- the timeline ----------------------------------------------------
    // Lengths in screen heights of scrolling; the stage holds for their sum.
    // 02 runs from the entry to the exit, 03 from its first word to the end of
    // the hold. Each is one number to tune after the browser review.
    // Creator Marketing V1.2, Part One (no trackpad hiccups): no still stretch at
    // the entry (V1.6 held the compact stack for 0.15 of a screen, so the first
    // movement after the hero seemed to do nothing) and a shorter hold at the
    // end (0.35 of a screen, was 0.75), so the page releases into the Website
    // chapter without a dead stretch; the pin is 3.55 screens, was 4.1.
    const PHASES: Array<[string, number]> = [
      ['spread', 0.5], // the stack opens: the featured spread
      ['rail', 1.45], // the full library moves right to left
      ['exit', 0.4], // the documents and the opening step back
      ['statement', 0.85], // the statement, word by word
      ['hold', 0.35], // the whole statement, held to be read
    ];
    const RUN = PHASES.reduce((sum, [, v]) => sum + v, 0);
    const windows = new Map<string, [number, number]>();
    {
      let at = 0;
      for (const [name, v] of PHASES) {
        windows.set(name, [at / RUN, (at + v) / RUN]);
        at += v;
      }
    }
    const phase = (p: number, name: string) => {
      const [a, b] = windows.get(name) as [number, number];
      return span(p, a, b);
    };
    flow.style.setProperty('--flow-run', String(RUN));

    // ---- geometry ----------------------------------------------------------
    // Read from layout offsets relative to the stage, so the transforms this
    // script writes never feed back into what it measures.
    const within = (el: HTMLElement): Box => {
      let x = 0;
      let y = 0;
      for (let n: HTMLElement | null = el; n && n !== stage; n = n.offsetParent as HTMLElement | null) {
        x += n.offsetLeft;
        y += n.offsetTop;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };

    let G = { left: 0, right: 0, cardW: 0, cardH: 0, gap: 0, bandY: 0, pile: { x: 0, y: 0 } as Pt, travel: 0 };

    // The compact stack: each card a little offset and turned, the first on top.
    const PILE = [
      { dx: 0, dy: 0, r: -1.5 },
      { dx: 12, dy: -7, r: 2 },
      { dx: -13, dy: -11, r: -3.5 },
      { dx: 20, dy: -16, r: 4 },
      { dx: -22, dy: -20, r: -5.5 },
      { dx: 26, dy: -24, r: 6 },
    ];
    const IN_PILE = PILE.length;
    const slotX = (i: number) => G.left + i * (G.cardW + G.gap);

    const measure = () => {
      reset();
      const vw = stage.clientWidth;
      const vh = stage.clientHeight;
      const headBox = within(head);
      const cs = getComputedStyle(head);
      const left = headBox.x + parseFloat(cs.paddingLeft);
      const right = headBox.x + headBox.w - parseFloat(cs.paddingRight);

      // Cards: sized from the screen, and lowered rather than crowding the
      // opening: never taller than the room left under it after a generous gap.
      let cardW = clamp(vw * 0.158, 196, 268);
      let cardH = cardW * 1.3;
      const bandTop = headBox.y + headBox.h + clamp(vh * 0.075, 32, 88);
      const bandBottom = vh - clamp(vh * 0.06, 24, 64);
      if (cardH > bandBottom - bandTop) {
        cardH = Math.max(168, bandBottom - bandTop);
        cardW = cardH / 1.3;
      }
      const gap = clamp(vw * 0.014, 14, 24);
      flow.style.setProperty('--card-w', `${cardW.toFixed(1)}px`);
      flow.style.setProperty('--card-h', `${cardH.toFixed(1)}px`);
      const lastRight = left + docs.length * (cardW + gap) - gap;
      const travel = Math.max(0, lastRight - right);
      const bandY = bandTop + (bandBottom - bandTop) / 2;
      G = { left, right, cardW, cardH, gap, bandY, pile: { x: (left + right) / 2, y: bandY }, travel };
    };

    // ---- per frame ---------------------------------------------------------
    const update = (p: number) => {
      const { cardW, cardH, bandY } = G;
      const tSpread = phase(p, 'spread');
      const tRail = phase(p, 'rail');
      const tExit = phase(p, 'exit');
      const tWords = phase(p, 'statement');

      // The opening steps back with the documents.
      const headOut = smooth(span(tExit, 0, 0.7));
      head.style.opacity = headOut > 0 ? (1 - headOut).toFixed(3) : '';
      head.style.transform = headOut > 0 ? `translate3d(0, ${(-28 * headOut).toFixed(2)}px, 0)` : '';
      head.style.visibility = headOut >= 0.999 ? 'hidden' : '';

      // The library.
      // The library moves with the scroll from its first pixel, easing only into its end.
      const offset = -(0.55 * tRail + 0.45 * easeOut(tRail)) * G.travel;
      const top = bandY - cardH / 2;
      docs.forEach((doc, i) => {
        const sx = slotX(i);
        let x = sx + offset;
        let y = top;
        let rot = 0;
        let opacity = 1;
        if (i < IN_PILE) {
          const pose = PILE[i];
          // Eased out, so the stack answers the first movement of the scroll.
          const q = easeOut(clamp((tSpread - i * 0.07) / (1 - (IN_PILE - 1) * 0.07)));
          x = lerp(G.pile.x - cardW / 2 + pose.dx, sx, q) + offset;
          y = lerp(top + pose.dy, top, q);
          rot = lerp(pose.r, 0, q);
        } else {
          opacity = smooth(span(tSpread, 0.8, 1));
        }
        // The exit: each card on screen sinks a little and fades, left to
        // right, a beat apart.
        if (tExit > 0) {
          const on = Math.max(0, Math.min(1, (x - G.left) / Math.max(1, G.right - G.left)));
          const q = smooth(span(tExit, on * 0.3, 0.55 + on * 0.3));
          y += 22 * q;
          opacity *= 1 - q;
        }
        doc.style.zIndex = i < IN_PILE && tSpread < 1 ? String(100 - i) : '';
        doc.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)${rot ? ` rotate(${rot.toFixed(3)}deg)` : ''}`;
        doc.style.opacity = opacity < 1 ? opacity.toFixed(3) : '';
        doc.style.visibility = opacity <= 0.001 ? 'hidden' : '';
      });

      // The statement, one word after another, each fading in with a slight
      // rise; complete by the end of its phase, then held.
      const each = 0.22;
      statement.style.visibility = tWords > 0 ? 'visible' : 'hidden';
      words.forEach((w, i) => {
        const start = (slots[i] / Math.max(1, slotCount - 1)) * (1 - each);
        const q = smooth(span(tWords, start, start + each));
        w.style.opacity = q.toFixed(3);
        w.style.transform = q < 1 ? `translate3d(0, ${(0.28 * (1 - q)).toFixed(3)}em, 0)` : '';
      });
      // Then the one highlight sweeps in behind its clause, early in the hold.
      mark?.style.setProperty('--sweep', smooth(span(phase(p, 'hold'), 0.04, 0.7)).toFixed(3));
    };

    const reset = () => {
      for (const el of [head, statement, ...docs, ...words]) {
        el.style.transform = '';
        el.style.opacity = '';
        el.style.visibility = '';
        el.style.zIndex = '';
      }
      mark?.style.removeProperty('--sweep');
    };

    const apply = () => {
      const on = live();
      flow.classList.toggle('is-live', on);
      if (on) {
        measure();
        update(0);
        window.dispatchEvent(new Event('scroll'));
      } else {
        reset();
      }
    };

    apply();
    document.fonts?.ready.then(() => {
      if (live()) apply();
    });
    addStage(flow, (p) => update(p));

    // ---- where the stage does not run ---------------------------------------------
    // (phones, tablets, short screens, reduced motion): the Foundation's opening
    // crossfades in as it arrives, once: as its top passes four fifths of the
    // way down the screen, whatever the section's height.
    const foundation = flow.querySelector<HTMLElement>('[data-tpm-foundation]');
    if (foundation && !live() && 'IntersectionObserver' in window && foundation.getBoundingClientRect().top > window.innerHeight * 0.85) {
      foundation.classList.add('is-waiting');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          foundation.classList.remove('is-waiting');
        },
        { rootMargin: '0px 0px -20% 0px' },
      );
      io.observe(foundation);
    }
    // The still layout's highlight: it sweeps in once, when the statement is
    // well in view; with reduced motion it simply stands.
    if (mark && !live() && !reducedMotion() && 'IntersectionObserver' in window) {
      mark.classList.add('is-waiting');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          mark.classList.remove('is-waiting');
        },
        { threshold: 1, rootMargin: '0px 0px -15% 0px' },
      );
      io.observe(mark);
    }
    onLiveChange(apply);
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => {
        if (live()) apply();
      }, 140);
    });
  }
</script>

<style>
  /* ---- the passage ----------------------------------------------------------- */
  .tpm-flow {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .tpm-flow {
      --view-h: 100svh;
    }
  }

  /* ---- 02 the opening, centered ------------------------------------------------ */
  .tpm-foundation {
    padding-block: var(--section-y) calc(var(--section-y) * 0.6);
    transition: opacity 0.7s var(--ease-out);
  }

  /* The still layout's crossfade into the Foundation (set by the script, so
     never without it). An opacity change, not motion, so it keeps its timing
     under the site's reduced-motion reset (global.css). */
  .tpm-foundation.is-waiting {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .tpm-foundation {
      transition-duration: 0.7s !important;
    }
  }

  .tpm-foundation__head {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
    text-align: center;
  }

  /* Exactly two lines, broken where the brief breaks it. */
  /* Never wider than the screen: at the narrowest the two lines take a
     slightly smaller size rather than overflow (V1.4). */
  .tpm-foundation__title {
    font-size: min(var(--text-2xl), (100vw - 2 * var(--gutter)) / 9.4);
  }

  .tpm-foundation__title > span {
    display: block;
    white-space: nowrap;
  }

  /* V1.4: about 830px (736px in V1.3), so on desktop the paragraph reads in
     three even lines rather than four with a short last one. At its 18px size
     that is a longer line than the 24px case paragraphs (about 90 to 100
     characters); the generous leading carries it, and it is only three lines. */
  /* The first sentence stands alone, with intentional room beneath it, before
     the second paragraph (Events V1.1 brief, companion pass). */
  .tpm-foundation__copies {
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 0.9rem + 1.2vw, 2rem);
  }

  .tpm-foundation__copy {
    max-width: 52rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 60rem) {
    .tpm-foundation__copy {
      text-wrap: balance;
    }
  }

  /* ---- 02 the library (still layout) ------------------------------------------------ */
  .tpm-library__docs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tpm-doc {
    aspect-ratio: 10 / 13;
    min-height: 0;
  }

  .tpm-doc__card {
    position: relative;
    height: 100%;
    padding: 1rem 1rem 1rem 1.35rem;
    overflow: hidden;
    border-radius: 12px;
    background: #13171a;
    box-shadow: inset 0 0 0 1px rgba(237, 240, 239, 0.08);
    transition: transform var(--dur) var(--ease-out);
  }

  .tpm-doc__strip {
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 1;
    width: 4px;
    background: var(--doc);
  }

  .tpm-doc__face {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* One visual zone for every icon: large, faded, at the right between the
     title and the subline, partly off the card. */
  .tpm-doc__face :global(.tpm-doc__icon) {
    position: absolute;
    right: -11%;
    top: 31%;
    width: 66%;
    height: auto;
    color: var(--doc);
    /* Faded through the fill rather than the element's opacity, so no layer
       edge ever shows around the icon. */
    fill-opacity: 0.17;
    transition: fill-opacity var(--dur) var(--ease-out);
  }

  /* The card's grid: the number in a fixed row (so every number sits on the
     same baseline), the title from the same height in an area two lines
     tall (a third line wraps into the space below without moving anything),
     open space, then the subline in a fixed two-line area at the bottom. */
  .tpm-doc__text {
    --sub-line: 1.4;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 1.25rem auto 1fr calc(2 * var(--sub-line) * 0.6875rem);
    row-gap: 0.55rem;
    height: 100%;
  }

  .tpm-doc__num {
    align-self: start;
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.25rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .tpm-doc__title {
    min-height: calc(2 * 1.08em);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.125rem, 0.95rem + 0.55vw, 1.4rem);
    line-height: 1.08;
    letter-spacing: -0.005em;
    color: var(--heading);
    text-wrap: balance;
  }

  .tpm-doc__sub {
    grid-row: 4;
    align-self: start;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: var(--sub-line);
    text-transform: uppercase;
    color: var(--ink-3);
    text-wrap: balance;
  }

  /* The unlabeled covers: neutral, quieter with depth, no text or icon. */
  .tpm-doc--depth .tpm-doc__card {
    background: #161a1d;
    box-shadow: inset 0 0 0 1px rgba(237, 240, 239, 0.06);
    opacity: calc(0.62 - var(--k, 0) * 0.24);
  }

  .tpm-doc--depth .tpm-doc__card::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 4px;
    background: rgba(237, 240, 239, 0.16);
  }

  /* A slight lift, and the faded icon a little clearer. */
  @media (hover: hover) and (pointer: fine) {
    .tpm-doc:not(.tpm-doc--depth):hover .tpm-doc__card {
      transform: translate3d(0, -6px, 0);
    }

    .tpm-doc:hover :global(.tpm-doc__icon) {
      fill-opacity: 0.27;
    }
  }

  /* ---- 03 the statement (still layout) ------------------------------------------ */
  .tpm-statement {
    padding-block: calc(var(--section-y) * 0.9) calc(var(--section-y) * 1.4);
  }

  .tpm-statement__copy {
    max-width: 20em;
    margin: 0;
    font-family: var(--font-display);
