---
/**
 * 04 Website (Technical Product Marketing, V1.1, with the V1.2 delta): the
 * first complete market-facing expression of the foundation, shown the way
 * the FABRIC case study shows its work (borrowing its restraint and pacing,
 * not its look): its own surface after the dark passage, a sparse metadata
 * row (goal, services, credits, as the flagship has it), one short paragraph
 * on John's contribution centered beneath it, then one oversized thin-bezel
 * desktop display, centered in open space, playing the approved walkthrough
 * of the site from the hero to the partnership form.
 *
 * The display enters with a short, restrained rise. The walkthrough plays
 * silently and continuously while the display is in view: from the hero to
 * the partnership form, a second on the form, a fade back to the hero (its
 * poster, the recording's first frame), and again, never cutting from the
 * form to the start. It pauses whenever the display leaves the viewport, and
 * a small control pauses and plays; there is no hover or scrubbing. Nothing
 * is laid over the display. On phones the hardware goes and the recording
 * runs edge to edge.
 *
 * V1.3: one quiet "Visit live site" button beside the display, never on it:
 * at the display's right edge, on the line of its foot (beneath the
 * recording, at the right, on phones). It opens the live site in a new tab
 * and says so to assistive technology.
 */
import tpm from '@data/tpm.json';
import ExternalLink from '@components/ExternalLink.astro';
import TpmCase from './TpmCase.astro';
import TpmWalkthrough from './TpmWalkthrough.astro';

const { website } = tpm;
---

<TpmCase
  id="tpm-website-title"
  title={website.title}
  meta={website.meta}
  contribution={website.contribution}
  em={website.em}
  surface="soft"
  align="center"
  class="tpm-website"
>
  <figure class="tpm-display" data-tpm-display>
    <div class="tpm-display__body">
      <div class="tpm-display__screen" data-surface="dark">
        <TpmWalkthrough media={website.media} widths={[640, 960, 1280, 1600, 1920]} sizes="(min-width: 48rem) min(84vw, 76rem), 100vw" />
      </div>
    </div>
    <div class="tpm-display__stand" aria-hidden="true">
      <span class="tpm-display__neck"></span>
      <span class="tpm-display__foot"></span>
    </div>
    <div class="tpm-display__live">
      <ExternalLink href={website.live.url} class="btn btn--secondary tpm-display__link">{website.live.label}</ExternalLink>
    </div>
  </figure>
</TpmCase>

<script>
  import { Walkthrough, addRise } from '@lib/tpm-motion';

  const display = document.querySelector<HTMLElement>('[data-tpm-display]');
  const screen = display?.querySelector<HTMLElement>('.tpm-display__screen');

  if (display && screen) {
    // Continuous: a second on the partnership form, then a 0.7 second fade
    // back to the hero before it plays again.
    new Walkthrough(screen, { threshold: 0.6, cycle: { hold: 1000, fade: 700 } });

    // A short, restrained rise as the display comes up the screen, read from the
    // scroll position (Creator Marketing V1.2, Part One: never a timed jump; not
    // for reduced motion).
    addRise(display, { distance: 48, scale: 0.03 });
  }
</script>

<style>
  /* ---- the display: thin bezel, graphite body, a slim stand ---------------------- */
  .tpm-display {
    width: 100%;
    margin: clamp(2.5rem, 2rem + 4vw, 6rem) 0 0;
  }

  .tpm-display__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  /* Phones: no hardware, the recording edge to edge. */
  .tpm-display__stand {
    display: none;
  }

  @media (min-width: 48rem) {
    .tpm-display {
      width: min(84vw, 76rem);
      margin-inline: auto;
    }

    /* The bezel is a thin, even border of the body (a share of the display's
       width, so it stays thin at every size). */
    .tpm-display__body {
      position: relative;
      z-index: 1;
      padding: 0.85%;
      border-radius: clamp(10px, 1.5vw, 20px);
      background: linear-gradient(180deg, #23282c 0%, #15181b 100%);
      box-shadow:
        inset 0 0 0 1px rgba(237, 240, 239, 0.07),
        0 0 0 1px rgba(13, 15, 16, 0.5),
        0 44px 80px -44px rgba(13, 15, 16, 0.55),
        0 18px 34px -22px rgba(13, 15, 16, 0.35);
    }

    .tpm-display__screen {
      border-radius: clamp(3px, 0.45vw, 7px);
    }

    .tpm-display__stand {
      display: grid;
      justify-items: center;
    }

    /* The neck, seen from the front, widening slightly to the foot. */
    .tpm-display__neck {
      width: 15%;
      aspect-ratio: 15 / 8;
      margin-top: -2px;
      clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
      background: linear-gradient(180deg, #0f1214 0%, #2a2f33 22%, #23282c 100%);
    }

    .tpm-display__foot {
      position: relative;
      width: 27%;
      height: clamp(5px, 0.75vw, 10px);
      border-radius: 3px 3px 999px 999px;
      background: linear-gradient(180deg, #30363a 0%, #1b1f22 100%);
      box-shadow: 0 14px 22px -10px rgba(13, 15, 16, 0.45);
    }
  }

  /* ---- the live site (V1.3): outside the display, secondary to it ---------------- */
  .tpm-display__live {
    display: flex;
    justify-content: flex-end;
    padding: 1rem var(--gutter) 0;
  }

  /* At the display's right edge, its bottom on the line of the foot. */
  @media (min-width: 48rem) {
    .tpm-display {
      position: relative;
    }

    .tpm-display__live {
      position: absolute;
      right: 0;
      bottom: 0;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tpm-display {
      transition: none;
    }
  }
</style>
