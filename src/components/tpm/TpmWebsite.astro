---
/**
 * 04 Website (Technical Product Marketing, V1.1): the first complete
 * market-facing expression of the foundation, shown the way the FABRIC case
 * study shows its work (borrowing its restraint and pacing, not its look):
 * its own surface after the dark passage, a sparse metadata row, one short
 * paragraph on John's contribution, then one oversized thin-bezel desktop
 * display, centered in open space, playing the approved walkthrough of the
 * site from the hero to the partnership form.
 *
 * The display enters with a short, restrained rise. The walkthrough plays
 * once, silently, when the display is well inside the viewport, pauses
 * whenever it leaves, and ends on the partnership form, which it holds; a
 * small control pauses, plays and replays. Nothing is laid around or over
 * the display. On phones the hardware goes and the recording runs edge to
 * edge.
 */
import tpm from '@data/tpm.json';
import TpmCase from './TpmCase.astro';
import TpmWalkthrough from './TpmWalkthrough.astro';

const { website } = tpm;
---

<TpmCase
  id="tpm-website-title"
  title={website.title}
  meta={website.meta}
  contribution={website.contribution}
  columns="minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 0.6fr) minmax(0, 1.65fr)"
  surface="soft"
  class="tpm-website"
>
  <figure class="tpm-display" data-tpm-display>
    <div class="tpm-display__body">
      <div class="tpm-display__screen" data-surface="dark">
        <TpmWalkthrough media={website.media} widths={[640, 960, 1280, 1600, 1920]} sizes="(min-width: 48rem) min(84vw, 76rem), 100vw" />
      </div>
    </div>
    <div class="tpm-display__stand" aria-hidden="true">
      <span class="tpm-display__neck"></span>
      <span class="tpm-display__foot"></span>
    </div>
  </figure>
</TpmCase>

<script>
  import { Walkthrough, reducedMotion } from '@lib/tpm-motion';

  const display = document.querySelector<HTMLElement>('[data-tpm-display]');
  const screen = display?.querySelector<HTMLElement>('.tpm-display__screen');

  if (display && screen) {
    new Walkthrough(screen, { threshold: 0.6 });

    // A short, restrained rise as the display comes into view (not for
    // reduced motion, and never without the observer that ends it).
    if (!reducedMotion() && 'IntersectionObserver' in window) {
      const rect = display.getBoundingClientRect();
      if (rect.top > window.innerHeight) {
        display.classList.add('is-pending');
        const io = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            io.disconnect();
            display.classList.remove('is-pending');
          },
          { threshold: 0.12 },
        );
        io.observe(display);
      }
    }
  }
</script>

<style>
  /* ---- the display: thin bezel, graphite body, a slim stand ---------------------- */
  .tpm-display {
    width: 100%;
    margin: clamp(2.5rem, 2rem + 4vw, 6rem) 0 0;
    transition:
      transform 1.1s var(--ease-out),
      opacity 0.9s var(--ease-out);
  }

  .tpm-display.is-pending {
    opacity: 0;
    transform: translate3d(0, 48px, 0) scale(0.97);
    /* Hidden at once, so it never fades out on its way to the entrance. */
    transition: none;
  }

  .tpm-display__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  /* Phones: no hardware, the recording edge to edge. */
  .tpm-display__stand {
    display: none;
  }

  @media (min-width: 48rem) {
    .tpm-display {
      width: min(84vw, 76rem);
      margin-inline: auto;
    }

    /* The bezel is a thin, even border of the body (a share of the display's
       width, so it stays thin at every size). */
    .tpm-display__body {
      position: relative;
      z-index: 1;
      padding: 0.85%;
      border-radius: clamp(10px, 1.5vw, 20px);
      background: linear-gradient(180deg, #23282c 0%, #15181b 100%);
      box-shadow:
        inset 0 0 0 1px rgba(237, 240, 239, 0.07),
        0 0 0 1px rgba(13, 15, 16, 0.5),
        0 44px 80px -44px rgba(13, 15, 16, 0.55),
        0 18px 34px -22px rgba(13, 15, 16, 0.35);
    }

    .tpm-display__screen {
      border-radius: clamp(3px, 0.45vw, 7px);
    }

    .tpm-display__stand {
      display: grid;
      justify-items: center;
    }

    /* The neck, seen from the front, widening slightly to the foot. */
    .tpm-display__neck {
      width: 15%;
      aspect-ratio: 15 / 8;
      margin-top: -2px;
      clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
      background: linear-gradient(180deg, #0f1214 0%, #2a2f33 22%, #23282c 100%);
    }

    .tpm-display__foot {
      position: relative;
      width: 27%;
      height: clamp(5px, 0.75vw, 10px);
      border-radius: 3px 3px 999px 999px;
      background: linear-gradient(180deg, #30363a 0%, #1b1f22 100%);
      box-shadow: 0 14px 22px -10px rgba(13, 15, 16, 0.45);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tpm-display {
      transition: none;
    }
  }
</style>
