---
/**
 * The foundation library's icons (Technical Product Marketing, V1.1): one for
 * each named document, drawn for that document's subject rather than a shared
 * category, as thin outlines that keep their line weight at any size
 * (non-scaling strokes) on the same 64-unit grid, so they read as one set.
 * Each card shows its icon large and faded, in the document's accent; the
 * icon is decorative, since the card's number, title and subline carry the
 * meaning.
 *
 *   00 conversation     Stakeholder Interviews        two speech bubbles
 *   01 layers           Strategic Foundation Brief    stacked layers
 *   02 persona-search   Target Buyer Analysis         a person and a lens
 *   03 search-alert     Market Pain Points Research   a lens with an alert
 *   04 profile-insight  Target Audience Psychology    a profile and a spark
 *   05 binoculars       Competitor Analysis           binoculars
 *   06 crosshair        Product Positioning           a crosshair
 *   07 fingerprint      Brand Archetype               a fingerprint
 *   08 shield-check     Claims Log                    a verified shield
 *   09 hierarchy        Messaging Hierarchy           a connected hierarchy
 *   10 waveform         Brand Tone of Voice           an audio waveform
 *   11 book             Brand Lexicon                 an open book
 */
export type DocIconName =
  | 'conversation'
  | 'layers'
  | 'persona-search'
  | 'search-alert'
  | 'profile-insight'
  | 'binoculars'
  | 'crosshair'
  | 'fingerprint'
  | 'shield-check'
  | 'hierarchy'
  | 'waveform'
  | 'book';

interface Props {
  name: DocIconName;
  class?: string;
}

const { name, class: className } = Astro.props;

