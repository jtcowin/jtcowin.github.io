---
/**
 * The opening of a work chapter (Technical Product Marketing, V1.1 to V1.3:
 * 04 Website, 05 Technical documentation and 06 the flagship animation
 * campaign): the chapter's name or headline, a sparse metadata row (label over
 * value) and one short paragraph on John's contribution, then the chapter's
 * one dominant visual (the slot), which the chapter lays out itself. The
 * paragraph can be centered beneath the row (all three chapters since the
 * V1.2 delta).
 *
 * V1.3: the row is three equal columns on wide screens in every chapter, so
 * Goal, Services and Credits start at the same places down the page, their
 * labels and first lines aligned and a long entry wrapping inside its column
 * without widening it (one column on narrower screens, never a lone item on a
 * second row). The paragraph keeps a readable measure of about 750px, and one
 * phrase in it may carry the page's emphasis (`em`, see tpm-copy.ts).
 *
 * In the values, **text** sets a name in bold, as the brief does, and a
 * hyphenated compound (V1.2: "conversion-focused") never breaks at its hyphen.
 */
import { emphasize } from '@lib/tpm-copy';

interface Props {
  id: string;
  title: string;
  meta: Array<{ label: string; value: string[] }>;
  contribution: string;
  /** The one phrase of the contribution set a little heavier (V1.3). */
  em?: string;
  surface: 'light' | 'soft' | 'light-return' | 'dark';
  /** Where the contribution sits: at the start (default) or centered. */
  align?: 'start' | 'center';
  class?: string;
}

const { id, title, meta, contribution, em, surface, align = 'start', class: className } = Astro.props;
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
const whole = (text: string) => text.split(/(\S*\w-\w\S*)/).map((t, i) => ({ t, keep: i % 2 === 1 }));
const parts = emphasize(contribution, em, `${title} paragraph`);
---

<section class:list={['tpm-case', className]} data-surface={surface} aria-labelledby={id}>
  <div class="container tpm-case__intro">
    <h2 id={id} class="display tpm-case__title">{title}</h2>
    <dl class="tpm-meta">
      {
        meta.map((item) => (
          <div class="tpm-meta__item">
            <dt class="tpm-meta__label">{item.label}</dt>
            <dd class="tpm-meta__value">
              {item.value.map((para) => (
                <p>
                  {rich(para).map(({ part, strong }) =>
                    strong ? <strong>{part}</strong> : whole(part).map(({ t, keep }) => (keep ? <span class="tpm-meta__whole">{t}</span> : t)),
                  )}
                </p>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class:list={['tpm-case__contribution', align === 'center' && 'tpm-case__contribution--center']}>
      {parts.map(({ text, em }) => (em ? <strong class="tpm-em">{text}</strong> : text))}
    </p>
  </div>
  <slot />
</section>

<style>
  .tpm-case {
    padding-block: var(--section-y) calc(var(--section-y) * 1.1);
  }

  .tpm-case__intro {
    display: grid;
    gap: clamp(1.75rem, 1.25rem + 1.6vw, 2.75rem);
  }

  .tpm-case__title {
    font-size: var(--text-2xl);
  }

  /* ---- the metadata row ---------------------------------------------------------- */
  .tpm-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem clamp(1.5rem, 3vw, 3rem);
    margin: 0;
  }

  .tpm-meta__item {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-strong);
  }

  .tpm-meta__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tpm-meta__value {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .tpm-meta__value p {
    margin: 0;
  }

  .tpm-meta__value strong {
    font-weight: 700;
    color: var(--heading);
    white-space: nowrap;
  }

  .tpm-meta__whole {
    white-space: nowrap;
  }

  /* Three equal columns (V1.3): the same widths in every chapter, whatever
     the length of an entry. */
  @media (min-width: 60rem) {
    .tpm-meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- the contribution ------------------------------------------------------------ */
  /* About 750px (V1.3): a readable measure that never stretches across the
     page; its lines run close to it rather than being balanced shorter. */
  .tpm-case__contribution {
    max-width: 47rem;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }

  .tpm-case__contribution--center {
    justify-self: center;
    text-align: center;
  }
</style>
