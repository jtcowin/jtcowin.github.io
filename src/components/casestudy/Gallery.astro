---
/**
 * Gallery driven by a manifest entry of type "gallery". Renders supplied items
 * as optimized images, and fills remaining slots with labeled placeholders.
 */
import { Picture } from 'astro:assets';
import { getAsset, resolveGalleryImages, aspectToCss } from '@lib/assets';

interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = getAsset(id);
const images = resolveGalleryImages(entry);
const slots = Math.max(entry.slots ?? 3, images.length);
const ratio = aspectToCss(entry.aspect);
const empty = Math.max(0, slots - images.length);
---

<div class="gallery" role="group" aria-label={entry.label}>
  {
    images.map((img) => (
      <figure class="gallery__item">
        <div class="gallery__frame" style={`aspect-ratio: ${ratio};`}>
          <Picture src={img.image} alt={img.alt} widths={[400, 800]} sizes="(min-width: 1200px) 260px, 33vw" formats={['avif', 'webp']} loading="lazy" class="gallery__img" />
        </div>
        {img.credit && <figcaption class="gallery__credit">{img.credit}</figcaption>}
      </figure>
    ))
  }
  {
    Array.from({ length: empty }).map((_, i) => (
      <figure class="gallery__item">
        <div class="gallery__frame gallery__frame--ph" style={`aspect-ratio: ${ratio};`} role="img" aria-label={`Placeholder ${i + 1} for ${entry.label}`}>
          <span class="gallery__type mono">Image · {entry.aspect}</span>
          <span class="gallery__label">
            {entry.label} <span class="mono gallery__n">{String(images.length + i + 1).padStart(2, '0')}</span>
          </span>
        </div>
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .gallery__item {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .gallery__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-sunk);
  }

  .gallery__frame :global(.gallery__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__frame--ph {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 0.6rem;
    color: var(--ink-3);
    background-image: repeating-linear-gradient(-45deg, transparent 0 9px, rgba(22, 24, 26, 0.05) 9px 10px);
  }

  .gallery__type {
    justify-self: start;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2em 0.45em;
    border: 1px solid currentColor;
    border-radius: 3px;
    opacity: 0.85;
  }

  .gallery__label {
    align-self: end;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ink-2);
    line-height: 1.3;
  }

  .gallery__n {
    font-size: 0.6rem;
    color: var(--ink-3);
  }

  .gallery__credit {
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  @media (max-width: 30rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
