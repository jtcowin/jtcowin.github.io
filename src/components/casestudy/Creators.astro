---
/**
 * Creator network list. Names/handles as text with an initials monogram; no
 * portraits are used without permission. Affiliations flagged as user-reported
 * where the manifest says so.
 */
import { getAsset } from '@lib/assets';

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const creators = ids.map((id) => getAsset(id));

function initials(name: string) {
  return name
    .replace(/^the\s+/i, '')
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<ul class="creators">
  {
    creators.map((c) => (
      <li class="creator">
        <span class="creator__avatar mono" aria-hidden="true">{initials(c.name ?? c.label)}</span>
        <span class="creator__text">
          <span class="creator__name">{c.name ?? c.label}</span>
          {c.affiliation && (
            <span class="creator__aff">
              {c.affiliation}
              {c.affiliationNote && <span class="creator__note"> · {c.affiliationNote}</span>}
            </span>
          )}
          {c.handle && <span class="creator__handle mono">{c.handle}</span>}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .creators {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .creator {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }

  .creator__avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--bg-sunk);
    border: 1px solid var(--line);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-2);
    letter-spacing: 0.04em;
  }

  .creator__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .creator__name {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .creator__aff {
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .creator__note {
    color: var(--ink-3);
  }

  .creator__handle {
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  @media (min-width: 40rem) {
    .creators {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
