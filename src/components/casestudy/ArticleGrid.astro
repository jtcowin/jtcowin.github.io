---
import ArticleCard from './ArticleCard.astro';
import { isIdVisible, SHOW_PLACEHOLDERS } from '@lib/assets';

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const shown = SHOW_PLACEHOLDERS ? ids : ids.filter((id) => isIdVisible(id));
---

{
  shown.length > 0 && (
    <div class="article-grid">
      {shown.map((id) => <ArticleCard id={id} />)}
    </div>
  )
}

<style>
  .article-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .article-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
