---
/**
 * Homepage case-study card. The whole card is one link target (stretched link
 * on the title), with a visible hover/focus state.
 */
import type { CollectionEntry } from 'astro:content';
import { withBase } from '@lib/paths';
import Media from './Media.astro';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { card } = entry.data;
const href = withBase(`/work/${entry.id}/`);
const num = String(index + 1).padStart(2, '0');
---

<article class:list={['card', index % 2 === 1 && 'card--flip']}>
  <div class="card__media">
    <Media id={card.asset} sizes="(min-width: 60rem) 58vw, 100vw" />
  </div>
  <div class="card__body">
    <p class="card__meta">
      <span class="mono card__num">{num}</span>
      <span class="eyebrow">{card.category}</span>
    </p>
    <h3 class="card__title display display-md">
      <a href={href} class="card__link">{card.title}</a>
    </h3>
    <p class="card__summary">{card.summary}</p>
    <ul class="card__metrics" aria-label="Key figures">
      {card.metrics.map((m) => <li>{m}</li>)}
    </ul>
    <span class="arrow-link card__cta" aria-hidden="true">
      {card.linkLabel} <Icon name="arrow-right" size={14} />
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .card__media {
    min-width: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--dur) var(--ease-out);
  }

  .card__media :global(.media__frame) {
    border-radius: var(--radius-lg);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .card:hover .card__media :global(.media__frame),
  .card:focus-within .card__media :global(.media__frame) {
    transform: scale(1.015);
  }

  .card__body {
    display: grid;
    gap: var(--space-4);
    align-content: center;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .card__num {
    font-size: var(--text-xs);
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }

  .card__title {
    max-width: 18em;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: covers the entire card */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius);
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:focus-within .card__link::after {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .card:hover .card__title {
    color: var(--accent-ink);
  }

  .card__summary {
    color: var(--ink-2);
    line-height: var(--leading-relaxed);
    max-width: 34em;
    text-wrap: pretty;
  }

  .card__metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
  }

  .card__metrics li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--ink-2);
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
  }

  .card__cta {
    margin-top: var(--space-2);
  }

  .card:hover .card__cta :global(svg) {
    transform: translateX(3px);
  }

  @media (min-width: 60rem) {
    .card {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 1.5rem + 3vw, 4.5rem);
      align-items: center;
    }

    .card--flip .card__media {
      order: 2;
    }

    .card--flip .card__body {
      order: 1;
    }
  }
</style>
