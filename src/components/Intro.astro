---
/**
 * The homepage opening sequence (Version 1.5, retimed in Events V1.6, and since
 * the Creator Marketing V1.0 brief the note alone): a brisk, directional loader
 * on the ink ground. A small marker in the accent travels a faint hairline from
 * the left of the screen to the right, a short streak behind it as it gathers
 * speed, while one quiet viewing note, set small at the center ("BEST
 * EXPERIENCED ON DESKTOP"), comes in and holds, fully legible, until the
 * marker arrives. V1.4 (Creator Marketing V1.4, Part One): the note is coded
 * into place. It resolves once, left to right: each position, as the leading
 * edge reaches it, cycles for a moment through a few monospace code glyphs in
 * the accent, then settles into its letter, which never changes again; the
 * scramble stays at the edge (two or three positions at a time), and the whole
 * line is legible 0.74 seconds in, then holds for 1.53 seconds before it
 * leaves. No cursor, caret, blinking, flashes, tearing, color fringes, scan
 * lines or particles, nothing after the line has resolved, and no change of
 * spacing, so a resolved letter never moves. The marker stays the primary
 * motion: it now gathers speed as it goes (V1.4), setting off at a
 * controlled, readable pace, quickening through the middle third and covering
 * the last quarter of the path quickest, arriving at the end at full speed,
 * with no overshoot, bounce or pause, as the hero comes in; its streak
 * lengthens with the speed. A pace, not a measure of loading.
 * When the marker reaches the end of its path the note and the path leave,
 * the ground dissolves and the hero builds in four overlapping stages
 * (Hero.astro and Header.astro; Full Site Iteration V1): the photograph and
 * its grade; the moving name, its stream setting off as the rule behind it
 * draws across the frame; the subject, resolving in front of the name; then
 * the descriptor, the arrow and the navigation, the whole composition settled
 * 1.1 seconds after the ground begins to clear. About 3.4 seconds in all. No
 * percentage: the marker is a pace, not a measure, and nothing here claims to
 * count anything.
 *
 * It plays on the homepage only, once per browsing session (the tab's session
 * storage). An inline script in the head decides before the first paint, by
 * adding the `intro` class to the document, so a visitor it skips never sees
 * it: a return to the homepage (from a case study, say), a visit that began on
 * another page of the site, and a link to a section all go straight to the
 * page. A tab opened in the background waits to start until it is shown.
 * Nothing waits for it: the hero's photograph loads as usual underneath (and is
 * preloaded, see index.astro), and scrolling, a click, a tap or a key dismisses
 * it at once. With reduced motion there is no travel and no words: the ground
 * clears in a fifth of a second, straight to the hero (were the note ever shown
 * there, it would only fade in, with no scramble and no letter-by-letter
 * movement).
 *
 * The timing lives in custom properties on the document (`--intro-*`, below),
 * which the hero (Hero.astro) and the header (Header.astro) read for their
 * part of the handoff. It is decorative and hidden from assistive technology;
 * without JavaScript it never appears, and it ends by itself even if the
 * script below never runs.
 */
import home from '@data/home.json';

const { note } = home.intro;
// The note letter by letter, word by word so a word never breaks; every letter
// carries its place in the line for its moment in the resolve (V1.4).
let at = 0;
const words = note.split(' ').map((w) => Array.from(w).map((ch) => ({ ch, c: at++ })));
const letters = at;
---

<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__ground"></div>
  <div class="intro__stage">
    <div class="intro__readout">
      <p class="intro__note" style={`--letters: ${letters}`}>
        {
          words.map((w, i) => [
            i ? ' ' : '',
            <span class="intro__word">
              {w.map(({ ch, c }) => (
                <span class="intro__ch" style={`--c: ${c}`}>
                  {ch}
                </span>
              ))}
            </span>,
          ])
        }
      </p>
    </div>
    <div class="intro__track">
      <span class="intro__lane"><span class="intro__run"><span class="intro__trail"></span></span></span>
      <span class="intro__marker"></span>
    </div>
  </div>
</div>

<script>
  // Dismissal and clean-up. The sequence itself is CSS, timed from the first
  // paint; this ends it early on the first sign of intent and removes the
  // overlay once it has gone.
  const root = document.documentElement;
  const overlay = document.querySelector<HTMLElement>('[data-intro]');

  if (overlay && root.classList.contains('intro')) {
    const events: Array<keyof WindowEventMap> = ['wheel', 'touchstart', 'pointerdown', 'keydown', 'scroll'];
    const ground = overlay.querySelector<HTMLElement>('.intro__ground');
    const stop = () => {
      for (const type of events) window.removeEventListener(type, skip, true);
    };
    // Once the ground has begun to clear, the handoff is already under way and
    // ends within a moment; cutting it short then would only make it jump.
    const clearing = () => {
      const clear = ground?.getAnimations?.().find((a) => (a as CSSAnimation).animationName === 'intro-clear');
      if (!clear) return false;
      const delay = Number(clear.effect?.getTiming().delay) || 0;
      return (Number(clear.currentTime) || 0) >= delay;
    };
    function skip() {
      stop();
      if (root.classList.contains('intro-skip') || clearing()) return;
      // The overlay fades at once, as it stands, and the hero's entrance,
      // timed from the handoff, is brought forward to now, so the hero is in
      // place beneath it (see Hero.astro and Header.astro).
      root.classList.add('intro-skip');
    }
    // When the overlay has gone it is removed. The hero keeps its timing
    // classes: its entrance is running on them, and dropping them now would
    // make it jump.
    const finish = () => {
      stop();
      root.classList.remove('intro');
      overlay.remove();
    };
    for (const type of events) window.addEventListener(type, skip, { capture: true, passive: true });
    overlay.addEventListener('animationend', (event) => {
      if (event.target === overlay) finish();
    });

    // The note's coded resolve (V1.4). The stylesheet reveals each letter at its
    // moment (intro-resolve), so the line reads in full even if this never runs;
    // here, for the moment before it, the position cycles through a few code
    // glyphs, timed from that same animation (its delay and its clock), so the
    // two never drift and a paused or background tab pauses both (the stylesheet
    // also takes each glyph away at its letter's moment, on that same clock, so a
    // glyph and its letter never show together, even for a frame). Only the
    // leading edge scrambles; a letter that has resolved is never touched again.
    // A fixed sequence, not chance: the same every time. Never with reduced
    // motion (the note is not shown then).
    if (!root.classList.contains('intro-still')) {
      const GLYPHS = '<>/_{}[]=+*#01';
      const STEP = 32; // ms per glyph, about every other frame
      const glyphMs = parseFloat(getComputedStyle(root).getPropertyValue('--intro-glyph')) || 0;
      const slots = Array.from(overlay.querySelectorAll<HTMLElement>('.intro__ch'))
        .map((ch, i) => ({ ch, i, a: ch.getAnimations?.().find((x) => (x as CSSAnimation).animationName === 'intro-resolve') }))
        .filter((s) => s.a);
      const tick = () => {
        if (!overlay.isConnected || root.classList.contains('intro-skip')) {
          for (const { ch } of slots) delete ch.dataset.g;
          return;
        }
        let pending = false;
        for (const { ch, i, a } of slots) {
          const at = Number(a!.effect?.getTiming().delay) || 0;
          const t = Number(a!.currentTime) || 0;
          if (t < at) pending = true;
          if (t >= at - glyphMs && t < at) {
            const g = GLYPHS[(i * 5 + Math.floor((t - (at - glyphMs)) / STEP) * 3) % GLYPHS.length];
            if (ch.dataset.g !== g) ch.dataset.g = g;
          } else if (ch.dataset.g !== undefined) {
            delete ch.dataset.g;
          }
        }
        if (pending) requestAnimationFrame(tick);
      };
      if (glyphMs > 0 && slots.length) requestAnimationFrame(tick);
    }
  } else {
    overlay?.remove();
  }
</script>

<style>
  /* ---- the timing --------------------------------------------------------------
     On the document, so the hero and the header can read their part of the
     handoff. The ground alone for a moment; the note resolves, left to right,
     in 0.7 s (V1.4) and holds, fully legible, for 1.53 s while the marker
     travels from just after the start to the end of its path, gathering speed,
     arriving as the hold ends: --intro-reveal (2.27 s, since V1.1), where the
     note and the path leave, the ground starts to clear and the hero's stages
     begin (--intro-hero, read by Hero.astro and Header.astro; since Full Site
     Iteration V1 they take 1.1 s, so the hero is settled at about 3.4 s), so
     the ground clears onto nothing. The same on phones, where the note matters
     most. */
  :global(html.intro-hold) {
    --intro-lead: 40ms; /* the ground alone, before the note */
    --intro-in: 700ms; /* the note resolving, left to right (V1.4; V1.2's letter rise took 600 ms) */
    --intro-glyph: 80ms; /* each position's moment of code glyphs before its letter (V1.4) */
    --intro-out: 130ms; /* the note leaving, as the ground starts to clear */
    --intro-hold: 1530ms; /* the complete note, fully legible (V1.4; the sequence keeps its length) */
    --intro-go: 120ms; /* the marker sets off */
    --intro-clear: 400ms; /* the ground dissolving */

    /* The reveal: the note read, the marker at the end of its path. */
    --intro-reveal: calc(var(--intro-lead) + var(--intro-in) + var(--intro-hold));
    --intro-hero: var(--intro-reveal);
  }

  /* Reduced motion: no travel and no words, the ground clearing straight away. */
  :global(html.intro-still) {
    --intro-reveal: 0ms;
    --intro-clear: 200ms;
  }

  /* Dismissed: the overlay fades as it stands (below) and the hero's entrance
     is due now, so the hero is in place beneath it (after the rules above, so
     it wins over them). */
  :global(html.intro-skip) {
    --intro-hero: 0ms;
  }

  /* ---- the overlay -------------------------------------------------------------- */
  .intro {
    display: none;
  }

  :global(html.intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #f2f1ec;
    /* Gone at the end of the timeline even if no script ever runs. */
    animation: intro-done 1ms linear calc(var(--intro-reveal) + 20ms + var(--intro-clear)) forwards;
  }

  /* The ground is its own layer, so the words and the marker can leave a beat
     ahead of it. */
  .intro__ground {
    position: absolute;
    inset: 0;
    background: var(--c-ink);
  }

  :global(html.intro) .intro__ground {
    animation: intro-clear var(--intro-clear) cubic-bezier(0.4, 0, 0.6, 1) calc(var(--intro-reveal) + 20ms) both;
  }

  /* ---- the stage: the note at the center, the path beneath it --------------------- */
  .intro__stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 4.5vh, 3rem);
    width: 100%;
    padding-inline: var(--gutter);
  }

  /* The note's place: one line at the center of the screen. */
  .intro__readout {
    display: grid;
    place-items: center;
    line-height: 1;
  }

  .intro__readout > p {
    grid-area: 1 / 1;
    margin: 0;
    white-space: nowrap;
    text-align: center;
    opacity: 0;
  }

  /* The note: a viewing recommendation, not a warning. The site's small tracked
     capitals, quiet. */
  .intro__note {
    font-family: var(--font-sans);
    font-size: clamp(0.6875rem, 0.64rem + 0.2vw, 0.8125rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--c-fog-2);
  }

  /* The path: a hairline from gutter to gutter, a short tick at each end. Its
     width is the distance the marker runs (100cqi). */
  .intro__track {
    position: relative;
    justify-self: stretch;
    height: 1px;
    background: rgba(237, 240, 239, 0.14);
    container-type: inline-size;
    opacity: 0;
  }

  .intro__track::before,
  .intro__track::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    background: rgba(237, 240, 239, 0.3);
  }

  .intro__track::before {
    left: 0;
  }

  .intro__track::after {
    right: 0;
  }

  /* The streak runs inside the path's clip, so it never reaches beyond the
     start; the marker rides on top of it, unclipped. */
  .intro__lane {
    position: absolute;
    inset: -2px 0;
    overflow: hidden;
  }

  .intro__run {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
  }

  .intro__trail {
    position: absolute;
    right: 0;
    top: 1px;
    width: min(22vw, 16rem);
    height: 2px;
    background: linear-gradient(to right, rgba(79, 145, 138, 0), rgba(79, 145, 138, 0.75) 72%, var(--c-aqua-light));
    transform-origin: 100% 50%;
    transform: scaleX(0);
  }

  .intro__marker {
    position: absolute;
    top: -3px;
    left: -3.5px;
    width: 7px;
    height: 7px;
    background: var(--c-aqua-light);
  }

  /* ---- the motion ---------------------------------------------------------------- */
  /* The note leaving fades promptly as it moves on (V1.6). The marker's run
     gathers speed (V1.4): about a third of its average pace as it sets off, a
     doubling through the middle third, the last quarter of the path in the last
     tenth of the time, arriving at three times the average pace; no overshoot,
     no bounce and no easing into a pause at the end. */
  :global(html.intro) .intro__stage {
    --intro-leave: cubic-bezier(0.3, 0.3, 0.6, 1);
    --intro-run: cubic-bezier(0.4, 0.12, 0.82, 0.45);
  }

  /* The path and the marker come up with the ground's first moment, and go as
     the ground starts to clear. */
  :global(html.intro) .intro__track {
    animation:
      intro-fade-in 240ms ease-out 0ms both,
      intro-fade-out 200ms ease-in calc(var(--intro-reveal) - 80ms) forwards;
  }

  /* The marker and its streak, from the left end of the path to the right one,
     gathering speed (V1.4); the streak lengthens with the speed, longest as the
     marker arrives, and leaves with the path. */
  :global(html.intro) .intro__run,
  :global(html.intro) .intro__marker {
    animation: intro-travel calc(var(--intro-reveal) - var(--intro-go)) var(--intro-run) var(--intro-go) both;
  }

  :global(html.intro) .intro__trail {
    animation: intro-streak calc(var(--intro-reveal) - var(--intro-go)) linear var(--intro-go) both;
  }

  /* The note (V1.4): the line is there, at its resting spacing, from the start of
     the resolve, its letters held back until their moments; each comes in, left to
     right, when the leading edge has passed it (the script fills the moment before
     with code glyphs). Once read, the line leaves to the right, the way the marker
     runs, as the ground starts to clear. */
  :global(html.intro) .intro__note {
    animation:
      intro-fade-in 1ms linear var(--intro-lead) both,
      intro-word-out var(--intro-out) var(--intro-leave) var(--intro-reveal) forwards;
  }

  .intro__word {
    display: inline-block;
  }

  .intro__ch {
    position: relative;
    display: inline-block;
  }

  /* Each letter at its moment, in reading order: the edge reaches it, it scrambles
     for --intro-glyph, it resolves; the last resolves as the entrance ends. A
     change of color only, so the letter's place never moves. */
  :global(html.intro) .intro__ch {
    animation: intro-resolve 1ms linear calc(var(--intro-lead) + var(--c) * (var(--intro-in) - var(--intro-glyph)) / max(1, var(--letters) - 1) + var(--intro-glyph)) both;
  }

  /* The glyph in a letter's place while it scrambles: a monospace code glyph in the
     accent, centered on the letter (the letter's own tracking left aside), and only
     while the script sets one. */
  .intro__ch::after {
    content: attr(data-g);
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% - 0.22em);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace;
    font-weight: 500;
    letter-spacing: 0;
    text-align: center;
    color: var(--c-aqua-light);
    opacity: 0.85;
  }

  /* The glyph goes at the letter's moment, on the same clock, so the two never
     show together, not even for a frame while the script catches up. */
  :global(html.intro) .intro__ch::after {
    animation: intro-glyph-out 1ms linear calc(var(--intro-lead) + var(--c) * (var(--intro-in) - var(--intro-glyph)) / max(1, var(--letters) - 1) + var(--intro-glyph)) both;
  }

  /* Reduced motion never shows the note (above); were it shown, it would only fade,
     with no scramble (the script never runs then). */
  @media (prefers-reduced-motion: reduce) {
    :global(html.intro) .intro__ch {
      animation-name: intro-fade-in;
    }

    :global(html.intro) .intro__note {
      animation-name: intro-fade-in, intro-fade-out;
    }
  }

  /* Reduced motion: no travel and no note; the ground clears at once, in a
     fifth of a second. */
  :global(html.intro-still) .intro__stage {
    display: none;
  }

  /* The site's reduced-motion reset ends every animation at once (global.css);
     this short crossfade, which is no motion, keeps its timing. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.intro-still) .intro {
      animation-duration: 1ms !important;
      animation-delay: calc(var(--intro-reveal) + 20ms + var(--intro-clear)) !important;
    }

    :global(html.intro-still) .intro__ground {
      animation-duration: var(--intro-clear) !important;
      animation-delay: calc(var(--intro-reveal) + 20ms) !important;
    }

    :global(html.intro-still.intro-skip) .intro {
      animation-delay: 0ms !important;
    }
  }

  /* Dismissed: the overlay fades at once (last, so it wins over every other
     ending). */
  :global(html.intro-skip) .intro {
    animation: intro-skip 220ms var(--ease-out) forwards;
  }

  /* A tab opened in the background holds everything until it is shown. */
  :global(html.intro-wait) :global(*) {
    animation-play-state: paused !important;
  }

  /* A letter held back until its moment (V1.4): the color only, so it keeps its place. */
  @keyframes intro-resolve {
    from {
      color: transparent;
    }
  }

  /* Its glyph, gone at the same moment (V1.4). */
  @keyframes intro-glyph-out {
    from {
      opacity: 0.85;
    }
    to {
      opacity: 0;
    }
  }

  /* V1.6: the note leaving is gone a little before its drift ends. */
  @keyframes intro-word-out {
    from {
      opacity: 1;
      transform: none;
    }
    65% {
      opacity: 0;
    }
    to {
      opacity: 0;
      transform: translateX(0.22em);
    }
  }

  @keyframes intro-travel {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(100cqi);
    }
  }

  /* The streak's length follows the marker's speed on its accelerating curve
     (V1.4): short as it sets off, lengthening through the run, longest as it
     arrives (the speed of --intro-run at each moment, as a share of its last). */
  @keyframes intro-streak {
    0% {
      transform: scaleX(0.1);
    }
    20% {
      transform: scaleX(0.16);
    }
    40% {
      transform: scaleX(0.23);
    }
    60% {
      transform: scaleX(0.32);
    }
    75% {
      transform: scaleX(0.43);
    }
    85% {
      transform: scaleX(0.55);
    }
    92% {
      transform: scaleX(0.69);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes intro-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes intro-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes intro-clear {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes intro-done {
    to {
      visibility: hidden;
    }
  }

  @keyframes intro-skip {
    from {
      opacity: 1;
    }
    99.9% {
      opacity: 0;
      visibility: visible;
    }
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
