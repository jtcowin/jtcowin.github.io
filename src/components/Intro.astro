---
/**
 * The homepage opening sequence (Version 1.5, retimed in Events V1.6): a brisk, directional loader on
 * the ink ground. A small marker in the accent travels a faint hairline from
 * the left of the screen to the right, a short streak behind it as it gathers
 * speed, while the words come in quick succession at the center: first a
 * viewing note, set small and quiet ("BEST EXPERIENCED ON DESKTOP"), then three
 * phrases, "Product complexity.", "Market clarity." and "Strategy, executed."
 * Each arrives from the left and leaves to the right, the way the marker runs,
 * the next arriving as the last leaves (the two overlap, so there is never a
 * blank between them), so the cadence is quick but never a flicker. V1.6: the
 * note is the message that has to be read, so it settles and then holds, fully
 * legible, for 1.3 seconds before anything replaces it; the three phrases then
 * follow in quick succession, each fully visible for 0.3 seconds, a three-beat
 * impression rather than a read. When the marker reaches the end of its path
 * the ground dissolves and the hero comes up in layers (Hero.astro and
 * Header.astro): the photograph, the name, the descriptor, the navigation,
 * then the rule and the arrow, overlapping, in 0.6 seconds. About 3.45 seconds
 * in all. No percentage: the marker is a pace, not a measure, and nothing here
 * claims to count anything.
 *
 * It plays on the homepage only, once per browsing session (the tab's session
 * storage). An inline script in the head decides before the first paint, by
 * adding the `intro` class to the document, so a visitor it skips never sees
 * it: a return to the homepage (from a case study, say), a visit that began on
 * another page of the site, and a link to a section all go straight to the
 * page. A tab opened in the background waits to start until it is shown.
 * Nothing waits for it: the hero's photograph loads as usual underneath (and is
 * preloaded, see index.astro), and scrolling, a click, a tap or a key dismisses
 * it at once. With reduced motion there is no travel and no words: the ground
 * clears in a fifth of a second, straight to the hero.
 *
 * The timing lives in custom properties on the document (`--intro-*`, below),
 * which the hero (Hero.astro) and the header (Header.astro) read for their
 * part of the handoff. It is decorative and hidden from assistive technology;
 * without JavaScript it never appears, and it ends by itself even if the
 * script below never runs.
 */
import home from '@data/home.json';

const { note, phrases } = home.intro;
---

<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__ground"></div>
  <div class="intro__stage">
    <div class="intro__readout">
      <p class="intro__note">{note}</p>
      {phrases.map((phrase, i) => <p class={`intro__phrase intro__phrase--${i + 1}`}>{phrase}</p>)}
    </div>
    <div class="intro__track">
      <span class="intro__lane"><span class="intro__run"><span class="intro__trail"></span></span></span>
      <span class="intro__marker"></span>
    </div>
  </div>
</div>

<script>
  // Dismissal and clean-up. The sequence itself is CSS, timed from the first
  // paint; this ends it early on the first sign of intent and removes the
  // overlay once it has gone.
  const root = document.documentElement;
  const overlay = document.querySelector<HTMLElement>('[data-intro]');

  if (overlay && root.classList.contains('intro')) {
    const events: Array<keyof WindowEventMap> = ['wheel', 'touchstart', 'pointerdown', 'keydown', 'scroll'];
    const ground = overlay.querySelector<HTMLElement>('.intro__ground');
    const stop = () => {
      for (const type of events) window.removeEventListener(type, skip, true);
    };
    // Once the ground has begun to clear, the handoff is already under way and
    // ends within a moment; cutting it short then would only make it jump.
    const clearing = () => {
      const clear = ground?.getAnimations?.().find((a) => (a as CSSAnimation).animationName === 'intro-clear');
      if (!clear) return false;
      const delay = Number(clear.effect?.getTiming().delay) || 0;
      return (Number(clear.currentTime) || 0) >= delay;
    };
    function skip() {
      stop();
      if (root.classList.contains('intro-skip') || clearing()) return;
      // The overlay fades at once, as it stands, and the hero's entrance,
      // timed from the handoff, is brought forward to now, so the hero is in
      // place beneath it (see Hero.astro and Header.astro).
      root.classList.add('intro-skip');
    }
    // When the overlay has gone it is removed. The hero keeps its timing
    // classes: its entrance is running on them, and dropping them now would
    // make it jump.
    const finish = () => {
      stop();
      root.classList.remove('intro');
      overlay.remove();
    };
    for (const type of events) window.addEventListener(type, skip, { capture: true, passive: true });
    overlay.addEventListener('animationend', (event) => {
      if (event.target === overlay) finish();
    });
  } else {
    overlay?.remove();
  }
</script>

<style>
  /* ---- the timing --------------------------------------------------------------
     On the document, so the hero and the header can read their part of the
     handoff. V1.6: the ground alone for a moment; the note arrives (130 ms),
     settles and holds, fully legible, for 1.3 s; then the three phrases, each
     fully visible for 0.3 s. Every change is a short overlapping transition:
     the next word starts to arrive 30 ms after the one before it starts to
     leave, and both take 130 ms, so there is never a blank and never a cut to
     black. The marker travels from just after the start to the moment the last
     phrase ends, --intro-reveal (2.85 s), where the ground starts to clear and
     the hero's layers begin (--intro-hero, read by Hero.astro and
     Header.astro; they take 0.6 s, so the hero is in place at about 3.45 s); the
     last phrase and the path leave with it, so the ground clears onto nothing.
     The same on phones. */
  :global(html.intro-hold) {
    --intro-lead: 40ms; /* the ground alone, before the note */
    --intro-in: 130ms; /* a word arriving */
    --intro-out: 130ms; /* a word leaving */
    --intro-beat: 30ms; /* from one word starting to leave to the next starting to arrive */
    --intro-hold: 1300ms; /* the note, fully legible */
    --intro-show: 300ms; /* each phrase, fully visible */
    --intro-go: 120ms; /* the marker sets off */
    --intro-clear: 400ms; /* the ground dissolving */

    /* Each phrase's turn, the three phrases, and the reveal. */
    --intro-step: calc(var(--intro-beat) + var(--intro-in) + var(--intro-show));
    --intro-p1: calc(var(--intro-lead) + var(--intro-in) + var(--intro-hold));
    --intro-p2: calc(var(--intro-p1) + var(--intro-step));
    --intro-p3: calc(var(--intro-p2) + var(--intro-step));
    --intro-reveal: calc(var(--intro-p3) + var(--intro-step));
    --intro-hero: var(--intro-reveal);
  }

  /* Reduced motion: no travel and no words, the ground clearing straight away. */
  :global(html.intro-still) {
    --intro-reveal: 0ms;
    --intro-clear: 200ms;
  }

  /* Dismissed: the overlay fades as it stands (below) and the hero's entrance
     is due now, so the hero is in place beneath it (after the rules above, so
     it wins over them). */
  :global(html.intro-skip) {
    --intro-hero: 0ms;
  }

  /* ---- the overlay -------------------------------------------------------------- */
  .intro {
    display: none;
  }

  :global(html.intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #f2f1ec;
    /* Gone at the end of the timeline even if no script ever runs. */
    animation: intro-done 1ms linear calc(var(--intro-reveal) + 20ms + var(--intro-clear)) forwards;
  }

  /* The ground is its own layer, so the words and the marker can leave a beat
     ahead of it. */
  .intro__ground {
    position: absolute;
    inset: 0;
    background: var(--c-ink);
  }

  :global(html.intro) .intro__ground {
    animation: intro-clear var(--intro-clear) cubic-bezier(0.4, 0, 0.6, 1) calc(var(--intro-reveal) + 20ms) both;
  }

  /* ---- the stage: the words at the center, the path beneath them ------------------ */
  .intro__stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 4.5vh, 3rem);
    width: 100%;
    padding-inline: var(--gutter);
  }

  /* Every word shares one place, so each is anchored to the same center. The
     phrases are the portfolio's display face, lighter and smaller than its
     headlines, sized so each keeps to one line (the longest is about 9em). */
  .intro__readout {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 450;
    font-stretch: 100%;
    font-size: min(clamp(1.625rem, 1.15rem + 1.8vw, 3.25rem), calc((100vw - 2 * var(--gutter)) / 9.6));
    line-height: 1;
    letter-spacing: 0;
  }

  .intro__readout > p {
    grid-area: 1 / 1;
    margin: 0;
    white-space: nowrap;
    text-align: center;
    opacity: 0;
  }

  /* The note: a viewing recommendation, not a warning. The site's small tracked
     capitals, quiet. */
  .intro__note {
    font-family: var(--font-sans);
    font-size: clamp(0.6875rem, 0.64rem + 0.2vw, 0.8125rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--c-fog-2);
  }

  /* The path: a hairline from gutter to gutter, a short tick at each end. Its
     width is the distance the marker runs (100cqi). */
  .intro__track {
    position: relative;
    justify-self: stretch;
    height: 1px;
    background: rgba(237, 240, 239, 0.14);
    container-type: inline-size;
    opacity: 0;
  }

  .intro__track::before,
  .intro__track::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    background: rgba(237, 240, 239, 0.3);
  }

  .intro__track::before {
    left: 0;
  }

  .intro__track::after {
    right: 0;
  }

  /* The streak runs inside the path's clip, so it never reaches beyond the
     start; the marker rides on top of it, unclipped. */
  .intro__lane {
    position: absolute;
    inset: -2px 0;
    overflow: hidden;
  }

  .intro__run {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
  }

  .intro__trail {
    position: absolute;
    right: 0;
    top: 1px;
    width: min(22vw, 16rem);
    height: 2px;
    background: linear-gradient(to right, rgba(79, 145, 138, 0), rgba(79, 145, 138, 0.75) 72%, var(--c-aqua-light));
    transform-origin: 100% 50%;
    transform: scaleX(0);
  }

  .intro__marker {
    position: absolute;
    top: -3px;
    left: -3.5px;
    width: 7px;
    height: 7px;
    background: var(--c-aqua-light);
  }

  /* ---- the motion ---------------------------------------------------------------- */
  /* The word leaving fades promptly as it moves on (V1.6), so the one arriving
     over it reads cleanly through the short overlap. */
  :global(html.intro) .intro__stage {
    --intro-arrive: cubic-bezier(0.22, 1, 0.36, 1);
    --intro-leave: cubic-bezier(0.3, 0.3, 0.6, 1);
    --intro-run: cubic-bezier(0.37, 0, 0.63, 1);
  }

  /* The path and the marker come up with the ground's first moment, and go as
     the ground starts to clear. */
  :global(html.intro) .intro__track {
    animation:
      intro-fade-in 240ms ease-out 0ms both,
      intro-fade-out 200ms ease-in calc(var(--intro-reveal) - 80ms) forwards;
  }

  /* The marker and its streak, from the left end of the path to the right one,
     easing in and out (a sine curve, no overshoot); the streak grows with the
     speed and is gone as the marker settles. */
  :global(html.intro) .intro__run,
  :global(html.intro) .intro__marker {
    animation: intro-travel calc(var(--intro-reveal) - var(--intro-go)) var(--intro-run) var(--intro-go) both;
  }

  :global(html.intro) .intro__trail {
    animation: intro-streak calc(var(--intro-reveal) - var(--intro-go)) linear var(--intro-go) both;
  }

  /* The words: each arrives from the left and leaves to the right. */
  :global(html.intro) .intro__note {
    animation:
      intro-word-in var(--intro-in) var(--intro-arrive) var(--intro-lead) both,
      intro-word-out var(--intro-out) var(--intro-leave) var(--intro-p1) forwards;
  }

  :global(html.intro) .intro__phrase--1 {
    animation:
      intro-word-in var(--intro-in) var(--intro-arrive) calc(var(--intro-p1) + var(--intro-beat)) both,
      intro-word-out var(--intro-out) var(--intro-leave) var(--intro-p2) forwards;
  }

  :global(html.intro) .intro__phrase--2 {
    animation:
      intro-word-in var(--intro-in) var(--intro-arrive) calc(var(--intro-p2) + var(--intro-beat)) both,
      intro-word-out var(--intro-out) var(--intro-leave) var(--intro-p3) forwards;
  }

  :global(html.intro) .intro__phrase--3 {
    animation:
      intro-word-in var(--intro-in) var(--intro-arrive) calc(var(--intro-p3) + var(--intro-beat)) both,
      intro-word-out var(--intro-out) var(--intro-leave) var(--intro-reveal) forwards;
  }

  /* Reduced motion: no travel and no words; the ground clears at once, in a
     fifth of a second. */
  :global(html.intro-still) .intro__stage {
    display: none;
  }

  /* The site's reduced-motion reset ends every animation at once (global.css);
     this short crossfade, which is no motion, keeps its timing. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.intro-still) .intro {
      animation-duration: 1ms !important;
      animation-delay: calc(var(--intro-reveal) + 20ms + var(--intro-clear)) !important;
    }

    :global(html.intro-still) .intro__ground {
      animation-duration: var(--intro-clear) !important;
      animation-delay: calc(var(--intro-reveal) + 20ms) !important;
    }

    :global(html.intro-still.intro-skip) .intro {
      animation-delay: 0ms !important;
    }
  }

  /* Dismissed: the overlay fades at once (last, so it wins over every other
     ending). */
  :global(html.intro-skip) .intro {
    animation: intro-skip 220ms var(--ease-out) forwards;
  }

  /* A tab opened in the background holds everything until it is shown. */
  :global(html.intro-wait) :global(*) {
    animation-play-state: paused !important;
  }

  @keyframes intro-word-in {
    from {
      opacity: 0;
      transform: translateX(-0.22em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* V1.6: the word leaving is gone a little before its drift ends, so the one
     arriving over it never shares the place with more than a trace of it. */
  @keyframes intro-word-out {
    from {
      opacity: 1;
      transform: none;
    }
    65% {
      opacity: 0;
    }
    to {
      opacity: 0;
      transform: translateX(0.22em);
    }
  }

  @keyframes intro-travel {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(100cqi);
    }
  }

  /* The streak's length follows the marker's speed on the sine curve: nothing
     at rest, longest in the middle of the run. */
  @keyframes intro-streak {
    0% {
      transform: scaleX(0);
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
    }
    50% {
      transform: scaleX(1);
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
    }
    to {
      transform: scaleX(0);
    }
  }

  @keyframes intro-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes intro-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes intro-clear {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes intro-done {
    to {
      visibility: hidden;
    }
  }

  @keyframes intro-skip {
    from {
      opacity: 1;
    }
    99.9% {
      opacity: 0;
      visibility: visible;
    }
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
