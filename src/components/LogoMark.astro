---
/**
 * Inline logo mark (text wordmark until an approved file exists), with the
 * relationship caption so partners are never mislabeled.
 */
import { Image } from 'astro:assets';
import { getLogo, resolveLogoImage } from '@lib/assets';

interface Props {
  id: string;
}

const { id } = Astro.props;
const logo = getLogo(id);
const img = resolveLogoImage(logo);
---

<div class="logomark">
  {img ? <Image src={img} alt={logo.name} height={24} class="logomark__img" loading="lazy" /> : <span class="logomark__word">{logo.name}</span>}
  <span class="logomark__rel mono">{logo.relationship}</span>
</div>

<style>
  .logomark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .logomark__word {
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }

  .logomark :global(.logomark__img) {
    height: 24px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.8;
  }

  .logomark__rel {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
