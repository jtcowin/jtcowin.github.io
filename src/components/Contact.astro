---
/**
 * Contact: the closing message, the email address and the resume.
 *
 * On the homepage Contact and the footer below it make one closing frame:
 * together they are at least one screen tall (`--footer-h` is the footer's
 * height, set in global.css from the footer's own spacing), so at the very end
 * of the page nothing of the section before shows above them, and the message
 * sits in the middle of the room between the floating header and the footer.
 * Where the content is taller than that (small screens), it simply grows.
 *
 * Behind it lies a quiet grid in the surface's own teal, drawn with two CSS
 * gradients: thin lines on generous cells aligned to the page's content edge,
 * one even field that runs behind the headline, the actions, the navigation
 * and on through the footer, eased in only at its outer edges. The lines are
 * faint enough to sit behind text without costing it contrast, lit or not.
 * With a fine pointer that can hover, the lines brighten a little in a broad,
 * feathered area around the pointer; nothing moves or bends. Touch screens
 * and reduced motion show only the still grid. The compact variant at the end
 * of the case-study pages keeps its plain surface.
 */
import home from '@data/home.json';
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import Icon from './Icon.astro';

interface Props {
  /** Compact variant used at the bottom of case-study pages. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { contact } = home;
const resumeHref = withBase(site.resumePath);
---

<section id="contact" class:list={['section', 'contact', compact ? 'contact--compact' : 'contact--frame']} aria-labelledby="contact-heading">
  {
    !compact && (
      <div class="contact__grid" aria-hidden="true" data-contact-grid>
        <span class="contact__lines" />
        <span class="contact__lines contact__lines--lit" />
      </div>
    )
  }
  <div class="container contact__inner">
    <div class="contact__copy">
      <p class="eyebrow contact__eyebrow">Contact</p>
      <h2 id="contact-heading" class:list={['display', compact ? 'display-lg' : 'display-xl']}>{contact.heading}</h2>
      <p class="lede contact__lede">{contact.copy}</p>
    </div>
    <div class="contact__actions">
      <a href={`mailto:${site.email}`} class="contact__email">
        <span class="contact__email-text">{site.email}</span>
        <Icon name="arrow-up-right" size={20} />
      </a>
      <a href={resumeHref} class="btn btn--secondary" download>
        <Icon name="download" size={14} /> {contact.secondary.label}
      </a>
    </div>
  </div>
</section>

<script>
  // The grid brightens a little around a fine pointer, anywhere over Contact
  // and the footer, which share it. Pointer moves are gathered into one update
  // a frame, which writes the position to two custom properties; the listeners
  // run only while the grid is near the screen. Nothing moves or bends.
  const grid = document.querySelector<HTMLElement>('[data-contact-grid]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (grid) {
    let raf = 0;
    let x = -1;
    let y = -1;
    let near = !('IntersectionObserver' in window);
    let listening = false;
    const apply = () => {
      raf = 0;
      const r = grid.getBoundingClientRect();
      const inside = x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
      if (inside) {
        grid.style.setProperty('--mx', `${(x - r.left).toFixed(1)}px`);
        grid.style.setProperty('--my', `${(y - r.top).toFixed(1)}px`);
      }
      grid.classList.toggle('is-lit', inside);
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(apply);
    };
    const move = (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;
      x = e.clientX;
      y = e.clientY;
      queue();
    };
    // Leaving the window altogether.
    const out = (e: PointerEvent) => {
      if (e.relatedTarget) return;
      x = -1;
      y = -1;
      queue();
    };
    const sync = () => {
      const want = near && fine.matches && !reduce.matches;
      if (want && !listening) {
        document.addEventListener('pointermove', move, { passive: true });
        document.addEventListener('pointerout', out, { passive: true });
        window.addEventListener('scroll', queue, { passive: true });
        listening = true;
      } else if (!want && listening) {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerout', out);
        window.removeEventListener('scroll', queue);
        grid.classList.remove('is-lit');
        listening = false;
      }
    };
    if (!near) {
      new IntersectionObserver(
        ([entry]) => {
          near = entry.isIntersecting;
          sync();
        },
        { rootMargin: '25% 0px' },
      ).observe(grid);
    }
    sync();
    fine.addEventListener?.('change', sync);
    reduce.addEventListener?.('change', sync);
  }
</script>

<style>
  /* Color comes from the numbered surface this section is placed on. */
  .contact {
    color: var(--ink-2);
  }

  .contact--compact {
    padding-block: calc(var(--section-y) * 0.75);
  }

  .contact__inner {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  /* Wider than before, so the headline breaks into two or three confident
     lines on the new canvas instead of four narrow ones. */
  .contact__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 58rem;
  }

  .contact__eyebrow {
    color: var(--accent);
  }

  .contact__lede {
    color: var(--ink-2);
  }

  .contact__actions {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: end;
  }

  .contact__email {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--heading);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.25rem;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
    overflow-wrap: anywhere;
  }

  .contact__email :global(svg) {
    flex: none;
    align-self: center;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .contact__email:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .contact__email:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  /* ---- the closing frame (homepage) ------------------------------------ */
  .contact--frame {
    --view-h: 100vh;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    /* With the footer, at least one full screen. */
    min-height: calc(var(--view-h) - var(--footer-h));
  }

  @supports (height: 1svh) {
    .contact--frame {
      --view-h: 100svh;
    }
  }

  /* The message sits a touch above the middle of the room it has. */
  .contact--frame::before,
  .contact--frame::after {
    content: '';
  }

  .contact--frame::before {
    flex: 1 1 0;
  }

  .contact--frame::after {
    flex: 1.25 1 0;
  }

  .contact--frame .contact__inner {
    position: relative;
    z-index: 1;
  }

  /* ---- the grid --------------------------------------------------------- */
  .contact__grid {
    /* Columns fitted to the content width, so a line runs along the text's
       left edge and another along the right edge of the content. The counts
       below keep the cells generous, about 110 to 140px at common widths. */
    --grid-cols: 3;
    --content-w: calc(min(100vw, var(--container)) - 2 * var(--gutter));
    --cell: calc(var(--content-w) / var(--grid-cols));
    /* The surface with a little of its own light aqua: a line is about 4.5
       points lighter than the surface in perceived lightness (CIE L*, about
       5% contrast), quiet enough to run behind the text. Around a pointer the
       lines take five points more of the aqua than in the reviewed build (17%
       instead of 12%), about 9 points lighter at the pointer itself. The
       brand surface's small text is set a touch lighter (global.css), so it
       keeps 4.5:1 even beside a fully lit line. */
    --grid-ink: color-mix(in srgb, var(--bg) 92%, var(--c-aqua-light));
    --grid-lit: color-mix(in srgb, var(--bg) 83%, var(--c-aqua-light));
    /* One even field behind everything, the headline, actions, navigation
       and footer included, eased in only at its outer edges: where Contact
       begins, at the foot of the page, and toward the sides of the screen. */
    --grid-fade: linear-gradient(to bottom, transparent 0, #000 2.5rem, #000 calc(100% - 3rem), transparent 100%);
    --grid-sides: linear-gradient(to right, transparent 0, #000 min(8vw, 6rem), #000 calc(100% - min(8vw, 6rem)), transparent 100%);
    /* The footer's rule, counted up from the foot of the grid. The rows start
       there, so no line runs just beside the rule, and the grid leaves a
       two-pixel band around it (wherever the rule's pixel row falls) to the
       rule, which keeps its own color edge to edge. */
    --rule-at: var(--footer-h);
    --grid-rule: linear-gradient(to top, #000 calc(var(--footer-h) - 1.5px), transparent calc(var(--footer-h) - 1.5px) calc(var(--footer-h) + 0.5px), #000 calc(var(--footer-h) + 0.5px));
    position: absolute;
    /* Down through the footer, so Contact and the footer share one grid. */
    inset: 0 0 calc(-1 * var(--footer-h));
    z-index: 0;
    pointer-events: none;
  }

  .contact__lines {
    position: absolute;
    inset: 0;
    /* The pattern starts at the content's left edge. */
    padding-inline: max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter)));
    background-image:
      linear-gradient(to right, var(--grid-ink) 0 1px, transparent 1px 100%),
      linear-gradient(to bottom, var(--grid-ink) 0 1px, transparent 1px 100%);
    background-size: var(--cell) var(--cell);
    background-origin: content-box;
    background-clip: border-box;
    /* Rows counted up from the top of the footer, so a row meets the
       footer's rule instead of running just beside it. */
    background-position: left 0 bottom var(--rule-at);
    -webkit-mask-image: var(--grid-fade), var(--grid-sides), var(--grid-rule);
    mask-image: var(--grid-fade), var(--grid-sides), var(--grid-rule);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  /* The same lines a little brighter, seen through a broad, feathered circle
     around the pointer. */
  .contact__lines--lit {
    background-image:
      linear-gradient(to right, var(--grid-lit) 0 1px, transparent 1px 100%),
      linear-gradient(to bottom, var(--grid-lit) 0 1px, transparent 1px 100%);
    -webkit-mask-image: var(--grid-fade), var(--grid-sides), var(--grid-rule), radial-gradient(circle var(--lit-r, 24rem) at var(--mx, 50%) var(--my, 50%), #000 0%, rgba(0, 0, 0, 0.58) 32%, rgba(0, 0, 0, 0.2) 64%, transparent 100%);
    mask-image: var(--grid-fade), var(--grid-sides), var(--grid-rule), radial-gradient(circle var(--lit-r, 24rem) at var(--mx, 50%) var(--my, 50%), #000 0%, rgba(0, 0, 0, 0.58) 32%, rgba(0, 0, 0, 0.2) 64%, transparent 100%);
    opacity: 0;
    transition: opacity 450ms var(--ease-out);
  }

  .contact__grid.is-lit .contact__lines--lit {
    opacity: 1;
  }

  /* Whole pixels keep the lines crisp. */
  @supports (width: round(1.5px, 1px)) {
    .contact__grid {
      --cell: round(down, calc(var(--content-w) / var(--grid-cols)), 1px);
      --rule-at: round(var(--footer-h), 1px);
    }

    .contact__lines {
      padding-inline: round(max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter))), 1px);
    }
  }

  /* Only a fine pointer that can hover, without reduced motion, lights the
     grid; touch screens and reduced motion show the still grid alone. */
  .contact__lines--lit {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .contact__lines--lit {
      display: block;
    }
  }

  @media (min-width: 48rem) {
    .contact__grid {
      --grid-cols: 6;
    }
  }

  @media (min-width: 60rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }

    .contact__actions {
      justify-items: end;
      text-align: right;
    }

    /* The actions take only the room they need, at the right edge. */
    .contact--frame .contact__actions {
      justify-self: end;
    }

    /* Clear of the floating header at the top; the footer anchors the foot. */
    .contact--frame {
      --fit: min(1vw, 1.8vh);
      padding-block: calc(var(--nav-h) + clamp(1rem, 2 * var(--fit), 3rem)) clamp(2rem, 4 * var(--fit), 5rem);
    }

    .contact__grid {
      --grid-cols: 8;
      --lit-r: clamp(18rem, 26vw, 30rem);
    }
  }

  @media (min-width: 75rem) {
    .contact__grid {
      --grid-cols: 10;
    }
  }
</style>
