---
/**
 * Site header.
 *
 * The header has no surface of its own: no bar, no border, no blur, and it
 * never fades the content passing beneath it. Each control carries its own
 * contrast instead, and takes it from whichever numbered surface is under the
 * header at that moment. A small script finds that surface and copies its
 * background, text, rule and focus tokens onto the header, so the pills always
 * match the ground they sit on and the switch happens exactly where one surface
 * meets the next.
 *
 * On the homepage the header follows the viewport over the full-bleed hero.
 * That is a progressive enhancement: without JavaScript it stays in the hero
 * and scrolls away with it, in its hero colors, which are always legible
 * there. Inner pages keep an ordinary sticky header with a home link: a small
 * outlined house and the word HOME.
 *
 * Hierarchy: Work and About are the lightest controls, Contact is the filled
 * call to action, Resume is the outlined one. The mobile menu is a native
 * <details> element, so it works with no JavaScript; the script only adds
 * Escape and click-outside.
 *
 * Work (V1.5) carries a compact menu of the case studies, numbered as on the
 * homepage, so any one is a step away. On a desktop it opens on hover (a
 * moment's grace on the way in, a longer one on the way out so the pointer can
 * travel into it) and when the keyboard focus arrives, and closes when the
 * pointer or the focus leaves or on Escape; the arrow keys move through it. On
 * a touch screen the first tap on Work opens it and a second follows the link.
 * It is never hover-only: without JavaScript, hover and focus still open it.
 * In the phone menu the case studies are listed under Work.
 */
import { getCollection } from 'astro:content';
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import Icon from './Icon.astro';

interface Props {
  /** Current page path (site-relative). */
  current?: string;
  /** Lay the header over a full-bleed hero instead of on its own row. */
  overlay?: boolean;
}

const { current = '/', overlay = false } = Astro.props;
const resumeHref = withBase(site.resumePath);

// The case studies, in the homepage's order and with its numbers and titles.
const work = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry, i) => ({ num: String(i + 1).padStart(2, '0'), title: entry.data.card.title, path: `/work/${entry.id}/` }));
---

<header
  class:list={['site-header', overlay && 'site-header--overlay']}
  id="top"
  data-header
  data-mode={overlay ? 'image' : 'light'}
>
  <div class="container site-header__inner">
    {
      /* No mark over the hero: the name is already the composition. Inner pages
         still need a way home: a restrained HOME label in the place the name
         used to take, set like the navigation (the capitals are CSS, so it is
         read as "Home"), led since V1.2 by a small outlined house: House
         Simple from Phosphor Icons 2.1.1 (MIT License, Copyright (c) 2023
         Phosphor Icons; the notice is in the README), in its Bold weight,
         whose stroke matches the label's bold capitals where the Regular reads
         lighter. Decorative: the link's name stays "Home". */
      overlay ? (
        <span class="brand brand--empty" aria-hidden="true" />
      ) : (
        <a href={withBase('/')} class="brand brand--home" aria-current={current === '/' ? 'page' : undefined}>
          <svg class="brand__house" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" data-icon="house-simple">
            <path d="M222.14,105.85l-80-80a20,20,0,0,0-28.28,0l-80,80A19.86,19.86,0,0,0,28,120v96a12,12,0,0,0,12,12H216a12,12,0,0,0,12-12V120A19.86,19.86,0,0,0,222.14,105.85ZM204,204H52V121.65l76-76,76,76Z" />
          </svg>
          Home
        </a>
      )
    }

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        <li class="nav__item" data-workmenu>
          <a href={withBase('/#work')} class="nav__link nav__link--menu" data-workmenu-trigger>
            Work<span class="nav__caret" aria-hidden="true"></span>
          </a>
          <div class="workmenu" id="nav-work" data-workmenu-panel>
            <ul class="workmenu__list">
              {
                work.map((w) => (
                  <li>
                    <a href={withBase(w.path)} class="workmenu__link" aria-current={current === w.path ? 'page' : undefined}>
                      <span class="workmenu__num">{w.num}</span>
                      <span class="workmenu__title">{w.title}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li>
          <a href={withBase('/#about')} class="nav__link">
            About
          </a>
        </li>
        <li>
          <a href={withBase('/#contact')} class="nav__cta nav__cta--primary">Contact</a>
        </li>
        <li>
          <a href={resumeHref} class="nav__cta nav__cta--ghost" download>Resume</a>
        </li>
      </ul>
    </nav>

    <details class="mobile" data-menu>
      <summary class="mobile__toggle" aria-label="Menu">
        <Icon name="menu" size={20} class="mobile__icon-open" />
        <Icon name="close" size={20} class="mobile__icon-close" />
      </summary>
      <nav class="mobile__panel" aria-label="Primary">
        <ul class="mobile__list">
          <li>
            <a href={withBase('/#work')} class="mobile__link">
              Work
            </a>
            <ul class="mobile__sub" aria-label="Case studies">
              {
                work.map((w) => (
                  <li>
                    <a href={withBase(w.path)} class="mobile__sublink" aria-current={current === w.path ? 'page' : undefined}>
                      <span class="mobile__num">{w.num}</span>
                      <span>{w.title}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
          <li>
            <a href={withBase('/#about')} class="mobile__link">
              About
            </a>
          </li>
          <li class="mobile__ctas">
            <a href={withBase('/#contact')} class="nav__cta nav__cta--primary">Contact</a>
            <a href={resumeHref} class="nav__cta nav__cta--ghost" download>Resume</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // ---- Menu: Escape and click-outside. <details> already does the rest. ----
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-menu]'));

  function closeAll() {
    for (const m of menus) if (m.open) m.open = false;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('a')) {
      closeAll();
      return;
    }
    if (!target.closest('details[data-menu]')) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus.find((m) => m.open);
    if (!open) return;
    open.open = false;
    open.querySelector<HTMLElement>('summary')?.focus();
  });

  // ---- Work: the case studies, a step from the Work link (V1.5) --------------
  // The menu is open while the item has the class is-open (its aria-expanded
  // follows). A fine pointer opens it on hover, after a moment's grace, and it
  // closes a little after the pointer leaves, so the pointer can travel into
  // it; the keyboard opens it when the focus arrives (Tab then walks through
  // it, the arrow keys too) and it closes when the focus leaves or on Escape;
  // on a touch screen the first tap on Work opens it and a second one follows
  // the link. A press anywhere else closes it.
  for (const item of Array.from(document.querySelectorAll<HTMLElement>('[data-workmenu]'))) {
    const trigger = item.querySelector<HTMLAnchorElement>('[data-workmenu-trigger]');
    const panel = item.querySelector<HTMLElement>('[data-workmenu-panel]');
    if (!trigger || !panel) continue;
    const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('a'));
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-controls', panel.id);
    // Closed, its links are out of reach at once (inert), even while it fades.
    panel.inert = true;
    let opening = 0;
    let closing = 0;
    let pointer = 'mouse';
    let quiet = false;
    const isOpen = () => item.classList.contains('is-open');
    const open = () => {
      window.clearTimeout(opening);
      window.clearTimeout(closing);
      item.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      panel.inert = false;
    };
    const close = () => {
      window.clearTimeout(opening);
      window.clearTimeout(closing);
      item.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      panel.inert = true;
    };
    item.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      window.clearTimeout(closing);
      if (!isOpen()) opening = window.setTimeout(open, 60);
    });
    item.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      window.clearTimeout(opening);
      if (isOpen()) closing = window.setTimeout(close, 280);
    });
    item.addEventListener('pointerdown', (event) => {
      pointer = event.pointerType;
    });
    trigger.addEventListener('click', (event) => {
      const touch = pointer !== 'mouse';
      pointer = 'mouse';
      if (touch && !isOpen()) {
        event.preventDefault();
        open();
        return;
      }
      close();
    });
    for (const link of links) link.addEventListener('click', close);
    item.addEventListener('focusin', (event) => {
      if (quiet) {
        quiet = false;
        return;
      }
      // Keyboard focus only (a click focuses too); a browser that cannot tell treats it as the keyboard's.
      let keyboard = true;
      try {
        keyboard = (event.target as HTMLElement).matches(':focus-visible');
      } catch {
        /* no :focus-visible */
      }
      if (keyboard) open();
    });
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) close();
    });
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        if (!isOpen()) return;
        event.preventDefault();
        close();
        if (document.activeElement !== trigger) {
          quiet = true;
          trigger.focus();
        }
        return;
      }
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      const n = links.length;
      let to = -1;
      if (event.key === 'ArrowDown') to = at < 0 ? 0 : (at + 1) % n;
      else if (event.key === 'ArrowUp') to = at < 0 ? n - 1 : (at - 1 + n) % n;
      else if (event.key === 'Home' && at >= 0) to = 0;
      else if (event.key === 'End' && at >= 0) to = n - 1;
      if (to < 0) return;
      event.preventDefault();
      open();
      links[to].focus();
    });
    document.addEventListener('pointerdown', (event) => {
      if (isOpen() && !item.contains(event.target as Node)) close();
    });
    // A page restored from the back-forward cache comes back with it closed.
    window.addEventListener('pageshow', close);
  }

  // ---- Surface tracking ----------------------------------------------------
  // Watch a one-pixel line through the middle of the header. Whichever
  // [data-surface] section crosses that line is the ground the controls sit on,
  // so its tokens are copied onto the header. The switch therefore happens at
  // the exact moment a surface boundary passes behind the controls: no early
  // flip, no late contrast.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const surfaces = Array.from(document.querySelectorAll<HTMLElement>('[data-surface]'));

  const TOKENS: Array<[string, string]> = [
    ['--bg', '--nav-bg'],
    ['--ink', '--nav-ink'],
    ['--ink-2', '--nav-ink-2'],
    ['--line-strong', '--nav-line'],
    ['--focus', '--nav-focus'],
  ];

  function adopt(surface: HTMLElement) {
    if (!header) return;
    const cs = getComputedStyle(surface);
    for (const [from, to] of TOKENS) {
      const v = cs.getPropertyValue(from).trim();
      if (v) header.style.setProperty(to, v);
    }
    header.dataset.mode = surface.dataset.surface === 'image' ? 'image' : 'surface';
  }

  if (header && surfaces.length && 'IntersectionObserver' in window) {
    if (header.classList.contains('site-header--overlay')) header.dataset.follow = '';

    let io: IntersectionObserver | null = null;
    // Every surface on the line right now. A surface can sit inside another
    // (the Technical Product Marketing hero's screen, dark inside the light
    // hero, grows over the header as the page scrolls), so the innermost one,
    // the last in document order, is the ground; when it leaves the line the
    // one around it takes over again.
    const crossing = new Set<HTMLElement>();

    const watch = () => {
      io?.disconnect();
      crossing.clear();
      const mid = Math.round(header.getBoundingClientRect().height / 2);
      const bottom = Math.max(0, window.innerHeight - mid - 1);
      io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) crossing.add(el);
            else crossing.delete(el);
          }
          let ground: HTMLElement | null = null;
          for (const s of surfaces) if (crossing.has(s)) ground = s;
          if (ground) adopt(ground);
        },
        { rootMargin: `-${mid}px 0px -${bottom}px 0px`, threshold: 0 },
      );
      for (const s of surfaces) io.observe(s);
    };

    watch();
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(watch, 150);
    });
  }
</script>

<style>
  /* ---- Tokens -----------------------------------------------------------
     Defaults describe the ground the header starts on before any script runs:
     the light page for inner pages, the photograph for the homepage. The
     script overwrites them from the live surface. */
  .site-header {
    --nav-bg: var(--c-bone);
    --nav-ink: var(--c-ink);
    --nav-ink-2: var(--c-ink-2);
    --nav-line: var(--c-steel-deep);
    --nav-focus: var(--c-teal);
    /* How much of the surface color a pill carries: enough that text or
       imagery scrolling beneath never undermines a label. */
    --nav-pill-alpha: 90%;

    position: sticky;
    top: 0;
    z-index: 50;
    background: none;
    border: 0;
  }

  .site-header--overlay {
    --nav-bg: var(--c-ink);
    --nav-ink: var(--c-fog);
    --nav-ink-2: var(--c-fog-2);
    --nav-line: rgba(237, 240, 239, 0.55);
    --nav-focus: var(--c-fog);

    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
  }

  /* Set by the script, so this never applies without JavaScript. */
  .site-header--overlay[data-follow] {
    position: fixed;
  }

  /* Over the photograph the pills must hold their own contrast even when the
     white moving name passes directly beneath them, which it does once the
     hero starts to scroll. At 72% ink the worst case, a pill over pure white,
     still gives the link text better than 5:1. */
  .site-header[data-mode='image'] {
    --nav-pill-alpha: 72%;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-row);
  }

  .site-header--overlay .site-header__inner {
    max-width: none;
    min-height: var(--nav-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.8rem;
    margin-inline-start: -0.8rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    text-decoration: none;
    color: var(--nav-ink);
    border-radius: 999px;
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
  }

  .brand:hover {
    color: var(--nav-ink);
    text-decoration: underline;
    text-decoration-color: var(--nav-line);
  }

  /* HOME: the pill and padding of the navigation links, in the small tracked
     capitals the site keeps for labels. */
  .brand--home {
    padding: 0.55rem 0.95rem;
    margin-inline-start: -0.95rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nav-ink-2);
    transition:
      color 180ms var(--ease-out),
      background-color 180ms var(--ease-out);
  }

  .brand--home:hover {
    color: var(--nav-ink);
    text-decoration: none;
    background: color-mix(in srgb, var(--nav-bg) 100%, transparent);
  }

  /* The house (V1.2): the label's optical size, its color, and a one-pixel
     rise on hover beside the label's color change. No movement for reduced
     motion. */
  .brand--home {
    gap: 0.55em;
  }

  .brand__house {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    transition: transform 180ms var(--ease-out);
  }

  .brand--home:hover .brand__house {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .brand--home:hover .brand__house {
      transform: none;
    }
  }

  .brand--empty {
    width: 0;
    padding: 0;
    margin: 0;
    background: none;
  }

  /* ---- Controls ---------------------------------------------------------- */
  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__link,
  .nav__cta,
  .mobile__toggle {
    transition:
      color 180ms var(--ease-out),
      background-color 180ms var(--ease-out),
      border-color 180ms var(--ease-out);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.95rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--nav-ink-2);
    text-decoration: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
  }

  .nav__link:hover {
    color: var(--nav-ink);
    background: color-mix(in srgb, var(--nav-bg) 100%, transparent);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.15rem;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid transparent;
  }

  .nav__cta--primary {
    background: var(--nav-ink);
    color: var(--nav-bg);
    border-color: var(--nav-ink);
  }

  .nav__cta--primary:hover {
    background: var(--nav-ink-2);
    border-color: var(--nav-ink-2);
    color: var(--nav-bg);
  }

  .nav__cta--ghost {
    color: var(--nav-ink);
    border-color: var(--nav-line);
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
  }

  .nav__cta--ghost:hover {
    border-color: var(--nav-ink);
    color: var(--nav-ink);
  }

  .site-header :global(a:focus-visible),
  .site-header :global(summary:focus-visible) {
    outline: 2px solid var(--nav-focus);
    outline-offset: 3px;
  }

  /* ---- Work's menu (V1.5) -------------------------------------------------
     A small chevron on Work says it opens; the menu drops just below it: one
     panel in the header's own colors (solid enough to read over anything), the
     three case studies with their numbers. It fades and settles a few pixels
     into place; closing, it fades a little faster. */
  .nav__item {
    position: relative;
  }

  .nav__caret {
    width: 0.38rem;
    height: 0.38rem;
    margin-left: 0.5rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    opacity: 0.75;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav__item.is-open .nav__caret {
    transform: translateY(1px) rotate(225deg);
  }

  .nav__item.is-open .nav__link--menu {
    color: var(--nav-ink);
    background: color-mix(in srgb, var(--nav-bg) 100%, transparent);
  }

  .workmenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 2;
    min-width: 19rem;
    padding: 0.4rem;
    border: 1px solid color-mix(in srgb, var(--nav-line) 60%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--nav-bg) 97%, transparent);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 120ms ease-in,
      transform 120ms ease-in,
      visibility 0s linear 120ms;
  }

  .site-header[data-mode='image'] .workmenu {
    background: rgba(13, 15, 16, 0.94);
  }

  /* The gap between Work and the menu belongs to the menu, so the pointer never
     leaves on its way down. */
  .workmenu::before {
    content: '';
    position: absolute;
    inset: -0.6rem 0 100%;
  }

  .nav__item.is-open .workmenu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out),
      visibility 0s linear 0s;
  }

  /* Without JavaScript, hover and focus still open it. */
  :global(html:not(.js)) .nav__item:hover .workmenu,
  :global(html:not(.js)) .nav__item:focus-within .workmenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .workmenu__list {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workmenu__link {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.7rem 0.85rem;
    border-radius: calc(var(--radius-lg) - 0.4rem);
    color: var(--nav-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .workmenu__num {
    color: var(--nav-ink-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .workmenu__link:hover {
    color: var(--nav-ink);
    background: color-mix(in srgb, var(--nav-ink) 9%, transparent);
  }

  /* The case study you are on: a quiet ground of its own. */
  .workmenu__link[aria-current='page'] {
    background: color-mix(in srgb, var(--nav-ink) 6%, transparent);
  }

  .workmenu__link[aria-current='page'] .workmenu__num {
    color: var(--nav-ink);
  }

  .site-header :global(.workmenu__link:focus-visible) {
    outline-offset: -2px;
  }

  /* ---- Mobile ------------------------------------------------------------ */
  .mobile {
    position: relative;
  }

  .mobile__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--nav-line);
    color: var(--nav-ink);
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
    cursor: pointer;
    list-style: none;
  }

  .mobile__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile :global(.mobile__icon-close) {
    display: none;
  }

  .mobile[open] :global(.mobile__icon-open) {
    display: none;
  }

  .mobile[open] :global(.mobile__icon-close) {
    display: block;
  }

  /* The open menu is a panel, not a page-wide band, so it may be solid. */
  .mobile__panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(20rem, calc(100vw - 2 * var(--gutter)));
