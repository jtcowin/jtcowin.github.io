---
/**
 * Site header.
 *
 * Two variants share one markup. On the homepage it overlays the full-bleed
 * hero photograph with no background block of its own, using light controls
 * over the hero's own top scrim. Everywhere else it is the ordinary sticky bar
 * on the light page background.
 *
 * Hierarchy in both: Work and About are plain text links, Contact is the
 * primary call to action, Resume is the quieter outline one. The mobile menu is
 * a native <details> element, so it opens, closes, and takes keyboard input
 * with no JavaScript at all; the script below only adds Escape and
 * click-outside.
 */
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import Icon from './Icon.astro';

interface Props {
  /** Current page path (site-relative). */
  current?: string;
  /** Lay the header over a full-bleed hero instead of on its own bar. */
  overlay?: boolean;
}

const { current = '/', overlay = false } = Astro.props;
const resumeHref = withBase(site.resumePath);

const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
];
---

<header class:list={['site-header', overlay && 'site-header--overlay']} id="top">
  <div class="container site-header__inner">
    <a href={withBase('/')} class="brand" aria-current={current === '/' ? 'page' : undefined}>
      <img
        class="brand__mark"
        src={withBase('/icon-192.png')}
        alt={`${site.name}, home`}
        width="44"
        height="44"
        decoding="async"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          links.map((l) => (
            <li>
              <a href={withBase(l.href)} class="nav__link">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase('/#contact')} class="nav__cta nav__cta--primary">Contact</a>
        </li>
        <li>
          <a href={resumeHref} class="nav__cta nav__cta--ghost" download>Resume</a>
        </li>
      </ul>
    </nav>

    <details class="mobile" data-menu>
      <summary class="mobile__toggle" aria-label="Menu">
        <Icon name="menu" size={20} class="mobile__icon-open" />
        <Icon name="close" size={20} class="mobile__icon-close" />
      </summary>
      <nav class="mobile__panel" aria-label="Primary">
        <ul class="mobile__list">
          {
            links.map((l) => (
              <li>
                <a href={withBase(l.href)} class="mobile__link">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li class="mobile__ctas">
            <a href={withBase('/#contact')} class="nav__cta nav__cta--primary">Contact</a>
            <a href={resumeHref} class="nav__cta nav__cta--ghost" download>Resume</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Escape and click-outside for the menu. The <details> element already opens,
  // closes, and handles keyboard on its own, so this is enhancement only.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-menu]'));

  function closeAll() {
    for (const m of menus) if (m.open) m.open = false;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('a')) {
      closeAll();
      return;
    }
    if (!target.closest('details[data-menu]')) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus.find((m) => m.open);
    if (!open) return;
    open.open = false;
    open.querySelector<HTMLElement>('summary')?.focus();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  /* Over the hero the header contributes no surface of its own: no bar, no
     border, no blur plane. The hero's top scrim is what carries the contrast. */
  .site-header--overlay {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 0;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4.25rem;
  }

  .site-header--overlay .site-header__inner {
    max-width: none;
    min-height: clamp(4.5rem, 9vh, 6rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: 999px;
  }

  .brand__mark {
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 999px;
    display: block;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .site-header--overlay .brand__mark {
    width: clamp(2.5rem, 3.4vw, 3.25rem);
    height: clamp(2.5rem, 3.4vw, 3.25rem);
    box-shadow: 0 0 0 1px rgba(242, 241, 236, 0.35);
  }

  .brand:hover .brand__mark {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.85rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: 999px;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--bg-sunk);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .nav__cta--primary {
    background: var(--ink);
    color: #fff;
  }

  .nav__cta--primary:hover {
    background: var(--accent-ink);
    color: #fff;
  }

  .nav__cta--ghost {
    border-color: var(--line-strong);
    color: var(--ink-2);
  }

  .nav__cta--ghost:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  /* ---- overlay controls ------------------------------------------------ */
  .site-header--overlay .nav__link {
    color: #f2f1ec;
    font-weight: 500;
  }

  .site-header--overlay .nav__link:hover {
    color: #fff;
    background: rgba(242, 241, 236, 0.16);
  }

  .site-header--overlay .nav__cta--primary {
    background: #f4f3ee;
    color: #16181a;
  }

  .site-header--overlay .nav__cta--primary:hover {
    background: #fff;
    color: #16181a;
  }

  .site-header--overlay .nav__cta--ghost {
    color: #f2f1ec;
    border-color: rgba(242, 241, 236, 0.55);
    background: rgba(12, 14, 16, 0.28);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .site-header--overlay .nav__cta--ghost:hover {
    border-color: #f2f1ec;
    background: rgba(12, 14, 16, 0.45);
    color: #fff;
  }

  .site-header--overlay :global(a:focus-visible),
  .site-header--overlay :global(summary:focus-visible) {
    outline: 2px solid #f2f1ec;
    outline-offset: 3px;
  }

  /* ---- mobile ---------------------------------------------------------- */
  .mobile {
    position: relative;
  }

  .mobile__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .mobile__toggle::-webkit-details-marker {
    display: none;
  }

  .site-header--overlay .mobile__toggle {
    color: #f2f1ec;
    border-color: rgba(242, 241, 236, 0.55);
    background: rgba(12, 14, 16, 0.32);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .mobile :global(.mobile__icon-close) {
    display: none;
  }

  .mobile[open] :global(.mobile__icon-open) {
    display: none;
  }

  .mobile[open] :global(.mobile__icon-close) {
    display: block;
  }

  .mobile__panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(18rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.6rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    animation: rise-in var(--dur) var(--ease-out) both;
  }

  .site-header--overlay .mobile__panel {
    background: rgba(14, 16, 18, 0.92);
    border-color: rgba(242, 241, 236, 0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .mobile__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .mobile__link {
    display: block;
    padding: 0.8rem 0.85rem;
    font-size: var(--text-md);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius);
    color: var(--ink);
  }

  .mobile__link:hover {
    background: var(--bg-sunk);
  }

  .site-header--overlay .mobile__link {
    color: #f2f1ec;
  }

  .site-header--overlay .mobile__link:hover {
    background: rgba(242, 241, 236, 0.14);
    color: #fff;
  }

  .mobile__ctas {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .site-header--overlay .mobile__ctas {
    border-top-color: rgba(242, 241, 236, 0.18);
  }

  .mobile__ctas .nav__cta {
    width: 100%;
  }

  @media (min-width: 60rem) {
    .nav {
      display: block;
    }

    .mobile {
      display: none;
    }
  }
</style>
