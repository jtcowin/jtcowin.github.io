---
/**
 * Site header.
 *
 * The header has no surface of its own: no bar, no border, no blur, and it
 * never fades the content passing beneath it. Each control carries its own
 * contrast instead, and takes it from whichever numbered surface is under the
 * header at that moment. A small script finds that surface and copies its
 * background, text, rule and focus tokens onto the header, so the pills always
 * match the ground they sit on and the switch happens exactly where one surface
 * meets the next.
 *
 * On the homepage the header follows the viewport over the full-bleed hero.
 * That is a progressive enhancement: without JavaScript it stays in the hero
 * and scrolls away with it, in its hero colours, which are always legible
 * there. Inner pages keep an ordinary sticky header with a text home link.
 *
 * Hierarchy: Work and About are the lightest controls, Contact is the filled
 * call to action, Resume is the outlined one. The mobile menu is a native
 * <details> element, so it works with no JavaScript; the script only adds
 * Escape and click-outside.
 */
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import Icon from './Icon.astro';

interface Props {
  /** Current page path (site-relative). */
  current?: string;
  /** Lay the header over a full-bleed hero instead of on its own row. */
  overlay?: boolean;
}

const { current = '/', overlay = false } = Astro.props;
const resumeHref = withBase(site.resumePath);

const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
];
---

<header
  class:list={['site-header', overlay && 'site-header--overlay']}
  id="top"
  data-header
  data-mode={overlay ? 'image' : 'light'}
>
  <div class="container site-header__inner">
    {
      /* No mark over the hero: the name is already the composition. Inner pages
         still need a way home, so they get a plain text link. */
      overlay ? (
        <span class="brand brand--empty" aria-hidden="true" />
      ) : (
        <a href={withBase('/')} class="brand" aria-current={current === '/' ? 'page' : undefined}>
          {site.name}
        </a>
      )
    }

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          links.map((l) => (
            <li>
              <a href={withBase(l.href)} class="nav__link">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase('/#contact')} class="nav__cta nav__cta--primary">Contact</a>
        </li>
        <li>
          <a href={resumeHref} class="nav__cta nav__cta--ghost" download>Resume</a>
        </li>
      </ul>
    </nav>

    <details class="mobile" data-menu>
      <summary class="mobile__toggle" aria-label="Menu">
        <Icon name="menu" size={20} class="mobile__icon-open" />
        <Icon name="close" size={20} class="mobile__icon-close" />
      </summary>
      <nav class="mobile__panel" aria-label="Primary">
        <ul class="mobile__list">
          {
            links.map((l) => (
              <li>
                <a href={withBase(l.href)} class="mobile__link">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li class="mobile__ctas">
            <a href={withBase('/#contact')} class="nav__cta nav__cta--primary">Contact</a>
            <a href={resumeHref} class="nav__cta nav__cta--ghost" download>Resume</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // ---- Menu: Escape and click-outside. <details> already does the rest. ----
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-menu]'));

  function closeAll() {
    for (const m of menus) if (m.open) m.open = false;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('a')) {
      closeAll();
      return;
    }
    if (!target.closest('details[data-menu]')) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus.find((m) => m.open);
    if (!open) return;
    open.open = false;
    open.querySelector<HTMLElement>('summary')?.focus();
  });

  // ---- Surface tracking ----------------------------------------------------
  // Watch a one-pixel line through the middle of the header. Whichever
  // [data-surface] section crosses that line is the ground the controls sit on,
  // so its tokens are copied onto the header. The switch therefore happens at
  // the exact moment a surface boundary passes behind the controls: no early
  // flip, no late contrast.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const surfaces = Array.from(document.querySelectorAll<HTMLElement>('[data-surface]'));

  const TOKENS: Array<[string, string]> = [
    ['--bg', '--nav-bg'],
    ['--ink', '--nav-ink'],
    ['--ink-2', '--nav-ink-2'],
    ['--line-strong', '--nav-line'],
    ['--focus', '--nav-focus'],
  ];

  function adopt(surface: HTMLElement) {
    if (!header) return;
    const cs = getComputedStyle(surface);
    for (const [from, to] of TOKENS) {
      const v = cs.getPropertyValue(from).trim();
      if (v) header.style.setProperty(to, v);
    }
    header.dataset.mode = surface.dataset.surface === 'image' ? 'image' : 'surface';
  }

  if (header && surfaces.length && 'IntersectionObserver' in window) {
    if (header.classList.contains('site-header--overlay')) header.dataset.follow = '';

    let io: IntersectionObserver | null = null;

    const watch = () => {
      io?.disconnect();
      const mid = Math.round(header.getBoundingClientRect().height / 2);
      const bottom = Math.max(0, window.innerHeight - mid - 1);
      io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) adopt(entry.target as HTMLElement);
          }
        },
        { rootMargin: `-${mid}px 0px -${bottom}px 0px`, threshold: 0 },
      );
      for (const s of surfaces) io.observe(s);
    };

    watch();
    let t = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(watch, 150);
    });
  }
</script>

<style>
  /* ---- Tokens -----------------------------------------------------------
     Defaults describe the ground the header starts on before any script runs:
     the light page for inner pages, the photograph for the homepage. The
     script overwrites them from the live surface. */
  .site-header {
    --nav-bg: var(--c-bone);
    --nav-ink: var(--c-ink);
    --nav-ink-2: var(--c-ink-2);
    --nav-line: var(--c-steel-deep);
    --nav-focus: var(--c-teal);
    /* How much of the surface colour a pill carries: enough that text or
       imagery scrolling beneath never undermines a label. */
    --nav-pill-alpha: 90%;

    position: sticky;
    top: 0;
    z-index: 50;
    background: none;
    border: 0;
  }

  .site-header--overlay {
    --nav-bg: var(--c-ink);
    --nav-ink: var(--c-fog);
    --nav-ink-2: var(--c-fog-2);
    --nav-line: rgba(237, 240, 239, 0.55);
    --nav-focus: var(--c-fog);

    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
  }

  /* Set by the script, so this never applies without JavaScript. */
  .site-header--overlay[data-follow] {
    position: fixed;
  }

  /* Over the photograph the pills must hold their own contrast even when the
     white moving name passes directly beneath them, which it does once the
     hero starts to scroll. At 72% ink the worst case, a pill over pure white,
     still gives the link text better than 5:1. */
  .site-header[data-mode='image'] {
    --nav-pill-alpha: 72%;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4.25rem;
  }

  .site-header--overlay .site-header__inner {
    max-width: none;
    min-height: clamp(4.5rem, 9vh, 6rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.8rem;
    margin-inline-start: -0.8rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    text-decoration: none;
    color: var(--nav-ink);
    border-radius: 999px;
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
  }

  .brand:hover {
    color: var(--nav-ink);
    text-decoration: underline;
    text-decoration-color: var(--nav-line);
  }

  .brand--empty {
    width: 0;
    padding: 0;
    margin: 0;
    background: none;
  }

  /* ---- Controls ---------------------------------------------------------- */
  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__link,
  .nav__cta,
  .mobile__toggle {
    transition:
      color 180ms var(--ease-out),
      background-color 180ms var(--ease-out),
      border-color 180ms var(--ease-out);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.95rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--nav-ink-2);
    text-decoration: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
  }

  .nav__link:hover {
    color: var(--nav-ink);
    background: color-mix(in srgb, var(--nav-bg) 100%, transparent);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.15rem;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid transparent;
  }

  .nav__cta--primary {
    background: var(--nav-ink);
    color: var(--nav-bg);
    border-color: var(--nav-ink);
  }

  .nav__cta--primary:hover {
    background: var(--nav-ink-2);
    border-color: var(--nav-ink-2);
    color: var(--nav-bg);
  }

  .nav__cta--ghost {
    color: var(--nav-ink);
    border-color: var(--nav-line);
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
  }

  .nav__cta--ghost:hover {
    border-color: var(--nav-ink);
    color: var(--nav-ink);
  }

  .site-header :global(a:focus-visible),
  .site-header :global(summary:focus-visible) {
    outline: 2px solid var(--nav-focus);
    outline-offset: 3px;
  }

  /* ---- Mobile ------------------------------------------------------------ */
  .mobile {
    position: relative;
  }

  .mobile__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--nav-line);
    color: var(--nav-ink);
    background: color-mix(in srgb, var(--nav-bg) var(--nav-pill-alpha), transparent);
    cursor: pointer;
    list-style: none;
  }

  .mobile__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile :global(.mobile__icon-close) {
    display: none;
  }

  .mobile[open] :global(.mobile__icon-open) {
    display: none;
  }

  .mobile[open] :global(.mobile__icon-close) {
    display: block;
  }

  /* The open menu is a panel, not a page-wide band, so it may be solid. */
  .mobile__panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: min(18rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.6rem;
    background: var(--nav-bg);
    border: 1px solid var(--nav-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    animation: rise-in var(--dur) var(--ease-out) both;
  }

  .site-header[data-mode='image'] .mobile__panel {
    background: rgba(13, 15, 16, 0.94);
  }

  .mobile__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .mobile__link {
    display: block;
    padding: 0.8rem 0.85rem;
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    color: var(--nav-ink);
  }

  .mobile__link:hover {
    color: var(--nav-ink);
    background: color-mix(in srgb, var(--nav-ink) 8%, transparent);
  }

  .mobile__ctas {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px solid color-mix(in srgb, var(--nav-line) 60%, transparent);
  }

  .mobile__ctas .nav__cta {
    width: 100%;
  }

  @media (min-width: 60rem) {
    .nav {
      display: block;
    }

    .mobile {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link,
    .nav__cta,
    .mobile__toggle {
      transition: none;
    }
  }
</style>
