---
/**
 * The Road Here: one photograph slot (Phase 3A draft).
 *
 * Give it an asset id from assets.json (road-*). Once the entry has a file and is
 * approved, it renders the optimized photograph at the entry's aspect ratio.
 * Until then it renders a quiet, labeled placeholder at the same ratio, in every
 * build: this page is an unlisted draft, and the placeholders show where each
 * photograph goes. Swapping in a photograph needs no change here or in the page.
 */
import { Picture } from 'astro:assets';
import { getAsset, isRenderable, resolveImage, aspectToCss } from '@lib/assets';

interface Props {
  id: string;
  class?: string;
  sizes?: string;
  priority?: boolean;
  /** Gentle vertical drift with the scroll (motion allowed only). */
  drift?: boolean;
  /** A cut-out object on a transparent background (V1.10): no frame, fill or crop, a soft shadow under it. */
  bare?: boolean;
  /** Inline style (custom properties such as --rot). */
  style?: string;
}

const { id, class: className, sizes = '(min-width: 64rem) 50vw, 100vw', priority = false, drift = false, bare = false, style: extra = '' } = Astro.props;
const entry = getAsset(id);
const image = resolveImage(entry);
const real = isRenderable(entry) && Boolean(image);
const ratio = aspectToCss(entry.aspect);
// Responsive delivery (V1.7): a few widths up to the derivative's own, never upscaled.
const widths = image ? [480, 800, 1200, 1600, 2048].filter((w) => w < image.width).concat(image.width) : undefined;
---

<figure class:list={['rf', real ? 'rf--real' : 'rf--pending', { 'rf--bare': bare }, className]} style={`--rf-ratio: ${ratio};${extra}`} data-asset={id}>
  <div class="rf__frame" data-road-drift={drift ? '' : undefined}>
    {
      real && image ? (
        <Picture src={image} alt={entry.alt} sizes={sizes} widths={widths} formats={['avif', 'webp']} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} class="rf__img" />
      ) : (
        <div class="rf__ph" role="img" aria-label={`Photograph to come: ${entry.label}`}>
          <span class="rf__ph-label">{entry.label}</span>
          <span class="rf__ph-ratio">{entry.aspect}</span>
        </div>
      )
    }
  </div>
</figure>

<style>
  .rf {
    margin: 0;
  }

  .rf__frame {
    position: relative;
    aspect-ratio: var(--rf-ratio);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-sunk);
  }

  .rf__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A cut-out artifact: the object itself, whole, resting with a soft shadow. */
  .rf--bare .rf__frame {
    overflow: visible;
    border-radius: 0;
    background: none;
  }

  .rf--bare .rf__img {
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.22)) drop-shadow(0 2px 3px rgb(0 0 0 / 0.18));
  }

  /* Gentle image movement: a real photograph is set a little larger than its frame and drifts with the scroll
     (the page script writes --drift); only with motion allowed and scripts running. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rf__frame[data-road-drift] .rf__img {
      scale: 1.08;
      translate: 0 var(--drift, 0px);
      will-change: translate;
    }
  }

  /* The placeholder: a fine diagonal hatch in the surface's own line color, with
     the slot's subject and ratio set small in its corner. */
  .rf__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    background:
      repeating-linear-gradient(135deg, transparent 0 11px, var(--line) 11px 12px),
      var(--bg-sunk);
    border: 1px solid var(--line);
    border-radius: inherit;
  }

  .rf__ph-label,
  .rf__ph-ratio {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .rf__ph-ratio {
    font-weight: 500;
    letter-spacing: 0.08em;
  }
</style>
