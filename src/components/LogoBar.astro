---
/**
 * Monochrome credibility bar. Renders approved logo files when present,
 * otherwise a text wordmark in the same slot, so a later logo swap does not
 * reflow the band. Relationship captions keep employers, products and
 * co-sponsors clearly distinguished.
 *
 * In Version 1.5 the bar closes the About section rather than standing alone,
 * so it is rendered `embedded`: no section of its own, no background, just a
 * rule above it and the entries on the surrounding surface.
 *
 * Version 1.6 moves it out of About into its own compact band between About
 * and Selected Work (`band`): a full-width section on the pale slate surface,
 * so it reads as a transition rather than another layer of About. It also
 * centers the composition: the heading, each mark within its
 * slot, and each relationship label beneath its mark. Desktop keeps every
 * entry in one row; narrower screens wrap into rows of four or two with the
 * short last row centered, so the grid stays balanced.
 */
import { Image } from 'astro:assets';
import { logos, resolveLogoImage } from '@lib/assets';

interface Props {
  /** Rendered inside another section: no section of its own, just a rule above. */
  embedded?: boolean;
  /** Its own full-width transition band on the `band` surface. */
  band?: boolean;
}

const { embedded = false, band = false } = Astro.props;

// Wordmarks and square marks need different heights to read at the same weight,
// so each logo is measured at build time rather than forced to one height.
const items = logos.logos
  .filter((l) => l.inBar)
  .map((l) => {
    const img = resolveLogoImage(l);
    return { logo: l, img, isMark: img ? img.width / img.height < 1.6 : false };
  });

const Tag = embedded ? 'div' : 'section';
// As its own section the heading is a section heading; inside another it is one level down.
const Heading = embedded ? 'h3' : 'h2';
---

<Tag
  class:list={['logobar', embedded && 'logobar--embedded', band && 'logobar--band']}
  data-surface={band ? 'band' : undefined}
  aria-labelledby="logobar-heading"
>
  <div class:list={[!embedded && 'container']}>
    <Heading id="logobar-heading" class="eyebrow eyebrow--muted logobar__heading">{logos.heading}</Heading>
    <ul class="logobar__list" style={`--count: ${items.length}`}>
      {
        items.map(({ logo, img, isMark }) => (
          <li class="logobar__item">
            <span class="logobar__slot">
              {img ? (
                <Image
                  src={img}
                  alt={logo.name}
                  height={isMark ? 46 : 26}
                  class:list={['logobar__img', isMark && 'logobar__img--mark']}
                  loading="lazy"
                />
              ) : (
                <span class="logobar__wordmark">{logo.name}</span>
              )}
            </span>
            <span class="logobar__rel">{logo.relationship}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Tag>

<style>
  .logobar {
    border-block: 1px solid var(--line);
    padding-block: var(--space-6);
  }

  /* Compact: the band is a pause between two chapters, not a chapter. */
  .logobar--band {
    border-block: 0;
    padding-block: clamp(1.75rem, 1.1rem + 1.8vw, 2.9rem);
  }

  .logobar--embedded {
    border-block: 0;
    border-top: 1px solid var(--line);
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) 0;
  }

  .logobar__heading {
    margin-bottom: clamp(1.25rem, 0.9rem + 1.2vw, 1.85rem);
    text-align: center;
  }

  /* Flex rather than grid so a short last row centers itself. */
  .logobar__list {
    --cols: 2;
    --col-gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-5) var(--col-gap);
  }

  /* Two fixed rows so every relationship label sits on the same baseline,
     however tall or short the mark above it is. */
  .logobar__item {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--col-gap)) / var(--cols));
    display: grid;
    grid-template-rows: 3rem auto;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
    min-width: 0;
  }

  /* The slot spans its column, so a mark can never be wider than the cell it
     sits in, and it is a size container so the text wordmark can fit itself. */
  .logobar__slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 3rem;
    min-width: 0;
    container-type: inline-size;
  }

  .logobar__wordmark {
    font-family: var(--font-sans);
    font-weight: 700;
    /* "Ambur Marketplace" runs about 9.2 of its own ems; above ~10.5% of the
       cell width it would break onto two lines in the narrow one-row layouts. */
    font-size: min(clamp(0.95rem, 0.85rem + 0.3vw, 1.1rem), 10.5cqi);
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--ink);
    opacity: 0.8;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .logobar__item:hover .logobar__wordmark {
    opacity: 1;
  }

  /* Supplied logos arrive in their own brand colors, several of them white
     artwork that would be invisible on a light ground. brightness(0) flattens
     every mark to one silhouette, which keeps the bar monochrome and legible
     without editing each file. */
  .logobar__item :global(.logobar__img) {
    height: 26px;
    width: auto;
    max-width: min(140px, 100%);
    object-fit: contain;
    filter: brightness(0);
    opacity: 0.78;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .logobar__item :global(.logobar__img--mark) {
    height: 44px;
    max-width: min(64px, 100%);
  }

  .logobar__item:hover :global(.logobar__img) {
    opacity: 1;
  }

  .logobar__rel {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (min-width: 40rem) {
    .logobar__list {
      --cols: 4;
    }
  }

  /* One row of all entries once each has at least ~9rem to breathe. */
  @media (min-width: 72rem) {
    .logobar__list {
      --cols: var(--count);
    }
  }
</style>
