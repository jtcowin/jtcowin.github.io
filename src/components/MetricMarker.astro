---
/**
 * Compact metric marker driven by the asset manifest (type: metric).
 * Static by design: no counting animation.
 */
import { getAsset } from '@lib/assets';

interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
const entry = getAsset(id);
---

<div class:list={['metric-marker', className]} role="group" aria-label={entry.alt}>
  <span class="metric-marker__dot" aria-hidden="true"></span>
  <span class="metric-marker__value serif">{entry.value}</span>
  <span class="metric-marker__label">{entry.metricLabel}</span>
</div>

<style>
  .metric-marker {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.6rem;
    align-items: baseline;
    padding: 0.85rem 1.1rem 0.9rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    min-width: 11.5rem;
  }

  .metric-marker__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    align-self: center;
    grid-row: 1;
  }

  .metric-marker__value {
    grid-row: 1;
    font-size: 1.85rem;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: lining-nums;
  }

  .metric-marker__label {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 1.35;
  }
</style>
