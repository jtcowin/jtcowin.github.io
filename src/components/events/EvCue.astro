---
/**
 * A section's cue (Events, V1.0; V1.1 reads the stages from events.json now
 * that the run of show has become the transition's one phrase): five small
 * squares, one per stage (Secure, Build, Capture, Cut, Amplify), the stages
 * this section covers lit, and their names.
 */
import events from '@data/events.json';

interface Props {
  keys: string[];
  class?: string;
}

const { keys, class: className } = Astro.props;
const stages = events.stages;
const lit = stages.map((s) => keys.includes(s.key));
const names = stages.filter((s) => keys.includes(s.key)).map((s) => s.label);
---

<p class:list={['ev-cue', className]}>
  <span class="ev-cue__tally" aria-hidden="true">{lit.map((on) => <span class:list={['ev-cue__sq', on && 'is-lit']} />)}</span>
  <span class="ev-cue__names">
    <span class="sr-only">{names.length > 1 ? 'Stages' : 'Stage'}: </span>
    {names.join(' · ')}
  </span>
</p>

<style>
  .ev-cue {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ev-cue__tally {
    display: inline-flex;
    gap: 3px;
  }

  .ev-cue__sq {
    width: 7px;
    height: 7px;
    border-radius: 1px;
    border: 1px solid var(--line-strong);
  }

  .ev-cue__sq.is-lit {
    border-color: var(--accent);
    background: var(--accent);
  }

  .ev-cue__names {
    color: var(--accent-ink);
  }
</style>
