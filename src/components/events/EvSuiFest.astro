---
/**
 * 06 Sui Fest (Events, V1.1): faster, more social, outward-facing. The
 * headline, the story in one paragraph (not a sponsor, so the moment had to
 * be made), and the Sui Fest video itself at the full measure, muted by
 * default: it plays silently while well in view (with motion allowed) and the
 * reader turns the sound on. Then three stills, each a different idea (the
 * interviewer at a team's booth, Bolt as one voice among many, the color of
 * the floor), and one compact outcome block that holds how the piece traveled
 * and what it did, in the brief's words only: exact figures appear only once
 * verified (an authoring placeholder until then; approved with its value in
 * assets.json, the figure joins the block). One credit block for the chapter.
 * V1.1 took out the chapter list of teams and its timestamps, the stills'
 * timecodes and the line-and-node path.
 */
import events from '@data/events.json';
import EvCue from './EvCue.astro';
import EvCredits from './EvCredits.astro';
import EvExtras from './EvExtras.astro';
import EvPlayer from './EvPlayer.astro';
import EvSlot from './EvSlot.astro';

const { suifest: s } = events;
---

<section class="evf" id="ev-suifest" data-surface="dark" aria-labelledby="ev-suifest-title">
  <div class="container evf__inner">
    <div class="evf__head">
      <EvCue keys={s.cues} />
      <p class="eyebrow evf__eyebrow">{s.eyebrow}</p>
      <h2 id="ev-suifest-title" class="display evf__title" data-ev-reveal>
        <span class="ev-cut"><span>{s.headline}</span></span>
      </h2>
      <p class="evf__copy">{s.copy}</p>
    </div>

    <EvPlayer id={s.video} label="Sui Fest interviews" domId="ev-suifest-player" class="evf__player" ambient />

    <ul class="evf__stills" aria-label="Stills from the video">
      {
        s.stills.map((id) => (
          <li class="evf__still">
            <EvSlot id={id} sizes="(min-width: 60rem) 33vw, (min-width: 40rem) 50vw, 100vw" />
          </li>
        ))
      }
    </ul>

    <div class="evf__outcome">
      <p class="evf__label">{s.outcome.label}</p>
      <p class="evf__lead">{s.outcome.lead}</p>
      <p class="evf__line">{s.outcome.line}</p>
      <EvExtras ids={s.pending} bare />
    </div>

    <EvCredits items={s.credits} class="evf__credits" />
  </div>
</section>

<style>
  .evf {
    padding-block: var(--section-y);
  }

  .evf__inner {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .evf__head {
    display: grid;
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  .evf__eyebrow {
    color: var(--accent);
  }

  .evf__title {
    max-width: 20ch;
    font-size: var(--text-3xl);
    line-height: 0.95;
  }

  .evf__copy {
    max-width: 44rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---- three stills, each its own idea ------------------------------------------------- */
  .evf__stills {
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .evf__stills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .evf__still:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60rem) {
    .evf__stills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .evf__still:first-child {
      grid-column: auto;
    }
  }

  /* ---- the outcome: how it traveled and what it did, in one block ------------------------- */
  .evf__outcome {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
  }

  .evf__label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .evf__lead {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-xl);
    line-height: 1.12;
    color: var(--heading);
    text-wrap: balance;
  }

  .evf__line {
    max-width: 38rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .evf__credits {
    max-width: 52rem;
  }
</style>
