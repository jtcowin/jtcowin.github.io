---
/**
 * 04 Command the room (Events, V1.0, kept in V1.1): the Sui Summit
 * presentation. The headline in three beats, one line of context, and the
 * presentation itself as the dominant visual (the session's opening, with
 * sound, at full width). Then three chapters of the work, Fill, Run and
 * Extend, that arrive in turn along one line as they come into view, and the
 * public-safe outcome. Its credits joined the one block for the Sui Summit
 * work at ETHDenver, which closes the production room (V1.1). The full
 * recording, a deck preview, the promotional post and a short extracted clip
 * are placeholders (authoring only) until their files and hosting are
 * settled; each appears in its slot once approved.
 */
import events from '@data/events.json';
import EvCue from './EvCue.astro';
import EvExtras from './EvExtras.astro';
import EvPlayer from './EvPlayer.astro';

const { room } = events;
const beats = room.headline.split(/(?<=[.!?])\s+/);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="evm" id="ev-room" data-surface="dark" aria-labelledby="ev-room-title">
  <div class="container evm__inner">
    <div class="evm__head">
      <div class="evm__heading">
        <EvCue keys={room.cues} />
        <h2 id="ev-room-title" class="display evm__title" data-ev-reveal>
          {
            beats.map((b, i) => [
              i ? ' ' : '',
              <span class="ev-cut" style={`--k: ${i}`}>
                <span>{b}</span>
              </span>,
            ])
          }
        </h2>
      </div>
      <div class="evm__intro">
        <p class="eyebrow evm__eyebrow">{room.eyebrow}</p>
        <p class="evm__copy">{room.copy}</p>
      </div>
    </div>

    <EvPlayer id={room.video} label="Sui Summit presentation" class="evm__player" domId="ev-room-player" />

    <ol class="evm__chapters" data-ev-reveal>
      {
        room.chapters.map((c, i) => (
          <li class="evm__chapter" style={`--i: ${i}`}>
            <p class="evm__chapter-head">
              <span class="evm__chapter-n" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <span class="evm__chapter-label">{c.label}</span>
            </p>
            <ul class="evm__points">
              {c.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="evm__close">
      <p class="evm__outcome">{room.outcome}</p>
    </div>

    <EvExtras ids={room.pending} class="evm__pending" />
  </div>
</section>

<style>
  .evm {
    padding-block: var(--section-y);
  }

  .evm__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .evm__head {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .evm__heading {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .evm__title {
    font-size: var(--text-3xl);
    line-height: 0.95;
  }

  .evm__title :global(.ev-cut) {
    display: block;
  }

  .evm__title :global(.ev-cut:nth-child(2)) {
    color: var(--accent-ink);
  }

  .evm__intro {
    display: grid;
    gap: 0.75rem;
    align-content: end;
  }

  .evm__eyebrow {
    color: var(--accent);
  }

  .evm__copy {
    max-width: 30rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
  }

  /* ---- the chapters: Fill, Run, Extend ------------------------------------------------- */
  .evm__chapters {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evm__chapter {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
    position: relative;
  }

  /* The line of light along each chapter's rule. */
  .evm__chapter::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 1px;
    background: var(--accent-ink);
    transform-origin: left center;
  }

  .evm__chapter-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
  }

  .evm__chapter-n {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
  }

  .evm__chapter-label {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--heading);
  }

  .evm__points {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .evm__points li {
    position: relative;
    padding-left: 1rem;
  }

  .evm__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: var(--ink-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .evm__chapters:not(.is-in) .evm__chapter {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }

    :global(html.js) .evm__chapters:not(.is-in) .evm__chapter::before {
      transform: scaleX(0);
    }

    :global(html.js) .evm__chapter {
      transition:
        opacity 0.6s var(--ease-out) calc(var(--i) * 0.28s),
        transform 0.7s var(--ease-out) calc(var(--i) * 0.28s);
    }

    :global(html.js) .evm__chapter::before {
      transition: transform 0.7s cubic-bezier(0.45, 0, 0.25, 1) calc(0.15s + var(--i) * 0.28s);
    }
  }

  .evm__close {
    display: grid;
    gap: 2rem;
  }

  .evm__outcome {
    max-width: 40rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-xl);
    line-height: 1.12;
    color: var(--heading);
    text-wrap: balance;
  }

  .evm__pending {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 60rem) {
    .evm__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      column-gap: clamp(2rem, 4vw, 5rem);
    }

    .evm__chapters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

  }
</style>
