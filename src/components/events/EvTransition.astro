---
/**
 * 02 The transition (Events, V1.1, replacing the run of show): the five
 * stages of the work as one phrase, SECURE. BUILD. CAPTURE. CUT. AMPLIFY.,
 * carrying the hero's dark ground into the page. As the reader scrolls out of
 * the hero, the phrase settles at the middle of the screen and its words
 * arrive one after another (a short wipe), over about seven tenths of a
 * screen of scrolling; the words already there stay, nothing else moves. A
 * short hold to read it, then straight into "The work starts before anyone
 * enters the room." as the phrase fades away. One centered line on wide
 * screens, two deliberate lines on small ones (after the third word). No
 * lines, nodes, numbers or paragraphs. With reduced motion (or without
 * JavaScript) the whole phrase is simply there, and fades as the next section
 * arrives.
 *
 * V1.3: the broadcast signal after AMPLIFY. (the approved Option A, in the
 * solid tile treatment of John's reference): a square tile in the accent, set
 * in the line like punctuation, a little taller than the capitals, with a
 * point and two pairs of arcs inside in outline weight. It is punctuation, not
 * a button, and is hidden from assistive technology (the phrase reads as
 * before). As the reader scrolls, it arrives once the last word is in: the
 * tile wipes in like the words, the point and the arcs open outward, one
 * restrained pulse leaves the tile, and it settles; nothing loops. If the
 * reader scrolls back above the last word it steps away, and arrives again
 * when the phrase completes. With reduced motion it is simply there.
 */
import events from '@data/events.json';

const words = events.stages.map((s) => `${s.label}.`);
const cut = events.transition.break;
const lines = [words.slice(0, cut), words.slice(cut)];
const phrase = words.join(' ');
---

<div class="evx" data-surface="dark" data-ev-transition>
  <div class="evx__pin">
    <div class="container evx__frame">
      <p class="display evx__phrase" data-evx-phrase>
        <span class="sr-only">{phrase}</span>
        {
          lines.map((line, k) => [
            k ? ' ' : '',
            <span class="evx__line" aria-hidden="true">
              {line.map((w, i) => [
                i ? ' ' : '',
                k === lines.length - 1 && i === line.length - 1 ? (
                  <span class="evx__tail"><span class="evx__word" data-word>{w}</span><span class="evx__signal" data-evx-signal><span class="evx__pulse" /><span class="evx__tile"><svg class="evx__glyph" viewBox="0 0 24 24" focusable="false"><circle class="evx__g evx__g--point" cx="12" cy="12" r="2" /><path class="evx__g evx__g--near" d="M8.6 8.6a4.8 4.8 0 0 0 0 6.8M15.4 8.6a4.8 4.8 0 0 1 0 6.8" /><path class="evx__g evx__g--far" d="M5.8 5.8a8.8 8.8 0 0 0 0 12.4M18.2 5.8a8.8 8.8 0 0 1 0 12.4" /></svg></span></span></span>
                ) : (
                  <span class="evx__word" data-word>{w}</span>
                ),
              ])}
            </span>,
          ])
        }
      </p>
    </div>
  </div>
</div>

<script>
  import { reducedMotion, onMotionChange } from '@lib/ev-media';

  const root = document.querySelector<HTMLElement>('[data-ev-transition]');
  if (root) {
    const words = Array.from(root.querySelectorAll<HTMLElement>('[data-word]'));
    const phrase = root.querySelector<HTMLElement>('[data-evx-phrase]');
    // The signal after AMPLIFY. (V1.3) arrives with the last word (its own
    // delay lets the word land first) and steps away if the reader scrolls back.
    const signal = root.querySelector<HTMLElement>('[data-evx-signal]');
    // In shares of the screen's height, by the section's top edge: the first
    // word arrives just before the phrase settles at the middle of the screen
    // (the top at 0.15), the last 0.7 of a screen later; the phrase holds
    // until the top is 0.78 above the screen, then the section moves on.
    const START = 0.15;
    const TRAVEL = 0.7;
    const UNPIN = 0.78;
    const OUT = 0.35;
    let near = false;
    let raf = 0;
    const span = (v: number, a: number, b: number) => Math.min(1, Math.max(0, (v - a) / (b - a)));

    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      const top = root.getBoundingClientRect().top / vh;
      const live = root.classList.contains('is-live');
      if (live) {
        const p = (START - top) / TRAVEL;
        words.forEach((w, i) => w.classList.toggle('is-on', p >= i / (words.length - 1)));
        signal?.classList.toggle('is-on', p >= 1);
      }
      // Leaving: the phrase fades as it rises out (from 35% of the screen to
      // 5%), while the next section comes up beneath it.
      if (phrase) {
        const r = phrase.getBoundingClientRect();
        const center = (r.top + r.height / 2) / vh;
        const fade = span(OUT - center, 0, OUT - 0.05);
        phrase.style.opacity = fade > 0 ? (1 - fade).toFixed(3) : '';
      }
    };
    const queue = () => {
      if (near && !raf) raf = requestAnimationFrame(update);
    };
    const apply = () => {
      const live = !reducedMotion();
      root.classList.toggle('is-live', live);
      root.style.setProperty('--evx-run', String(1 + UNPIN));
      if (!live) for (const w of words) w.classList.add('is-on');
      queue();
    };
    apply();
    onMotionChange(apply);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          near = e.isIntersecting;
          queue();
        },
        { rootMargin: '50% 0px' },
      ).observe(root);
    } else near = true;
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
  }
</script>

<style>
  .evx {
    --view-h: 100vh;
    position: relative;
  }

  @supports (height: 1svh) {
    .evx {
      --view-h: 100svh;
    }
  }

  /* At rest (reduced motion, no JavaScript): the phrase, whole, in a calm band. */
  .evx__pin {
    display: grid;
    align-items: center;
    min-height: calc(var(--view-h) * 0.62);
    padding-block: clamp(4rem, 12vh, 8rem);
  }

  .evx__frame {
    container-type: inline-size;
  }

  .evx__phrase {
    margin: 0;
    text-align: center;
    text-transform: uppercase;
    /* sized so the longer small-screen line (the first three words, about
       11.5em) fits the measure */
    font-size: clamp(1.375rem, 8cqi, 4.25rem);
    line-height: 1.04;
    letter-spacing: 0.005em;
    color: var(--heading);
  }

  /* Two deliberate lines on a small screen; one line where it fits. */
  .evx__line {
    display: block;
  }

  .evx__word {
    display: inline-block;
  }

  @media (min-width: 48rem) {
    .evx__line {
      display: inline;
    }

    .evx__phrase {
      font-size: min(4.8cqi, 6rem);
      white-space: nowrap;
    }
  }

  /* Live: the section is as tall as its reading; the phrase holds at the middle
     of the screen while its words arrive. */
  .evx.is-live {
    height: calc(var(--view-h) * var(--evx-run, 1.78));
  }

  .evx.is-live .evx__pin {
    position: sticky;
    top: 0;
    height: var(--view-h);
    min-height: 0;
    padding-block: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .evx.is-live .evx__word {
      opacity: 0;
      clip-path: inset(-0.2em 100% -0.2em 0);
      transition:
        clip-path 0.6s cubic-bezier(0.2, 0.75, 0.2, 1),
        opacity 0.45s ease;
    }

    .evx.is-live .evx__word.is-on {
      opacity: 1;
      clip-path: inset(-0.2em -0.2em -0.2em -0.2em);
    }
  }

  /* ---- the signal after AMPLIFY. (V1.3): a solid tile in the accent, set in the
     line like punctuation (a little taller than the capitals, sitting on the line
     the way the word does), with the broadcast glyph in outline weight ----------- */
  .evx__tail {
    white-space: nowrap;
  }

  .evx__signal {
    position: relative;
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-left: 0.26em;
    vertical-align: -0.1em;
  }

  .evx__tile {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 0.04em;
    background: var(--accent);
    color: var(--heading);
  }

  .evx__glyph {
    display: block;
    width: 72%;
    height: 72%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .evx__g {
    transform-box: view-box;
    transform-origin: 12px 12px;
  }

  .evx__g--point {
    fill: currentColor;
    stroke: none;
  }

  .evx__pulse {
    position: absolute;
    inset: 0;
    border-radius: 0.04em;
    box-shadow: 0 0 0 0.045em var(--accent-ink);
    opacity: 0;
    pointer-events: none;
  }

  /* Live, with motion allowed: it waits until the last word is in, then the tile
     wipes in as the words do, the point and the arcs open outward, and one
     restrained pulse leaves the tile (once: nothing repeats). With reduced motion
     none of this applies and the signal is simply there. */
  @media (prefers-reduced-motion: no-preference) {
    .evx.is-live .evx__tile {
      clip-path: inset(0 100% 0 0);
    }

    .evx.is-live .evx__g {
      opacity: 0;
    }

    .evx.is-live .evx__signal.is-on .evx__tile {
      animation: evx-tile 0.45s cubic-bezier(0.2, 0.75, 0.2, 1) 0.3s both;
    }

    .evx.is-live .evx__signal.is-on .evx__g--point {
      animation: evx-point 0.26s cubic-bezier(0.2, 0.7, 0.3, 1) 0.62s both;
    }

    .evx.is-live .evx__signal.is-on .evx__g--near {
      animation: evx-arc 0.38s cubic-bezier(0.2, 0.7, 0.3, 1) 0.74s both;
    }

    .evx.is-live .evx__signal.is-on .evx__g--far {
      animation: evx-arc 0.38s cubic-bezier(0.2, 0.7, 0.3, 1) 0.86s both;
    }

    .evx.is-live .evx__signal.is-on .evx__pulse {
      animation: evx-pulse 0.95s cubic-bezier(0.2, 0.7, 0.3, 1) 1.2s forwards;
    }
  }

  @keyframes evx-tile {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes evx-point {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes evx-arc {
    from {
      opacity: 0;
      transform: scale(0.55);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes evx-pulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
</style>
