---
/**
 * 01 Hero (Events and Multimedia Production, V1.2). The approved headline and
 * paragraph, then one editorial reel in place of V1.1's three programs and
 * their control (LIVE, CONVERSATIONS, PRODUCED are gone, with their buttons).
 *
 * The composition is an implementation trial (the V1.2 brief), to be judged in
 * the deployed preview: the kicker above; one header row with the headline on
 * the left (about 63% of the width) and the paragraph on the right (about 33%),
 * set against the headline's lower lines; then the reel beneath, as wide as the
 * content, in a wide cinematic frame (2.2:1; 2.4:1 on shorter wide screens,
 * so the whole reel stays within the first screen on most laptops; 16:9 on
 * narrow screens, where the three stack in that order).
 *
 * The reel: the chapters of events.json in order, each one video, muted,
 * played through once and crossfaded (350ms) into the next, round and round.
 * The label at the frame's top left reads the chapter's number and title
 * (01 / TECHNICAL EXPLAINER), the same through every cut inside the chapter;
 * chapters are numbered among those whose video is approved and present, so a
 * pending chapter (the team interview) is simply absent, with no placeholder,
 * until its video arrives. The production accents stay: the corner brackets,
 * the label, the running timecode at the top right (the reel's own clock), the
 * pause control, and one small segmented progress rail along the bottom edge,
 * a segment to a chapter, with no words beneath it. Only the pause control:
 * no next, previous or category buttons. The reel pauses off screen and in a
 * hidden tab; with reduced motion or a data-saving preference it rests on a
 * strong poster frame and shows an explicit Play control. Each chapter's crop
 * of the wide frame is set in events.json (`pos`).
 *
 * V1.4, a restrained program monitor, nothing more: beside the label a small
 * steady tally dot (lit while the reel plays, never blinking) and the word
 * PROGRAM (PROGRAM · 01 / TECHNICAL EXPLAINER); TC before the running counter
 * (TC 00:00:04:22); the rail along the bottom inside edge as a sequence
 * timeline, a segment to each chapter at its length (so a fifth chapter takes
 * its place on its own), completed, active and upcoming segments told apart by
 * a quiet difference in opacity, and one thin playhead moving through the
 * active one (it shows where the reel is; it is not a scrubber). On hover with
 * a fine pointer, or with keyboard focus inside the frame, faint title-safe
 * corner marks (the classic 80% area) fade in, and out as the pointer or focus
 * leaves; never on touch-only screens, and with reduced motion they simply
 * appear. No REC, meters, grain, flicker, crosshair or other decoration.
 */
import { getImage } from 'astro:assets';
import events from '@data/events.json';
import { getAsset, isVisible, resolveImage } from '@lib/assets';
import { withBase } from '@lib/paths';
import { emphasize } from '@lib/tpm-copy';
import Icon from '@components/Icon.astro';

const { hero } = events;
const { monitor } = hero;
const title = emphasize(hero.headline, hero.accent, 'events hero headline');

const prepared = await Promise.all(
  hero.chapters.map(async (ch) => {
    const entry = getAsset(ch.asset);
    if (!(isVisible(entry) && entry.type === 'video' && entry.file)) return null;
    const still = resolveImage(entry);
    const poster = still ? await getImage({ src: still, width: Math.min(1600, still.width), format: 'webp', quality: 80 }) : null;
    return { ...ch, entry, poster: poster?.src, src: withBase(`/media/${entry.file}`), duration: Number(entry.duration) || 0 };
  }),
);
// A chapter whose video is pending is left out entirely (in development too:
// the live hero never shows a placeholder); the rest are numbered in order.
const chapters = prepared.filter((c): c is NonNullable<typeof c> => Boolean(c)).map((c, i) => ({ ...c, number: String(i + 1).padStart(2, '0') }));
const first = chapters[0];
if (!first) throw new Error('[events] the hero reel needs at least one approved chapter (events.json hero.chapters, assets.json)');
---

<section class="evh" data-surface="dark" aria-labelledby="ev-title">
  <div class="container evh__inner">
    <p class="evh__kicker ev-in" style="--in: 0">
      <span class="evh__tally" aria-hidden="true"></span>
      {hero.kicker}
    </p>
    <header class="evh__head">
      <h1 id="ev-title" class="display evh__title ev-in" style="--in: 1">
        {title.map(({ text, em }) => (em ? <span class="ev-accent">{text}</span> : text))}
      </h1>
      <p class="lede evh__lede ev-in" style="--in: 2">{hero.copy}</p>
    </header>

    <div class="evh__reel ev-in" style="--in: 3" data-ev-reel data-active={first.key}>
      <div class="evh__frame">
        {
          chapters.map((ch, i) => (
            <div
              class:list={['evh__layer', i === 0 && 'is-on is-in', ch.fitNarrow === 'contain' && 'evh__layer--contain']}
              data-chapter-layer={ch.key}
              data-number={ch.number}
              data-title={ch.title}
              data-duration={ch.duration}
              style={`--pos: ${ch.pos ?? '50% 50%'}`}
            >
              <video class="evh__video" data-chapter={ch.key} muted playsinline preload="none" controls poster={ch.poster} aria-label={ch.entry.alt}>
                <source src={ch.src} type="video/mp4" />
              </video>
            </div>
          ))
        }
        <span class="evh__safe" aria-hidden="true"></span>
        <div class="evh__hud" aria-hidden="true">
          <span class="evh__reading">
            <span class="evh__dot"></span>
            <span class="evh__bus">{monitor.program}</span>
            <span class="evh__sep">·</span>
            <span data-reel-label>{first.number} / {first.title}</span>
          </span>
          <span class="evh__tc"><span class="evh__tc-key">{monitor.timecode}</span><span data-reel-tc>00:00:00:00</span></span>
        </div>
        <button type="button" class="evh__toggle" data-reel-toggle data-pause={hero.pause} data-play={hero.play} aria-label={hero.play} data-state="paused">
          <span class="evh__ico evh__ico--pause"><Icon name="pause" size={12} /></span>
          <span class="evh__ico evh__ico--play"><Icon name="play" size={12} /></span>
          <span class="evh__toggle-text">{hero.playShown}</span>
        </button>
        <span class="evh__rail" aria-hidden="true" data-reel-rail>
          {
            chapters.map((ch, i) => (
              <span class="evh__seg" data-reel-seg={ch.key} data-state={i === 0 ? 'active' : 'next'} style={`--w: ${ch.duration > 0 ? ch.duration.toFixed(2) : 1}`} />
            ))
          }
          <span class="evh__playhead" data-reel-head />
        </span>
      </div>
      <span class="evh__crop evh__crop--tl" aria-hidden="true"></span>
      <span class="evh__crop evh__crop--tr" aria-hidden="true"></span>
      <span class="evh__crop evh__crop--bl" aria-hidden="true"></span>
      <span class="evh__crop evh__crop--br" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script>
  import { Reel } from '@lib/ev-media';
  const root = document.querySelector<HTMLElement>('[data-ev-reel]');
  if (root) new Reel(root);
</script>

<style>
  .evh {
    --view-h: 100vh;
    position: relative;
    padding-block: calc(var(--header-row) + clamp(0.75rem, 2.5vh, 2.5rem)) clamp(2.5rem, 6vh, 4.5rem);
  }

  @supports (height: 1svh) {
    .evh {
      --view-h: 100svh;
    }
  }

  .evh__inner {
    display: grid;
    gap: clamp(1rem, 2.4vh, 2.25rem);
  }

  .evh__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  /* A tally light: lit while the reel runs. */
  .evh__tally {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(79, 145, 138, 0.22);
  }

  /* ---- the header row: the headline, then the paragraph (side by side on wide
     screens, the paragraph set against the headline's lower lines) ------------------- */
  .evh__head {
    display: grid;
    gap: clamp(1rem, 2.4vh, 1.5rem);
  }

  .evh__title {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 6.25rem);
    line-height: 0.96;
  }

  .ev-accent,
  .evh :global(.ev-accent) {
    color: var(--accent-ink);
  }

  .evh__lede {
    max-width: 34rem;
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1875rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---- the reel's frame: wide and cinematic (16:9 on narrow screens) ---------------- */
  .evh__reel {
    position: relative;
    min-width: 0;
  }

  .evh__frame {
    --hud-in: clamp(0.5rem, 1.4%, 1rem);
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 9;
    background: #050607;
    border-radius: var(--radius);
  }

  /* A faint shade along the bottom edge, so the rail reads on any picture. */
  .evh__frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 14%;
    border-radius: 0 0 var(--radius) var(--radius);
    background: linear-gradient(to top, rgba(5, 6, 7, 0.42), rgba(5, 6, 7, 0));
    pointer-events: none;
  }

  @media (min-width: 40rem) {
    .evh__frame {
      aspect-ratio: 2.2 / 1;
    }
  }

  /* One chapter shows at a time. Between chapters, a crossfade (350ms): the
     incoming chapter fades in over the outgoing one, which stays put beneath it
     until it is covered, then steps away unseen. */
  .evh__layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0.35s;
  }

  .evh__layer.is-on {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0s;
  }

  .evh__layer.is-in {
    z-index: 1;
  }

  /* Each chapter's crop of the wide frame (events.json `pos`). */
  .evh__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    background: #050607;
  }

  /* The presentation's own frame is wider than 16:9: whole, letterboxed, on narrow
     screens, set a little low, so the label rides on the band above the picture and
     the rail on the band beneath its captions. */
  @media (max-width: 39.99rem) {
    .evh__layer--contain .evh__video {
      object-fit: contain;
      object-position: 50% 70%;
    }
  }

  /* The frame's readings: the chapter at the top left, the timecode at the top
     right beside the pause control, on small dark chips. */
  .evh__hud {
    position: absolute;
    top: var(--hud-in);
    left: var(--hud-in);
    right: calc(var(--hud-in) + 1.75rem + 0.4rem);
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .evh__reading,
  .evh__tc {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.35em 0.65em;
    border-radius: 4px;
    background: rgba(13, 15, 16, 0.62);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    color: #edf0ef;
    backdrop-filter: blur(4px);
  }

  .evh__tc {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: #c3cacb;
  }

  /* The tally: a small steady dot, lit in the light accent while the reel plays
     (on program), unlit while it is paused or waiting. It never blinks. */
  .evh__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7e8995;
  }

  .evh__reel.is-playing .evh__dot {
    background: #9fc9c3;
  }

  .evh__bus {
    color: #c3cacb;
  }

  .evh__sep {
    color: #7e8995;
  }

  .evh__tc-key {
    color: #8f99a3;
    letter-spacing: 0.12em;
  }

  /* ---- the pause control, at the top right beside the timecode ---------------------- */
  .evh__toggle {
    position: absolute;
    top: calc(var(--hud-in) - 0.2rem);
    right: var(--hud-in);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid rgba(237, 240, 239, 0.3);
    border-radius: 999px;
    background: rgba(13, 15, 16, 0.62);
    color: #f2f1ec;
    backdrop-filter: blur(4px);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .evh__toggle:hover {
    background: rgba(13, 15, 16, 0.85);
  }

  .evh__ico {
    display: none;
  }

  .evh__toggle[data-state='playing'] .evh__ico--pause,
  .evh__toggle[data-state='paused'] .evh__ico--play {
    display: grid;
  }

  /* Reduced motion, saving data or a refused autoplay: the reel waits on its
     poster, and the control, at the middle of the frame, says plainly that it
     plays. */
  .evh__toggle-text {
    display: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .evh__reel.is-waiting .evh__toggle {
    top: 50%;
    right: 50%;
    height: 2.75rem;
    padding-inline: 1rem 1.2rem;
    transform: translate(50%, -50%);
    background: rgba(13, 15, 16, 0.72);
  }

  .evh__reel.is-waiting .evh__toggle-text {
    display: inline;
  }

  /* ---- the sequence timeline, along the frame's bottom inside edge (V1.4): a segment
     to each chapter, as long as the chapter; completed, active and upcoming segments
     told apart by a quiet difference in opacity, and one thin playhead moving through
     the active one. Information, not a control: nothing to drag, no words. ---------- */
  .evh__rail {
    position: absolute;
    left: var(--hud-in);
    right: var(--hud-in);
    bottom: clamp(0.2rem, 0.8%, 0.45rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 9px;
    pointer-events: none;
  }

  .evh__seg {
    flex: var(--w, 1) 1 0px;
    height: 3px;
    border-radius: 1px;
    background: #edf0ef;
    opacity: 0.2;
    transition: opacity 0.35s ease;
  }

  .evh__seg[data-state='done'] {
    opacity: 0.42;
  }

  .evh__seg[data-state='active'] {
    opacity: 0.68;
  }

  .evh__playhead {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    margin-left: -1px;
    border-radius: 1px;
    background: #9fc9c3;
  }

  /* ---- title-safe guides (V1.4): four faint corner marks at the classic 80% area,
     only while a fine pointer is over the frame or the keyboard is inside it --------- */
  .evh__safe {
    --arm: clamp(0.75rem, 2.2cqi, 1.25rem);
    --mark: rgba(237, 240, 239, 0.1);
    position: absolute;
    inset: 10%;
    z-index: 2;
    background:
      linear-gradient(var(--mark), var(--mark)) left top / var(--arm) 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) left top / 1px var(--arm) no-repeat,
      linear-gradient(var(--mark), var(--mark)) right top / var(--arm) 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) right top / 1px var(--arm) no-repeat,
      linear-gradient(var(--mark), var(--mark)) left bottom / var(--arm) 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) left bottom / 1px var(--arm) no-repeat,
      linear-gradient(var(--mark), var(--mark)) right bottom / var(--arm) 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) right bottom / 1px var(--arm) no-repeat;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .evh__frame:hover .evh__safe,
    .evh__frame:has(:focus-visible) .evh__safe {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evh__safe,
    .evh__seg {
      transition: none;
    }
  }

  :global(html:not(.js)) .evh__toggle,
  :global(html:not(.js)) .evh__rail,
  :global(html:not(.js)) .evh__hud,
  :global(html:not(.js)) .evh__safe {
    display: none;
  }

  /* Smaller frames keep the tally, the label and the control: first the timecode
     steps aside, then, on the smallest, the word PROGRAM. */
  @container (max-width: 31rem) {
    .evh__tc {
      display: none;
    }
  }

  @container (max-width: 21.5rem) {
    .evh__bus,
    .evh__sep {
      display: none;
    }
  }

  /* Crop marks just outside the frame's corners. */
  .evh__crop {
    position: absolute;
    width: 0.9rem;
    height: 0.9rem;
    border: 0 solid var(--line-strong);
    pointer-events: none;
  }

  .evh__crop--tl {
    left: -0.65rem;
    top: -0.65rem;
    border-left-width: 1px;
    border-top-width: 1px;
  }

  .evh__crop--tr {
    right: -0.65rem;
    top: -0.65rem;
    border-right-width: 1px;
    border-top-width: 1px;
  }

  .evh__crop--bl {
    left: -0.65rem;
    bottom: -0.65rem;
    border-left-width: 1px;
    border-bottom-width: 1px;
  }

  .evh__crop--br {
    right: -0.65rem;
    bottom: -0.65rem;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  /* ---- entrance ----------------------------------------------------------------------- */
  .ev-in {
    animation: rise-in 700ms var(--ease-out) both;
    animation-delay: calc(60ms + var(--in, 0) * 90ms);
  }

  /* ---- wide screens: the header row, then the reel across ---------------------------- */
  @media (min-width: 60rem) {
    .evh {
      min-height: var(--view-h);
      display: grid;
      align-content: center;
    }

    .evh__head {
      grid-template-columns: minmax(0, 63fr) minmax(0, 33fr);
      column-gap: 4%;
      align-items: end;
    }

    .evh__title {
      max-width: none;
      font-size: min(clamp(2.6rem, 1.2rem + 4.6vw, 6.25rem), 8.4vh);
    }

    /* Set against the headline's lower lines (its last line on the headline's
       baseline), never taller than the headline beside it. */
    .evh__lede {
      max-width: none;
      padding-bottom: 0.3em;
      font-size: clamp(1rem, 0.3rem + 0.9vw, 1.1875rem);
      line-height: 1.45;
    }
  }

  /* Shorter wide screens (most laptops, 960px tall or less and wider than 3:2): a
     slightly wider cinematic frame (2.4:1, still the content's full width) and a
     tighter header, so the whole reel, its rail included, stays within the first
     screen. Each chapter's crop (`pos`) holds at both proportions. */
  @media (min-width: 60rem) and (min-aspect-ratio: 155/100) and (max-height: 60rem) {
    .evh {
      padding-top: calc(var(--header-row) + clamp(0.5rem, 1.2vh, 1.5rem));
    }

    .evh__inner {
      gap: clamp(0.75rem, 1.8vh, 1.5rem);
    }

    /* Never below 3.75rem, so the paragraph beside it stays within its height. */
    .evh__title {
      font-size: max(min(clamp(2.6rem, 1.2rem + 4.6vw, 6.25rem), 7.6vh), 3.75rem);
    }

    .evh__frame {
      aspect-ratio: 2.4 / 1;
    }
  }
</style>
