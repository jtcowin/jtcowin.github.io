---
/**
 * 01 Hero (Events and Multimedia Production, V1.1): the kicker and the
 * headline across the top like a title card; below, one program monitor
 * (16:9) beside the paragraph, and beneath the monitor one compact control
 * with the three program reels: Q01 LIVE (presentations and event
 * environments), Q02 CONVERSATIONS (interviews, podcasts and exchanges) and
 * Q03 PRODUCED (polished explainers and finished multimedia). The control
 * shows only each reel's cue and name; what each one means is read to
 * assistive technology with its button, never shown.
 *
 * Q01 is on first. Only the active reel is loaded and playing, muted; it
 * plays through and the program crossfades (350ms) to the next; a reel the
 * reader picks starts from its beginning, plays through, and then the program
 * carries on from it. The active cue carries a thin teal progress line; the
 * others stay muted gray. The corner crop marks, the cue reading and the
 * running timecode at the top of the monitor are the production accents. The
 * program pauses off screen and in a hidden tab, stays on its posters for
 * reduced motion or a data-saving preference (its control plays it on
 * request), and has its own pause control. On narrow screens the control
 * stacks into three compact rows. Reels and their order come from
 * events.json; the media from assets.json.
 */
import { getImage } from 'astro:assets';
import events from '@data/events.json';
import { getAsset, isVisible, resolveImage, SHOW_PLACEHOLDERS } from '@lib/assets';
import { withBase } from '@lib/paths';
import { emphasize } from '@lib/tpm-copy';
import Icon from '@components/Icon.astro';

const { hero } = events;
const title = emphasize(hero.headline, hero.accent, 'events hero headline');

const all = await Promise.all(
  hero.programs.map(async (pr) => {
    const entry = getAsset(pr.asset);
    const ready = isVisible(entry) && entry.type === 'video' && Boolean(entry.file);
    const still = resolveImage(entry);
    const poster = still ? await getImage({ src: still, width: Math.min(1600, still.width), format: 'webp', quality: 80 }) : null;
    return { ...pr, entry, ready, poster: poster?.src ?? null, src: ready ? withBase(`/media/${entry.file}`) : null };
  }),
);
// A reel whose video is not yet approved and present has no cue in a
// production build (in `npm run dev` it is a labeled placeholder), so the
// program never cuts to an empty monitor.
const reels = all.filter((s) => s.ready || SHOW_PLACEHOLDERS);
const def = reels.find((s) => s.key === hero.default) ?? reels[0];
if (!def) throw new Error('[events] the hero needs at least one approved program reel (events.json hero.programs, assets.json)');
---

<section class="evh" data-surface="dark" aria-labelledby="ev-title">
  <div class="container evh__inner">
    <header class="evh__head">
      <p class="evh__kicker ev-in" style="--in: 0">
        <span class="evh__tally" aria-hidden="true"></span>
        {hero.kicker}
      </p>
      <h1 id="ev-title" class="display evh__title ev-in" style="--in: 1">
        {title.map(({ text, em }) => (em ? <span class="ev-accent">{text}</span> : text))}
      </h1>
    </header>

    <div class="evh__body" data-ev-program data-default={def.key} data-active={def.key}>
      <div class="evh__program ev-in" style="--in: 2">
        <div class="evh__monitor">
          {
            reels.map((s) =>
              s.ready ? (
                <div class:list={['evh__layer', s.key === def.key && 'is-on is-in']} data-cue-layer={s.key}>
                  <video class="evh__video" data-cue={s.key} muted playsinline preload="none" controls poster={s.poster ?? undefined} aria-label={s.entry.alt}>
                    <source src={s.src} type="video/mp4" />
                  </video>
                </div>
              ) : (
                SHOW_PLACEHOLDERS && (
                  <div class:list={['evh__layer', 'evh__layer--pending', s.key === def.key && 'is-on']} data-cue-layer={s.key}>
                    <span>Placeholder · {s.entry.label} · 16:9</span>
                  </div>
                )
              ),
            )
          }
          <div class="evh__hud" aria-hidden="true">
            <span class="evh__reading">
              <span class="evh__rec"></span>
              <span data-program-cue>
                <span data-program-q>{def.q}</span>{' '}
                <span class="evh__dash"></span>{' '}
                <span data-program-label>{def.label}</span>
              </span>
            </span>
            <span class="evh__tc" data-program-tc>00:00:00:00</span>
          </div>
          <button type="button" class="evh__toggle" data-program-toggle data-pause={hero.pause} data-play={hero.play} aria-label={hero.play} data-state="paused">
            <span class="evh__ico evh__ico--pause"><Icon name="pause" size={12} /></span>
            <span class="evh__ico evh__ico--play"><Icon name="play" size={12} /></span>
          </button>
          <span class="evh__crop evh__crop--tl" aria-hidden="true"></span>
          <span class="evh__crop evh__crop--tr" aria-hidden="true"></span>
          <span class="evh__crop evh__crop--bl" aria-hidden="true"></span>
          <span class="evh__crop evh__crop--br" aria-hidden="true"></span>
        </div>

        <div class="evh__cues" role="group" aria-label="Program">
          {
            reels.map((s) => (
              <button
                type="button"
                class="evh__cue"
                data-cue-btn={s.key}
                data-q={s.q}
                data-label={s.label}
                aria-label={`${s.q} ${s.label}: ${s.means}`}
                aria-pressed={s.key === def.key ? 'true' : 'false'}
              >
                <span class="evh__cue-track" aria-hidden="true">
                  <span class="evh__cue-fill" data-cue-progress />
                </span>
                <span class="evh__cue-q">{s.q}</span>{' '}
                <span class="evh__dash" aria-hidden="true" />{' '}
                <span class="evh__cue-label">{s.label}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="evh__side">
        <p class="lede evh__lede ev-in" style="--in: 2">{hero.copy}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { Program } from '@lib/ev-media';
  const root = document.querySelector<HTMLElement>('[data-ev-program]');
  if (root) new Program(root);
</script>

<style>
  .evh {
    --view-h: 100vh;
    position: relative;
    padding-block: calc(var(--header-row) + clamp(1.5rem, 4vh, 3rem)) clamp(2.5rem, 6vh, 4.5rem);
  }

  @supports (height: 1svh) {
    .evh {
      --view-h: 100svh;
    }
  }

  .evh__inner {
    display: grid;
    gap: clamp(1.5rem, 3.5vh, 2.5rem);
  }

  .evh__head {
    display: grid;
    gap: clamp(0.75rem, 1.6vh, 1.25rem);
  }

  .evh__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  /* A tally light: lit while the program runs. */
  .evh__tally {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(79, 145, 138, 0.22);
  }

  .evh__title {
    max-width: 22ch;
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 6.25rem);
    line-height: 0.96;
  }

  .ev-accent,
  .evh :global(.ev-accent) {
    color: var(--accent-ink);
  }

  .evh__body {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* Room beneath the monitor for its crop marks, then the control. */
  .evh__program {
    display: grid;
    gap: clamp(1.4rem, 2.6vh, 1.9rem);
    min-width: 0;
  }

  .evh__side {
    display: grid;
    align-content: start;
  }

  .evh__lede {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 0.98rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---- the program monitor --------------------------------------------------------- */
  .evh__monitor {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #050607;
    border-radius: var(--radius);
  }

  /* One reel shows at a time. A cut is a crossfade (350ms): the incoming reel
     fades in over the outgoing one, which stays put beneath it until it is
     covered, then steps away unseen. */
  .evh__layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0.35s;
  }

  .evh__layer.is-on {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0s;
  }

  .evh__layer.is-in {
    z-index: 1;
  }

  .evh__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #050607;
  }

  .evh__layer--pending {
    display: grid;
    place-items: center;
    border: 1px dashed rgba(237, 240, 239, 0.3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* The monitor's readings: the cue and the timecode, on small dark chips. */
  .evh__hud {
    position: absolute;
    inset: clamp(0.5rem, 2%, 1rem) clamp(0.5rem, 2%, 1rem) auto;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    pointer-events: none;
  }

  .evh__reading,
  .evh__tc {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.65em;
    border-radius: 4px;
    background: rgba(13, 15, 16, 0.62);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    color: #edf0ef;
    backdrop-filter: blur(4px);
  }

  .evh__reading [data-program-cue] {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }

  .evh__tc {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: #c3cacb;
  }

  .evh__rec {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7e8995;
  }

  .evh__body.is-playing .evh__rec {
    background: #9fc9c3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .evh__body.is-playing .evh__rec {
      animation: evh-tally 2.4s ease-in-out infinite;
    }
  }

  @keyframes evh-tally {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* The rule between a cue's number and its name: drawn, an em wide, so the
     words stay words for assistive technology. */
  .evh__dash {
    flex: none;
    width: 1em;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .evh__toggle {
    position: absolute;
    left: clamp(0.5rem, 2%, 1rem);
    bottom: clamp(0.5rem, 2%, 1rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(237, 240, 239, 0.3);
    border-radius: 50%;
    background: rgba(13, 15, 16, 0.6);
    color: #f2f1ec;
    backdrop-filter: blur(4px);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .evh__toggle:hover {
    background: rgba(13, 15, 16, 0.85);
  }

  .evh__ico {
    display: none;
  }

  .evh__toggle[data-state='playing'] .evh__ico--pause,
  .evh__toggle[data-state='paused'] .evh__ico--play {
    display: grid;
  }

  :global(html:not(.js)) .evh__toggle,
  :global(html:not(.js)) .evh__hud,
  :global(html:not(.js)) .evh__cues {
    display: none;
  }

  /* Crop marks just outside the monitor's corners. */
  .evh__crop {
    position: absolute;
    width: 0.9rem;
    height: 0.9rem;
    border: 0 solid var(--line-strong);
    pointer-events: none;
  }

  .evh__crop--tl {
    left: -0.65rem;
    top: -0.65rem;
    border-left-width: 1px;
    border-top-width: 1px;
  }

  .evh__crop--tr {
    right: -0.65rem;
    top: -0.65rem;
    border-right-width: 1px;
    border-top-width: 1px;
  }

  .evh__crop--bl {
    left: -0.65rem;
    bottom: -0.65rem;
    border-left-width: 1px;
    border-bottom-width: 1px;
  }

  .evh__crop--br {
    right: -0.65rem;
    bottom: -0.65rem;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  /* ---- the control: three compact rows on a narrow screen, one row beneath the
     monitor from 40rem, three cells of one width -------------------------------------- */
  .evh__cues {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .evh__cue {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.1rem;
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-3);
    border-top: 1px solid var(--line-strong);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .evh__cue:hover {
    color: var(--ink-2);
  }

  .evh__cue[aria-pressed='true'] {
    color: var(--ink);
  }

  .evh__cue-q {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .evh__cue[aria-pressed='true'] .evh__cue-q {
    color: var(--accent-ink);
  }

  /* The active reel's progress, a thin teal line along the cue's top rule. */
  .evh__cue-track {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
    overflow: hidden;
  }

  .evh__cue-fill {
    position: absolute;
    inset: 0;
    background: var(--accent-ink);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .evh__cue[aria-pressed='false'] .evh__cue-fill {
    visibility: hidden;
  }

  @media (min-width: 40rem) {
    .evh__cues {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(0.75rem, 1.6vw, 1.5rem);
    }

    .evh__cue {
      padding: 0.8rem 0 0.2rem;
      min-height: 0;
    }
  }

  @media (min-width: 60rem) {
    .evh__cue {
      font-size: var(--text-sm);
    }
  }

  /* ---- entrance ----------------------------------------------------------------------- */
  .ev-in {
    animation: rise-in 700ms var(--ease-out) both;
    animation-delay: calc(60ms + var(--in, 0) * 90ms);
  }

  /* ---- wide screens: the title across, then the monitor (and its control) beside the
     paragraph ------------------------------------------------------------------------ */
  @media (min-width: 60rem) {
    .evh {
      min-height: var(--view-h);
      display: grid;
      align-content: center;
    }

    .evh__body {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: clamp(1.75rem, 3vw, 3.5rem);
    }

    .evh__title {
      max-width: none;
    }
  }

  /* Short desktop screens: the title a little smaller, so the monitor and its
     control share the first screen with it. */
  @media (min-width: 60rem) and (max-height: 50rem) {
    .evh__title {
      font-size: clamp(2.6rem, 1rem + 4vw, 5rem);
    }
  }
</style>
