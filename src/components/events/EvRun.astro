---
/**
 * 02 Run of show (Events, V1.0): the page's table of contents and its thesis.
 * Five stages on one timeline (Secure, Build, Capture, Cut, Amplify), each
 * with one short line and a link to the section that shows it, under three
 * spans of time: before the event, in the room, after the room clears. As the
 * timeline crosses the screen a line of light runs along its ruler and each
 * stage arrives as the line reaches it. No cards: a ruler, five cue marks and
 * type. Wide screens read it left to right; narrow ones top to bottom. With
 * reduced motion or without JavaScript every stage is simply there.
 */
import events from '@data/events.json';

const { run } = events;
const pad = (n: number) => String(n).padStart(2, '0');
const n = run.stages.length;
---

<section class="evr" data-surface="dark" aria-labelledby="ev-run-title">
  <div class="container evr__inner">
    <div class="evr__head">
      <p class="eyebrow evr__eyebrow">{run.eyebrow}</p>
      <h2 id="ev-run-title" class="display evr__title" data-ev-reveal>
        <span class="ev-cut"><span>{run.title}</span></span>
      </h2>
    </div>

    <nav class="evr__show" aria-label="Run of show" data-ev-run style={`--n: ${n}`}>
      <div class="evr__phases" aria-hidden="true">
        {
          run.phases.map((ph) => (
            <span class="evr__phase" style={`--from: ${ph.from}; --to: ${ph.to}`}>
              {ph.label}
            </span>
          ))
        }
      </div>
      <div class="evr__ruler" aria-hidden="true">
        <span class="evr__fill" data-run-fill></span>
      </div>
      <ol class="evr__stages">
        {
          run.stages.map((s, i) => (
            <li class="evr__stage" data-run-stage style={`--i: ${i}`}>
              <a class="evr__link" href={s.href}>
                <span class="evr__mark" aria-hidden="true" />
                <span class="evr__n" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                <span class="evr__label">{s.label}</span>
                <span class="evr__line">{s.line}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<script>
  import { reducedMotion } from '@lib/ev-media';

  const show = document.querySelector<HTMLElement>('[data-ev-run]');
  if (show) {
    const fill = show.querySelector<HTMLElement>('[data-run-fill]');
    const stages = Array.from(show.querySelectorAll<HTMLElement>('[data-run-stage]'));
    const n = stages.length;
    const all = () => {
      show.classList.add('is-done');
      for (const s of stages) s.classList.add('is-on');
      if (fill) fill.style.transform = '';
    };
    if (reducedMotion() || !('IntersectionObserver' in window)) all();
    else {
      show.classList.add('is-live');
      let near = false;
      let raf = 0;
      let last = -1;
      const wide = window.matchMedia('(min-width: 60rem)');
      const update = () => {
        raf = 0;
        const r = show.getBoundingClientRect();
        const vh = window.innerHeight;
        // From the timeline's top at 85% of the screen to its bottom at 55%.
        const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / Math.max(1, r.height + vh * 0.3)));
        if (Math.abs(p - last) < 0.002) return;
        last = p;
        if (fill) fill.style.transform = wide.matches ? `scaleX(${p.toFixed(4)})` : `scaleY(${p.toFixed(4)})`;
        stages.forEach((s, i) => s.classList.toggle('is-on', p >= (i + 0.35) / n));
        if (p >= 1) {
          // Once complete it stays complete.
          all();
          window.removeEventListener('scroll', queue);
        }
      };
      const queue = () => {
        if (near && !raf) raf = requestAnimationFrame(update);
      };
      new IntersectionObserver(([e]) => {
        near = e.isIntersecting;
        queue();
      }, { rootMargin: '10% 0px' }).observe(show);
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', () => { last = -1; queue(); }, { passive: true });
    }
  }
</script>

<style>
  .evr {
    padding-block: clamp(2rem, 5vh, 3.5rem) var(--section-y);
  }

  .evr__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .evr__head {
    display: grid;
    gap: 1rem;
    padding-top: clamp(2rem, 5vh, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .evr__eyebrow {
    color: var(--accent);
  }

  .evr__title {
    max-width: 18ch;
    font-size: var(--text-2xl);
  }

  /* ---- the timeline: narrow screens, top to bottom ----------------------------------- */
  .evr__show {
    position: relative;
    display: grid;
    padding-left: 1.75rem;
  }

  .evr__phases {
    display: none;
  }

  .evr__ruler {
    position: absolute;
    left: 0.3rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: var(--line-strong);
  }

  .evr__fill {
    position: absolute;
    inset: 0;
    background: var(--accent-ink);
    transform-origin: center top;
  }

  .evr__show.is-live .evr__fill {
    transform: scaleY(0);
  }

  .evr__stages {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evr__link {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .evr__mark {
    position: absolute;
    left: calc(-1.75rem + 0.3rem - 4.5px);
    top: 0.42rem;
    width: 10px;
    height: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--bg);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .evr__n {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    line-height: 1.6;
  }

  .evr__label {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--heading);
  }

  .evr__line {
    grid-column: 2;
    max-width: 22rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .evr__link:hover .evr__label,
  .evr__link:focus-visible .evr__label {
    color: var(--accent-ink);
  }

  /* Each stage arrives as the line reaches it: its mark lights, its words
     brighten and settle. Waiting, the words stay readable (the muted ink,
     above 4.5:1 on the dark ground). */
  .evr__show.is-live .evr__stage {
    transform: translate3d(0, 6px, 0);
    transition: transform 0.6s var(--ease-out);
  }

  .evr__show.is-live .evr__stage:not(.is-on) :is(.evr__label, .evr__line) {
    color: var(--ink-3);
  }

  .evr__label,
  .evr__line {
    transition: color 0.5s var(--ease-out);
  }

  .evr__show.is-live .evr__stage.is-on {
    transform: none;
  }

  .evr__stage.is-on .evr__mark {
    border-color: var(--accent-ink);
    background: var(--accent-ink);
  }

  /* ---- wide screens: left to right, the phases above the ruler ---------------------- */
  @media (min-width: 60rem) {
    .evr__show {
      padding-left: 0;
      grid-template-rows: auto auto auto;
    }

    .evr__phases {
      display: grid;
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      column-gap: 1.5rem;
      margin-bottom: 1.1rem;
    }

    .evr__phase {
      grid-column: calc(var(--from) + 1) / calc(var(--to) + 2);
      padding: 0 0 0.6rem;
      border-bottom: 1px solid var(--line-strong);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-3);
      position: relative;
    }

    /* Bracket ends. */
    .evr__phase::before,
    .evr__phase::after {
      content: '';
      position: absolute;
      bottom: -1px;
      width: 1px;
      height: 6px;
      background: var(--line-strong);
    }

    .evr__phase::before {
      left: 0;
    }

    .evr__phase::after {
      right: 0;
    }

    .evr__ruler {
      position: relative;
      left: auto;
      top: auto;
      bottom: auto;
      width: auto;
      height: 1px;
      margin-bottom: 1.5rem;
      /* ticks every 1/20 of the run */
      background:
        repeating-linear-gradient(to right, var(--line-strong) 0 1px, transparent 1px calc(100% / 40)) 0 -4px / 100% 9px no-repeat,
        var(--line-strong);
    }

    .evr__fill {
      height: 1px;
      transform-origin: left center;
    }

    .evr__show.is-live .evr__fill {
      transform: scaleX(0);
    }

    .evr__stages {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .evr__link {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding-top: 0.25rem;
    }

    .evr__mark {
      left: 0;
      top: calc(-1.5rem - 5px);
    }

    .evr__line {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evr__show .evr__stage {
      transform: none;
    }
  }
</style>
