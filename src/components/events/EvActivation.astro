---
/**
 * 03 Build the activation (Events, V1.0): the operational work behind a
 * physical activation. One paragraph, short annotations, and a drawing: a
 * schematic of the activation package in elevation (the sponsorship around
 * it, the host it was coordinated with, the table and booth, the screen and
 * its animation, the merchandise, and the way it all reached the room), drawn
 * in line, labeled as a schematic made for this page, and numbered against
 * the annotations so the words carry it at any width. It is a designed
 * visualization, never presented as a photograph of the real activation.
 *
 * The activation kit (banner, flyer, merchandise, screen loop, table plan,
 * credential, networking) follows the drawing as a coordinated package as
 * soon as any of its genuine materials is approved in assets.json (the screen
 * animation as a silent loop with its own pause control); until then it shows
 * only as labeled placeholders in `npm run dev`.
 */
import events from '@data/events.json';
import { getAsset, isSlotReady, SHOW_PLACEHOLDERS } from '@lib/assets';
import EvCue from './EvCue.astro';
import EvCredits from './EvCredits.astro';
import EvSlot from './EvSlot.astro';

const { activation: a } = events;
const showKit = a.kit.some((id) => isSlotReady(getAsset(id))) || SHOW_PLACEHOLDERS;
// Where each number sits on the drawing (share of the 720 by 500 view box).
const at: Record<string, [number, number]> = {
  package: [18.6, 18],
  host: [7.2, 33.5],
  screen: [57.8, 31],
  merch: [21.5, 52],
  table: [52, 76],
  flow: [85.5, 64],
};
---

<section class="eva" id="ev-activation" data-surface="light" aria-labelledby="ev-activation-title">
  <div class="container eva__inner">
    <div class="eva__top">
      <div class="eva__text">
        <EvCue keys={a.cues} />
        <h2 id="ev-activation-title" class="display eva__title" data-ev-reveal>
          <span class="ev-cut"><span>{a.headline}</span></span>
        </h2>
        <p class="eva__copy">{a.copy}</p>
        <ol class="eva__notes">
          {
            a.notes.map((n, i) => (
              <li class="eva__note">
                <span class="eva__num" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="eva__note-text">
                  <strong>{n.label}</strong>
                  <span>{n.note}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <figure class="eva__plan" data-ev-reveal>
        <div class="eva__drawing">
          <svg viewBox="0 0 720 500" aria-hidden="true" focusable="false" class="eva__svg">
            <!-- 1 the sponsorship package around the whole booth -->
            <rect class="eva__l eva__l--dash" x="128" y="88" width="500" height="352" rx="18" />
            <!-- 2 the host, coordinated with -->
            <path class="eva__l eva__l--dash" d="M108 214 C 150 214, 160 300, 160 318" />
            <circle class="eva__l eva__l--accent" cx="90" cy="206" r="18" pathLength="1" />
            <circle class="eva__fill-accent" cx="90" cy="206" r="5" />
            <!-- the floor -->
            <path class="eva__l eva__l--floor" d="M28 440 H692" pathLength="1" />
            <!-- the banner behind the table -->
            <rect class="eva__l" x="500" y="112" width="96" height="328" rx="2" pathLength="1" />
            <rect class="eva__fill-soft" x="510" y="126" width="76" height="16" rx="2" />
            <path class="eva__l eva__l--thin" d="M512 160 H584 M512 172 H572 M512 184 H580" pathLength="1" />
            <!-- 5 the table and its cloth -->
            <path class="eva__l eva__l--bold" d="M150 318 H470" pathLength="1" />
            <rect class="eva__l" x="156" y="318" width="308" height="122" rx="2" pathLength="1" />
            <circle class="eva__l eva__l--accent" cx="310" cy="380" r="16" pathLength="1" />
            <!-- 3 the screen and its animation -->
            <rect class="eva__l eva__l--bold" x="240" y="176" width="160" height="100" rx="6" pathLength="1" />
            <path class="eva__l" d="M320 276 V318 M296 318 H344" pathLength="1" />
            <path class="eva__l eva__l--accent" d="M258 238 C 278 204, 292 204, 308 226 S 340 256, 356 222 S 376 200, 384 214" pathLength="1" />
            <path class="eva__l eva__l--thin" d="M258 258 H300" pathLength="1" />
            <!-- 4 the merchandise: folded shirts and a tote -->
            <path class="eva__l" d="M170 318 V298 H232 V318 M174 298 V284 H228 V298 M178 284 V272 H224 V284" pathLength="1" />
            <path class="eva__l" d="M408 318 L414 270 H446 L452 318 M420 270 C 420 254, 440 254, 440 270" pathLength="1" />
            <!-- 6 the way it reaches the room -->
            <path class="eva__l eva__l--accent eva__l--dash" d="M452 300 C 520 300, 560 330, 616 360" />
            <path class="eva__l eva__l--accent eva__l--dash" d="M232 304 C 180 304, 120 340, 82 372" />
            <circle class="eva__l" cx="640" cy="368" r="10" pathLength="1" />
            <path class="eva__l" d="M622 404 C 622 384, 658 384, 658 404" pathLength="1" />
            <circle class="eva__l" cx="676" cy="380" r="9" pathLength="1" />
            <path class="eva__l" d="M660 412 C 660 394, 692 394, 692 412" pathLength="1" />
            <circle class="eva__l" cx="62" cy="380" r="10" pathLength="1" />
            <path class="eva__l" d="M44 416 C 44 396, 80 396, 80 416" pathLength="1" />
          </svg>
          {
            a.notes.map((n, i) => (
              <span class="eva__pin" style={`left: ${at[n.key][0]}%; top: ${at[n.key][1]}%; --i: ${i}`} aria-hidden="true">
                {i + 1}
              </span>
            ))
          }
        </div>
        <figcaption class="eva__caption">{a.schematicLabel}</figcaption>
      </figure>
    </div>

    {
      showKit && (
        <div class="eva__kit" role="group" aria-label="Activation kit">
          {a.kit.map((id) => (
            <EvSlot id={id} class={`eva__kit-item eva__kit-item--${id.replace('ev-kit-', '')}`} sizes="(min-width: 60rem) 33vw, 100vw" />
          ))}
        </div>
      )
    }

    <EvCredits items={a.credits} class="eva__credits" />
  </div>
</section>

<style>
  .eva {
    padding-block: var(--section-y);
  }

  .eva__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .eva__text {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    align-content: start;
  }

  .eva__title {
    max-width: 16ch;
    font-size: var(--text-2xl);
  }

  .eva__copy {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .eva__notes {
    display: grid;
    gap: 0.85rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .eva__note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .eva__num,
  .eva__pin {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--c-teal);
    color: var(--c-bone);
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .eva__note-text {
    display: grid;
    gap: 0.1rem;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .eva__note-text strong {
    font-weight: 700;
    color: var(--ink);
  }

  .eva__note-text span {
    color: var(--ink-3);
  }

  /* ---- the schematic ------------------------------------------------------------------ */
  .eva__plan {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .eva__drawing {
    position: relative;
    aspect-ratio: 720 / 500;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(to right, color-mix(in srgb, var(--line) 55%, transparent) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(to bottom, color-mix(in srgb, var(--line) 55%, transparent) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--bg-elev);
    border: 1px solid var(--line);
  }

  .eva__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .eva__l {
    fill: none;
    stroke: #25313a;
    stroke-opacity: 0.62;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .eva__l--thin {
    stroke-opacity: 0.35;
    stroke-width: 1;
  }

  .eva__l--bold {
    stroke-opacity: 0.8;
    stroke-width: 2;
  }

  .eva__l--floor {
    stroke-opacity: 0.3;
  }

  .eva__l--accent {
    stroke: #1f4546;
    stroke-opacity: 0.9;
    stroke-width: 1.8;
  }

  .eva__l--dash {
    stroke-dasharray: 4 5;
  }

  .eva__fill-accent {
    fill: #1f4546;
  }

  .eva__fill-soft {
    fill: #1f4546;
    fill-opacity: 0.18;
  }

  .eva__pin {
    position: absolute;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 3px var(--bg-elev);
  }

  .eva__caption {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  /* Drawn in once as it arrives (solid lines draw; dashed ones and pins fade). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .eva__plan:not(.is-in) .eva__l:not(.eva__l--dash) {
      stroke-dasharray: 1 2;
      stroke-dashoffset: 1;
    }

    :global(html.js) .eva__plan .eva__l:not(.eva__l--dash) {
      transition: stroke-dashoffset 1.1s cubic-bezier(0.45, 0, 0.25, 1) 0.1s;
    }

    :global(html.js) .eva__plan:not(.is-in) :is(.eva__l--dash, .eva__fill-accent, .eva__fill-soft) {
      opacity: 0;
    }

    :global(html.js) .eva__plan :is(.eva__l--dash, .eva__fill-accent, .eva__fill-soft) {
      transition: opacity 0.6s ease 0.9s;
    }

    :global(html.js) .eva__plan:not(.is-in) .eva__pin {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
    }

    :global(html.js) .eva__plan .eva__pin {
      transition:
        opacity 0.35s ease calc(1s + var(--i) * 0.08s),
        transform 0.45s var(--ease-out) calc(1s + var(--i) * 0.08s);
    }
  }

  /* ---- the kit: a coordinated package (authoring placeholders until approved) ----------
     The banner across the top, the rest in columns at their own ratios, so a
     genuine file drops in without moving anything else. */
  .eva__kit {
    columns: 2 15rem;
    column-gap: 0.75rem;
  }

  .eva__kit :global(.ev-slot) {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .eva__kit :global(.eva__kit-item--banner) {
    column-span: all;
  }

  .eva__credits {
    max-width: 52rem;
  }

  .eva__top {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 60rem) {
    .eva__top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(2.5rem, 5vw, 6rem);
      align-items: start;
    }

    .eva__plan {
      position: sticky;
      top: calc(var(--header-row) + 1.5rem);
    }

    .eva__kit {
      columns: 3 15rem;
    }

  }
</style>
