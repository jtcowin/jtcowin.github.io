---
/**
 * 03 Build the activation (Events, V1.1): the operational work behind a
 * physical activation. The headline and one paragraph, then one polished,
 * original 3D visualization of the activation in place of V1.0's flat
 * schematic: a dark exhibition room with a large projection on the wall at
 * left, the booth at the center (a television, a dark fascia carrying the
 * Bolt Liquidity wordmark from its own SVG, two neat stacks of branded
 * hoodies), and a restrained conversation area at right. It is rendered for
 * this page in Blender (scripts/render/), representative and never presented
 * as a photograph of the real activation, and carries no hotspots or labels.
 *
 * Its two screens play their loops while the frame is in view: the
 * television (the primary motion, bright and legible) and, softer, the
 * projection on the wall (its texture showing through, its edges soft, at
 * about a third of the television's intensity). Their light on the room rises
 * and falls with what they show. Both are muted and inline, load nothing
 * until the frame comes near, pause out of view or in a hidden tab, and have
 * one pause control. Reduced motion, a data-saving preference, a small screen
 * or no JavaScript keep the static render, both screens on their poster
 * frames (the same composition, made by scripts/render/activation-composite.py).
 *
 * The activation kit (banner, flyer, merchandise, screen loop, table plan,
 * credential, networking) follows as a coordinated package as soon as any of
 * its genuine materials is approved in assets.json; until then it shows only
 * as labeled placeholders in `npm run dev`. The section's credits are in the
 * one block for the Sui Summit work at ETHDenver, which closes the production
 * room (V1.1).
 */
import { getImage, Picture } from 'astro:assets';
import events from '@data/events.json';
import stage from '@data/ev-activation.json';
import { getAsset, isSlotReady, isVisible, resolveAssetFile, resolveImage, SHOW_PLACEHOLDERS } from '@lib/assets';
import { withBase } from '@lib/paths';
import Icon from '@components/Icon.astro';
import EvCue from './EvCue.astro';
import EvSlot from './EvSlot.astro';

const { activation: a } = events;
const showKit = a.kit.some((id) => isSlotReady(getAsset(id))) || SHOW_PLACEHOLDERS;

const render = getAsset(a.visual);
const still = resolveImage(render);
if (!still || !isVisible(render)) throw new Error('[events] the activation render (assets.json ev-activation-render) must be approved and present');
const tv = getAsset(a.tv);
const wall = getAsset(a.wall);
const layer = (file: string) => {
  const img = resolveAssetFile(`events-video/activation/${file}`);
  if (!img) throw new Error(`[events] the activation layer ${file} is missing from src/assets/events-video/activation/`);
  return img;
};
// The live layers (only loaded once a screen that can play them reaches the frame).
const live = isVisible(tv) && isVisible(wall) && Boolean(tv.file && wall.file);
const plate = live ? await getImage({ src: layer('activation-plate.jpg'), widths: [1280, 1920, 2560], sizes: '(min-width: 87.5rem) 1310px, 100vw', format: 'webp', quality: 82 }) : null;
const spillTv = live ? await getImage({ src: layer('activation-spill-tv.jpg'), width: 1280, format: 'webp', quality: 78 }) : null;
const spillWall = live ? await getImage({ src: layer('activation-spill-wall.jpg'), width: 1280, format: 'webp', quality: 78 }) : null;
const mask = live ? await getImage({ src: layer('activation-wall-mask.png'), width: 1280, format: 'webp', quality: 85 }) : null;
const posterOf = async (entry: typeof tv) => {
  const img = resolveImage(entry);
  return img ? (await getImage({ src: img, width: Math.min(960, img.width), format: 'webp', quality: 82 })).src : undefined;
};
const tvPoster = live ? await posterOf(tv) : undefined;
const wallPoster = live ? await posterOf(wall) : undefined;
const [vw, vh] = stage.aspect;
const quads = JSON.stringify({ tv: stage.tv, wall: stage.wall });
const glow = JSON.stringify({ rate: stage.rate, spill: stage.spill, lum: stage.lum });
---

<section class="eva" id="ev-activation" data-surface="light" aria-labelledby="ev-activation-title">
  <div class="container eva__inner">
    <div class="eva__head">
      <div class="eva__heading">
        <EvCue keys={a.cues} />
        <h2 id="ev-activation-title" class="display eva__title" data-ev-reveal>
          <span class="ev-cut"><span>{a.headline}</span></span>
        </h2>
      </div>
      <p class="eva__copy">{a.copy}</p>
    </div>

    <figure class="eva__viz" data-ev-activation>
      <div class="eva__stage" style={`aspect-ratio: ${vw} / ${vh}; --wall-a: ${stage.wallOpacity}`} data-ev-stage data-quads={quads} data-glow={glow}>
        <Picture
          src={still}
          alt={render.alt}
          widths={[640, 960, 1280, 1920, 2560].filter((w) => w <= still.width)}
          sizes="(min-width: 87.5rem) 1310px, 100vw"
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
          class="eva__still"
        />
        {
          live && plate && spillTv && spillWall && mask && (
            <div class="eva__live" data-ev-live hidden aria-hidden="true">
              <img class="eva__plate" src={plate.src} srcset={plate.srcSet.attribute} sizes="(min-width: 87.5rem) 1310px, 100vw" alt="" loading="lazy" decoding="async" />
              <div class="eva__wall" style={`-webkit-mask-image: url(${mask.src}); mask-image: url(${mask.src})`}>
                <video class="eva__screen" data-screen="wall" width="960" height="640" muted loop playsinline preload="none" poster={wallPoster}>
                  <source src={withBase(`/media/${wall.file}`)} type="video/mp4" />
                </video>
              </div>
              <img class="eva__spill" data-spill="wall" src={spillWall.src} alt="" loading="lazy" decoding="async" />
              <img class="eva__spill" data-spill="tv" src={spillTv.src} alt="" loading="lazy" decoding="async" />
              <video class="eva__screen eva__tv" data-screen="tv" width="960" height="540" muted loop playsinline preload="none" poster={tvPoster}>
                <source src={withBase(`/media/${tv.file}`)} type="video/mp4" />
              </video>
            </div>
          )
        }
        {
          live && (
            <button type="button" class="eva__toggle" data-ev-stage-toggle aria-label="Pause: the activation’s screens" data-state="paused" hidden>
              <span class="eva__ico eva__ico--pause">
                <Icon name="pause" size={12} />
              </span>
              <span class="eva__ico eva__ico--play">
                <Icon name="play" size={12} />
              </span>
            </button>
          )
        }
      </div>
      <figcaption class="eva__caption">{a.caption}</figcaption>
    </figure>

    {
      showKit && (
        <div class="eva__kit" role="group" aria-label="Activation kit">
          {a.kit.map((id) => (
            <EvSlot id={id} class={`eva__kit-item eva__kit-item--${id.replace('ev-kit-', '')}`} sizes="(min-width: 60rem) 33vw, 100vw" />
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  import { mountActivation } from '@lib/ev-stage';
  const root = document.querySelector<HTMLElement>('[data-ev-activation]');
  if (root) mountActivation(root);
</script>

<style>
  .eva {
    padding-block: var(--section-y);
  }

  .eva__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .eva__head {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .eva__heading {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    align-content: start;
  }

  .eva__title {
    max-width: 16ch;
    font-size: var(--text-2xl);
  }

  .eva__copy {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---- the visualization ----------------------------------------------------------- */
  .eva__viz {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .eva__stage {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    max-width: 100%;
    border-radius: var(--radius-lg);
    background: #0b0c0d;
  }

  .eva__still,
  .eva__stage :global(picture),
  .eva__live,
  .eva__plate,
  .eva__spill,
  .eva__wall {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .eva__stage :global(.eva__still) {
    object-fit: cover;
  }

  /* Live: the room without its screens' pictures, then the projection (its
     texture and soft edges are its mask), the screens' light on the room, and
     the television on top. The layers fade in over the still render once they
     are ready, the same composition, so nothing seems to change but motion. */
  .eva__live {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .eva__stage.is-live .eva__live {
    opacity: 1;
  }

  .eva__plate {
    object-fit: cover;
  }

  .eva__wall {
    mix-blend-mode: screen;
    opacity: var(--wall-a, 0.4);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .eva__spill {
    object-fit: cover;
    mix-blend-mode: screen;
    opacity: 0;
    will-change: opacity;
  }

  /* Each screen's video is drawn at its own size and mapped onto its corners by
     the script (a perspective transform from the render's geometry). */
  .eva__screen {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    width: 960px;
    height: 540px;
    max-width: none;
    object-fit: fill;
    transform-origin: 0 0;
    background: #000;
  }

  .eva__wall .eva__screen {
    height: 640px;
  }

  .eva__toggle {
    position: absolute;
    right: clamp(0.6rem, 1.6%, 1rem);
    bottom: clamp(0.6rem, 3%, 1rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid rgba(237, 240, 239, 0.3);
    border-radius: 50%;
    background: rgba(13, 15, 16, 0.55);
    color: #f2f1ec;
    backdrop-filter: blur(4px);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .eva__toggle:hover {
    background: rgba(13, 15, 16, 0.85);
  }

  .eva__toggle:focus-visible {
    outline: 2px solid var(--c-fog);
    outline-offset: 2px;
  }

  .eva__ico {
    display: none;
  }

  .eva__toggle[data-state='playing'] .eva__ico--pause,
  .eva__toggle[data-state='paused'] .eva__ico--play {
    display: grid;
  }

  .eva__caption {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  /* ---- the kit: a coordinated package (authoring placeholders until approved) ----------
     The banner across the top, the rest in columns at their own ratios, so a
     genuine file drops in without moving anything else. */
  .eva__kit {
    columns: 2 15rem;
    column-gap: 0.75rem;
  }

  .eva__kit :global(.ev-slot) {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .eva__kit :global(.eva__kit-item--banner) {
    column-span: all;
  }

  @media (min-width: 60rem) {
    .eva__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(2.5rem, 5vw, 6rem);
      align-items: end;
    }

    .eva__kit {
      columns: 3 15rem;
    }
  }
</style>
