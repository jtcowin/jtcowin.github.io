---
/**
 * Select Work: the case studies as an equal-size visual catalog.
 *
 * Every card shares one template and one set of dimensions: a compact number
 * and label, the title, a one-sentence subline and the case-study link, over a
 * media grid of one dominant panel and two smaller supporting panels. The
 * visuals come from each case study's frontmatter (`card.media`) by asset id;
 * `card.media.focus`, in the same slot order (main, then the two sides), sets
 * which part of an image stays in view when its panel crops it.
 * An id whose file is not approved yet falls back to a typographic panel built
 * from that case study's approved facts (`card.media.fallback`), so a card
 * never shows an empty frame, and the real image replaces it as soon as the
 * manifest entry has a file.
 *
 * Desktop stacks the cards as you scroll: each one parks a little lower than
 * the one before (`--peek`), so the top edges of the earlier cards stay in view
 * above the active one, and a covered card recedes slightly (its pictures dim;
 * its text keeps full contrast). Once the last card has arrived the complete
 * stack rests briefly and then leaves as one, every edge still in view. On
 * screens tall enough, the section's headline and introduction stay pinned
 * above the stack until then (see index.astro, which sizes the stack for
 * both). The stacking is CSS `position: sticky`, switched on once the page's
 * script has run, so DOM order, reading order and tab order stay those of an
 * ordinary list.
 * Without JavaScript, with reduced motion, and on phones and tablets the cards
 * read as a normal vertical sequence.
 *
 * Motion: a dominant panel may carry a muted loop (`card.media.motion`). Only
 * the active card's loop plays; it pauses when its card is covered or leaves
 * the screen, loads nothing until first needed, and stays on its poster under
 * reduced motion, with data saving, or on small screens. A small button pauses
 * or plays it at any time, since the loop runs longer than five seconds.
 */
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture, Image, getImage } from 'astro:assets';
import { withBase } from '@lib/paths';
import { getAsset, hasAsset, isIdVisible, resolveImage, resolveGalleryImages, getLogo, resolveLogoImage } from '@lib/assets';
import Icon from './Icon.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;

type Slot =
  | { kind: 'image'; img: ImageMetadata; alt: string }
  | { kind: 'video'; src: string; poster: string; alt: string }
  | { kind: 'fallback'; name: string }
  | { kind: 'empty' };

/** An approved still for this id (a gallery gives its first image). */
function still(id: string | undefined): { img: ImageMetadata; alt: string } | null {
  if (!id || !hasAsset(id) || !isIdVisible(id)) return null;
  const entry = getAsset(id);
  if (entry.type === 'gallery') {
    const first = resolveGalleryImages(entry)[0];
    return first ? { img: first.image, alt: first.alt } : null;
  }
  const img = resolveImage(entry);
  return img ? { img, alt: entry.alt } : null;
}

async function motion(id: string | undefined): Promise<Slot | null> {
  if (!id || !hasAsset(id) || !isIdVisible(id)) return null;
  const entry = getAsset(id);
  const posterImg = resolveImage(entry);
  if (entry.type !== 'video' || !entry.file || !posterImg) return null;
  const poster = await getImage({ src: posterImg, width: Math.min(1600, posterImg.width), format: 'webp' });
  return { kind: 'video', src: withBase(`/media/${entry.file.replace(/^\/+/, '')}`), poster: poster.src, alt: entry.alt };
}

function toSlot(id: string | undefined, fallback: string | undefined): Slot {
  const s = still(id);
  if (s) return { kind: 'image', ...s };
  return fallback ? { kind: 'fallback', name: fallback } : { kind: 'empty' };
}

const cards = await Promise.all(
  entries.map(async (entry, index) => {
    const { card } = entry.data;
    const fb = card.media.fallback ?? [];
    const main = (await motion(card.media.motion)) ?? toSlot(card.media.main, fb[0]);
    return {
      id: entry.id,
      href: withBase(`/work/${entry.id}/`),
      num: String(index + 1).padStart(2, '0'),
      card,
      main,
      sides: [toSlot(card.media.side[0], fb[1]), toSlot(card.media.side[1], fb[2])],
    };
  }),
);

// Typographic stand-ins, drawn only from approved case-study facts.
const cosponsors = ['trezor', 'bitrefill', 'rayls-labs']
  .map((id) => {
    const logo = getLogo(id);
    return { logo, img: resolveLogoImage(logo) };
  })
  .filter((x) => x.logo.permission === 'approved');
const places = [
  { place: 'Mykonos', region: 'Greece · creator retreat' },
  { place: 'Playa Flamingo', region: 'Costa Rica · creator retreat' },
  { place: 'Singapore', region: 'Conference activation' },
];
---

<div class="catalog" data-catalog>
  {
    cards.map(({ href, num, card, main, sides }, index) => (
      <article class="card" style={`--i: ${index}; --r: ${cards.length - 1 - index}`} data-card>
        <div class="card__inner">
          <header class="card__head">
            <p class="card__meta">
              <span class="card__num">{num}</span>
              <span class="card__label">{card.category}</span>
            </p>
            <h3 class="card__title">
              <a href={href} class="card__link">
                {card.title}
              </a>
            </h3>
            <p class="card__subline">{card.subline}</p>
          </header>

          <div class="card__media">
            {[main, ...sides].map((slot, n) => (
              <div class:list={['card__panel', n === 0 ? 'card__panel--main' : 'card__panel--side']}>
                {slot.kind === 'video' ? (
                  <>
                    <video
                      class="card__video"
                      muted
                      loop
                      playsinline
                      preload="none"
                      poster={slot.poster}
                      aria-label={slot.alt}
                      data-card-video
                    >
                      <source src={slot.src} type="video/mp4" />
                    </video>
                    <button type="button" class="card__toggle" data-card-toggle aria-label="Play the video" hidden>
                      <span class="card__toggle-play">
                        <Icon name="play" size={12} />
                      </span>
                      <span class="card__toggle-pause">
                        <Icon name="pause" size={12} />
                      </span>
                    </button>
                  </>
                ) : slot.kind === 'image' ? (
                  <Picture
                    src={slot.img}
                    alt={slot.alt}
                    widths={n === 0 ? [640, 960, 1280, 1600] : [360, 560, 760]}
                    sizes={n === 0 ? '(min-width: 60rem) 62vw, 100vw' : '(min-width: 60rem) 30vw, 50vw'}
                    formats={['avif', 'webp']}
                    loading="lazy"
                    class="card__img"
                    style={card.media.focus?.[n] ? `object-position: ${card.media.focus[n]}` : undefined}
                  />
                ) : slot.kind === 'fallback' && slot.name === 'activations' ? (
                  <div class="fb fb--places">
                    <p class="fb__kicker">Three international activations</p>
                    <ol class="fb__places">
                      {places.map((p) => (
                        <li>
                          <span class="fb__place">{p.place}</span>
                          <span class="fb__region">{p.region}</span>
                        </li>
                      ))}
                    </ol>
                  </div>
                ) : slot.kind === 'fallback' && slot.name === 'impressions' ? (
                  <div class="fb fb--metric">
                    <p class="fb__metric">
                      <span class="fb__metric-small">Approximately</span> <span class="fb__metric-big">1.25M</span>{' '}
                      <span class="fb__metric-small">impressions</span>
                    </p>
                  </div>
                ) : slot.kind === 'fallback' && slot.name === 'cosponsors' ? (
                  <div class="fb fb--logos">
                    <p class="fb__kicker">Co-sponsors</p>
                    <ul class="fb__logos">
                      {cosponsors.map(({ logo, img }) => (
                        <li>
                          {img ? (
                            <Image src={img} alt={logo.name} height={26} class="fb__logo" loading="lazy" />
                          ) : (
                            <span class="fb__wordmark">{logo.name}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <div class="fb fb--empty" aria-hidden="true" />
                )}
              </div>
            ))}
          </div>

          <span class="card__cta" aria-hidden="true">
            {card.linkLabel} <Icon name="arrow-right" size={14} />
          </span>
        </div>
      </article>
    ))
  }
</div>

<script>
  // Depth and motion for the stack. The stacking itself is CSS; this adds the
  // slight recede of a covered card and decides which loop, if any, plays.
  const wide = window.matchMedia('(min-width: 60rem)');
  const small = window.matchMedia('(max-width: 47.99rem)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const lessData = window.matchMedia('(prefers-reduced-data: reduce)');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));

  type Loop = { video: HTMLVideoElement; toggle: HTMLButtonElement | null; held: boolean; on: boolean };
  const loops = new Map<number, Loop>();
  cards.forEach((card, i) => {
    const video = card.querySelector<HTMLVideoElement>('video[data-card-video]');
    if (!video) return;
    const toggle = card.querySelector<HTMLButtonElement>('[data-card-toggle]');
    const loop: Loop = { video, toggle, held: false, on: false };
    loops.set(i, loop);
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        // The reader's choice wins from here on, in either direction.
        loop.held = !video.paused;
        if (video.paused) start(loop, true);
        else stop(loop);
      });
    }
    video.addEventListener('play', () => label(loop));
    video.addEventListener('pause', () => label(loop));
  });

  function label(loop: Loop) {
    if (!loop.toggle) return;
    const playing = !loop.video.paused;
    loop.toggle.dataset.state = playing ? 'playing' : 'paused';
    loop.toggle.setAttribute('aria-label', playing ? 'Pause the video' : 'Play the video');
  }

  function autoplayAllowed() {
    return !reduce.matches && !small.matches && !lessData.matches && !(conn && conn.saveData);
  }

  function start(loop: Loop, byReader = false) {
    if (!byReader && (loop.held || !autoplayAllowed())) return;
    if (loop.video.preload !== 'auto') loop.video.preload = 'auto';
    const p = loop.video.play();
    if (p && typeof p.catch === 'function') p.catch(() => label(loop));
  }

  function stop(loop: Loop) {
    if (!loop.video.paused) loop.video.pause();
  }

  let raf = 0;
  function update() {
    raf = 0;
    const vh = window.innerHeight;
    const stacked = wide.matches && !reduce.matches;
    let active = -1;
    for (let i = 0; i < cards.length; i += 1) {
      const rect = cards[i].getBoundingClientRect();
      const next = cards[i + 1] ? cards[i + 1].getBoundingClientRect() : null;
      // 0 while the next card is still below this one, 1 once it covers it.
      const covered = next && stacked ? Math.min(1, Math.max(0, (rect.bottom - next.top) / Math.max(rect.height, 1))) : 0;
      const inner = cards[i].firstElementChild as HTMLElement | null;
      if (inner) {
        inner.style.setProperty('--recede', stacked ? String(1 - covered * 0.04) : '1');
        inner.style.setProperty('--dim', stacked ? String(1 - covered * 0.16) : '1');
      }
      const inView = rect.top < vh * 0.7 && rect.bottom > vh * 0.3;
      if (inView && covered < 0.5) active = i;
    }
    loops.forEach((loop, i) => {
      if (i === active) {
        if (!loop.on) start(loop);
        loop.on = true;
      } else {
        stop(loop);
        loop.on = false;
      }
    });
  }

  const onScroll = () => {
    if (!raf) raf = requestAnimationFrame(update);
  };

  // The pinned introduction sizes the stack from the head's height; measure
  // the real one (its type is known, but its wrapping is the browser's).
  const work = document.getElementById('work');
  const head = document.querySelector<HTMLElement>('[data-work-head]');
  const measure = () => {
    if (work && head) work.style.setProperty('--head-h', `${head.getBoundingClientRect().height}px`);
  };
  if (work && head) {
    measure();
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(head);
    document.fonts?.ready.then(measure);
  }

  // Keyboard focus never rests on a covered card. Going backwards through the
  // stack (Shift+Tab) reaches cards that later ones cover; when a control in
  // a covered card takes keyboard focus, the page scrolls back to where that
  // card has just parked, with the next card still waiting below it.
  document.querySelector<HTMLElement>('[data-catalog]')?.addEventListener('focusin', (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest<HTMLElement>('[data-card]');
    const i = card ? cards.indexOf(card) : -1;
    if (!card || i < 0 || i === cards.length - 1 || !wide.matches || reduce.matches) return;
    let keyboard = true;
    try {
      keyboard = target.matches(':focus-visible');
    } catch {
      /* no :focus-visible: treat every focus as the keyboard's */
    }
    if (!keyboard) return;
    requestAnimationFrame(() => {
      if (cards[i + 1].getBoundingClientRect().top >= target.getBoundingClientRect().bottom) return;
      const parkedTop = parseFloat(getComputedStyle(card).top) || 0;
      // The card's place in the flow, read without its sticky offset.
      card.style.position = 'static';
      const flowTop = card.getBoundingClientRect().top + window.scrollY;
      card.style.position = '';
      window.scrollTo({ top: flowTop - parkedTop, behavior: 'smooth' });
    });
  });

  if (cards.length) {
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    reduce.addEventListener?.('change', onScroll);
    update();
  }
</script>

<style>
  /* ---- the catalog -------------------------------------------------------- */
  .catalog {
    display: grid;
    gap: var(--space-6);
  }

  .card {
    min-width: 0;
  }

  /* The chapter around the cards is a dark surface; each card resets to a light
     tone so its text reads as it would on a light page. The three cards share
     one neutral family, warm to cool, so the exposed edges of the stack stay
     distinguishable without giving each project its own color. */
  .card__inner {
    --bg: var(--card-bg);
    --bg-elev: color-mix(in srgb, var(--card-bg) 55%, #ffffff);
    --bg-sunk: color-mix(in srgb, var(--card-bg) 88%, var(--c-slate));
    --line: rgba(13, 15, 16, 0.1);
    --line-strong: rgba(13, 15, 16, 0.22);
    --heading: var(--c-ink);
    --ink: var(--c-ink);
    --ink-2: var(--c-ink-2);
    --ink-3: var(--c-steel-deep);
    --accent: var(--c-teal);
    --accent-ink: var(--c-teal);
    --focus: var(--c-teal);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'media'
      'cta';
    gap: clamp(1rem, 0.6rem + 1vw, 1.5rem);
    height: 100%;
    padding: clamp(1.1rem, 0.8rem + 1.1vw, 1.9rem);
    border: 1px solid rgba(13, 15, 16, 0.12);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    color: var(--ink-2);
  }

  .card:nth-child(3n + 1) .card__inner {
    --card-bg: #f4f0e9;
  }

  .card:nth-child(3n + 2) .card__inner {
    --card-bg: #e9ecea;
  }

  .card:nth-child(3n + 3) .card__inner {
    --card-bg: #dce2e2;
  }

  /* ---- head: number and label, title, one sentence ----------------------- */
  .card__head {
    grid-area: head;
    display: grid;
    row-gap: 0.4rem;
    align-items: start;
  }

  .card__meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
  }

  .card__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .card__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.35rem);
    line-height: 1.02;
    letter-spacing: -0.012em;
    color: var(--heading);
    text-wrap: balance;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Whole-card link target, without changing DOM or tab order. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-lg);
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__inner:focus-within .card__link::after {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .card__inner:hover .card__title {
    color: var(--accent-ink);
  }

  .card__subline {
    margin: 0.15rem 0 0;
    max-width: 36em;
    /* Three lines at most from 360px phones up, two on desktop. */
    font-size: clamp(0.875rem, 0.78rem + 0.55vw, 1.0625rem);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* The case-study link label: last on phones, beside the head on desktop.
     The title is the link; the whole card is its target. */
  .card__cta {
    grid-area: cta;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6rem 1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .card__cta :global(svg) {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .card__inner:hover .card__cta {
    border-color: var(--ink);
    background: var(--bg-elev);
  }

  .card__inner:hover .card__cta :global(svg) {
    transform: translateX(3px);
  }

  /* ---- media: one dominant panel, two supporting ------------------------- */
  .card__media {
    grid-area: media;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'main main'
      'side1 side2';
    gap: 0.6rem;
    min-height: 0;
  }

  .card__panel {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-sunk);
    /* The stand-ins size their padding and type to the panel. */
    container-type: size;
  }

  /* Phones and tablets: the dominant panel full width in the 16:9 of most of
     the work, the two supporting panels side by side beneath it. */
  .card__panel--main {
    grid-area: main;
    aspect-ratio: 16 / 9;
  }

  .card__panel--side {
    aspect-ratio: 16 / 10;
  }

  .card__panel--side:nth-child(2) {
    grid-area: side1;
  }

  .card__panel--side:nth-child(3) {
    grid-area: side2;
  }

  .card__panel :global(picture) {
    position: absolute;
    inset: 0;
  }

  .card__panel :global(.card__img),
  .card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__video {
    background: var(--c-ink);
  }

  /* Pause and play: above the whole-card link so it stays operable. */
  .card__toggle {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid rgba(237, 240, 239, 0.35);
    border-radius: 50%;
    background: rgba(13, 15, 16, 0.62);
    color: var(--c-fog);
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .card__toggle:hover {
    background: rgba(13, 15, 16, 0.85);
  }

  .card__toggle:focus-visible {
    outline: 2px solid var(--c-fog);
    outline-offset: 2px;
  }

  /* One icon at a time: play while paused (and before anything has
     played), pause while playing. */
  .card__toggle-play,
  .card__toggle-pause {
    display: grid;
    place-items: center;
  }

  .card__toggle-pause,
  .card__toggle[data-state='playing'] .card__toggle-play {
    display: none;
  }

  .card__toggle[data-state='playing'] .card__toggle-pause {
    display: grid;
  }

  /* ---- typographic stand-ins -------------------------------------------- */
  .fb {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: space-between;
    gap: clamp(0.35rem, 5cqh, 0.75rem);
    padding: clamp(0.5rem, 10cqmin, 1.6rem);
    container-type: size;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--c-aqua) 16%, transparent), transparent 60%),
      var(--bg-sunk);
  }

  .fb__kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @container (max-width: 7rem) {
    .fb__kicker {
      letter-spacing: 0.06em;
    }
  }

  .fb--places {
    grid-template-rows: auto minmax(0, 1fr);
    align-content: stretch;
  }

  .fb__places {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-rows: minmax(0, 1fr);
    counter-reset: place;
  }

  .fb__places li {
    counter-increment: place;
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr);
    grid-template-areas:
      'n place'
      '. region';
    align-content: center;
    align-items: baseline;
    padding-block: clamp(0.1rem, 2cqh, 0.9rem);
    border-top: 1px solid var(--line-strong);
  }

  .fb__places li::before {
    content: counter(place, decimal-leading-zero);
    grid-area: n;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
  }

  .fb__place {
    grid-area: place;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1rem, 9cqh, 3.25rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--heading);
  }

  .fb__region {
    grid-area: region;
    margin-top: 0.15em;
    font-size: clamp(0.68rem, 2.8cqh, 0.95rem);
    line-height: 1.25;
    color: var(--ink-3);
  }

  /* The shortest panels (the smallest phones) keep the three places and
     drop the line under each. */
  @container (max-height: 8rem) {
    .fb__region {
      display: none;
    }

    .fb__place {
      font-size: 0.95rem;
    }

    .fb__places li {
      padding-block: 0.1rem;
    }
  }

