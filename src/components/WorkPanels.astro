---
/**
 * Select Work: the case studies as an equal-size visual catalog.
 *
 * Every card shares one template and one set of dimensions: a compact number
 * and label, the title, a one-sentence subline and the case-study link, over a
 * media grid of one dominant panel and two smaller supporting panels. The
 * visuals come from each case study's frontmatter (`card.media`) by asset id;
 * `card.media.focus`, in the same slot order (main, then the two sides), sets
 * which part of an image stays in view when its panel crops it, and
 * `card.media.fit` can show a still whole instead (`contain`), uncropped on a
 * plate of its own background color.
 * An id whose file is not approved yet falls back to a typographic panel built
 * from that case study's approved facts (`card.media.fallback`), so a card
 * never shows an empty frame, and the real image replaces it as soon as the
 * manifest entry has a file.
 *
 * Desktop stacks the cards as you scroll: each one parks a little lower than
 * the one before (`--peek`), so the top edges of the earlier cards stay in view
 * above the active one, and a covered card recedes slightly (its pictures dim;
 * its text keeps full contrast). Once the last card has arrived the complete
 * stack rests briefly and then leaves as one, every edge still in view. On
 * screens tall enough, the section's headline and introduction stay pinned
 * above the stack until then (see index.astro, which sizes the stack for
 * both). The stacking is CSS `position: sticky`, switched on once the page's
 * script has run, so DOM order, reading order and tab order stay those of an
 * ordinary list.
 * Without JavaScript, with reduced motion, and on phones and tablets the cards
 * read as a normal vertical sequence.
 *
 * Motion: a dominant panel may carry a primary video (`card.media.motion`), a
 * short muted, looping, inline preview with a poster. Only the active card's
 * primary plays on its own, once its panel is substantially in view, and it
 * pauses on its first frame when the card leaves that position; no two ever
 * play at once. A supporting panel whose id is a video entry is a secondary
 * motion tile: it shows its poster and plays only when the visitor asks (a
 * silent hover preview with a fine pointer, or its button), then returns to
 * its poster. Nothing autoplays or plays on hover under reduced motion, with
 * data saving, or on small screens, and video data loads only as its card
 * approaches. Every video has a pause and play button, since each runs longer
 * than five seconds.
 */
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture, Image, getImage } from 'astro:assets';
import { withBase } from '@lib/paths';
import { getAsset, hasAsset, isIdVisible, resolveImage, resolveGalleryImages, getLogo, resolveLogoImage } from '@lib/assets';
import Icon from './Icon.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;

type Slot =
  | { kind: 'image'; img: ImageMetadata; alt: string; plate?: string }
  | { kind: 'video'; role: 'primary' | 'secondary'; src: string; poster: string; alt: string; label: string }
  | { kind: 'fallback'; name: string }
  | { kind: 'empty' };

/** An approved still for this id (a gallery gives its first image). */
function still(id: string | undefined): { img: ImageMetadata; alt: string; plate?: string } | null {
  if (!id || !hasAsset(id) || !isIdVisible(id)) return null;
  const entry = getAsset(id);
  if (entry.type === 'gallery') {
    const first = resolveGalleryImages(entry)[0];
    return first ? { img: first.image, alt: first.alt } : null;
  }
  const img = resolveImage(entry);
  return img ? { img, alt: entry.alt, plate: entry.plate } : null;
}

/**
 * A video entry as a motion slot: the primary loop of the dominant panel, or
 * a secondary motion tile in a supporting panel. Every video carries a poster
 * (a still of its own first frame or a strong frame of it).
 */
async function motion(id: string | undefined | null, role: 'primary' | 'secondary'): Promise<Slot | null> {
  if (!id || !hasAsset(id) || !isIdVisible(id)) return null;
  const entry = getAsset(id);
  const posterImg = resolveImage(entry);
  if (entry.type !== 'video' || !entry.file || !posterImg) return null;
  const width = role === 'primary' ? 1600 : 960;
  const poster = await getImage({ src: posterImg, width: Math.min(width, posterImg.width), format: 'webp' });
  return {
    kind: 'video',
    role,
    src: withBase(`/media/${entry.file.replace(/^\/+/, '')}`),
    poster: poster.src,
    alt: entry.alt,
    label: entry.label,
  };
}

/** A still for this id, else its typographic stand-in, else a quiet tone. */
function stillSlot(id: string | undefined, fallback: string | null | undefined): Slot {
  const s = still(id);
  if (s) return { kind: 'image', ...s };
  return fallback ? { kind: 'fallback', name: fallback } : { kind: 'empty' };
}

/** A supporting panel: a secondary motion tile for a video entry, else a still. */
async function toSlot(id: string | undefined, fallback: string | null | undefined): Promise<Slot> {
  return (await motion(id, 'secondary')) ?? stillSlot(id, fallback);
}

const cards = await Promise.all(
  entries.map(async (entry, index) => {
    const { card } = entry.data;
    const fb = card.media.fallback ?? [];
    // Without its loop, the dominant panel shows the main id as a still (a
    // video entry's poster).
    const main = (await motion(card.media.motion, 'primary')) ?? stillSlot(card.media.main, fb[0]);
    return {
      id: entry.id,
      href: withBase(`/work/${entry.id}/`),
      num: String(index + 1).padStart(2, '0'),
      card,
      main,
      sides: [await toSlot(card.media.side[0], fb[1]), await toSlot(card.media.side[1], fb[2])],
    };
  }),
);

// Typographic stand-ins, drawn only from approved case-study facts.
const cosponsors = ['trezor', 'bitrefill', 'rayls-labs']
  .map((id) => {
    const logo = getLogo(id);
    return { logo, img: resolveLogoImage(logo) };
  })
  .filter((x) => x.logo.permission === 'approved');
const places = [
  { place: 'Mykonos', region: 'Greece · creator retreat' },
  { place: 'Playa Flamingo', region: 'Costa Rica · creator retreat' },
  { place: 'Singapore', region: 'Conference activation' },
];
---

<div class="catalog" data-catalog>
  {
    cards.map(({ href, num, card, main, sides }, index) => (
      <article class="card" style={`--i: ${index}; --r: ${cards.length - 1 - index}`} data-card>
        <div class="card__inner">
          <header class="card__head">
            <p class="card__meta">
              <span class="card__num">{num}</span>
              <span class="card__label">{card.category}</span>
            </p>
            <h3 class="card__title">
              <a href={href} class="card__link">
                {card.title}
              </a>
            </h3>
            <p class="card__subline">{card.subline}</p>
          </header>

          <div class="card__media">
            {[main, ...sides].map((slot, n) => {
              const contain = card.media.fit?.[n] === 'contain' && slot.kind === 'image';
              return (
                <div
                  class:list={['card__panel', n === 0 ? 'card__panel--main' : 'card__panel--side', { 'card__panel--contain': contain }]}
                  style={contain && slot.kind === 'image' && slot.plate ? `--plate: ${slot.plate}` : undefined}
                >
                  {slot.kind === 'video' ? (
                    <>
                      <video
                        class="card__video"
                        muted
                        loop
                        playsinline
                        preload="none"
                        poster={slot.poster}
                        aria-label={slot.alt}
                        data-card-video={slot.role === 'primary' ? '' : undefined}
                        data-card-secondary={slot.role === 'secondary' ? '' : undefined}
                      >
                        <source src={slot.src} type="video/mp4" />
                      </video>
                      <button
                        type="button"
                        class="card__toggle"
                        data-card-toggle
                        data-label={slot.label}
                        aria-label={`Play video: ${slot.label}`}
                        hidden
                      >
                        <span class="card__toggle-play">
                          <Icon name="play" size={12} />
                        </span>
                        <span class="card__toggle-pause">
                          <Icon name="pause" size={12} />
                        </span>
                      </button>
                    </>
                  ) : slot.kind === 'image' ? (
                    <Picture
                      src={slot.img}
                      alt={slot.alt}
                      widths={n === 0 ? [640, 960, 1280, 1600] : [360, 560, 760]}
                      sizes={n === 0 ? '(min-width: 60rem) 62vw, 100vw' : contain ? '(min-width: 60rem) 18vw, 30vw' : '(min-width: 60rem) 30vw, 50vw'}
                      formats={['avif', 'webp']}
                      loading="lazy"
                      class="card__img"
                      style={!contain && card.media.focus?.[n] ? `object-position: ${card.media.focus[n]}` : undefined}
                    />
                  ) : slot.kind === 'fallback' && slot.name === 'activations' ? (
                    <div class="fb fb--places">
                      <p class="fb__kicker">Three international activations</p>
                      <ol class="fb__places">
                        {places.map((p) => (
                          <li>
                            <span class="fb__place">{p.place}</span>
                            <span class="fb__region">{p.region}</span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  ) : slot.kind === 'fallback' && slot.name === 'impressions' ? (
                    <div class="fb fb--metric">
                      <p class="fb__metric">
                        <span class="fb__metric-small">Approximately</span> <span class="fb__metric-big">1.25M</span>{' '}
                        <span class="fb__metric-small">impressions</span>
                      </p>
                    </div>
                  ) : slot.kind === 'fallback' && slot.name === 'cosponsors' ? (
                    <div class="fb fb--logos">
                      <p class="fb__kicker">Co-sponsors</p>
                      <ul class="fb__logos">
                        {cosponsors.map(({ logo, img }) => (
                          <li>
                            {img ? (
                              <Image src={img} alt={logo.name} height={26} class="fb__logo" loading="lazy" />
                            ) : (
                              <span class="fb__wordmark">{logo.name}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : slot.kind === 'fallback' && slot.name === 'suifest' ? (
                    <div class="fb fb--event">
                      <p class="fb__kicker">Sui Fest interviews</p>
                      <p class="fb__event">
                        <span class="fb__event-big">TOKEN2049</span> <span class="fb__event-small">Singapore 2025</span>
                      </p>
                    </div>
                  ) : (
                    <div class="fb fb--empty" aria-hidden="true" />
                  )}
                </div>
              );
            })}
          </div>

          <span class="card__cta" aria-hidden="true">
            {card.linkLabel} <Icon name="arrow-right" size={14} />
          </span>
        </div>
      </article>
    ))
  }
</div>

<script>
  // Depth and motion for the stack. The stacking itself is CSS; this adds the
  // slight recede of a covered card and runs the playback model:
  //
  // - Only the active card's primary video plays on its own, once its panel
  //   is substantially in view (60% or more, clear of the next card). It
  //   pauses, back on its first frame (its poster), when the card leaves that
  //   position, and starting one primary stops any other, so two never play
  //   at once.
  // - A secondary motion tile shows its poster and plays only when the
  //   visitor asks: a silent hover preview with a fine pointer, or its play
  //   button for keyboard and touch. It returns to its poster when it stops or
  //   goes out of view, and the card's primary waits while it plays.
  // - Reduced motion keeps every poster: nothing autoplays or plays on hover.
  //   Data saving and small screens autoplay nothing either. The buttons
  //   always play on request.
  // - Video data loads only as a card approaches the screen.
  const wide = window.matchMedia('(min-width: 60rem)');
  const small = window.matchMedia('(max-width: 47.99rem)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const lessData = window.matchMedia('(prefers-reduced-data: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const mains = cards.map((card) => card.querySelector<HTMLElement>('.card__panel--main'));

  type Clip = {
    video: HTMLVideoElement;
    panel: HTMLElement;
    toggle: HTMLButtonElement | null;
    label: string;
    card: number;
    primary: boolean;
    /** Paused by the reader: stays paused until they play it again. */
    held: boolean;
    /** Started with its button, so it plays on until they stop it. */
    asked: boolean;
    /** The browser refused to start it on its own (a power-saving mode). */
    blocked: boolean;
    hovering: boolean;
  };
  const clips: Clip[] = [];

  const saving = () => lessData.matches || Boolean(conn && conn.saveData);
  const autoplayAllowed = () => !reduce.matches && !small.matches && !saving();
  const hoverAllowed = () => finePointer.matches && !reduce.matches && !saving();

  cards.forEach((card, i) => {
    card.querySelectorAll<HTMLVideoElement>('video[data-card-video], video[data-card-secondary]').forEach((video) => {
      const panel = video.closest<HTMLElement>('.card__panel');
      if (!panel) return;
      const toggle = panel.querySelector<HTMLButtonElement>('[data-card-toggle]');
      const clip: Clip = {
        video,
        panel,
        toggle,
        label: toggle?.dataset.label ?? 'video',
        card: i,
        primary: video.hasAttribute('data-card-video'),
        held: false,
        asked: false,
        blocked: false,
        hovering: false,
      };
      clips.push(clip);
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          if (video.paused) {
            clip.held = false;
            clip.asked = true;
            clip.blocked = false;
            play(clip);
          } else if (clip.primary) {
            // The reader's choice holds from here on.
            clip.held = true;
            clip.asked = false;
            video.pause();
          } else {
            rest(clip);
          }
        });
      }
      video.addEventListener('play', () => label(clip));
      video.addEventListener('pause', () => label(clip));
      video.addEventListener('emptied', () => label(clip));
    });
  });

  function label(clip: Clip) {
    if (!clip.toggle) return;
    const playing = !clip.video.paused;
    clip.toggle.dataset.state = playing ? 'playing' : 'paused';
    clip.toggle.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} video: ${clip.label}`);
  }

  function play(clip: Clip) {
    const { video } = clip;
    for (const other of clips) {
      if (other === clip) continue;
      // One primary at a time across the stack; a secondary also puts its
      // own card's primary on hold, so the card has one moving picture.
      if (clip.primary && other.primary) park(other);
      else if (!clip.primary && !other.primary) rest(other);
      else if (!clip.primary && other.primary && other.card === clip.card && !other.video.paused) other.video.pause();
    }
    if (video.preload !== 'auto') video.preload = 'auto';
    const p = video.play();
    if (p && typeof p.catch === 'function') {
      p.catch((error: unknown) => {
        // Refused by the browser's autoplay rules: not retried on every
        // scroll, and the button still plays it. (A play interrupted by a
        // pause is not a refusal.)
        if (!clip.asked && error instanceof DOMException && error.name === 'NotAllowedError') clip.blocked = true;
        label(clip);
      });
    }
  }

  /** A primary paused and back on its first frame, which is its poster. */
  function park(clip: Clip) {
    if (!clip.video.paused) clip.video.pause();
    if (clip.video.currentTime > 0) clip.video.currentTime = 0;
  }

  /**
   * A secondary paused and back on its poster: reloading with nothing to
   * preload resets it to the poster and fetches nothing more.
   */
  function rest(clip: Clip) {
    clip.asked = false;
    if (clip.video.paused && clip.video.readyState === 0) return;
    clip.video.pause();
    clip.video.preload = 'none';
    clip.video.load();
    label(clip);
    schedule();
  }

  /** How much of a panel is on screen and clear of the next card, 0 to 1. */
  function seen(el: HTMLElement | null, i: number, vh: number, stacked: boolean): number {
    if (!el) return 0;
    const r = el.getBoundingClientRect();
    if (r.height <= 0) return 0;
    const next = stacked && cards[i + 1] ? cards[i + 1].getBoundingClientRect().top : vh;
    const floor = Math.min(vh, next);
    return Math.max(0, Math.min(r.bottom, floor) - Math.max(r.top, 0)) / r.height;
  }

  let raf = 0;
  function update() {
    raf = 0;
    const vh = window.innerHeight;
    const stacked = wide.matches && !reduce.matches;
    for (let i = 0; i < cards.length; i += 1) {
      const rect = cards[i].getBoundingClientRect();
      const next = cards[i + 1] ? cards[i + 1].getBoundingClientRect() : null;
      // 0 while the next card is still below this one, 1 once it covers it.
      const covered = next && stacked ? Math.min(1, Math.max(0, (rect.bottom - next.top) / Math.max(rect.height, 1))) : 0;
      const inner = cards[i].firstElementChild as HTMLElement | null;
      if (inner) {
        inner.style.setProperty('--recede', stacked ? String(1 - covered * 0.04) : '1');
        inner.style.setProperty('--dim', stacked ? String(1 - covered * 0.16) : '1');
      }
    }
    const view = mains.map((m, i) => seen(m, i, vh, stacked));
    // The active card: one the reader started, while it stays in view, or
    // else the card whose dominant panel is most in view, if substantially.
    const chosen = clips.find((c) => c.primary && c.asked && !c.video.paused && view[c.card] >= 0.25);
    let active = chosen ? chosen.card : -1;
    if (active < 0) {
      let best = -1;
      view.forEach((v, i) => {
        if (best < 0 || v > view[best]) best = i;
      });
      active = best >= 0 && view[best] >= 0.6 ? best : -1;
    }
    for (const clip of clips) {
      if (clip.primary) {
        const busy = clips.some((c) => !c.primary && c.card === clip.card && !c.video.paused);
        if (clip.card !== active) {
          clip.asked = false;
          park(clip);
        } else if (busy || clip.held) {
          if (!clip.video.paused) clip.video.pause();
        } else if ((clip.asked || (autoplayAllowed() && !clip.blocked)) && clip.video.paused) {
          play(clip);
        }
      } else if (!clip.video.paused && seen(clip.panel, clip.card, vh, stacked) < 0.3) {
        rest(clip);
      }
    }
  }

  function schedule() {
    if (!raf) raf = requestAnimationFrame(update);
  }

  // Hover previews: the whole card is its link, so the pointer is tracked on
  // the card and matched against each secondary tile.
  cards.forEach((card, i) => {
    const tiles = clips.filter((c) => !c.primary && c.card === i);
    if (!tiles.length) return;
    const track = (x: number, y: number) => {
      for (const clip of tiles) {
        const r = clip.panel.getBoundingClientRect();
        const inside = x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
        if (inside === clip.hovering) continue;
        clip.hovering = inside;
        if (inside) {
          if (hoverAllowed() && clip.video.paused) play(clip);
        } else if (!clip.asked) {
          rest(clip);
        }
      }
    };
    card.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'mouse' || e.pointerType === 'pen') track(e.clientX, e.clientY);
      },
      { passive: true },
    );
    card.addEventListener('pointerleave', () => track(-1, -1));
  });

  // Load a card's primary only as the card comes within a screen of view.
  if ('IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          near.unobserve(entry.target);
          if (!autoplayAllowed()) continue;
          const i = cards.indexOf(entry.target as HTMLElement);
          for (const clip of clips) {
            if (clip.primary && clip.card === i && clip.video.preload === 'none') {
              clip.video.preload = 'auto';
              clip.video.load();
            }
          }
        }
      },
      { rootMargin: '100% 0px 100% 0px' },
    );
    cards.forEach((card) => {
      if (clips.some((c) => c.primary && c.card === cards.indexOf(card))) near.observe(card);
    });
  }

  // Nothing plays in a hidden tab, or on its own once reduced motion is on.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      for (const clip of clips) {
        if (clip.primary) {
          if (!clip.video.paused) clip.video.pause();
        } else rest(clip);
      }
    } else schedule();
  });
  reduce.addEventListener?.('change', () => {
    if (reduce.matches) {
      for (const clip of clips) {
        if (clip.asked) continue;
        if (clip.primary) park(clip);
        else rest(clip);
      }
    }
    schedule();
  });

  // The pinned introduction sizes the stack from the head's height; measure
  // the real one (its type is known, but its wrapping is the browser's).
  const work = document.getElementById('work');
  const head = document.querySelector<HTMLElement>('[data-work-head]');
  const measure = () => {
    if (work && head) work.style.setProperty('--head-h', `${head.getBoundingClientRect().height}px`);
  };
  if (work && head) {
    measure();
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(head);
    document.fonts?.ready.then(measure);
  }

  // Keyboard focus never rests on a covered card. Going backwards through the
  // stack (Shift+Tab) reaches cards that later ones cover; when a control in
  // a covered card takes keyboard focus, the page scrolls back to where that
  // card has just parked, with the next card still waiting below it.
  document.querySelector<HTMLElement>('[data-catalog]')?.addEventListener('focusin', (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest<HTMLElement>('[data-card]');
    const i = card ? cards.indexOf(card) : -1;
    if (!card || i < 0 || i === cards.length - 1 || !wide.matches || reduce.matches) return;
    let keyboard = true;
    try {
      keyboard = target.matches(':focus-visible');
    } catch {
      /* no :focus-visible: treat every focus as the keyboard's */
    }
    if (!keyboard) return;
    requestAnimationFrame(() => {
      if (cards[i + 1].getBoundingClientRect().top >= target.getBoundingClientRect().bottom) return;
      const parkedTop = parseFloat(getComputedStyle(card).top) || 0;
      // The card's place in the flow, read without its sticky offset.
      card.style.position = 'static';
      const flowTop = card.getBoundingClientRect().top + window.scrollY;
      card.style.position = '';
      window.scrollTo({ top: flowTop - parkedTop, behavior: 'smooth' });
    });
  });

  if (cards.length) {
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    update();
  }
</script>

<style>
  /* ---- the catalog -------------------------------------------------------- */
  .catalog {
    display: grid;
    gap: var(--space-6);
  }

  .card {
    min-width: 0;
  }

  /* The chapter around the cards is a dark surface; each card resets to a light
     tone so its text reads as it would on a light page. The three cards share
     one neutral family, warm to cool, so the exposed edges of the stack stay
     distinguishable without giving each project its own color. */
  .card__inner {
    --bg: var(--card-bg);
    --bg-elev: color-mix(in srgb, var(--card-bg) 55%, #ffffff);
    --bg-sunk: color-mix(in srgb, var(--card-bg) 88%, var(--c-slate));
    --line: rgba(13, 15, 16, 0.1);
    --line-strong: rgba(13, 15, 16, 0.22);
    --heading: var(--c-ink);
    --ink: var(--c-ink);
    --ink-2: var(--c-ink-2);
    --ink-3: var(--c-steel-deep);
    --accent: var(--c-teal);
    --accent-ink: var(--c-teal);
    --focus: var(--c-teal);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'media'
      'cta';
    gap: clamp(1rem, 0.6rem + 1vw, 1.5rem);
    height: 100%;
    padding: clamp(1.1rem, 0.8rem + 1.1vw, 1.9rem);
    border: 1px solid rgba(13, 15, 16, 0.12);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    color: var(--ink-2);
  }

  .card:nth-child(3n + 1) .card__inner {
    --card-bg: #f4f0e9;
