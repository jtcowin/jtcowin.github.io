---
/**
 * Select Work: the case studies as an equal-size visual catalog.
 *
 * Every card shares one template and one set of dimensions: a compact number
 * and label, the title, a one-sentence subline and the case-study link, over
 * one landscape video (Full Site Iteration V1, in place of the dominant panel
 * and its two supporting panels): the creator montage, the Technical Product
 * Marketing hero animation and the events montage, each from its case study's
 * frontmatter (`card.media.video`, an approved video entry in the asset
 * manifest). The video takes the card's full media width, in the same frame
 * and treatment on every card: since Full Site Iteration V1.1 an exact 16:9 at
 * every width, so the complete video shows and nothing of it is cropped
 * (object-fit: contain as a safeguard; the edits are 16:9, so nothing
 * letterboxes). Every head keeps the same height (the subline keeps room for
 * its two lines, and a script gives every head the tallest one's height), so
 * the three cards always share one size. On desktop the card is as wide as the
 * content, or, in the stack, as wide as fits the screen with its complete
 * frame, centered (see index.astro, which sizes it).
 *
 * Desktop stacks the cards as you scroll: each one parks a little lower than
 * the one before (`--peek`), so the top edges of the earlier cards stay in view
 * above the active one, and a covered card recedes slightly (its video dims;
 * its text keeps full contrast). Once the last card has arrived the complete
 * stack rests briefly and then leaves as one, every edge still in view. On
 * screens tall enough, the section's headline and introduction stay pinned
 * above the stack until then (see index.astro, which sizes the stack for
 * both). The stacking is CSS `position: sticky`, switched on once the page's
 * script has run, so DOM order, reading order and tab order stay those of an
 * ordinary list.
 * Without JavaScript, with reduced motion, and on phones and tablets the cards
 * read as a normal vertical sequence.
 *
 * Motion: each card's video is a muted, looping, inline edit that sits on its
 * poster, a still of the edit at its exact crop, which holds the frame until
 * the video is playing and again whenever it stops; without JavaScript, or if
 * a video cannot load, the poster simply stays. Only the active card's video
 * plays on its own, once the card has reached its resting place in the stack,
 * and it returns to its poster when the card leaves that position; no two
 * ever play at once. Nothing autoplays under reduced motion, with data
 * saving, or on small screens, and video data loads only as its card
 * approaches. Every video has a pause and play button, since each runs
 * longer than five seconds; the reader's pause holds.
 */
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { withBase } from '@lib/paths';
import { getAsset, hasAsset, isIdVisible, resolveImage } from '@lib/assets';
import Icon from './Icon.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;

/** Responsive widths for a picture, none wider than its source. */
function widthsFor(img: ImageMetadata, wanted: number[]): number[] {
  const out = wanted.filter((w) => w < img.width);
  out.push(Math.min(img.width, wanted[wanted.length - 1]));
  return [...new Set(out)];
}

const cards = entries.map((entry, index) => {
  const { card } = entry.data;
  const id = card.media.video;
  const e = hasAsset(id) && isIdVisible(id) ? getAsset(id) : null;
  const poster = e ? resolveImage(e) : null;
  if (!e || e.type !== 'video' || !e.file || !poster) {
    throw new Error(`[work] card ${index + 1} (${card.title}) needs its one approved video, with its poster (${id})`);
  }
  return {
    href: withBase(`/work/${entry.id}/`),
    num: String(index + 1).padStart(2, '0'),
    card,
    video: {
      src: withBase(`/media/${e.file.replace(/^\/+/, '')}`),
      poster,
      alt: e.alt,
      label: e.label,
    },
  };
});
---

<div class="catalog" data-catalog>
  {
    cards.map(({ href, num, card, video }, index) => (
      <article class="card" style={`--i: ${index}; --r: ${cards.length - 1 - index}`} data-card>
        <div class="card__inner">
          <header class="card__head">
            <p class="card__meta">
              <span class="card__num">{num}</span>
              <span class="card__label">{card.category}</span>
            </p>
            <h3 class="card__title">
              <a href={href} class="card__link">
                {card.title}
              </a>
            </h3>
            <p class="card__subline">{card.subline}</p>
          </header>

          <div class="card__media">
            <div class="card__frame">
              <Picture
                src={video.poster}
                alt=""
                widths={widthsFor(video.poster, [640, 960, 1280, 1600, 1920])}
                sizes="(min-width: 60rem) min(92vw, 86rem), 100vw"
                formats={['avif', 'webp']}
                loading="lazy"
                class="card__img card__poster"
              />
              <video class="card__video" muted loop playsinline preload="none" aria-label={video.alt} data-card-video>
                <source src={video.src} type="video/mp4" />
              </video>
            </div>
            <button type="button" class="card__toggle" data-card-toggle data-label={video.label} aria-label={`Play video: ${video.label}`} hidden>
              <span class="card__toggle-play">
                <Icon name="play" size={12} />
              </span>
              <span class="card__toggle-pause">
                <Icon name="pause" size={12} />
              </span>
            </button>
          </div>

          <span class="card__cta" aria-hidden="true">
            {card.linkLabel} <Icon name="arrow-right" size={14} />
          </span>
        </div>
      </article>
    ))
  }
</div>

<script>
  // Depth and motion for the stack. The stacking itself is CSS; this adds the
  // slight recede of a covered card and runs the playback model:
  //
  // - Every card's video sits on its poster, a still of the edit at its exact
  //   crop. The video stays invisible until its first frame is on screen,
  //   then fades in over the poster; whenever it stops it disappears, back on
  //   the poster, and returns to its first frame. Without JavaScript, or if a
  //   video cannot load, the poster stays (and a broken video's button goes).
  // - Only the active card's video plays on its own. On desktop the active
  //   card is the one that has reached its resting place in the stack with
  //   its video substantially in view (60% or more, clear of the next card);
  //   elsewhere, the card whose video is most in view, if substantially. A
  //   video stops when its card leaves that position, and starting one stops
  //   any other, so two never play at once.
  // - Reduced motion keeps every poster: nothing autoplays. Data saving and
  //   small screens autoplay nothing either. The buttons always play on
  //   request, and a pause from the reader holds until they play it again.
  // - Video data loads only as needed: a card's as it comes within a screen
  //   of view.
  const small = window.matchMedia('(max-width: 47.99rem)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const lessData = window.matchMedia('(prefers-reduced-data: reduce)');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const medias = cards.map((card) => card.querySelector<HTMLElement>('.card__media'));

  type Clip = {
    video: HTMLVideoElement;
    toggle: HTMLButtonElement | null;
    label: string;
    card: number;
    /** Paused by the reader: stays paused until they play it again. */
    held: boolean;
    /** Started with its button, so it plays on until they stop it. */
    asked: boolean;
    /** The browser refused to start it on its own (a power-saving mode). */
    blocked: boolean;
    /** The video could not load: its poster stays and its button goes. */
    failed: boolean;
  };
  const clips: Clip[] = [];

  const saving = () => lessData.matches || Boolean(conn && conn.saveData);
  const autoplayAllowed = () => !reduce.matches && !small.matches && !saving();

  cards.forEach((card, i) => {
    const video = card.querySelector<HTMLVideoElement>('video[data-card-video]');
    const media = medias[i];
    if (!video || !media) return;
    const toggle = media.querySelector<HTMLButtonElement>('[data-card-toggle]');
    const clip: Clip = {
      video,
      toggle,
      label: toggle?.dataset.label ?? 'video',
      card: i,
      held: false,
      asked: false,
      blocked: false,
      failed: false,
    };
    clips.push(clip);
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        if (video.paused) {
          clip.held = false;
          clip.asked = true;
          clip.blocked = false;
          play(clip);
        } else {
          // The reader's choice holds from here on.
          clip.held = true;
          clip.asked = false;
          video.pause();
        }
      });
    }
    video.addEventListener('play', () => label(clip));
    video.addEventListener('pause', () => label(clip));
    video.addEventListener('emptied', () => label(clip));
    video.addEventListener('playing', () => reveal(clip));
    // A video that cannot load keeps its poster. Each <source> reports its
    // own failure, so the last one failing means none could be used.
    const fail = () => {
      clip.failed = true;
      hide(clip);
      if (toggle) toggle.hidden = true;
    };
    video.addEventListener('error', fail);
    video.querySelector('source:last-of-type')?.addEventListener('error', fail);
  });

  function label(clip: Clip) {
    if (!clip.toggle) return;
    const playing = !clip.video.paused;
    clip.toggle.dataset.state = playing ? 'playing' : 'paused';
    clip.toggle.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} video: ${clip.label}`);
  }

  /** The video over its poster, from its first frame on screen. */
  function reveal(clip: Clip) {
    const { video } = clip;
    if (video.hasAttribute('data-shown')) return;
    const show = () => {
      if (!video.paused && !clip.failed) video.setAttribute('data-shown', '');
    };
    const onFrame = (video as HTMLVideoElement & { requestVideoFrameCallback?: (callback: () => void) => number })
      .requestVideoFrameCallback;
    if (typeof onFrame === 'function') onFrame.call(video, show);
    else show();
  }

  /** Back to the poster. */
  function hide(clip: Clip) {
    if (clip.video.hasAttribute('data-shown')) clip.video.removeAttribute('data-shown');
  }

  function play(clip: Clip) {
    if (clip.failed) return;
    const { video } = clip;
    // One video at a time across the stack.
    for (const other of clips) if (other !== clip) park(other);
    if (video.preload !== 'auto') video.preload = 'auto';
    const p = video.play();
    if (p && typeof p.catch === 'function') {
      p.catch((error: unknown) => {
        // Refused by the browser's autoplay rules: not retried on every
        // scroll, and the button still plays it. (A play interrupted by a
        // pause is not a refusal.)
        if (!clip.asked && error instanceof DOMException && error.name === 'NotAllowedError') clip.blocked = true;
        label(clip);
      });
    }
  }

  /** A video stopped: back on its poster, from its first frame next time. */
  function park(clip: Clip) {
    if (!clip.video.paused) clip.video.pause();
    hide(clip);
    if (clip.video.currentTime > 0) clip.video.currentTime = 0;
  }

  /** How much of a card's video is on screen and clear of the next card, 0 to 1. */
  function seen(el: HTMLElement | null, i: number, vh: number, stacked: boolean): number {
    if (!el) return 0;
    const r = el.getBoundingClientRect();
    if (r.height <= 0) return 0;
    const next = stacked && cards[i + 1] ? cards[i + 1].getBoundingClientRect().top : vh;
    const floor = Math.min(vh, next);
    return Math.max(0, Math.min(r.bottom, floor) - Math.max(r.top, 0)) / r.height;
  }

  /**
   * Whether a card is at its resting place: in the desktop stack, once it has
   * reached the position where it parks (its sticky top) or gone past it;
   * elsewhere, always.
   */
  function rested(card: HTMLElement, stacked: boolean): boolean {
    if (!stacked) return true;
    const top = parseFloat(getComputedStyle(card).top);
    if (!Number.isFinite(top)) return true;
    return card.getBoundingClientRect().top <= top + 2;
  }

  /** Whether the cards are stacking: sticky only on a desktop width tall enough
   *  for a complete card, with motion allowed (the stylesheet decides). */
  const stacking = () => cards.length > 0 && getComputedStyle(cards[0]).position === 'sticky';

  let raf = 0;
  function update() {
    raf = 0;
    const vh = window.innerHeight;
    const stacked = stacking();
    for (let i = 0; i < cards.length; i += 1) {
      const rect = cards[i].getBoundingClientRect();
      const next = cards[i + 1] ? cards[i + 1].getBoundingClientRect() : null;
      // 0 while the next card is still below this one, 1 once it covers it.
      const covered = next && stacked ? Math.min(1, Math.max(0, (rect.bottom - next.top) / Math.max(rect.height, 1))) : 0;
      const inner = cards[i].firstElementChild as HTMLElement | null;
      if (inner) {
        inner.style.setProperty('--recede', stacked ? String(1 - covered * 0.04) : '1');
        inner.style.setProperty('--dim', stacked ? String(1 - covered * 0.16) : '1');
      }
    }
    const view = medias.map((m, i) => seen(m, i, vh, stacked));
    // The active card: one the reader started, while it stays in view, or
    // else the card at rest whose video is most in view, if substantially.
    const chosen = clips.find((c) => c.asked && !c.video.paused && view[c.card] >= 0.25);
    let active = chosen ? chosen.card : -1;
    if (active < 0) {
      view.forEach((v, i) => {
        if (v < 0.6 || (active >= 0 && v <= view[active]) || !rested(cards[i], stacked)) return;
        active = i;
      });
    }
    for (const clip of clips) {
      if (clip.failed) continue;
      if (clip.card !== active) {
        clip.asked = false;
        park(clip);
      } else if (clip.held) {
        if (!clip.video.paused) clip.video.pause();
      } else if ((clip.asked || (autoplayAllowed() && !clip.blocked)) && clip.video.paused) {
        play(clip);
      }
    }
  }

  function schedule() {
    if (!raf) raf = requestAnimationFrame(update);
  }

  // Load a card's video only as the card comes within a screen of view.
  if ('IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          near.unobserve(entry.target);
          if (!autoplayAllowed()) continue;
          const i = cards.indexOf(entry.target as HTMLElement);
          for (const clip of clips) {
            if (clip.card === i && !clip.failed && clip.video.preload === 'none') {
              clip.video.preload = 'auto';
              clip.video.load();
            }
          }
        }
      },
      { rootMargin: '100% 0px 100% 0px' },
    );
    cards.forEach((card, i) => {
      if (clips.some((c) => c.card === i)) near.observe(card);
    });
  }

  // Nothing plays in a hidden tab, or on its own once reduced motion is on.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      for (const clip of clips) if (!clip.video.paused) clip.video.pause();
    } else schedule();
  });
  reduce.addEventListener?.('change', () => {
    if (reduce.matches) {
      for (const clip of clips) if (!clip.asked) park(clip);
    }
    schedule();
  });

  // The pinned introduction sizes the stack from the head's height; measure
  // the real one (its type is known, but its wrapping is the browser's).
  const work = document.getElementById('work');
  const head = document.querySelector<HTMLElement>('[data-work-head]');
  const measure = () => {
    if (work && head) work.style.setProperty('--head-h', `${head.getBoundingClientRect().height}px`);
  };
  if (work && head) {
    measure();
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(head);
    document.fonts?.ready.then(measure);
  }

  // Every card's head keeps the tallest head's height (Full Site Iteration
  // V1.1), so the three cards share one size, and the card's size is worked
  // out from it (index.astro). Measured as set, from the head's top to the foot
  // of its last line (the layout's own offsets, so a receding card's scale
  // does not count), rounded up to whole pixels.
  const heads = cards.map((card) => card.querySelector<HTMLElement>('.card__head')).filter((h): h is HTMLElement => Boolean(h));
  const measureHeads = () => {
    if (!work || !heads.length) return;
    let tallest = 0;
    for (const h of heads) {
      const last = h.lastElementChild as HTMLElement | null;
      if (last) tallest = Math.max(tallest, last.offsetTop + last.offsetHeight - h.offsetTop);
    }
    if (tallest > 0) work.style.setProperty('--card-head', `${Math.ceil(tallest)}px`);
  };
  if (work && heads.length) {
    measureHeads();
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(measureHeads);
      for (const h of heads) ro.observe(h);
    }
    document.fonts?.ready.then(measureHeads);
  }

  // Keyboard focus never rests on a covered card. Going backwards through the
  // stack (Shift+Tab) reaches cards that later ones cover; when a control in
  // a covered card takes keyboard focus, the page scrolls back to where that
  // card has just parked, with the next card still waiting below it.
  document.querySelector<HTMLElement>('[data-catalog]')?.addEventListener('focusin', (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest<HTMLElement>('[data-card]');
    const i = card ? cards.indexOf(card) : -1;
    if (!card || i < 0 || i === cards.length - 1 || !stacking()) return;
    let keyboard = true;
    try {
      keyboard = target.matches(':focus-visible');
    } catch {
      /* no :focus-visible: treat every focus as the keyboard's */
    }
    if (!keyboard) return;
    requestAnimationFrame(() => {
      if (cards[i + 1].getBoundingClientRect().top >= target.getBoundingClientRect().bottom) return;
      const parkedTop = parseFloat(getComputedStyle(card).top) || 0;
      // The card's place in the flow, read without its sticky offset.
      card.style.position = 'static';
      const flowTop = card.getBoundingClientRect().top + window.scrollY;
      card.style.position = '';
      window.scrollTo({ top: flowTop - parkedTop, behavior: 'smooth' });
    });
  });

  if (cards.length) {
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    update();
  }
</script>

<style>
  /* ---- the catalog -------------------------------------------------------- */
  .catalog {
    display: grid;
    gap: var(--space-6);
  }

  .card {
    min-width: 0;
  }

  /* The chapter around the cards is a dark surface; each card resets to a light
     tone so its text reads as it would on a light page. The three cards share
     one neutral family, warm to cool, so the exposed edges of the stack stay
     distinguishable without giving each project its own color. */
  .card__inner {
    --bg: var(--card-bg);
    --bg-elev: color-mix(in srgb, var(--card-bg) 55%, #ffffff);
    --bg-sunk: color-mix(in srgb, var(--card-bg) 88%, var(--c-slate));
    --line: rgba(13, 15, 16, 0.1);
    --line-strong: rgba(13, 15, 16, 0.22);
    --heading: var(--c-ink);
    --ink: var(--c-ink);
    --ink-2: var(--c-ink-2);
    --ink-3: var(--c-steel-deep);
    --accent: var(--c-teal);
    --accent-ink: var(--c-teal);
    --focus: var(--c-teal);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'media'
      'cta';
    /* On desktop these come from the Select Work section (index.astro), which
       works out the card's size from them; elsewhere the same values. */
    gap: var(--card-gap, clamp(1rem, 0.6rem + 1vw, 1.5rem));
    padding: var(--card-pad, clamp(1.1rem, 0.8rem + 1.1vw, 1.9rem));
    border: 1px solid rgba(13, 15, 16, 0.12);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    color: var(--ink-2);
  }

  .card:nth-child(3n + 1) .card__inner {
    --card-bg: #f4f0e9;
  }

  .card:nth-child(3n + 2) .card__inner {
    --card-bg: #e9ecea;
  }

  .card:nth-child(3n + 3) .card__inner {
    --card-bg: #dce2e2;
  }

  /* ---- head: number and label, title, one sentence ----------------------- */
  .card__head {
    grid-area: head;
    display: grid;
    row-gap: 0.4rem;
    align-items: start;
  }

  .card__meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
  }

  .card__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .card__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--card-title, clamp(1.5rem, 1.1rem + 1.3vw, 2.35rem));
    line-height: 1.02;
    letter-spacing: -0.012em;
    color: var(--heading);
    text-wrap: balance;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Whole-card link target, without changing DOM or tab order. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-lg);
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__inner:focus-within .card__link::after {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  .card__inner:hover .card__title {
    color: var(--accent-ink);
  }

  .card__subline {
    margin: 0.15rem 0 0;
    max-width: 36em;
    /* Three lines at most from 360px phones up, two on desktop. */
    font-size: var(--card-sub, clamp(0.875rem, 0.78rem + 0.55vw, 1.0625rem));
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* The case-study link label: last on phones, beside the head on desktop.
     The title is the link; the whole card is its target. */
  .card__cta {
    grid-area: cta;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6rem 1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .card__cta :global(svg) {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .card__inner:hover .card__cta {
    border-color: var(--ink);
    background: var(--bg-elev);
  }

  .card__inner:hover .card__cta :global(svg) {
    transform: translateX(3px);
  }

  /* ---- media: one video, the card's full media width (Full Site Iteration V1) --
     The same frame and treatment on every card, and since V1.1 at every width:
     an exact 16:9 at the card's full inner width, so the complete video shows.
     The video and its poster are contained in it, a safeguard: the edits are
     16:9, so they fill it exactly and nothing letterboxes or crops. */
  .card__media {
    grid-area: media;
    position: relative;
    min-width: 0;
    min-height: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-sunk);
  }

  .card__media :global(picture),
  .card__frame {
    position: absolute;
    inset: 0;
  }

  .card__media :global(.card__img),
  .card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* The video: the poster holds the frame, and the video, invisible until its
