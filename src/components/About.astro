---
/**
 * About: a wide editorial section directly beneath the hero.
 *
 * The headline runs across the top, the approved narrative sits in two balanced
 * reading columns, and the career snapshot runs along the bottom from the
 * present on the left to the earliest work on the right. On small screens the
 * snapshot becomes an ordinary vertical list in the same order, so nothing has
 * to be scrolled sideways.
 *
 * Named companies and products are marked in the copy with double asterisks and
 * render as <strong>, so the emphasis is semantic rather than a font weight.
 */
import home from '@data/home.json';
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import Icon from './Icon.astro';

const { about } = home;
const resumeHref = withBase(site.resumePath);

/** Split "a **b** c" into runs, where every odd run is emphasised. */
function runs(text: string) {
  return text.split('**').map((t, i) => ({ text: t, strong: i % 2 === 1 }));
}

const items = about.career.items;
// The two Phi Labs phases are bracketed together so they read as one employer.
const groupStart = items.findIndex((item) => item.group);
const groupSize = items.filter((item) => item.group && item.group === items[groupStart]?.group).length;
---

<section id="about" class="section about" aria-labelledby="about-heading">
  <div class="container">
    <h2 id="about-heading" class="about__heading display">{about.heading}</h2>

    <div class="about__copy">
      {
        about.paragraphs.map((paragraph) => (
          <p>
            {runs(paragraph).map((run) => (run.strong ? <strong>{run.text}</strong> : run.text))}
          </p>
        ))
      }
    </div>

    <div class="career">
      <h3 class="sr-only">{about.career.heading}</h3>

      <p class="career__ends" aria-hidden="true">
        <span>{about.career.nowLabel}</span>
        <span>{about.career.earlierLabel}</span>
      </p>

      <div class="career__track">
        <span class="career__rule" aria-hidden="true"></span>
        <ol class="career__list">
          {
            items.map((item, i) => (
              <li
                class:list={[
                  'career__item',
                  item.current && 'career__item--current',
                  item.group && 'career__item--grouped',
                  i === groupStart && 'career__item--group-start',
                ]}
                style={i === groupStart ? `--group-size: ${groupSize}` : undefined}
              >
                <span class="career__pill mono">{item.period}</span>
                <span class="career__employer">{item.employer}</span>
                {item.phase && <span class="career__phase">{item.phase}</span>}
                <span class="career__detail">{item.detail}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <a href={resumeHref} class="arrow-link career__link" download>
        {about.career.link.label} <Icon name="download" size={14} />
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-elev);
    border-block-end: 1px solid var(--line);
  }

  .about__heading {
    font-size: var(--text-2xl);
    max-width: 18ch;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3.25rem);
    text-wrap: balance;
  }

  .about__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 46rem;
  }

  .about__copy p {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .about__copy strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ---- career snapshot -------------------------------------------------- */
  .career {
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    display: grid;
    gap: var(--space-4);
  }

  .career__ends {
    display: flex;
    justify-content: space-between;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .career__track {
    position: relative;
  }

  .career__rule {
    position: absolute;
    inset-inline: 0;
    top: 0.85rem;
    height: 1px;
    background: var(--line-strong);
  }

  .career__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6) var(--space-5);
  }

  .career__item {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  /* The pill carries the section background so the rule appears to pass
     behind it rather than through it. */
  .career__pill {
    justify-self: start;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-elev);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .career__item--current .career__pill {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .career__employer {
    margin-top: 0.35rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .career__phase {
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .career__item--current .career__phase {
    color: var(--accent-ink);
  }

  .career__detail {
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--ink-3);
    text-wrap: pretty;
  }

  .career__link {
    justify-self: start;
    margin-top: var(--space-3);
  }

  /* ---- wide: two reading columns and a horizontal snapshot -------------- */
  @media (min-width: 48rem) {
    .about__copy {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
      max-width: none;
    }
  }

  @media (min-width: 60rem) {
    .about__heading {
      font-size: var(--text-3xl);
    }

    .career__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* A quiet bracket over the two phases of the same employer, so they read as
       one company rather than two. */
    .career__item--group-start {
      position: relative;
    }

    .career__item--group-start::before {
      content: '';
      position: absolute;
      inset-inline-start: 0;
      inline-size: calc(var(--group-size) * 100% + (var(--group-size) - 1) * var(--space-5));
      block-size: 0.45rem;
      inset-block-start: -1.1rem;
      border: 1px solid var(--line-strong);
      border-block-end: 0;
      opacity: 0.85;
    }
  }

  /* ---- small: an ordinary vertical timeline ----------------------------- */
  @media (max-width: 59.99rem) {
    .career__ends {
      display: none;
    }

    .career__rule {
      inset-inline: auto;
      inset-block: 0.85rem 0;
      inset-inline-start: 0.6rem;
      width: 1px;
      height: auto;
    }

    .career__list {
      gap: var(--space-6);
      padding-inline-start: 1.9rem;
    }

    .career__item {
      position: relative;
    }

    .career__pill {
      margin-inline-start: -1.9rem;
    }

    .career__item--grouped .career__employer::before {
      content: '';
      position: absolute;
      inset-inline-start: -1.3rem;
      inset-block: 0.1rem 0;
      width: 2px;
      background: var(--line-strong);
      opacity: 0.7;
    }
  }
</style>
