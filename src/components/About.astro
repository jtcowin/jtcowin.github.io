---
/**
 * About: career context directly beneath the hero, closed by the trust bar.
 *
 * One wide chapter in four bands: a one-line headline across the canvas, three
 * narrative columns (foundation, Phi Labs, and a short present-day thesis), a
 * compact four-entry career row under a single NOW to EARLIER rule, and the
 * credibility bar. On small screens every band stacks in reading order and the
 * career row becomes an ordinary vertical list, so nothing scrolls sideways.
 *
 * Named companies and products are marked in the copy with double asterisks and
 * render as <strong>, so the emphasis is semantic rather than a font weight.
 */
import home from '@data/home.json';
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import Icon from './Icon.astro';
import LogoBar from './LogoBar.astro';

const { about } = home;
const resumeHref = withBase(site.resumePath);

/** Split "a **b** c" into runs, where every odd run is emphasised. */
function runs(text: string) {
  return text.split('**').map((t, i) => ({ text: t, strong: i % 2 === 1 }));
}
---

<section id="about" class="section about" aria-labelledby="about-heading">
  <div class="container">
    <h2 id="about-heading" class="about__heading display">{about.heading}</h2>

    <div class="about__cols">
      {
        about.columns.map((col) => (
          <p class:list={['about__col', `about__col--${col.role}`]}>
            {runs(col.text).map((run) => (run.strong ? <strong>{run.text}</strong> : run.text))}
          </p>
        ))
      }
    </div>

    <div class="career">
      <h3 class="sr-only">{about.career.heading}</h3>

      <p class="career__axis" aria-hidden="true">
        <span class="career__end">{about.career.nowLabel}</span>
        <span class="career__rule"></span>
        <span class="career__end">{about.career.earlierLabel}</span>
      </p>

      <ol class="career__list">
        {
          about.career.items.map((item) => (
            <li class:list={['career__item', item.current && 'career__item--current']}>
              {item.label && <span class="career__label">{item.label}</span>}
              <span class="career__employer">{item.employer}</span>
              <span class="career__detail">{item.detail}</span>
            </li>
          ))
        }
      </ol>

      <a href={resumeHref} class="arrow-link career__link" download>
        {about.career.link.label} <Icon name="download" size={14} />
      </a>
    </div>

    <LogoBar embedded />
  </div>
</section>

<style>
  .about {
    padding-block: clamp(3.5rem, 2rem + 4vw, 6rem);
  }

  /* One line across the canvas on wide screens. The size is fitted to the
     container width (the phrase runs about 15.6 of its own ems at this weight
     and width) with a margin for rendering variance, and capped where the
     canvas stops growing. */
  .about__heading {
    font-size: clamp(2.5rem, 1rem + 6vw, 4rem);
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3.25rem);
    max-width: none;
    text-wrap: balance;
  }

  .about__cols {
    display: grid;
    gap: var(--space-5);
  }

  .about__col {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .about__col strong {
    font-weight: 700;
    color: var(--ink);
  }

  /* The third column is a thesis, not a third paragraph, so it is set as a
     statement and its shorter length reads as intentional. */
  .about__col--thesis {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 92%;
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--heading);
    padding-top: var(--space-4);
    border-top: 2px solid var(--accent);
  }

  /* ---- career row -------------------------------------------------------- */
  .career {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    gap: var(--space-5);
  }

  .career__axis {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .career__end {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .career__rule {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .career__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5) var(--space-6);
  }

  .career__item {
    display: grid;
    align-content: start;
    gap: 0.3rem;
  }

  .career__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .career__item--current .career__label {
    color: var(--accent);
  }

  .career__employer {
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .career__detail {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .career__link {
    justify-self: start;
  }

  .about :global(.logobar--embedded) {
    margin-top: clamp(2rem, 1.25rem + 2vw, 3rem);
  }

  /* ---- wide ------------------------------------------------------------- */
  @media (min-width: 48rem) {
    .career__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .about__heading {
      font-size: min(5.6vw, 5.5rem);
      white-space: nowrap;
    }
  }

  @media (min-width: 64rem) {
    .about__cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 1rem + 2.5vw, 4rem);
      align-items: start;
    }

    .career__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ---- narrow: the axis becomes a vertical rule beside the entries ------- */
  @media (max-width: 47.99rem) {
    .career__axis {
      display: none;
    }

    .career__list {
      padding-inline-start: 1.25rem;
      border-inline-start: 1px solid var(--line-strong);
    }
  }
</style>
