---
/**
 * About: career context directly beneath the hero, closed by the trust bar.
 *
 * One wide chapter in four bands: a one-line headline across the canvas, three
 * narrative columns (foundation, Phi Labs, and a short present-day thesis), the
 * career snapshot, and the credibility bar. The snapshot is a two-level list:
 * each group is one primary heading (the employer or practice) with its
 * secondary labels and descriptions beneath it, so Phi Labs Global reads as one
 * company holding two scopes. On wide screens the groups sit in one row under a
 * NOW to EARLIER rule; everywhere else they stack in reading order, so nothing
 * scrolls sideways.
 *
 * Named companies and products are marked in the copy with double asterisks and
 * render as <strong>, so the emphasis is semantic rather than a font weight.
 */
import home from '@data/home.json';
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import Icon from './Icon.astro';
import LogoBar from './LogoBar.astro';

const { about } = home;
const resumeHref = withBase(site.resumePath);

/** Split "a **b** c" into runs, where every odd run is emphasised. */
function runs(text: string) {
  return text.split('**').map((t, i) => ({ text: t, strong: i % 2 === 1 }));
}

/** Keep numeric compounds such as "140-plus" on one line; odd runs are the compounds. */
function compounds(text: string) {
  return text.split(/(\d+-[a-z]+)/).map((t, i) => ({ text: t, keep: i % 2 === 1 }));
}
---

<section id="about" class="section about" aria-labelledby="about-heading">
  <div class="container">
    <h2 id="about-heading" class="about__heading display">{about.heading}</h2>

    <div class="about__cols">
      {
        about.columns.map((col) => (
          <p class:list={['about__col', `about__col--${col.role}`]}>
            {runs(col.text).map((run) => (run.strong ? <strong>{run.text}</strong> : run.text))}
          </p>
        ))
      }
    </div>

    <div class="career">
      <h3 class="sr-only">{about.career.heading}</h3>

      <p class="career__axis" aria-hidden="true">
        <span class="career__end">{about.career.nowLabel}</span>
        <span class="career__rule"></span>
        <span class="career__end">{about.career.earlierLabel}</span>
      </p>

      <ol class="career__list">
        {
          about.career.groups.map((group) => (
            <li class:list={['career__group', group.roles.length > 1 && 'career__group--wide']}>
              <h4 class="career__employer">{group.employer}</h4>
              <ol class="career__roles">
                {group.roles.map((role) => (
                  <li class:list={['career__role', role.current && 'career__role--current']}>
                    <p class="career__label">{role.label}</p>
                    <p class="career__detail">
                      {compounds(role.detail).map((run) => (run.keep ? <span class="nobr">{run.text}</span> : run.text))}
                    </p>
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>

      <a href={resumeHref} class="arrow-link career__link" download>
        {about.career.link.label} <Icon name="download" size={14} />
      </a>
    </div>

    <LogoBar embedded />
  </div>
</section>

<style>
  .about {
    padding-block: clamp(3.5rem, 2rem + 4vw, 6rem);
  }

  /* One line across the canvas on wide screens. The size is fitted to the
     container width (the phrase runs about 15.6 of its own ems at this weight
     and width) with a margin for rendering variance, and capped where the
     canvas stops growing. */
  .about__heading {
    font-size: clamp(2.5rem, 1rem + 6vw, 4rem);
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3.25rem);
    max-width: none;
    text-wrap: balance;
  }

  .about__cols {
    display: grid;
    gap: var(--space-5);
  }

  .about__col {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .about__col strong {
    font-weight: 700;
    color: var(--ink);
  }

  /* The third column is a thesis, not a third paragraph, so it is set as a
     statement and its shorter length reads as intentional. */
  .about__col--thesis {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 92%;
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--heading);
    padding-top: var(--space-4);
    border-top: 2px solid var(--accent);
  }

  /* ---- career snapshot --------------------------------------------------
     Spacing inside a group comes from margins rather than gaps, so the same
     rules hold whether or not the group is a subgrid (see the wide queries). */
  .career {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    gap: var(--space-5);
  }

  /* The NOW to EARLIER rule only appears where the groups share one row, so
     the axis always describes the layout beneath it. */
  .career__axis {
    display: none;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .career__end {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .career__rule {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .career__list,
  .career__roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .career__list {
    gap: var(--space-7) var(--space-6);
  }

  .career__group {
    display: grid;
    align-content: start;
    gap: 0;
  }

  /* Primary heading: the employer or practice, set in the display face with a
     rule beneath it. On Phi Labs Global the rule spans both of its roles. */
  .career__employer {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(1.25rem, 1.05rem + 0.45vw, 1.5rem);
    line-height: 1.12;
    letter-spacing: -0.005em;
    color: var(--heading);
    text-wrap: balance;
  }

  .career__roles {
    gap: var(--space-5) var(--space-6);
  }

  .career__role {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }

  /* Secondary label: compact metadata beneath the heading, never a title. */
  .career__label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .career__role--current .career__label {
    color: var(--accent);
  }

  .career__detail {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .career__detail .nobr {
    white-space: nowrap;
  }

  .career__link {
    justify-self: start;
  }

  .about :global(.logobar--embedded) {
    margin-top: clamp(2rem, 1.25rem + 2vw, 3rem);
  }

  /* ---- wide ------------------------------------------------------------- */
  @media (min-width: 48rem) {
    /* Two columns: Phi Labs Global takes the first row with its two roles side
       by side, and the two earlier groups share the second. The inner column
       gap matches the outer one, so the roles land on the outer tracks. */
    .career__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0;
    }

    .career__group--wide {
      grid-column: 1 / -1;
      margin-bottom: var(--space-7);
    }

    .career__group--wide .career__roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    /* Groups in the same row share their heading and role rows, so every rule
       and every label starts on one line even when a heading wraps. */
    @supports (grid-template-rows: subgrid) {
      .career__group {
        grid-row: span 2;
        grid-template-rows: subgrid;
      }

      .career__employer {
        align-self: end;
      }
    }
  }

  /* The smallest phones cannot fit "Operator discipline." at the 2.5rem floor,
     which breaks the headline into four short lines; sizing it to the viewport
     keeps the two-line reading every other phone gets. */
  @media (max-width: 22rem) {
    .about__heading {
      font-size: 10.4vw;
    }
  }

  @media (min-width: 60rem) {
    .about__heading {
      font-size: min(5.6vw, 5.5rem);
      white-space: nowrap;
    }
  }

  @media (min-width: 64rem) {
    .about__cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 0.9fr);
      gap: clamp(2rem, 1rem + 2.5vw, 4rem);
      align-items: start;
    }
  }

  /* One row: Phi Labs Global spans two of four columns. */
  @media (min-width: 72rem) {
    .career__axis {
      display: flex;
    }

    .career__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .career__group--wide {
      grid-column: span 2;
      margin-bottom: 0;
    }
  }
</style>
