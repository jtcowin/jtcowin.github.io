---
/**
 * Version 1.3 hero: one full-viewport photograph with the name over it.
 *
 * The photograph is full bleed and keeps its own setting; nothing is cut out.
 * Only two pieces of copy sit on it, the name and the descriptor, and the
 * header overlays the same frame, so the first viewport is the composition and
 * nothing of the next section shows above the fold.
 *
 * The name is written in normal case and uppercased in CSS, so assistive
 * technology announces "John Cowin" instead of spelling out capitals.
 *
 * Motion is a single entrance: a slight scale correction on the photograph and
 * a clipped reveal per name line. Nothing loops, follows the pointer, or
 * scrolls. Under prefers-reduced-motion the finished state renders at once.
 */
import { Picture } from 'astro:assets';
import home from '@data/home.json';
import { getAsset, resolveImage } from '@lib/assets';

const { hero } = home;
const portrait = getAsset(hero.portrait);
const portraitImg = resolveImage(portrait);
---

<section class="hero" aria-labelledby="hero-title">
  {
    portraitImg && (
      <div class="hero__media">
        {/* Decorative: the name and role are already live text below, so repeating
            them in alt text would only duplicate what is announced. Widths stop at
            the source's own 1536px rather than upscaling it. */}
        <Picture
          src={portraitImg}
          alt=""
          widths={[640, 960, 1280, 1536]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
    )
  }

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__descriptor">{hero.descriptor}</p>
    <h1 class="hero__name" id="hero-title">
      <span class="hero__line"><span class="hero__word">{hero.nameFirst}</span></span>
      <span class="hero__line hero__line--last"><span class="hero__word">{hero.nameLast}</span></span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: #16181a;
  }

  /* ---- photograph ----------------------------------------------------- */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media :global(picture),
  .hero__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__img {
    object-fit: cover;
    /* Tall viewports crop horizontally, so the face has to be held near 34%
       across; wide viewports crop vertically, so the top of the head is held
       just inside the frame. */
    object-position: 34% 50%;
    animation: hero-settle 1400ms var(--ease-out) both;
  }

  /* ---- legibility ----------------------------------------------------- */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Three gradients, no panels. The bottom one carries the name, the top one
       the header, and the right one the descriptor sitting in the photograph's
       open side. Stop values are tuned against measured contrast on the actual
       photograph rather than by eye. */
    background:
      linear-gradient(
        to top,
        rgba(8, 10, 12, 0.84) 0%,
        rgba(8, 10, 12, 0.68) 20%,
        rgba(8, 10, 12, 0.54) 44%,
        rgba(8, 10, 12, 0.24) 62%,
        rgba(8, 10, 12, 0) 78%
      ),
      linear-gradient(to bottom, rgba(8, 10, 12, 0.52) 0%, rgba(8, 10, 12, 0) 26%),
      linear-gradient(to left, rgba(8, 10, 12, 0.52) 0%, rgba(8, 10, 12, 0) 34%);
  }

  /* ---- copy ------------------------------------------------------------ */
  .hero__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(1.25rem, 2vw, 2rem);
    padding-inline: var(--gutter);
    padding-block-end: clamp(2rem, 1rem + 4vh, 4rem);
  }

  .hero__descriptor {
    align-self: end;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f2f1ec;
    margin: 0;
    max-width: 26ch;
    animation: hero-fade 700ms var(--ease-out) 620ms both;
  }

  .hero__name {
    font-family: var(--font-grotesk);
    /* Medium, not black: the name stays the dominant element through scale and
       placement rather than through sheer weight. Tracking opens slightly to
       match, which a heavy weight could not carry. */
    font-weight: 500;
    font-size: clamp(3.25rem, 19vw, 16rem);
    line-height: 0.86;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #f2f1ec;
    margin: 0;
    display: grid;
    justify-items: start;
  }

  /* Each line clips its own word so the reveal reads as type rising into
     place rather than the whole block sliding. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-block-end: 0.06em;
  }

  .hero__word {
    display: block;
    animation: hero-rise 900ms var(--ease-out) both;
  }

  .hero__line--last .hero__word {
    animation-delay: 140ms;
  }

  /* ---- wide screens ---------------------------------------------------- */
  @media (min-width: 60rem) {
    .hero__name {
      font-size: clamp(7rem, 13.5vw, 16rem);
    }

    .hero__img {
      /* Wide viewports crop top and bottom; hold the frame high so the top of
         the head stays in and the lower body carries the name. */
      object-position: 50% 16%;
    }

    .hero__content {
      padding-block: clamp(6rem, 13vh, 9rem) clamp(2.5rem, 6vh, 5rem);
    }

    .hero__descriptor {
      justify-self: end;
      text-align: right;
      align-self: end;
      max-width: 20ch;
      line-height: 1.8;
      padding-block-end: clamp(1.5rem, 5vh, 4rem);
    }

    /* The two words read as one name but sit as two placed blocks, the second
       carried right across the lower half of the photograph. */
    /* Expressed in em so the offset stays proportional to the name at every
       size instead of drifting with the viewport. */
    .hero__line--last {
      margin-inline-start: 1.6em;
    }
  }

  @media (min-width: 90rem) {
    .hero__name {
      font-size: clamp(9rem, 12.5vw, 15rem);
    }
  }

  /* ---- motion ---------------------------------------------------------- */
  @keyframes hero-settle {
    from {
      transform: scale(1.045);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translate3d(0, 105%, 0);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img,
    .hero__word,
    .hero__descriptor {
      animation: none !important;
    }
  }
</style>
