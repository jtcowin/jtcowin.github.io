---
/**
 * Split editorial hero: copy on the left, a layered "work system" on the right.
 *
 * The portrait is the human anchor and the largest layer; three artifacts behind
 * and around it prove technical, strategic, and production breadth. Motion is
 * limited to staggered entry, a slow drift, and a slight pointer response on
 * fine-pointer devices. With prefers-reduced-motion the composition is static.
 *
 * On small screens the copy comes first, then the portrait plus two supporting
 * artifacts; the website frame is dropped rather than shrunk to illegibility.
 */
import home from '@data/home.json';
import site from '@data/site.json';
import { withBase } from '@lib/paths';
import { isIdVisible } from '@lib/assets';
import Media from './Media.astro';
import MetricMarker from './MetricMarker.astro';
import Icon from './Icon.astro';

const { hero } = home;
const a = hero.artifacts;

function resolveHref(href: string) {
  return href === 'resume' ? withBase(site.resumePath) : withBase(href);
}

// Each layer is dropped entirely if its asset is not approved, so the
// composition stays intentional rather than showing a gap.
const layers = [
  { key: 'portrait', id: a.portrait, cls: 'artifact--portrait', i: 0, rot: '-1.4deg', depth: '0.5', sizes: '(min-width: 60rem) 22vw, 48vw', priority: true },
  { key: 'doc', id: a.docPanel, cls: 'artifact--doc', i: 1, rot: '1.4deg', depth: '0.8', sizes: '(min-width: 60rem) 28vw, 48vw', priority: true },
  { key: 'summit', id: a.summitStill, cls: 'artifact--summit', i: 2, rot: '-1deg', depth: '1', sizes: '(min-width: 60rem) 27vw, 48vw', priority: false },
  { key: 'website', id: a.websiteFrame, cls: 'artifact--website', i: 3, rot: '1.1deg', depth: '1.25', sizes: '(min-width: 60rem) 24vw, 48vw', priority: false },
].filter((l) => isIdVisible(l.id));

const showMetric = isIdVisible(a.metric);
---

<section class="hero grid-texture" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow rise" style="--delay: 0ms">{hero.eyebrow}</p>
      <h1 id="hero-title" class="display display-xl rise" style="--delay: 60ms">{hero.headline}</h1>
      <p class="lede rise" style="--delay: 140ms">{hero.copy}</p>
      <div class="hero__actions rise" style="--delay: 220ms">
        <a href={resolveHref(hero.primaryCta.href)} class="btn btn--primary">
          {hero.primaryCta.label} <Icon name="arrow-right" size={14} />
        </a>
        <a href={resolveHref(hero.secondaryCta.href)} class="btn btn--secondary" download>
          <Icon name="download" size={14} /> {hero.secondaryCta.label}
        </a>
        {
          hero.emailLink && (
            <a href={`mailto:${site.email}`} class="hero__email mono">
              {site.email}
            </a>
          )
        }
      </div>
    </div>

    <div class="hero__stage" data-stage role="group" aria-label="John Cowin and selected work artifacts">
      {
        layers.map((l) => (
          <div class:list={['artifact', l.cls]} style={`--i: ${l.i}; --rot: ${l.rot};`} data-depth={l.depth}>
            <div class="artifact__parallax">
              <div class="artifact__inner">
                <Media id={l.id} compact priority={l.priority} sizes={l.sizes} />
              </div>
            </div>
          </div>
        ))
      }
      {
        showMetric && (
          <div class="artifact artifact--metric" style="--i: 4; --rot: 0deg;" data-depth="1.45">
            <div class="artifact__parallax">
              <div class="artifact__inner">
                <MetricMarker id={a.metric} />
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  // Slight pointer response for the layered artifacts. Enhancement only.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const hero = stage?.closest<HTMLElement>('.hero');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (stage && hero && fine.matches && !reduce.matches) {
    const items = Array.from(stage.querySelectorAll<HTMLElement>('.artifact'));
    let raf = 0;
    let nx = 0;
    let ny = 0;

    const apply = () => {
      raf = 0;
      for (const el of items) {
        const depth = Number(el.dataset.depth ?? 1);
        el.style.setProperty('--dx', `${(nx * depth * 9).toFixed(2)}px`);
        el.style.setProperty('--dy', `${(ny * depth * 7).toFixed(2)}px`);
      }
    };

    hero.addEventListener('pointerenter', () => {
      hero.dataset.parallaxActive = '';
    });

    hero.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      nx = Math.max(-1, Math.min(1, ((e.clientX - (r.left + r.width / 2)) / r.width) * 2));
      ny = Math.max(-1, Math.min(1, ((e.clientY - (r.top + r.height / 2)) / r.height) * 2));
      if (!raf) raf = requestAnimationFrame(apply);
    });

    hero.addEventListener('pointerleave', () => {
      nx = 0;
      ny = 0;
      if (!raf) raf = requestAnimationFrame(apply);
      // Drop the compositing hint once the transition back to rest has finished.
      window.setTimeout(() => delete hero.dataset.parallaxActive, 750);
    });
  }
</script>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 38rem;
  }

  .hero__copy h1 {
    margin-top: -0.25rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: var(--space-2);
  }

  .hero__email {
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration-color: var(--line-strong);
    padding-inline: 0.25rem;
  }

  /* ---- Stage: mobile-first, portrait led ------------------------------ */
  .hero__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 0.75rem;
    align-items: start;
    max-width: 34rem;
  }

  .artifact {
    position: relative;
    min-width: 0;
    animation: artifact-in 900ms var(--ease-out) both;
    animation-delay: calc(140ms + var(--i) * 110ms);
  }

  .artifact--portrait {
    grid-row: 1 / span 2;
    align-self: stretch;
  }

  /* The website frame is the least legible at phone size, so it is dropped
     rather than shrunk. Portrait plus two artifacts carry the composition. */
  .artifact--website {
    display: none;
  }

  .artifact--metric {
    grid-column: 1 / -1;
    justify-self: start;
    margin-top: 0.25rem;
  }

  .artifact__parallax {
    transform: translate3d(var(--dx, 0px), var(--dy, 0px), 0);
    transition: transform 700ms var(--ease-out);
  }

  /* `will-change` is applied by the pointer-parallax script only on devices that
     actually run it, and only while the pointer is over the hero. Leaving it in CSS
     pins a compositing layer for the life of the page for no benefit. */
  .hero[data-parallax-active] .artifact__parallax {
    will-change: transform;
  }

  .artifact__inner {
    transform: rotate(var(--rot));
    animation: drift 11s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.7s);
    filter: drop-shadow(0 18px 28px rgba(22, 24, 26, 0.16));
  }

  .artifact--portrait .artifact__inner {
    filter: drop-shadow(0 26px 44px rgba(22, 24, 26, 0.26));
  }

  .artifact--metric .artifact__inner {
    animation: none;
    filter: none;
  }

  .artifact--metric :global(.metric-marker) {
    min-width: 9.5rem;
    padding: 0.65rem 0.85rem 0.7rem;
  }

  .artifact--metric :global(.metric-marker__value) {
    font-size: 1.5rem;
  }

  @keyframes artifact-in {
    from {
      opacity: 0;
      transform: translate3d(0, 28px, 0) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes drift {
    0%,
    100% {
      transform: rotate(var(--rot)) translateY(0);
    }
    50% {
      transform: rotate(var(--rot)) translateY(-6px);
    }
  }

  /* ---- Desktop: layered collage, portrait dominant -------------------- */
  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 10fr) minmax(0, 11fr);
    }

    .hero__stage {
      display: block;
      max-width: none;
      aspect-ratio: 1 / 0.94;
      margin-inline-end: -4%;
    }

    .artifact {
      position: absolute;
    }

    .artifact--portrait {
      left: 0;
      top: 8%;
      width: 45%;
      z-index: 3;
    }

    .artifact--doc {
      left: 41%;
      top: 0;
      width: 57%;
      z-index: 2;
    }

    .artifact--summit {
      left: 46%;
      top: 31%;
      width: 54%;
      z-index: 4;
    }

    .artifact--website {
      display: block;
      left: 33%;
      top: 60%;
      width: 52%;
      z-index: 5;
    }

    /* Tucked under the portrait rather than over the website frame, which it
       previously covered at the headline. */
    .artifact--metric {
      left: 0;
      right: auto;
      top: 67%;
      width: auto;
      margin-top: 0;
      z-index: 6;
    }

    .artifact--metric :global(.metric-marker) {
      min-width: 11.5rem;
      padding: 0.85rem 1.1rem 0.9rem;
    }

    .artifact--metric :global(.metric-marker__value) {
      font-size: 1.85rem;
    }
  }

  @media (min-width: 75rem) {
    .hero__stage {
      margin-inline-end: -7%;
    }
  }

  /* Reduced motion: fully static composition */
  @media (prefers-reduced-motion: reduce) {
    .artifact,
    .artifact__inner,
    .artifact--metric {
      animation: none !important;
    }

    .artifact__parallax {
      transition: none;
      transform: none !important;
    }
  }
</style>
