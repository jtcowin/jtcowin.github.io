---
/**
 * Version 1.4 hero: a layered composition in one full viewport.
 *
 * Layer order, back to front:
 *   1. the full-bleed photograph, with a gradient that sits the background back
 *   2. the moving name and the thin rule
 *   3. the same photograph with its background removed, so the subject occludes
 *      the two layers behind him
 *   4. the navigation and the informational copy
 *
 * Layers 1 and 3 are the same frame at the same size and object-position, so
 * they register exactly and read as one photograph with type running through it.
 * Layer 3 is above layer 2 from the first paint, and layer 2 waits for it to
 * load (Full Site Iteration V1.1), so the name is never seen across John.
 *
 * The name is one accessible instance plus a repeating visual stream that is
 * hidden from assistive technology, so the heading announces "John Cowin" once
 * rather than repeating it. The loop is a duplicated track translated by half
 * its own width, which has no seam. Under prefers-reduced-motion the stream
 * renders as one static instance and nothing moves.
 *
 * Phones (Mobile Optimization V1, below 48rem): the name runs higher, through
 * the hair just under the header row, the way a masthead sits behind a cover
 * portrait, so more of the lettering shows beside the head and none of it
 * crosses the face; it is a little smaller (15vw), so whole words pass through
 * the open wall, and the grade's band moves up with it. The rule across the
 * chest is gone, and the arrow sits to the left of the descriptor as one
 * compact lockup. Tablets and desktops keep the composition as it was.
 */
import { Picture } from 'astro:assets';
import home from '@data/home.json';
import { getAsset, resolveImage } from '@lib/assets';

const { hero } = home;
const portrait = getAsset(hero.portrait);
const portraitImg = resolveImage(portrait);
const foreground = getAsset(hero.foreground);
const foregroundImg = resolveImage(foreground);

// One group is repeated twice to make the track; the animation moves exactly one
// group width, so the restart lands on identical pixels. Three phrases per group
// covers ultrawide viewports without the track running short.
const PHRASES_PER_GROUP = 3;
const group = Array.from({ length: PHRASES_PER_GROUP }, () => `${hero.name} ${hero.separator}`);
---

<section class="hero" aria-labelledby="hero-title" data-surface="image">
  {
    portraitImg && (
      <div class="hero__photo">
        {/* Decorative: the name and the role are live text in this same section,
            so alt text here would only repeat what is already announced. */}
        <Picture
          src={portraitImg}
          alt=""
          widths={[640, 960, 1280, 1536]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
        <div class="hero__grade"></div>
      </div>
    )
  }

  <div class="hero__behind">
    <h1 class="hero__name" id="hero-title">
      <span class="sr-only">{hero.name}</span>
      <span class="stream" aria-hidden="true">
        <span class="stream__track">
          <span class="stream__group">
            {group.map((phrase) => <span class="stream__phrase">{phrase}</span>)}
          </span>
          <span class="stream__group">
            {group.map((phrase) => <span class="stream__phrase">{phrase}</span>)}
          </span>
        </span>
      </span>
    </h1>
    <div class="hero__rule hero__rule--behind"></div>
  </div>

  {
    foregroundImg && (
      <div class="hero__subject" aria-hidden="true">
        <Picture
          src={foregroundImg}
          alt=""
          widths={[640, 960, 1280, 1536]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
    )
  }

  {/* Full Site Iteration V1.1: the name never shows across John. The portrait (the
      cutout above the name) is opaque from the first paint, but an image that has
      not arrived yet occludes nothing, so the name and the rule behind it wait,
      hidden, until the portrait has loaded and decoded (the section is then marked
      data-subject). Run as the page is parsed, so a portrait already in the cache
      is ready before the first paint. A portrait that cannot load keeps them hidden;
      the heading is still read out. Without JavaScript nothing waits. */}
  <script is:inline>
    (() => {
      const hero = document.currentScript?.closest('.hero') ?? document.querySelector('.hero');
      if (!hero) return;
      const img = hero.querySelector('.hero__subject img');
      const go = () => hero.setAttribute('data-subject', '');
      const wait = () => {
        if (img.complete && img.naturalWidth) go();
        else img.addEventListener('load', go, { once: true });
      };
      if (!img) go();
      else if (typeof img.decode === 'function') img.decode().then(go, wait);
      else wait();
    })();
  </script>

  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__rule hero__rule--front" aria-hidden="true"></div>

  <div class="hero__info">
    <svg class="hero__arrow" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
      <path d="M6 6 L20 20" />
      <path d="M20 12 L20 20 L12 20" />
    </svg>
    <p class="hero__descriptor">{hero.descriptor}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--c-ink);

    /* One set of offsets keeps the rule, the stream and the information block
       related to each other instead of each floating on its own. */
    --info-bottom: clamp(1.75rem, 4.5vh, 3.25rem);
    /* Reserves the height the arrow and the descriptor actually occupy, so the
       rule always sits above them. Narrow screens wrap the descriptor onto
       three lines and need the taller reservation. */
    --info-block: clamp(7rem, 6rem + 6vw, 8.5rem);
    --rule-bottom: calc(var(--info-bottom) + var(--info-block));
  }

  /* ---- 1. photograph --------------------------------------------------- */
  .hero__photo,
  .hero__subject {
    position: absolute;
    inset: 0;
  }

  .hero__photo {
    z-index: 0;
  }

  .hero__photo :global(picture),
  .hero__subject :global(picture),
  .hero__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Both layers must share these exactly or the subject will not register with
     the frame behind him. */
  .hero__img {
    object-fit: cover;
    object-position: 34% 50%;
  }

  .hero__photo .hero__img {
    animation: hero-settle 1400ms var(--ease-out) both;
  }

  /* The photograph is a graded derivative (see the asset manifest), so this
     layer no longer darkens the whole frame. It lays down only what the white
     type needs, where the type is: a soft band behind the moving name, a band
     under the rule and descriptor, and a little weight under the navigation.
     The subject layer does not carry any of it, so his skin and clothing keep
     their natural color and he reads in front of the grade. */
  .hero__grade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(8, 10, 12, 0) 12%,
        rgba(8, 10, 12, 0.44) 22%,
        rgba(8, 10, 12, 0.5) 34%,
        rgba(8, 10, 12, 0.44) 46%,
        rgba(8, 10, 12, 0.14) 58%,
        rgba(8, 10, 12, 0) 66%
      ),
      linear-gradient(to top, rgba(8, 10, 12, 0.58) 0%, rgba(8, 10, 12, 0.2) 22%, rgba(8, 10, 12, 0) 36%),
      linear-gradient(to bottom, rgba(8, 10, 12, 0.3) 0%, rgba(8, 10, 12, 0) 14%);
  }

  @media (max-width: 59.99rem) {
    /* The name sits lower on tall screens, so its band moves with it. */
    .hero__grade {
      background:
        linear-gradient(
          to bottom,
          rgba(8, 10, 12, 0) 18%,
          rgba(8, 10, 12, 0.46) 27%,
          rgba(8, 10, 12, 0.5) 36%,
          rgba(8, 10, 12, 0.4) 44%,
          rgba(8, 10, 12, 0) 56%
        ),
        linear-gradient(to top, rgba(8, 10, 12, 0.58) 0%, rgba(8, 10, 12, 0.2) 22%, rgba(8, 10, 12, 0) 36%),
        linear-gradient(to bottom, rgba(8, 10, 12, 0.3) 0%, rgba(8, 10, 12, 0) 14%);
    }
  }

  /* Phones (Mobile Optimization V1): the name runs just under the header row,
     so the band starts at the top (where it also carries the navigation) and
     keeps the wall as dark as before down to the shoulders. */
  @media (max-width: 47.99rem) {
    .hero__grade {
      background:
        linear-gradient(
          to bottom,
          rgba(8, 10, 12, 0.42) 0%,
          rgba(8, 10, 12, 0.5) 9%,
          rgba(8, 10, 12, 0.5) 17%,
          rgba(8, 10, 12, 0.44) 27%,
          rgba(8, 10, 12, 0.4) 44%,
          rgba(8, 10, 12, 0) 56%
        ),
        linear-gradient(to top, rgba(8, 10, 12, 0.58) 0%, rgba(8, 10, 12, 0.2) 22%, rgba(8, 10, 12, 0) 36%);
    }
  }

  /* ---- 2. moving name and rule ----------------------------------------- */
  .hero__behind {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Until the portrait above it has loaded, nothing would hide the name where it
     crosses John, so the layer waits (the inline script above marks the section). */
  :global(html.js) .hero:not([data-subject]) .hero__behind {
    visibility: hidden;
  }

  /* Placed so the stream runs through the subject's head and shoulders, which
     is what makes the occlusion read. */
  .hero__name {
    position: absolute;
    inset-inline: 0;
    top: 31%;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-stretch: 100%;
    font-size: clamp(3.25rem, 17vw, 16rem);
    line-height: 1;
    letter-spacing: 0.01em;
    color: #f2f1ec;
  }

  .stream {
    display: block;
    overflow: hidden;
  }

  .stream__track {
    display: flex;
    width: max-content;
    animation: stream-move 48s linear infinite;
  }

  .stream__group {
    display: flex;
    flex: 0 0 auto;
  }

  .stream__phrase {
    display: block;
    flex: 0 0 auto;
    padding-inline-end: 0.28em;
    white-space: nowrap;
  }

  /* The rule belongs behind the subject, and on wide screens roughly forty per
     cent of its length falls on open background, so the occlusion reads. Below
     75rem the crop is tight enough that the subject spans the whole width at
     that height and a rule behind him would be invisible from end to end, so
     narrow screens draw the same rule in front instead of losing it. Exactly
     one of the two is ever displayed. */
  .hero__rule {
    position: absolute;
    inset-inline: var(--gutter);
    bottom: var(--rule-bottom);
    height: 1px;
    background: rgba(242, 241, 236, 0.85);
  }

  /* Sits above the subject, unlike the grade, because on narrow screens the
     descriptor falls on his forearm rather than on background. Confined to the
     bottom band so it never reaches the moving name. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(8, 10, 12, 0.84) 0%,
      rgba(8, 10, 12, 0.68) 10%,
      rgba(8, 10, 12, 0.36) 20%,
      rgba(8, 10, 12, 0) 34%
    );
  }

  .hero__rule--front {
    z-index: 4;
    pointer-events: none;
  }

  .hero__rule--behind {
    display: none;
  }

  @media (min-width: 75rem) {
    .hero__rule--behind {
      display: block;
    }

    .hero__rule--front {
      display: none;
    }

    .hero__veil {
      background: linear-gradient(to top, rgba(8, 10, 12, 0.34) 0%, rgba(8, 10, 12, 0) 16%);
    }

    /* One line of descriptor at this width, so the block is shorter. */
    .hero {
      --info-block: clamp(4.5rem, 3.5rem + 2vw, 5.5rem);
    }
  }

  /* ---- 3. subject ------------------------------------------------------ */
  .hero__subject {
    z-index: 2;
    pointer-events: none;
  }

  .hero__subject .hero__img {
    animation: hero-settle 1400ms var(--ease-out) both;
  }

  /* ---- 4. information -------------------------------------------------- */
  .hero__info {
    position: absolute;
    z-index: 4;
    right: var(--gutter);
    bottom: var(--info-bottom);
    display: grid;
    justify-items: end;
    gap: clamp(0.6rem, 1.4vh, 1rem);
    text-align: right;
    animation: hero-fade 700ms var(--ease-out) 620ms both;
  }

  .hero__arrow {
    width: clamp(1.6rem, 2.6vw, 2.25rem);
    height: clamp(1.6rem, 2.6vw, 2.25rem);
    fill: none;
    stroke: #f2f1ec;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__descriptor {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.75rem, 0.66rem + 0.35vw, 0.9375rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #f2f1ec;
    line-height: 1.7;
    max-width: 22ch;
  }

  /* ---- phones (Mobile Optimization V1) ------------------------------------
     The name's letters start 0.6rem under the header row: in this face their
     tops sit 0.1em below the top of the line, so the line starts that much
     higher. They run through the hair, above the brows, behind the portrait.
     No rule across the chest; the arrow, a little smaller, leads the
     descriptor as one lockup (the two lines set left against it, the lockup
     still at the lower right). */
  @media (max-width: 47.99rem) {
    .hero__name {
      --name-size: 15vw;
      top: calc(var(--header-row) + 0.6rem - 0.1 * var(--name-size));
      font-size: var(--name-size);
    }

    .hero__rule--front {
      display: none;
    }

    .hero__info {
      grid-auto-flow: column;
      align-items: start;
      justify-items: start;
      column-gap: 0.7rem;
      text-align: left;
    }

    /* Its stroke spans the capitals of the first line, as heavy as it was at
       its larger size. */
    .hero__arrow {
      width: 1.25rem;
      height: 1.25rem;
      margin-top: 0.06rem;
      stroke-width: 1.75;
    }
  }

  /* ---- wide screens ---------------------------------------------------- */
  @media (min-width: 60rem) {
    .hero__img {
      object-position: 50% 16%;
    }

    .hero__name {
      top: 24%;
      font-size: clamp(7rem, 13.5vw, 16rem);
    }

    .hero__descriptor {
      max-width: none;
    }
  }

  @media (min-width: 90rem) {
    .hero__name {
      font-size: clamp(9rem, 12.5vw, 15rem);
    }
  }

  /* ---- motion ---------------------------------------------------------- */
  @keyframes hero-settle {
    from {
      transform: scale(1.045);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Exactly one group width, so the restart is invisible. */
  @keyframes stream-move {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ---- the handoff from the opening sequence (Intro.astro) -----------------------
     The ground clears at --intro-hero, set on the document (0.4 s, --intro-clear),
     and the composition builds in stages (Full Site Iteration V1, reordered in
     V1.1 so the name is never in front of John), the whole hero settled 1.14
     seconds after the loading screen begins to clear:
       1. the scene: the photograph and its grade, from dim and a little large to
          their own light and size, from the first moment, as the ground dissolves
          (0 to 0.7 s);
       2. the portrait: the cutout is in place above the rear layers from the first
          paint, fully opaque, settling with the photograph on the same clock so the
          two stay registered (it has no opacity of its own to resolve, so there is
          never a frame in which it is see-through);
       3. the name and the rule behind the portrait, once the ground has gone: the
          name fades in as its stream begins to travel (the stream starts here, not
          before), while the rule draws across the frame from the left, the way the
          marker ran (0.4 to 0.94 s);
       4. the descriptor, the arrow and the navigation (Header.astro) complete the
          composition (0.76 to 1.14 s).
     Opacity, the rule's draw and a few pixels at most: no bounce, no blur, no large
     travel, nothing that moves on its own once settled. The fills only reach
     backwards, so once the handoff ends nothing holds the hero. With reduced motion
     none of this runs: the ground clears straight to the hero as it stands. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.intro-hold) .hero__photo .hero__img,
    :global(html.intro-hold) .hero__subject .hero__img,
    :global(html.intro-hold) .hero__info {
      animation: none;
    }

    :global(html.intro-hold) .hero__photo {
      animation: hero-ambient 700ms var(--ease-out) var(--intro-hero) backwards;
    }

    /* The portrait settles with the photograph, opaque throughout. */
    :global(html.intro-hold) .hero__subject {
      animation: hero-ambient 700ms var(--ease-out) var(--intro-hero) backwards;
    }

    :global(html.intro-hold) .hero__name {
      animation: hero-resolve 420ms var(--ease-out) calc(var(--intro-hero) + 400ms) backwards;
    }

    /* The stream begins its travel as the name comes in. */
    :global(html.intro-hold) .stream__track {
      animation-delay: calc(var(--intro-hero) + 400ms);
    }

    :global(html.intro-hold) .hero__rule {
      transform-origin: 0 50%;
      animation: hero-draw 500ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--intro-hero) + 440ms) backwards;
    }

    :global(html.intro-hold) .hero__descriptor {
      animation: hero-rise-fade 380ms var(--ease-out) calc(var(--intro-hero) + 760ms) backwards;
    }

    :global(html.intro-hold) .hero__arrow {
      animation: hero-point 340ms var(--ease-out) calc(var(--intro-hero) + 800ms) backwards;
    }
  }

  @keyframes hero-ambient {
    from {
      transform: scale(1.03);
      filter: brightness(0.45);
    }
    to {
      transform: none;
      filter: none;
    }
  }

  @keyframes hero-rise-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 6px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* A layer resolving in place: opacity only. */
  @keyframes hero-resolve {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-point {
    from {
      opacity: 0;
      transform: translate3d(-5px, -5px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__photo .hero__img,
    .hero__subject .hero__img,
    .hero__info {
      animation: none !important;
    }

    /* One static instance of the name behind the subject, no travel. */
    .stream__track {
      animation: none;
    }
  }

  /* On a phone the head covers the left of the line, so the still name starts
     in the open wall beside it, where its first word reads whole. */
  @media (max-width: 47.99rem) and (prefers-reduced-motion: reduce) {
    .stream__track {
      transform: translate3d(60vw, 0, 0);
    }
  }
</style>
