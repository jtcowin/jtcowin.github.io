---
/**
 * Commercial Impact (V1.3; polished in V1.4, October 2026): the homepage's
 * commercial proof, after About and its trust bar and before Select Work. One
 * centered proof stack: the eyebrow, the dominant result ($0 to $300M+ in
 * processed protocol volume) and its label, the short paragraph, then the
 * integrations: the three direct aggregator marks and a fourth, typographic
 * tile for the downstream integrations, subordinate to the marks and never
 * counted (a 2 x 2 grid on phones). Not a dashboard: no cards, no fourth figure.
 *
 * V1.4: its own surface, a deep teal-charcoal a step off the ink of Select Work,
 * so the change of ground marks the boundary between the two (the header reads
 * it like any surface). Copy: home.json `commercial`; **text** is set in bold.
 * Sui Foundation and Mysten Labs never appear here (their prospective pilot is
 * told with its context in the Events case study).
 */
import home from '@data/home.json';
import IntegrationLogos from './IntegrationLogos.astro';

const c = home.commercial;
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
---

<section id="impact" class="section impact" data-surface="dark" data-impact aria-labelledby="impact-heading">
  <div class="container impact__inner">
    <p class="impact__eyebrow">{c.eyebrow}</p>
    <h2 id="impact-heading" class="impact__proof">
      <span class="impact__figure" aria-hidden="true">{c.proof}</span>
      <span class="sr-only">{c.proofSpoken}</span>
      <span class="impact__label">{c.proofLabel}</span>
    </h2>
    <p class="impact__copy">{rich(c.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
    <div class="impact__integrations">
      <p class="impact__eyebrow">{c.integrationsLabel}</p>
      <IntegrationLogos class="impact__logos" label="Integrations" quad>
        <li class="impact__more" data-downstream>
          <span class="impact__more-lead"><span class="impact__plus" aria-hidden="true">+</span> {c.downstream.lead}</span>{' '}
          <span class="impact__more-rest">{c.downstream.rest}</span>
        </li>
      </IntegrationLogos>
    </div>
  </div>
</section>

<style>
  /* A deep teal-charcoal: clearly not the ink of Select Work below, still the
     same quiet dark family. Every token not redefined here is the dark
     surface's. */
  .impact {
    --bg: #0f1e1f;
    --bg-elev: #152627;
    --line: #213233;
    --line-strong: #34494a;
  }

  .impact__inner {
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    text-align: center;
  }

  /* The restrained, letter-spaced metadata of Technical Product Marketing's
     "First 48 hours after launch". */
  .impact__eyebrow {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .impact__proof {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin: calc(-1 * clamp(0.5rem, 1.5vw, 1.5rem)) 0 0;
    font-weight: inherit;
  }

  /* The one dominant result: oversized white type, as Technical Product Marketing's results set theirs. */
  .impact__figure {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: clamp(3.25rem, 1.9rem + 7vw, 8.75rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--heading);
    white-space: nowrap;
  }

  .impact__label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .impact__copy {
    margin: 0;
    max-width: 36rem;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: balance;
  }

  .impact__copy strong {
    font-weight: 700;
    color: var(--heading);
  }

  /* The integrations under a fine centered rule: the label, then one row of
     four (three marks and the downstream tile). */
  .impact__integrations {
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    width: min(100%, 60rem);
    padding-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
    border-top: 1px solid var(--line-strong);
  }

  .impact__integrations :global(.impact__logos) {
    justify-content: center;
  }

  /* The fourth item: two short lines, about a mark's footprint, set quieter
     than the marks it follows. */
  .impact__more {
    display: grid;
    align-content: center;
    min-height: calc(var(--base) * 2);
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-strong);
    text-align: left;
    font-size: clamp(0.8125rem, calc(var(--base) * 0.7), 0.95rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink-2);
  }

  .impact__more-lead {
    color: var(--heading);
  }

  @media (min-width: 22.5rem) {
    .impact__more-rest {
      white-space: nowrap;
    }
  }

  .impact__plus {
    font-weight: 700;
    color: var(--accent);
  }
</style>
