---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import About from '@components/About.astro';
import WorkPanels from '@components/WorkPanels.astro';
import WorkReel from '@components/WorkReel.astro';
import Capabilities from '@components/Capabilities.astro';
import Contact from '@components/Contact.astro';
import Intro from '@components/Intro.astro';
import home from '@data/home.json';
import site from '@data/site.json';
import { getImage } from 'astro:assets';
import { getAsset, resolveImage } from '@lib/assets';
import { emphasize } from '@lib/tpm-copy';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
// Full Site Iteration V1: the introduction's one emphasized phrase (home.json `work.em`).
const workCopy = emphasize(home.work.copy, home.work.em, 'Select Work introduction');

// The hero's two photographic layers (Hero.astro), preloaded with the same
// widths and format its pictures request, so the opening sequence hands over
// to a composition that is already on screen beneath it.
const heroLayers = (
  await Promise.all(
    [home.hero.portrait, home.hero.foreground].map(async (id) => {
      const src = resolveImage(getAsset(id));
      return src ? getImage({ src, widths: [640, 960, 1280, 1536], format: 'avif' }) : null;
    }),
  )
).filter((image) => image !== null);

/**
 * Surfaces are handed out by position, not by section. The hero is surface 01
 * (image); every chapter after it takes the next surface in this list, in the
 * order the chapters appear below. Reorder the chapters and their colors
 * follow automatically; nothing in the components changes.
 *
 * Past the sixth surface the sequence continues from dark, soft and light
 * rather than restarting on another photograph.
 */
const SEQUENCE = ['light', 'dark', 'soft', 'brand', 'light-return'];
const OVERFLOW = ['dark', 'soft', 'light'];
let position = 0;
const surface = () => {
  const s = position < SEQUENCE.length ? SEQUENCE[position] : OVERFLOW[(position - SEQUENCE.length) % OVERFLOW.length];
  position += 1;
  return s;
};

// Evaluated in document order, so these match the chapters below.
const S = { about: surface(), work: surface(), capabilities: surface(), contact: surface() };
---

<BaseLayout
  path="/"
  ogAsset="og-home"
  share={{ title: site.homeShare.title, description: site.homeShare.description }}
  footerSurface={S.contact}
>
  {/* The opening sequence (see Intro.astro): decided before the first paint,
      once per browsing session. A return to the homepage, a visit that began
      on another page of the site, or a link to a section goes straight to the
      page; reduced motion gets a near-instant crossfade (intro-still); a tab
      opened in the background waits until it is shown. */}
  <script is:inline slot="head">
    (function () {
      try {
        var d = document.documentElement;
        var s = window.sessionStorage;
        if (s.getItem('jc-intro')) return;
        s.setItem('jc-intro', '1');
        if (window.location.hash) return;
        var from = document.referrer;
        if (from && new URL(from).origin === window.location.origin) return;
        d.classList.add('intro', 'intro-hold');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('intro-still');
        if (document.visibilityState === 'hidden') {
          d.classList.add('intro-wait');
          document.addEventListener('visibilitychange', function wake() {
            if (document.visibilityState !== 'visible') return;
            d.classList.remove('intro-wait');
            document.removeEventListener('visibilitychange', wake);
          });
        }
      } catch (e) {
        /* no session storage: no sequence, rather than one on every visit */
      }
    })();
  </script>
  {/* The faces of the first screen and the hero photograph, fetched first. */}
  <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin slot="head" />
  <link rel="preload" as="font" type="font/woff2" href={manropeLatin} crossorigin slot="head" />
  {
    heroLayers.map((image) => (
      <link rel="preload" as="image" type="image/avif" imagesrcset={image.srcSet.attribute} imagesizes="100vw" fetchpriority="high" slot="head" />
    ))
  }
  <Intro />
  <Hero />

  <div class="chapter" data-surface={S.about}>
    <About />
  </div>

  {/* One chapter: the Select Work catalog and the wordless work reel belong together. */}
  <div class="chapter" data-surface={S.work}>
    <section id="work" class="section work" aria-labelledby="work-heading" style={`--cards: ${work.length}`}>
      <div class="container work__track">
        <div class="section-head work__head" data-work-head>
          <h2 id="work-heading" class="display display-lg">{home.work.heading}</h2>
          <p class="lede">{workCopy.map(({ text, em }) => (em ? <strong class="em-key">{text}</strong> : text))}</p>
        </div>
        <WorkPanels entries={work} />
      </div>
    </section>
    <WorkReel />
  </div>

  <div class="chapter" data-surface={S.capabilities}>
    <Capabilities />
  </div>

  <div class="chapter" data-surface={S.contact}>
    <Contact />
  </div>
</BaseLayout>

<style>
  /* The reel follows the last card directly; its own padding is the gap. */
  .work {
    padding-top: var(--section-y);
    padding-bottom: 0;
  }

  .work__head {
    max-width: 56rem;
  }

  /* ---- Select Work on desktop --------------------------------------------
     The section starts just below the floating header, and the Work link
     lands with it flush at the top, so the opening frame is the headline, the
     introduction and the first card. Everything that sizes the card stack
     lives here, shared by the head and the cards.

     The card (Full Site Iteration V1.1): its head, then the complete video in
     an exact 16:9 frame at the card's full inner width, so nothing of the
     video is ever cropped. Its type and spacing are set here, shared with
     WorkPanels, so its height follows from its width (--card-h). In the stack
     a card is as wide as the content allows, or, where the screen is not tall
     enough for that, as wide as fits the screen below the header with its
     complete frame: it scales down in proportion and is centered, rather
     than cropping the video. */
  @media (min-width: 60rem) {
    .work {
      --fit: min(1vw, 1.8vh);
      --view-h: 100vh;
      --work-top: calc(var(--nav-h) + clamp(0.5rem, 0.75 * var(--fit), 1rem));
      --work-gap: clamp(1.25rem, 2 * var(--fit), 2.5rem);
      --work-foot: clamp(1rem, 1.5 * var(--fit), 2rem);
      /* The head's height from its type: one line of headline, two of
         introduction. A script replaces it with the measured height. */
      --head-h: calc(var(--text-2xl) * 0.98 + var(--space-4) + 2 * var(--text-lg) * var(--leading-normal));
      /* The stack: each card parks a little lower than the one before, and
         the edges of the cards after the first add up to --stack-rest. */
      --peek: 0.875rem;
      --stack-rest: calc((var(--cards, 3) - 1) * var(--peek));
      /* The card's parts: the content's width, its padding (with the 1px
         border, 2px across), the gap between head and frame, and its type. */
      --card-max: calc(min(100vw, var(--container)) - 2 * var(--gutter));
      --card-pad: clamp(1.1rem, 0.8rem + 1.1vw, 1.9rem);
      --card-gap: clamp(1rem, 0.6rem + 1vw, 1.5rem);
      --card-title: clamp(1.5rem, 1.1rem + 1.3vw, 2.35rem);
      --card-sub: clamp(0.875rem, 0.78rem + 0.55vw, 1.0625rem);
      /* The head from its type: the number and label, one line of title and
         room for two of subline. A script replaces it with the tallest head as
         set, which every card's head then keeps. */
      --card-head: calc(1.6rem + var(--card-title) * 1.02 + 3 * var(--card-sub));
      /* The card at the content's width, but never so wide that its complete
         frame is taller than the screen below the header: on a short screen
         it scales down in proportion (the stack narrows it further, below). */
      --card-w: min(var(--card-max), calc((var(--view-h) - var(--nav-h) - 2rem) * 16 / 9 + 2 * var(--card-pad) + 2px));
      --card-h: calc(2 * var(--card-pad) + 2px + var(--card-head) + var(--card-gap) + (var(--card-w) - 2 * var(--card-pad) - 2px) * 9 / 16);
      /* Without the pinned introduction the parked stack sits centered in the
         screen below the header. */
      --stack-top: calc(var(--nav-h) + max(0.75rem, (var(--view-h) - var(--nav-h) - var(--card-h) - 2 * var(--peek)) / 2));
      --stack-gap: clamp(3rem, 10vh, 7rem);
      padding-top: var(--work-top);
      scroll-margin-top: calc(-1 * var(--scroll-pad));
    }

    @supports (height: 1svh) {
      .work {
        --fit: min(1vw, 1.8svh);
        --view-h: 100svh;
      }
    }

    .work__head {
      margin-bottom: var(--work-gap);
    }
  }

  /* ---- the stack's card size ---------------------------------------------
     Where the cards stack (WorkPanels: a desktop width, at least 45rem of
     height, motion allowed and the page's script run), a parked card must show
     whole: the screen below the header, less the stack's edges, is its room,
     and the card is the widest whose head and complete 16:9 frame fit that
     room, never wider than the content. Shorter screens, reduced motion and no
     JavaScript read the cards in an ordinary sequence, each at the content's
     width or, on a short screen, as wide as keeps its frame within the screen. */
  @media (min-width: 60rem) and (min-height: 45rem) and (prefers-reduced-motion: no-preference) {
    :global(.js) .work {
      --card-room: calc(var(--view-h) - var(--nav-h) - 2rem - 2 * var(--peek));
      --card-w: min(var(--card-max), calc((var(--card-room) - 2 * var(--card-pad) - 2px - var(--card-head) - var(--card-gap)) * 16 / 9 + 2 * var(--card-pad) + 2px));
    }
  }

  /* ---- the pinned introduction --------------------------------------------
     On screens tall enough to hold the introduction and a complete card at
     the content's width (Full Site Iteration V1.1: 82rem; the cards' complete
     16:9 frames need the height that 56rem gave before), the headline and
     introduction stay in place while the cards arrive beneath them. The cards
     park just below the introduction, and the head's margin box ends exactly
     where the stack's margin boxes end (see WorkPanels), so the head and the
     complete stack release together after the last card. With JavaScript
     off, reduced motion, or a shorter or very wide screen, everything reads in
     normal flow (or with the stack alone). */
  @media (min-width: 60rem) and (min-height: 82rem) and (max-aspect-ratio: 2/1) and (prefers-reduced-motion: no-preference) {
    :global(.js) .work {
      --stack-top: calc(var(--work-top) + var(--head-h) + var(--work-gap));
      --card-room: calc(var(--view-h) - var(--stack-top) - 2 * var(--peek) - var(--work-foot));
      /* A short run between cards keeps the pinned sequence brief; the next
         card waits just below the frame, so the opening view is clean. */
      --stack-gap: calc(var(--work-foot) + 2 * var(--peek) + 1rem);
    }

    :global(.js) .work__track {
      display: flex;
      flex-direction: column;
    }

    :global(.js) .work__head {
      position: sticky;
      top: var(--work-top);
      z-index: 1;
      margin-bottom: calc(var(--card-h) + var(--stack-rest) + var(--work-gap));
    }

    :global(.js) .work__track > :global(.catalog) {
      margin-top: calc(-1 * (var(--card-h) + var(--stack-rest)));
    }
  }
</style>
