---
/**
 * The Road Here (Phase 3A draft, October 2026; V1.7 build): John's career before
 * Web3, as one editorial page in five sections: the hero, from music school to the
 * road (the live, television and festival evidence), more than the drummer (the four areas of the business
 * he ran), the 2020 pivot (a quiet timeline from the road into DeFi), and where it
 * led, back to the selected work. Then the shared Contact (as on the homepage) and
 * the footer. V1.7: no numbered eyebrows or chapter navigation; each headline
 * carries one accent phrase; at most one bold phrase a paragraph.
 *
 * Draft status: unlinked from the homepage and navigation, marked noindex and kept
 * out of the sitemap (astro.config.mjs) until John approves it.
 *
 * Words: src/data/road.json. Photographs: assets.json road-* entries, through
 * RoadFrame (a labeled placeholder until each photograph is supplied). Motion is
 * restrained: one reveal as each block comes into view, a gentle drift on the
 * photographs, the timeline's line drawing down and then a slow pulse rising along
 * it (V1.8), lighting each milestone it passes; all of it off with reduced
 * motion or without scripts. Privacy: the band is never named here or in metadata.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Contact from '@components/Contact.astro';
import RoadFrame from '@components/road/RoadFrame.astro';
import Icon from '@components/Icon.astro';
import { Picture } from 'astro:assets';
import { getAsset, resolveImage } from '@lib/assets';
import road from '@data/road.json';
import { withBase } from '@lib/paths';

const { meta, hero, school, operator, pivot, led } = road;
// A headline split around its accent phrase (which must appear in it).
const accented = (headline: string, accent: string, where: string): [string, string, string] => {
  const i = headline.indexOf(accent);
  if (i < 0) throw new Error(`[road] the ${where} accent must appear in its headline`);
  return [headline.slice(0, i), accent, headline.slice(i + accent.length)];
};
// **text** is set in bold; one phrase a paragraph at most.
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
const [headLead, headAccent] = accented(hero.headline, hero.accent, 'hero');
const H = {
  school: accented(school.headline, school.accent, 'school'),
  operator: accented(operator.headline, operator.accent, 'operator'),
  pivot: accented(pivot.headline, pivot.accent, 'pivot'),
  led: accented(led.headline, led.accent, 'led'),
};
// The hero figure (V1.8): a transparent cutout, set like the homepage portrait rather than in a frame.
const heroEntry = getAsset(hero.image);
const heroImg = resolveImage(heroEntry);
if (!heroImg) throw new Error('[road] the hero cutout is missing');
type GroupIcon = 'route' | 'pen' | 'users' | 'broadcast';
const groups = operator.groups as Array<{ title: string; items: string[]; icon: GroupIcon }>;
---

<BaseLayout title={meta.title} description={meta.description} path="/the-road-here/" noindex footerSurface="brand">
  <article class="road" aria-labelledby="road-title">
    {/* Hero */}
    <section class="road-hero" data-surface="dark" aria-labelledby="road-title">
      <div class="container road-hero__grid">
        <div class="road-hero__copy">
          <h1 id="road-title" class="display road-hero__title road-reveal">
            {headLead}<span class="road-accent">{headAccent}</span>
          </h1>
          <p class="lede road-hero__lede road-reveal">{rich(hero.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        {/* The figure stands on the hero's lower edge, out of any frame (V1.8). */}
        <div class="road-hero__figure">
          <Picture
            src={heroImg}
            alt={heroEntry.alt}
            widths={[480, 720, 890]}
            sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 26rem, 88vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            class="road-hero__img"
          />
        </div>
      </div>
    </section>

    {/* From music school to the road */}
    <section id="road-school" class="section road-school" data-surface="light" aria-labelledby="road-school-title">
      <div class="container">
        <div class="road-school__grid">
          <div class="road-school__copy">
            <h2 id="road-school-title" class="display display-lg road-reveal">{H.school[0]}<span class="road-accent">{H.school[1]}</span>{H.school[2]}</h2>
            <div class="prose road-reveal">
              {school.paragraphs.map((p) => <p>{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
            </div>
          </div>
        </div>
        {/* Three pieces of real evidence (V1.8): the live performance, large and centered, with the television
            appearance and the festival poster (cropped above its lower-tier names) laid over its opposite outer
            edges, clear of John and the kit. Phones: stacked in that order, without overlap. */}
        <div class="road-stage">
          <RoadFrame id={school.image} class="road-stage__live road-reveal" drift sizes="(min-width: 64rem) 38rem, (min-width: 40rem) 62vw, 100vw" />
          <RoadFrame id={school.tv} class="road-stage__card road-stage__tv road-reveal" sizes="(min-width: 64rem) 16rem, (min-width: 40rem) 26vw, 82vw" />
          <RoadFrame id={school.festival} class="road-stage__card road-stage__festival road-reveal" sizes="(min-width: 64rem) 18rem, (min-width: 40rem) 28vw, 82vw" />
        </div>
      </div>
    </section>

    {/* More than the drummer */}
    <section id="road-operator" class="section road-operator" data-surface="soft" aria-labelledby="road-operator-title">
      <div class="container">
        <div class="road-operator__head">
          <div>
            <h2 id="road-operator-title" class="display display-lg road-reveal">{H.operator[0]}<span class="road-accent">{H.operator[1]}</span>{H.operator[2]}</h2>
            <p class="lede road-reveal">{rich(operator.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
          </div>
          {/* No drift: the whole kit stays in frame. */}
          <RoadFrame id={operator.image} class="road-operator__image road-reveal" sizes="(min-width: 64rem) 45vw, 100vw" />
        </div>
        <ul class="road-groups">
          {groups.map((g) => (
            <li class="road-group road-reveal">
              <span class="road-group__icon" aria-hidden="true"><Icon name={g.icon} size={18} /></span>
              <h3 class="road-group__title">{g.title}</h3>
              <ul class="road-group__items">
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* The 2020 pivot */}
    <section id="road-pivot" class="section road-pivot" data-surface="dark" aria-labelledby="road-pivot-title">
      <div class="container road-pivot__grid">
        <div class="road-pivot__copy">
          <h2 id="road-pivot-title" class="display display-lg road-reveal">{H.pivot[0]}<span class="road-accent">{H.pivot[1]}</span>{H.pivot[2]}</h2>
          <div class="prose road-reveal">
            {pivot.paragraphs.map((p) => <p>{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
          </div>
        </div>
        <ol class="road-timeline" data-road-timeline aria-label="From the road to Web3">
          {pivot.timeline.map((t) => (
            <li class="road-timeline__item road-reveal">
              <span class="road-timeline__when">{t.when}</span>
              <span class="road-timeline__what">{t.what}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Where it led */}
    <section id="road-led" class="section road-led" data-surface="light-return" aria-labelledby="road-led-title">
      <div class="container">
        <div class="road-led__head">
          <h2 id="road-led-title" class="display display-xl road-reveal">{H.led[0]}<span class="road-accent">{H.led[1]}</span>{H.led[2]}</h2>
          <p class="lede road-reveal">{rich(led.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        <ul class="road-pairs" aria-label="Then and now">
          {led.pairs.map((p) => (
            <li class="road-pair road-reveal">
              <span class="road-pair__then"><span class="sr-only">Then: </span>{p.then}</span>
              <span class="road-pair__arrow" aria-hidden="true">→</span>
              <span class="road-pair__now"><span class="sr-only">Now: </span>{p.now}</span>
            </li>
          ))}
        </ul>
        <div class="road-led__actions road-reveal">
          <a class="btn btn--primary" href={withBase(led.cta.href)}>{led.cta.label}</a>
          <a class="btn btn--secondary" href={withBase(led.secondary.href)}>{led.secondary.label}</a>
        </div>
      </div>
    </section>
  </article>

  {/* The shared Contact, exactly as the homepage sets it (V1.7). */}
  <div class="chapter" data-surface="brand">
    <Contact />
  </div>
</BaseLayout>

<script>
  // Restrained motion: each block reveals once as it comes into view; the photographs drift gently with the
  // scroll; the timeline's line draws down as the section arrives. Reduced motion, no IntersectionObserver
  // or no scripts: everything is simply shown.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLElement>('.road-reveal')];
  const timeline = document.querySelector<HTMLElement>('[data-road-timeline]');
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
    timeline?.classList.add('is-in');
  } else {
    document.documentElement.classList.add('road-motion');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));
    if (timeline) io.observe(timeline);

    const drift = [...document.querySelectorAll<HTMLElement>('[data-road-drift]')];
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const el of drift) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2); // -1 .. 1 across the screen
        el.style.setProperty('--drift', `${(-p * 3).toFixed(2)}%`);
      }
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();

    // The living timeline (V1.8). Once the line has drawn, a soft accent pulse travels up it from the bottom;
    // each milestone it passes brightens briefly (its node, year and words). Then a long rest, and again, only
    // while the section is on screen and the tab is visible. Reduced motion or no scripts: a static timeline.
    if (timeline) {
      const nodes = [...timeline.querySelectorAll<HTMLElement>('.road-timeline__item')];
      const TRAVEL = 2800; // ms, bottom to top
      const REST = 4800; // ms between pulses
      const FIRST = 1500; // ms after the line starts drawing
      let visible = false;
      let running = false;
      let frame = 0;
      let timer = 0;
      const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

      const geometry = () => {
        const box = timeline.getBoundingClientRect();
        const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        const inset = rem * 0.45;
        const top = inset;
        const bottom = box.height - inset;
        const centers = nodes.map((n) => {
          const r = n.getBoundingClientRect();
          return r.top - box.top + rem * 0.3 + 5.5; // the node's center: 0.3rem down, half of an 11px dot
        });
        return { top, bottom, centers };
      };

      const light = (n: HTMLElement) => {
        n.classList.add('is-lit');
        window.setTimeout(() => n.classList.remove('is-lit'), 1300);
      };

      const cycle = () => {
        if (!visible || document.hidden) {
          running = false;
          return;
        }
        running = true;
        const g = geometry();
        const lit = new Set<number>();
        const start = performance.now();
        const step = (now: number) => {
          if (!visible || document.hidden) {
            timeline.style.setProperty('--pulse-o', '0');
            running = false;
            return;
          }
          const t = Math.min(1, (now - start) / TRAVEL);
          const y = g.bottom - ease(t) * (g.bottom - g.top);
          timeline.style.setProperty('--pulse-y', `${y.toFixed(1)}px`);
          timeline.style.setProperty('--pulse-o', String(Math.min(1, t * 6, (1 - t) * 6)));
          g.centers.forEach((c, i) => {
            if (!lit.has(i) && y <= c + 4) {
              lit.add(i);
              light(nodes[i]);
            }
          });
          if (t < 1) frame = requestAnimationFrame(step);
          else {
            timeline.style.setProperty('--pulse-o', '0');
            timer = window.setTimeout(cycle, REST);
          }
        };
        frame = requestAnimationFrame(step);
      };

      const stop = () => {
        cancelAnimationFrame(frame);
        window.clearTimeout(timer);
        timeline.style.setProperty('--pulse-o', '0');
        running = false;
      };

      let first = true;
      const watch = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            visible = e.isIntersecting;
            if (visible && !running) {
              window.clearTimeout(timer);
              timer = window.setTimeout(cycle, first ? FIRST : 700);
              first = false;
            } else if (!visible) stop();
          }
        },
        { threshold: 0.35 },
      );
      watch.observe(timeline);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (visible && !running) timer = window.setTimeout(cycle, 700);
      });
    }
  }
</script>

<style>
  .road {
    margin-top: calc(-1 * var(--header-row));
  }

  .road-accent {
    color: var(--accent-ink);
  }

  /* Bold for factual proof and key responsibilities: one phrase a paragraph. */
  .road strong {
    font-weight: 700;
    color: var(--heading);
  }

  /* ---- reveal: a short rise and fade, once ---- */
  :global(html.road-motion .road-reveal) {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 700ms var(--ease-out),
      translate 700ms var(--ease-out);
  }

  :global(html.road-motion .road-reveal.is-in) {
    opacity: 1;
    translate: 0 0;
  }

  /* ---- hero ---- */
  /* The figure stands on the section's lower edge, so the hero has no bottom
     padding of its own; the copy keeps its room. */
  .road-hero {
    padding-top: calc(var(--header-row) + clamp(2.5rem, 6vw, 6rem));
    padding-bottom: 0;
    min-height: min(100svh, 62rem);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }

  .road-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    width: 100%;
  }

  .road-hero__copy {
    align-self: center;
  }

  .road-hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .road-hero__title {
    font-size: var(--text-4xl);
    line-height: 0.95;
  }

  .road-hero__lede {
    max-width: 34rem;
  }

  /* The cutout, homepage style: no frame, card or shadow. Phones and tablets:
     centered under the copy, sized so his face, the cymbal and his hands are
     whole. Desktop: anchored bottom right, as tall as the room under the
     header allows, clear of the navigation and the headline. */
  .road-hero__figure {
    justify-self: center;
    width: min(88vw, 26rem);
    line-height: 0;
  }

  .road-hero__figure :global(picture),
  .road-hero__figure :global(.road-hero__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 64rem) {
    .road-hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      min-height: calc(min(100svh, 62rem) - var(--header-row) - clamp(2.5rem, 6vw, 6rem));
    }

    .road-hero__copy {
      padding-bottom: clamp(3rem, 6vw, 6rem);
    }

    /* As tall as the frame below the header allows, rising into the hero's top
       padding (never under the navigation), so the hero is one screen. */
    .road-hero__figure {
      justify-self: end;
      width: auto;
      height: min(calc(min(100svh, 62rem) - var(--header-row) - 1.5rem), 56rem);
      aspect-ratio: 890 / 1480;
      margin-top: calc(-1 * (clamp(2.5rem, 6vw, 6rem) - 1.5rem));
    }

    .road-hero__figure :global(picture),
    .road-hero__figure :global(.road-hero__img) {
      height: 100%;
      width: auto;
    }
  }

  /* ---- from music school to the road ---- */
  .road-school__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .road-school__copy {
    display: grid;
    gap: var(--space-5);
  }

  /* Desktop: the headline and the copy side by side above the composition. */
  @media (min-width: 64rem) {
    .road-school__copy {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }

  /* The layered composition (V1.8). Phones: stacked, live performance first,
     the two cards a little narrower and alternating sides, no overlap. */
  .road-stage {
    display: grid;
    gap: clamp(1.25rem, 4vw, 1.75rem);
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .road-stage :global(.road-stage__card) {
    width: 82%;
    padding: 6px;
    background: var(--bg-elev);
    border-radius: calc(var(--radius) + 6px);
    box-shadow: var(--shadow-lg);
  }

  .road-stage :global(.road-stage__tv) {
    justify-self: start;
    rotate: -1.5deg;
  }

  .road-stage :global(.road-stage__festival) {
    justify-self: end;
    rotate: 1.5deg;
  }

  /* From 40rem: the live performance large and centered; the television card
     over its lower-left edge and the festival poster over its upper-right edge
     (empty stage darkness there), each overlapping by a little over a tenth of
     its width, so neither touches John, the kit or the riser. */
  @media (min-width: 40rem) {
    .road-stage {
      display: block;
      position: relative;
      width: min(100%, 66rem);
      margin-inline: auto;
      padding-block: clamp(1rem, 3vw, 2.5rem);
    }

    .road-stage :global(.road-stage__live) {
      width: min(60%, 38rem);
      margin-inline: auto;
    }

    .road-stage :global(.road-stage__card) {
      position: absolute;
    }

    .road-stage :global(.road-stage__tv) {
      width: 25%;
      left: 0;
      bottom: 12%;
    }

    .road-stage :global(.road-stage__festival) {
      width: 27%;
      right: 0;
      top: 9%;
    }
  }

  /* ---- more than the drummer ---- */
  .road-operator__head {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
  }

  .road-operator__head > div {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .road-operator__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .road-groups {
    list-style: none;
    margin: clamp(3rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }

  /* Two by two, then four across once each card is wide enough that every
     title (the longest is "Business and relationships") holds one line, a step
     smaller there; headings and lists start level across the row (V1.7). */
  @media (min-width: 40rem) {
    .road-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 85rem) {
    .road-groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .road-group {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  /* One restrained line icon a card, in the accent, in a fine circle. */
  .road-group__icon {
    display: inline-grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    margin-bottom: var(--space-2);
    border: 1px solid var(--accent-line);
    border-radius: 50%;
    color: var(--accent);
  }

  .road-group__icon :global(svg) {
    display: block;
  }

  .road-group__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-lg);
    line-height: 1.1;
    color: var(--heading);
  }

  @media (min-width: 85rem) {
    .road-group__title {
      font-size: 1.3125rem;
      white-space: nowrap;
    }
  }

  .road-group__items {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .road-group__items li {
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
  }

  /* ---- the 2020 pivot ---- */
  .road-pivot__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .road-pivot__copy {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .road-pivot__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }

  .road-timeline {
    --dot: 11px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 calc(var(--dot) + 1.5rem);
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* The understated line: drawn down once as the section arrives. */
  .road-timeline::before {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 0.5px);
    top: 0.45rem;
    bottom: 0.45rem;
    width: 1px;
    background: linear-gradient(var(--line-strong), var(--accent));
    transform-origin: top;
  }

  :global(html.road-motion) .road-timeline::before {
    scale: 1 0;
    transition: scale 1400ms var(--ease-out);
  }

  :global(html.road-motion) .road-timeline.is-in::before {
    scale: 1 1;
  }

  /* The traveling pulse (V1.8): a short, soft accent segment on the line, head
     up, moved by the script (--pulse-y is its center); invisible at rest and
     with reduced motion or no scripts. */
  .road-timeline::after {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 1.5px);
    top: calc(var(--pulse-y, 0px) - 2.25rem);
    width: 3px;
    height: 4.5rem;
    border-radius: 3px;
    background: linear-gradient(to top, transparent, color-mix(in srgb, var(--accent) 75%, transparent) 65%, var(--accent-ink));
