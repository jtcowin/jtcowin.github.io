---
/**
 * The Road Here (Phase 3A, October 2026; V1.7 build; launched V1.18): John's career before
 * Web3, as one editorial page in five sections: the hero, from music school to the
 * road (the live, television and festival evidence), more than the drummer (the four areas of the business
 * he ran), the 2020 pivot (a quiet timeline from the road into DeFi), and where it
 * led, back to the selected work. Then the shared Contact (as on the homepage) and
 * the footer. V1.7: no numbered eyebrows or chapter navigation; each headline
 * carries one accent phrase (V1.16: paragraphs marked road-rich carry several approved bold phrases).
 *
 * Status: live (V1.18, November 2026). Indexed, in the sitemap, canonical on
 * johncowin.com, and linked from the homepage's About section.
 *
 * Words: src/data/road.json. Photographs: assets.json road-* entries, through
 * RoadFrame (a labeled placeholder until each photograph is supplied). Motion is
 * restrained: one reveal as each block comes into view, a gentle drift on the
 * live photograph, the timeline following the scroll from top to bottom, and the
 * capability rail (4.5s) and the Then to Now panel (4s, V1.13) advancing while
 * in view and idle; all of it off with reduced motion, and without scripts everything is
 * laid out open and static. Privacy: the band is never named here or in metadata.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Contact from '@components/Contact.astro';
import RoadFrame from '@components/road/RoadFrame.astro';
import Icon from '@components/Icon.astro';
import { Picture } from 'astro:assets';
import { getAsset, resolveImage } from '@lib/assets';
import road from '@data/road.json';
import { withBase } from '@lib/paths';

const { meta, hero, school, operator, pivot, led } = road;
// A headline split around its accent phrase (which must appear in it).
const accented = (headline: string, accent: string, where: string): [string, string, string] => {
  const i = headline.indexOf(accent);
  if (i < 0) throw new Error(`[road] the ${where} accent must appear in its headline`);
  return [headline.slice(0, i), accent, headline.slice(i + accent.length)];
};
// **text** is set in bold; one phrase a paragraph at most.
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
const [headLead, headAccent] = accented(hero.headline, hero.accent, 'hero');
const H = {
  school: accented(school.headline, school.accent, 'school'),
  operator: accented(operator.headline, operator.accent, 'operator'),
  pivot: accented(pivot.headline, pivot.accent, 'pivot'),
  led: accented(led.headline, led.accent, 'led'),
};
// The hero figure (V1.8): a transparent cutout, set like the homepage portrait rather than in a frame.
const heroEntry = getAsset(hero.image);
const heroImg = resolveImage(heroEntry);
if (!heroImg) throw new Error('[road] the hero cutout is missing');
// Section 2's image group (V1.15): the live photograph and John's three transparent prints, as supplied.
const stagePhoto = (id: string) => {
  const entry = getAsset(id);
  const image = resolveImage(entry);
  if (!image) throw new Error(`[road] Section 2 needs the approved image ${id}`);
  return { entry, image };
};
const stage = {
  live: stagePhoto(school.stage.live),
  overlays: school.stage.overlays.map((o) => ({ slot: o.slot, ...stagePhoto(o.asset) })),
};
const stageWidths = (w: number, max: number) => [320, 480, 640, 800, 1024].filter((x) => x < Math.min(w, max)).concat(Math.min(w, max));
// The capability rail (V1.12): a short label for each collapsed panel, the full title in the open one.
const groups = operator.groups as Array<{ label: string; title: string; items: string[]; icon: 'route' | 'pen' | 'users' | 'broadcast' }>;
// V1.13: each open title grows from its collapsed label ("Operations" → "Operations and Touring").
groups.forEach((g) => {
  if (!g.title.startsWith(`${g.label} `)) throw new Error(`[road] the title "${g.title}" must begin with its label "${g.label}"`);
});
type MilestoneIcon = 'education' | 'launch' | 'touring' | 'stage' | 'globe' | 'television' | 'paused' | 'discover' | 'chain';
const timeline = pivot.timeline as Array<{ when: string; what: string; icon: MilestoneIcon }>;
---

<BaseLayout title={meta.title} description={meta.description} path="/the-road-here/" footerSurface="brand">
  <article class="road" aria-labelledby="road-title">
    {/* Hero */}
    <section class="road-hero" data-surface="dark" aria-labelledby="road-title">
      <div class="container road-hero__grid">
        <div class="road-hero__copy">
          <h1 id="road-title" class="display road-hero__title road-reveal">
            <span class="road-hero__line">{headLead.trim()}</span>{' '}<span class="road-hero__line road-accent">{headAccent}</span>
          </h1>
          <p class="road-rich lede road-hero__lede road-reveal">{rich(hero.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        {/* The figure stands on the hero's lower edge, out of any frame (V1.8). */}
        <div class="road-hero__figure">
          <Picture
            src={heroImg}
            alt={heroEntry.alt}
            widths={[480, 720, 890]}
            sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 26rem, 88vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            class="road-hero__img"
          />
        </div>
      </div>
    </section>

    {/* From music school to the road (V1.15: copy left, the live photograph and its three prints right) */}
    <section id="road-school" class="section road-school" data-surface="light" aria-labelledby="road-school-title">
      <div class="container road-school__grid">
        <div class="road-school__copy">
          <h2 id="road-school-title" class="display display-lg road-reveal">{H.school[0]}<span class="road-accent">{H.school[1]}</span>{H.school[2]}</h2>
          <div class="prose road-reveal">
            {school.paragraphs.map((p) => <p class="road-rich road-body">{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
          </div>
        </div>
        {/* The image group (V1.15): the live performance photograph is the dominant base; John's three supplied
            transparent prints sit over its corners (the poster upper right, the television still lower left, the
            credential lower right), rotated a little, with soft shadows. Placed in % of the group, so it scales
            as one: beside the copy on desktop, below it on phones and tablets. */}
        <div class="road-stage">
          <div class="road-stage__live road-reveal">
            <Picture src={stage.live.image} alt={stage.live.entry.alt} widths={stageWidths(stage.live.image.width, 1024)} sizes="(min-width: 56rem) 28rem, 76vw" formats={['avif', 'webp']} loading="lazy" />
          </div>
          {stage.overlays.map((o, i) => (
            <div class:list={['road-stage__print road-reveal', `road-stage__print--${o.slot}`]} style={`--i: ${i + 1}`}>
              <Picture src={o.image} alt={o.entry.alt} widths={stageWidths(o.image.width, 1200)} sizes="(min-width: 56rem) 18rem, 46vw" formats={['avif', 'webp']} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* More than the drummer */}
    <section id="road-operator" class="section road-operator" data-surface="soft" aria-labelledby="road-operator-title">
      <div class="container">
        <div class="road-operator__head">
          <div class="road-operator__copy">
            <h2 id="road-operator-title" class="display display-lg road-reveal"><span class="road-operator__line">{H.operator[0].trim()}</span>{' '}<span class="road-operator__line road-accent">{H.operator[1]}</span>{H.operator[2]}</h2>
            <p class="road-rich road-body road-operator__lede road-reveal">{rich(operator.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
          </div>
          {/* No drift: the whole kit stays in frame. */}
          <RoadFrame id={operator.image} class="road-operator__image road-reveal" sizes="(min-width: 64rem) 45vw, 100vw" />
        </div>
        {/* The capability rail (V1.12): four adjacent panels, one open at a time. Desktop: a stable-height row in
            which the open panel takes about 44% and shows its full title and list, while the other three keep their
            short labels; it advances every 4.5s while in view and idle, and hover, focus or a tap opens a panel at
            once. Phones and tablets: a vertical accordion that never cycles on its own. Collapsed lists stay in the
            accessible text; without scripts all four are simply laid out open. */}
        <div class="road-rail road-reveal" data-road-rail>
          {groups.map((g, i) => (
            <div class:list={['road-rail__panel', { 'is-open': i === 0 }]} data-panel={i}>
              <span class="road-rail__progress" aria-hidden="true"></span>
              <Icon name={g.icon} size={288} class="road-rail__mark" />
              <h3 class="road-rail__head">
                <button type="button" class="road-rail__btn" id={`road-rail-btn-${i}`} aria-controls={`road-rail-list-${i}`} aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span class="road-rail__title"><span class="road-rail__first">{g.label}</span><span class="road-rail__rest">{g.title.slice(g.label.length).replace(/^ /, '\u00a0')}</span></span>
                  <Icon name="chevron-down" size={16} class="road-rail__chev" />
                </button>
              </h3>
              <div class="road-rail__content" id={`road-rail-list-${i}`}>
                <ul class="road-rail__items">
                  {g.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* The 2020 pivot */}
    <section id="road-pivot" class="section road-pivot" data-surface="dark" aria-labelledby="road-pivot-title">
      <div class="container road-pivot__grid">
        <div class="road-pivot__copy">
          <h2 id="road-pivot-title" class="display display-lg road-reveal">{H.pivot[0]}<span class="road-accent">{H.pivot[1]}</span>{H.pivot[2]}</h2>
          <div class="prose road-reveal">
            {pivot.paragraphs.map((p) => <p class="road-rich road-body">{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
          </div>
        </div>
        {/* The timeline (V1.9; V1.12 branches and icons): a central spine, milestones alternating left and right on
            dotted branches, each ending in one small outline icon for the milestone, in order from top to bottom.
            Scroll sets the active milestone, the spine filling down to it. */}
        <ol class="road-tl road-reveal" data-road-timeline aria-label="From the road to Web3">
          {timeline.map((t, i) => (
            <li class:list={['road-tl__item', i % 2 ? 'road-tl__item--right' : 'road-tl__item--left']} tabindex="0" data-step={i}>
              <span class="road-tl__node" aria-hidden="true"></span>
              <div class="road-tl__body">
                <span class="road-tl__icon" aria-hidden="true"><Icon name={t.icon} size={18} /></span>
                <span class="road-tl__when">{t.when}</span>
                <span class="road-tl__what">{t.what}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Where it led */}
    <section id="road-led" class="section road-led" data-surface="light-return" aria-labelledby="road-led-title">
      <div class="container">
        <div class="road-led__head">
          <h2 id="road-led-title" class="display display-lg road-led__title road-reveal"><span class="road-led__line">{H.led[0].trim()}</span>{' '}<span class="road-led__line road-accent">{H.led[1]}</span>{H.led[2]}</h2>
          <p class="road-rich road-body road-reveal">{rich(led.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        {/* Then to Now (V1.13): one wide framed panel of four mappings, each on one row: the music-career origin,
            a connector pointing right, and today's work, in stronger type. One row at a time is highlighted, top to
            bottom, every 4s while in view and idle, its connector drawing left to right; hover or focus takes a
            row and pauses the cycle until the interaction ends. Phones: each mapping stacks inside its row and the
            cycle continues. Reduced motion or no scripts: static, every row equally readable. */}
        <div class="road-shift road-reveal">
          <p class="road-shift__ends" aria-hidden="true"><span>Then</span><span>Now</span></p>
          <ol class="road-shift__rows" data-road-shift aria-label="Then and now">
            {led.pairs.map((p) => (
              <li class="road-shift__row">
                <button type="button" class="road-shift__btn">
                  <span class="road-shift__then"><span class="sr-only">Then: </span>{p.then}</span>
                  <span class="road-shift__link" aria-hidden="true"><span class="road-shift__fill"></span></span>
                  <span class="road-shift__now"><span class="sr-only">Now: </span>{p.now}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
        <div class="road-led__actions road-reveal">
          <a class="btn btn--primary" href={withBase(led.cta.href)}>{led.cta.label}</a>
          <a class="btn btn--secondary" href={withBase(led.secondary.href)}>{led.secondary.label}</a>
        </div>
      </div>
    </section>
  </article>

  {/* The shared Contact, exactly as the homepage sets it (V1.7). */}
  <div class="chapter" data-surface="brand">
    <Contact />
  </div>
</BaseLayout>

<script>
  // Restrained motion: each block reveals once as it comes into view and the live photograph drifts gently with the
  // scroll. Three components: the capability rail (4.5s, V1.12) and Then to Now (4s, V1.13) each advance on a calm
  // sequence that any hover, focus or tap overrides; the timeline follows the scroll from top to bottom. Reduced motion, no
  // IntersectionObserver or no scripts: everything is simply shown, complete and static.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLElement>('.road-reveal')];
  const motion = !reduce && 'IntersectionObserver' in window;

  if (!motion) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    document.documentElement.classList.add('road-motion');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));

    const drift = [...document.querySelectorAll<HTMLElement>('[data-road-drift]')];
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const el of drift) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2); // -1 .. 1 across the screen
        el.style.setProperty('--drift', `${(-p * 3).toFixed(2)}%`);
      }
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }

  // ---- A calm, interruptible sequence (V1.12), shared by the capability rail and Then to Now: it runs only
  // while its component is on screen, the tab is visible, nothing is under the pointer or in focus, nothing has been
  // chosen by a click or tap, and the layout allows it. Reduced motion never starts it. By default it advances on
  // a timer (4.5s unless given); with `onRun` the caller is told when it runs or pauses and advances itself (the rail follows
  // its progress bar, so the two can never drift apart).
  const STEP = 4500;
  const sequence = (root: HTMLElement, wide: MediaQueryList, advance: () => void, onRun?: (running: boolean) => void, onUnpin?: () => void, step = STEP) => {
    let visible = false;
    let hover = false;
    let focus = false;
    let pinned = false;
    let timer = 0;
    const idle = () => visible && !hover && !focus && !pinned && wide.matches && !document.hidden && !reduce;
    const arm = () => {
      if (onRun) return onRun(idle());
      window.clearTimeout(timer);
      if (idle()) timer = window.setTimeout(tick, step);
    };
    const tick = () => {
      if (!idle()) return;
      advance();
      arm();
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          visible = entries.some((e) => e.isIntersecting);
          if (!visible && pinned) {
            pinned = false; // a choice holds until the reader moves on
            onUnpin?.();
          }
          arm();
        },
        { threshold: 0.4 },
      ).observe(root);
    }
    root.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') { hover = true; arm(); }
    });
    root.addEventListener('pointerleave', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') { hover = false; arm(); }
    });
    root.addEventListener('focusin', () => { focus = true; arm(); });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) { focus = false; arm(); }
    });
    document.addEventListener('visibilitychange', arm);
    wide.addEventListener('change', arm);
    arm();
    return { pin: () => { pinned = true; arm(); } };
  };

  // ---- The capability rail (V1.12): exactly one panel open. Wide screens: the open panel's progress bar fills
  // along its top edge over 4.5s and, when full, the next panel opens; hover or focus opens a panel at once and
  // pauses the bar, which resumes on leaving; a tap or click keeps the choice (its bar shown full). Narrow screens:
  // an accordion, opened by tap or keyboard, that never cycles.
  const rail = document.querySelector<HTMLElement>('[data-road-rail]');
  if (rail) {
    const panels = [...rail.querySelectorAll<HTMLElement>('.road-rail__panel')];
    const buttons = panels.map((p) => p.querySelector<HTMLButtonElement>('.road-rail__btn')!);
    const wide = window.matchMedia('(min-width: 60rem)');
    let open = 0;
    const show = (k: number) => {
      if (k === open && panels[k].classList.contains('is-open')) return;
      open = k;
      panels.forEach((p, i) => {
        p.classList.toggle('is-open', i === k);
        buttons[i].setAttribute('aria-expanded', String(i === k));
      });
    };
    rail.classList.add('is-live');
    if (!reduce) rail.classList.add('is-auto');
    show(0);
    const seq = sequence(
      rail,
      wide,
      () => {},
      (running) => rail.classList.toggle('is-paused', !running),
      () => rail.classList.remove('is-pinned'),
    );
    panels.forEach((p, i) => {
      p.querySelector('.road-rail__progress')!.addEventListener('animationend', () => {
        if (p.classList.contains('is-open') && !rail.classList.contains('is-paused')) show((i + 1) % panels.length);
      });
      p.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse' && wide.matches) show(i);
      });
      buttons[i].addEventListener('focus', () => { if (wide.matches) show(i); });
      buttons[i].addEventListener('click', () => {
        show(i);
        rail.classList.add('is-pinned');
        seq.pin();
      });
      buttons[i].addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        buttons[(i + d + buttons.length) % buttons.length].focus();
      });
    });
  }

  // ---- The timeline (V1.10): driven by scroll, so the reader sets the pace. The milestone whose node has passed the
  // reading line (a little above the middle of the screen) is active, top to bottom; the spine fills down to it.
  // Hover, focus or a tap activates a milestone without moving the page; the next scroll hands control back.
  // Nothing runs while the timeline is off screen.
  const tl = document.querySelector<HTMLElement>('[data-road-timeline]');
  if (tl && motion) {
    const steps = [...tl.querySelectorAll<HTMLElement>('.road-tl__item')];
    tl.classList.add('is-live');
    let active = -2;
    let held = false;
    let frame = 0;
    const show = (k: number) => {
      if (k === active) return;
      active = k;
      steps.forEach((s, i) => {
        s.classList.toggle('is-active', i === k);
        s.classList.toggle('is-done', k >= 0 && i < k);
      });
    };
    const read = () => {
      frame = 0;
      if (held) return;
      const line = window.innerHeight * 0.48;
      let k = -1;
      steps.forEach((s, i) => {
        const node = s.querySelector<HTMLElement>('.road-tl__node');
        if (node && node.getBoundingClientRect().top <= line) k = i;
      });
      show(k);
    };
    const onScroll = () => {
      held = false;
      if (!frame) frame = requestAnimationFrame(read);
    };
    new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          onScroll();
        } else {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        }
      }
    }).observe(tl);

    const take = (i: number) => {
      held = true;
      show(i);
    };
    const release = () => {
      held = false;
      read();
    };
    steps.forEach((s, i) => {
      s.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') take(i);
      });
      s.addEventListener('focus', () => take(i));
      s.addEventListener('click', () => take(i));
    });
    tl.addEventListener('pointerleave', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse' && !tl.contains(document.activeElement)) release();
    });
    tl.addEventListener('focusout', (e) => {
      if (!tl.contains(e.relatedTarget as Node | null)) release();
    });
  }

  // ---- Then to Now (V1.13): the first row is highlighted as the panel comes into view, then each in turn, top to
  // bottom, every 4s while in view and idle, on every screen size. Hover or focus takes a row and pauses the cycle,
  // which resumes when the interaction ends. Reduced motion: static.
  const shift = document.querySelector<HTMLElement>('[data-road-shift]');
  if (shift && !reduce) {
    const rows = [...shift.querySelectorAll<HTMLElement>('.road-shift__row')];
    let on = -1;
    const show = (k: number) => {
      on = k;
      rows.forEach((r, i) => r.classList.toggle('is-on', i === k));
    };
    shift.classList.add('is-live');
    sequence(shift, window.matchMedia('all'), () => show((on + 1) % rows.length), undefined, undefined, 4000);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries, obs) => {
          if (entries.some((e) => e.isIntersecting) && on < 0) {
            obs.disconnect();
            show(0);
          }
        },
        { threshold: 0.4 },
      ).observe(shift);
    }
    rows.forEach((r, i) => {
      r.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') show(i);
      });
      const btn = r.querySelector<HTMLButtonElement>('.road-shift__btn')!;
      btn.addEventListener('focus', () => show(i));
      btn.addEventListener('click', () => show(i));
    });
  }
</script>

<style>
  /* One body style for the page's section paragraphs (V1.17): the size the
     longer copy already used (--text-md with relaxed leading), set once here
     and applied by .road-body in Sections 2 to 5. The hero's opening
     paragraph keeps the larger lede size as the page's introduction, and the
     shared Contact keeps its own. */
  .road {
    --road-body-size: var(--text-md);
    --road-body-leading: var(--leading-relaxed);
    margin-top: calc(-1 * var(--header-row));
  }

  .road-body {
    font-size: var(--road-body-size);
    line-height: var(--road-body-leading);
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: var(--measure);
  }

  .road-accent {
    color: var(--accent-ink);
  }

  /* Bold for factual proof and key responsibilities: one phrase a paragraph. */
  .road strong {
    font-weight: 700;
    color: var(--heading);
  }

  /* ---- reveal: a short rise and fade, once ---- */
  :global(html.road-motion .road-reveal) {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 700ms var(--ease-out),
      translate 700ms var(--ease-out);
  }

  :global(html.road-motion .road-reveal.is-in) {
    opacity: 1;
    translate: 0 0;
  }

  /* ---- hero ---- */
  /* The figure stands on the section's lower edge, so the hero has no bottom
     padding of its own; the copy keeps its room. */
  .road-hero {
    padding-top: calc(var(--header-row) + clamp(2.5rem, 6vw, 6rem));
    padding-bottom: 0;
    min-height: min(100svh, 62rem);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }

  .road-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    width: 100%;
  }

  .road-hero__copy {
    align-self: center;
  }

  .road-hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .road-hero__title {
    font-size: var(--text-4xl);
    line-height: 0.95;
  }

  /* V1.10: two intentional lines, "Before Web3." over "There was music."; from
     40rem each line holds whole, and on the narrowest phones a line may wrap
     within itself, keeping the order. */
  .road-hero__line {
    display: block;
  }

  @media (min-width: 40rem) {
    .road-hero__line {
      white-space: nowrap;
    }
  }

  .road-hero__lede {
    max-width: 34rem;
  }

  /* The cutout, homepage style: no frame, card or shadow. Phones and tablets:
     centered under the copy, sized so his face, the cymbal and his hands are
     whole. Desktop: anchored bottom right, as tall as the room under the
     header allows, clear of the navigation and the headline. */
  .road-hero__figure {
    justify-self: center;
    width: min(88vw, 26rem);
    line-height: 0;
  }

  .road-hero__figure :global(picture),
  .road-hero__figure :global(.road-hero__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 64rem) {
    .road-hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      min-height: calc(min(100svh, 62rem) - var(--header-row) - clamp(2.5rem, 6vw, 6rem));
    }

    .road-hero__copy {
      padding-bottom: clamp(3rem, 6vw, 6rem);
    }

    /* As tall as the frame below the header allows, rising into the hero's top
       padding (never under the navigation), so the hero is one screen. */
    .road-hero__figure {
      justify-self: end;
      width: auto;
      height: min(calc(min(100svh, 62rem) - var(--header-row) - 1.5rem), 56rem);
      aspect-ratio: 890 / 1480;
      margin-top: calc(-1 * (clamp(2.5rem, 6vw, 6rem) - 1.5rem));
    }

    .road-hero__figure :global(picture),
    .road-hero__figure :global(.road-hero__img) {
      height: 100%;
      width: auto;
    }
  }

  /* ---- from music school to the road (V1.9) ---- */
  .road-school__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .road-school__copy {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  /* Two columns while both stay readable (V1.14): the copy 42%, the image
     group 58%, the copy centered against it. Below 56rem: copy first, then
     the image group, scaled as one. */
  @media (min-width: 56rem) {
    .road-school__grid {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
      column-gap: clamp(2rem, 3.5vw, 4rem);
      align-items: center;
    }
  }

  /* One desktop screen (V1.17, corrected in V1.19): from 56rem, on screens
     at least 40rem tall. The header floats over the page (sticky, taking the
     surface beneath it), so the section's resting position is flush with
     the top of the screen with the header over its top edge, as About on
     the homepage. The section is therefore one full viewport tall
     (border-box) and reserves the header's height inside its top padding;
     the content is centered in the room below the header. The image group
     is sized to that room (less the section's padding), up to 48rem wide,
     so the content always fits; min-height keeps the section a full screen
     even where the 48rem cap leaves the group smaller. In-page links land
     flush too. Phones and short screens keep the natural height. (V1.17
     sized the section to the viewport minus the header, which left the
     header's 68px of Section 3 showing at the foot and put the collage's
     top under the header.) */
  @media (min-width: 56rem) and (min-height: 40rem) {
    .road-school {
      --s2-pad: clamp(1.5rem, 4.5svh, 3.25rem);
      box-sizing: border-box;
      min-height: 100svh;
      padding-block: calc(var(--header-row) + var(--s2-pad)) var(--s2-pad);
      display: flex;
      align-items: center;
      scroll-margin-top: calc(-1 * var(--scroll-pad));
    }

    .road-school__grid {
      width: 100%;
    }

    /* The group is 1.315 times as tall as it is wide (the photograph plus
       the room the prints take around it). */
    .road-school .road-stage {
      width: min(100%, 48rem, calc((100svh - var(--header-row) - 2 * var(--s2-pad)) / 1.315));
    }
  }

  /* The image group (V1.15). The live photograph carries most of the
     weight: about three quarters of the group's width, set in from the edges
     so the prints can sit over its corners without leaving the group. The
     prints are John's transparent PNGs, shown whole, never cropped or
     stretched, each with a soft shadow that follows its own edges. The upper
     right and lower corners of the photograph are dark stage and floor, so
     John and the kit stay clear. Everything is in % of the group, so the
     arrangement holds from phones to desktop. */
  .road-stage {
    position: relative;
    width: min(100%, 38rem);
    margin-inline: auto;
  }

  .road-stage :global(picture),
  .road-stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The room around the photograph is its margin, which resolves against
     the group's own width (padding would resolve against the column's), so
     the group is always 1.315 times as tall as it is wide. */
  .road-stage__live {
    position: relative;
    z-index: 1;
    margin: 9% 8% 15% 6%;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .road-stage__print {
    position: absolute;
    z-index: 2;
    rotate: var(--rot);
    filter: drop-shadow(0 2px 3px rgb(20 18 16 / 0.2)) drop-shadow(0 14px 24px rgb(20 18 16 / 0.22));
  }

  .road-stage__print--upper-right {
    --rot: 4deg;
    top: 1.5%;
    right: 1.5%;
    width: 50%;
  }

  .road-stage__print--lower-left {
    --rot: -5deg;
    left: 1.5%;
    bottom: 4%;
    width: 45%;
  }

  .road-stage__print--lower-right {
    --rot: 7deg;
    right: 2.5%;
    bottom: 1.5%;
    width: 29%;
  }

  /* The prints follow the photograph in, one after another. */
  :global(html.road-motion) .road-stage__print.road-reveal {
    transition-delay: calc(var(--i, 0) * 140ms + 120ms);
  }

  /* ---- more than the drummer ---- */
  .road-operator__head {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .road-operator__copy {
    display: grid;
    gap: var(--space-5);
  }

  /* V1.9: the copy sits level with the photograph's visual center, not its foot. */
  @media (min-width: 48rem) {
    .road-operator__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  /* The headline (V1.12 delta): "On stage at night." over "Running the
     business by day."; "Running" never sits on the first line. From 75rem
     each line holds whole, the copy column widening as far as the second
     line needs and the photograph taking the rest; below that the second
     line may wrap within itself. */
  .road-operator__line {
    display: block;
  }

  @media (min-width: 75rem) {
    .road-operator__head {
      grid-template-columns: minmax(min-content, 1fr) minmax(0, 1fr);
    }

    .road-operator__line {
      white-space: nowrap;
    }
  }

  /* The capability rail (V1.12). Without scripts: the four groups laid out
     open (one column, two from 40rem, four from 72rem). With scripts: a
     vertical accordion, and from 60rem one horizontal row of four adjacent
     panels at a fixed height, the open panel 44% of it. No icons, numbers,
     badges, connector or rules under the items; the open panel's one accent
     is a fine top rule over a slightly lifted tone. */
  .road-rail {
    --pad: clamp(1.25rem, 2vw, 2rem);
    margin-top: clamp(3rem, 5vw, 4.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
  }

  .road-rail__panel {
    position: relative;
    min-width: 0;
    padding: var(--pad);
  }

  .road-rail__panel + .road-rail__panel {
    border-top: 1px solid var(--line);
  }

  .road-rail__head {
    margin: 0;
    font: inherit;
  }

  .road-rail__btn {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-lg);
    line-height: 1.15;
    color: var(--heading);
    cursor: pointer;
    border-radius: 4px;
  }

  .road-rail__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  /* V1.13: the title begins with the collapsed label and, as the card opens,
     gains its second phrase in place ("Operations" → "Operations and
     Touring"); the first word never moves. */
  .road-rail__title {
    white-space: nowrap;
  }

  .road-rail__rest {
    display: inline-block;
    vertical-align: bottom;
  }

  .road-rail__progress,
  .road-rail :global(.road-rail__mark),
  :global(.road-rail__chev) {
    display: none;
  }

  @keyframes road-rail-fill {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  /* Real bullets (V1.12 delta): small teal discs, no rules between items. */
  .road-rail__items {
    list-style: disc;
    margin: 1rem 0 0;
    padding: 0 0 0 1.1em;
    display: grid;
    gap: 0.55rem;
    font-size: var(--text-md);
    line-height: 1.35;
    color: var(--ink-2);
  }

  @media (min-width: 40rem) {
    .road-rail:not(.is-live) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .road-rail:not(.is-live) .road-rail__panel + .road-rail__panel {
      border-top: 0;
    }

    .road-rail:not(.is-live) .road-rail__panel:nth-child(even) {
      border-left: 1px solid var(--line);
    }

    .road-rail:not(.is-live) .road-rail__panel:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (min-width: 72rem) {
    .road-rail:not(.is-live) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .road-rail:not(.is-live) .road-rail__panel + .road-rail__panel {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  /* The accordion (scripts on, below 60rem): each title a full-width button
     with a small chevron; the list folds open under it. A folded list is
     clipped, not removed, so it stays in the accessible text. */
  .road-rail.is-live .road-rail__panel {
    padding-block: 0;
    transition: background-color 400ms var(--ease-out);
  }

  .road-rail.is-live .road-rail__btn {
    padding-block: 1.15rem;
  }

  .road-rail.is-live :global(.road-rail__chev) {
    display: block;
    flex: none;
    color: var(--ink-3);
    transition: rotate 300ms var(--ease-out);
  }

  .road-rail.is-live .road-rail__panel.is-open :global(.road-rail__chev) {
    rotate: 180deg;
    color: var(--accent);
  }

  .road-rail.is-live .road-rail__content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 400ms var(--ease-out);
  }

  .road-rail__items li::marker {
    color: var(--accent);
    font-size: 0.85em;
  }

  .road-rail.is-live .road-rail__items {
    min-height: 0;
    overflow: hidden;
    margin-top: 0;
    padding-bottom: 0;
    transition: padding-bottom 400ms var(--ease-out);
  }

  .road-rail.is-live .road-rail__panel.is-open .road-rail__content {
    grid-template-rows: 1fr;
  }

  .road-rail.is-live .road-rail__panel.is-open .road-rail__items {
    padding-bottom: 1.35rem;
  }

  .road-rail.is-live .road-rail__panel.is-open {
    background: var(--bg-elev);
  }

  /* Accordion rows carry their icon too: faint, on the right, cropped by the
     row and growing a little when the row opens. */
  .road-rail.is-live .road-rail__panel {
    overflow: hidden;
  }

  .road-rail.is-live :global(.road-rail__mark) {
    display: block;
    position: absolute;
    z-index: 0;
    right: -2.75rem;
    top: -1.25rem;
    width: 8rem;
    height: auto;
    color: var(--accent-ink);
    stroke-width: 0.6;
    opacity: 0.06;
    pointer-events: none;
    transform-origin: 100% 0;
    transition:
      transform 500ms var(--ease-out),
      opacity 400ms var(--ease-out);
  }

  .road-rail.is-live .road-rail__panel.is-open :global(.road-rail__mark) {
    opacity: 0.08;
    transform: translateY(2.5rem) scale(1.35);
  }

  .road-rail.is-live .road-rail__head,
  .road-rail.is-live .road-rail__content {
    position: relative;
    z-index: 1;
  }

  /* The rail (scripts on, from 60rem): one stable-height row. The open panel
     takes 44%; the three others share the rest and keep their short label,
     horizontal and whole. The open list is laid out at the open width from
     the start, so it never rewraps while the panels resize. */
  @media (min-width: 60rem) {
    .road-rail.is-live {
      --open-n: 44;
      container-type: inline-size;
      display: flex;
      height: clamp(17.5rem, 15rem + 3vw, 19.5rem);
    }

    .road-rail.is-live .road-rail__panel {
      flex: 1 1 0;
      padding: var(--pad);
      overflow: hidden;
      background: transparent;
      transition:
        flex-grow 600ms var(--ease-out),
        flex-basis 600ms var(--ease-out),
        background-color 500ms var(--ease-out);
    }

    .road-rail.is-live .road-rail__panel + .road-rail__panel {
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .road-rail.is-live .road-rail__panel.is-open {
      flex: 0 0 calc(var(--open-n) * 1%);
      background: var(--bg-elev);
    }

    /* The progress bar (V1.12 delta): a fine teal line along the open
       panel's top edge, on a faint track, filling left to right over the
       4.5s the panel is open; when it is full the next panel opens (the
       script listens for its end, so the two never drift apart). It holds
       while the rail is paused, starts empty on each new panel, and shows
       full, as a plain rule, when a panel is chosen by a tap or click or
       motion is reduced. */
    .road-rail.is-live .road-rail__progress {
      display: block;
      position: absolute;
      z-index: 2;
      inset: 0 0 auto;
      height: 2px;
      background: color-mix(in srgb, var(--accent) 16%, transparent);
      opacity: 0;
      transition: opacity 400ms var(--ease-out);
    }

    .road-rail.is-live .road-rail__progress::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--accent);
      transform-origin: left;
    }

    .road-rail.is-live .road-rail__panel.is-open .road-rail__progress {
      opacity: 1;
    }

    .road-rail.is-auto:not(.is-pinned) .road-rail__panel.is-open .road-rail__progress::after {
      animation: road-rail-fill 4500ms linear both;
    }

    .road-rail.is-auto.is-paused .road-rail__panel.is-open .road-rail__progress::after {
      animation-play-state: paused;
    }

    /* The card icon (V1.13): on every card, large and faint, set low on the
       right and cropped by the card's edges so it fills the collapsed
       card's empty space. As a card opens, the same icon grows and settles
       further into the wider card, moving with it. Thin-lined, behind the
       title and list, never in a badge. Sized to the rail, so it keeps its
       composition at every width. */
    .road-rail.is-live :global(.road-rail__mark) {
      display: block;
      position: absolute;
      z-index: 0;
      right: 0;
      bottom: 0;
      top: auto;
      width: clamp(12rem, 22cqw, 18rem);
      height: auto;
      color: var(--accent-ink);
      stroke-width: 0.55;
      opacity: 0.06;
      transform-origin: 100% 100%;
      transform: translate(16%, 20%) scale(0.88);
      pointer-events: none;
      transition:
        transform 700ms var(--ease-out),
        opacity 500ms var(--ease-out);
    }

    .road-rail.is-live .road-rail__panel.is-open :global(.road-rail__mark) {
      opacity: 0.08;
      transform: translate(8%, 24%) scale(1.14);
    }

    .road-rail.is-live .road-rail__head {
      position: relative;
      z-index: 1;
    }

    .road-rail.is-live .road-rail__btn {
      padding-block: 0;
      white-space: nowrap;
    }

    /* The whole collapsed panel is the button's target. */
    .road-rail.is-live .road-rail__btn::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    .road-rail.is-live .road-rail__panel.is-open .road-rail__btn::after {
      display: none;
    }

    .road-rail.is-live :global(.road-rail__chev) {
      display: none;
    }

    .road-rail.is-live .road-rail__panel:not(.is-open) .road-rail__first {
      transition: color 300ms var(--ease-out);
    }

    .road-rail.is-live .road-rail__panel:not(.is-open) .road-rail__btn:is(:hover, :focus-visible) .road-rail__first {
      color: var(--accent-ink);
    }

    /* The second phrase: folded to nothing on a collapsed card (still in the
       button's accessible name), unfolding after the first word as the card
       opens. */
    .road-rail.is-live .road-rail__rest {
      max-width: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        max-width 250ms var(--ease-out),
        opacity 200ms var(--ease-out);
    }

    .road-rail.is-live .road-rail__panel.is-open .road-rail__rest {
      max-width: 16em;
      opacity: 1;
      transition:
        max-width 700ms var(--ease-out) 120ms,
        opacity 500ms var(--ease-out) 220ms;
    }

    /* The list: laid out at the open panel's width, fading and easing in a
       moment after its panel opens; folded lists stay in the accessible text,
       clipped by their narrow panels. */
    .road-rail.is-live .road-rail__content {
      display: block;
      position: absolute;
      left: var(--pad);
      top: calc(var(--pad) + var(--text-lg) * 1.15 + 1.4rem);
      width: calc(var(--open-n) * 1cqw - 2 * var(--pad));
      opacity: 0;
      translate: 0.75rem 0;
      pointer-events: none;
      transition:
        opacity 250ms var(--ease-out),
        translate 250ms var(--ease-out);
    }

    .road-rail.is-live .road-rail__items,
    .road-rail.is-live .road-rail__panel.is-open .road-rail__items {
      overflow: visible;
      padding-bottom: 0;
      gap: 0.6rem;
    }

    .road-rail.is-live .road-rail__content {
      z-index: 1;
    }

    .road-rail.is-live .road-rail__panel.is-open .road-rail__content {
      opacity: 1;
      translate: 0 0;
      pointer-events: auto;
      transition:
        opacity 500ms var(--ease-out) 220ms,
        translate 500ms var(--ease-out) 220ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .road-rail *,
    .road-rail *::after,
    .road-rail .road-rail__panel {
      transition: none !important;
      animation: none !important;
    }
  }

  /* ---- the 2020 pivot ---- */
  /* V1.10: the dark section blends in from the pale section above and out into
     the fog of the next, over bands of its own padding, so no text ever sits on
     the gradient. */
  .road-pivot {
    --blend: clamp(5rem, 4rem + 6vw, 10rem);
    padding-block: calc(var(--section-y) + var(--blend));
    background: linear-gradient(
      to bottom,
      var(--c-pale) 0,
      color-mix(in srgb, var(--c-pale) 62%, var(--c-ink)) calc(var(--blend) * 0.3),
      color-mix(in srgb, var(--c-pale) 22%, var(--c-ink)) calc(var(--blend) * 0.65),
      var(--c-ink) var(--blend),
      var(--c-ink) calc(100% - var(--blend)),
      color-mix(in srgb, var(--c-fog) 22%, var(--c-ink)) calc(100% - var(--blend) * 0.65),
      color-mix(in srgb, var(--c-fog) 62%, var(--c-ink)) calc(100% - var(--blend) * 0.3),
      var(--c-fog) 100%
    );
  }

  .road-pivot__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .road-pivot__copy {
    display: grid;
    gap: var(--space-5);
  }

  /* Desktop: the narrative stays in view, below the header, while the longer
     timeline runs beside it; it is released at the end of the section. */
  @media (min-width: 64rem) {
    .road-pivot__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }

    .road-pivot__copy {
      position: sticky;
      top: calc(var(--header-row) + 3rem);
    }
  }

  /* The timeline (V1.9, structure from John's reference): one central spine,
     a node on it for each milestone, a branch running outward from the node,
     the year and words set beneath the branch and aligned toward the spine; the
     entries alternate left and right, each starting about halfway down the one
     before; time runs top to bottom. Translated into the site's own type and
     colors. V1.12: the branches are dotted, and each ends in one small outline
     icon for its milestone, in the site's icon family and weight. Phones: the spine on the left, every entry to its right. The spine is
     drawn node to node so it can fill down to the active milestone. */
  .road-tl {
    --node: 13px;
    --node-y: 0.1rem;
    --gap-x: 0px;
    --gap-y: clamp(2.25rem, 6vw, 3rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .road-tl__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    align-items: start;
    border-radius: var(--radius);
    outline-offset: 6px;
  }

  .road-tl__item + .road-tl__item {
    margin-top: var(--gap-y);
  }

  .road-tl__node {
    position: relative;
    z-index: 1;
    grid-column: 1;
