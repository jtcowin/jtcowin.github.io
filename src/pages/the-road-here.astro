---
/**
 * The Road Here (Phase 3A draft, October 2026): John's career before Web3, as one
 * editorial page in five chapters. 01 the hero, 02 from music school to the road
 * (with the milestones), 03 more than the drummer (the four areas of the business
 * he ran), 04 the 2020 pivot (a quiet timeline from the road into DeFi), 05 where
 * it led, leading back to the selected work. Then Contact and the footer.
 *
 * Draft status: unlinked from the homepage and navigation, marked noindex and kept
 * out of the sitemap (astro.config.mjs) until John approves it.
 *
 * Words: src/data/road.json. Photographs: assets.json road-* entries, through
 * RoadFrame (a labeled placeholder until each photograph is supplied). Motion is
 * restrained: one reveal as each block comes into view, a gentle drift on the
 * photographs, and the timeline's line drawing down; all of it off with reduced
 * motion or without scripts. Privacy: the band is never named here or in metadata.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Contact from '@components/Contact.astro';
import RoadFrame from '@components/road/RoadFrame.astro';
import road from '@data/road.json';
import { withBase } from '@lib/paths';

const { meta, hero, school, operator, pivot, led } = road;
const [headLead, headAccent] = (() => {
  const i = hero.headline.indexOf(hero.accent);
  if (i < 0) throw new Error('[road] the hero accent must appear in the headline');
  return [hero.headline.slice(0, i), hero.accent];
})();
---

<BaseLayout title={meta.title} description={meta.description} path="/the-road-here/" noindex footerSurface="brand">
  <article class="road" aria-labelledby="road-title">
    {/* 01 Hero */}
    <section class="road-hero" data-surface="dark" aria-labelledby="road-title">
      <div class="container road-hero__grid">
        <div class="road-hero__copy">
          <p class="eyebrow road-reveal">01 / {hero.label}</p>
          <h1 id="road-title" class="display road-hero__title road-reveal">
            {headLead}<span class="road-accent">{headAccent}</span>
          </h1>
          <p class="lede road-hero__lede road-reveal">{hero.copy}</p>
          <nav class="road-hero__chapters road-reveal" aria-label="Chapters">
            <ol>
              {hero.chapters.map((c, i) => (
                <li>
                  <a href={c.href}>
                    <span class="road-num">0{i + 2}</span>
                    {c.label}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
        <RoadFrame id={hero.image} class="road-hero__portrait road-reveal" priority drift sizes="(min-width: 64rem) 40vw, 100vw" />
      </div>
    </section>

    {/* 02 From music school to the road */}
    <section id="road-school" class="section road-school" data-surface="light" aria-labelledby="road-school-title">
      <div class="container">
        <div class="road-school__grid">
          <div class="road-school__copy">
            <p class="eyebrow road-reveal">{school.index} / {school.label}</p>
            <h2 id="road-school-title" class="display display-lg road-reveal">{school.headline}</h2>
            <div class="prose road-reveal">
              {school.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          </div>
          <div class="road-school__media road-reveal">
            <RoadFrame id={school.image} drift sizes="(min-width: 64rem) 55vw, 100vw" />
            {/* Reserved for one genuine artifact (a poster, a laminate, a press clipping), chosen and privacy-checked later. */}
            <RoadFrame id={school.artifact} class="road-school__artifact" sizes="(min-width: 64rem) 16vw, 40vw" />
          </div>
        </div>
        <ul class="road-milestones" aria-label="Milestones">
          {school.milestones.map((m) => (
            <li class="road-milestone road-reveal">
              <span class="road-milestone__value">{m.value}</span>
              <span class="road-milestone__label">{m.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* 03 More than the drummer */}
    <section id="road-operator" class="section road-operator" data-surface="soft" aria-labelledby="road-operator-title">
      <div class="container">
        <div class="road-operator__head">
          <div>
            <p class="eyebrow road-reveal">{operator.index} / {operator.label}</p>
            <h2 id="road-operator-title" class="display display-lg road-reveal">{operator.headline}</h2>
            <p class="lede road-reveal">{operator.copy}</p>
          </div>
          <RoadFrame id={operator.image} class="road-operator__image road-reveal" drift sizes="(min-width: 64rem) 45vw, 100vw" />
        </div>
        <ul class="road-groups">
          {operator.groups.map((g, i) => (
            <li class="road-group road-reveal">
              <span class="road-num">0{i + 1}</span>
              <h3 class="road-group__title">{g.title}</h3>
              <ul class="road-group__items">
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* 04 The 2020 pivot */}
    <section id="road-pivot" class="section road-pivot" data-surface="dark" aria-labelledby="road-pivot-title">
      <div class="container road-pivot__grid">
        <div class="road-pivot__copy">
          <p class="eyebrow road-reveal">{pivot.index} / {pivot.label}</p>
          <h2 id="road-pivot-title" class="display display-lg road-reveal">{pivot.headline}</h2>
          <div class="prose road-reveal">
            {pivot.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <ol class="road-timeline" data-road-timeline aria-label="From the road to Web3">
          {pivot.timeline.map((t) => (
            <li class="road-timeline__item road-reveal">
              <span class="road-timeline__when">{t.when}</span>
              <span class="road-timeline__what">{t.what}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* 05 Where it led */}
    <section id="road-led" class="section road-led" data-surface="light-return" aria-labelledby="road-led-title">
      <div class="container">
        <div class="road-led__head">
          <p class="eyebrow road-reveal">{led.index} / {led.label}</p>
          <h2 id="road-led-title" class="display display-xl road-reveal">{led.headline}</h2>
          <p class="lede road-reveal">{led.copy}</p>
        </div>
        <ul class="road-pairs" aria-label="Then and now">
          {led.pairs.map((p) => (
            <li class="road-pair road-reveal">
              <span class="road-pair__then"><span class="sr-only">Then: </span>{p.then}</span>
              <span class="road-pair__arrow" aria-hidden="true">→</span>
              <span class="road-pair__now"><span class="sr-only">Now: </span>{p.now}</span>
            </li>
          ))}
        </ul>
        <div class="road-led__actions road-reveal">
          <a class="btn btn--primary" href={withBase(led.cta.href)}>{led.cta.label}</a>
          <a class="btn btn--secondary" href={withBase(led.secondary.href)}>{led.secondary.label}</a>
        </div>
      </div>
    </section>
  </article>

  <div class="chapter" data-surface="brand">
    <Contact compact />
  </div>
</BaseLayout>

<script>
  // Restrained motion: each block reveals once as it comes into view; the photographs drift gently with the
  // scroll; the timeline's line draws down as the section arrives. Reduced motion, no IntersectionObserver
  // or no scripts: everything is simply shown.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLElement>('.road-reveal')];
  const timeline = document.querySelector<HTMLElement>('[data-road-timeline]');
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
    timeline?.classList.add('is-in');
  } else {
    document.documentElement.classList.add('road-motion');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));
    if (timeline) io.observe(timeline);

    const drift = [...document.querySelectorAll<HTMLElement>('[data-road-drift]')];
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const el of drift) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2); // -1 .. 1 across the screen
        el.style.setProperty('--drift', `${(-p * 3).toFixed(2)}%`);
      }
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }
</script>

<style>
  .road {
    margin-top: calc(-1 * var(--header-row));
  }

  .road-accent {
    color: var(--accent-ink);
  }

  .road-num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  /* ---- reveal: a short rise and fade, once ---- */
  :global(html.road-motion .road-reveal) {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 700ms var(--ease-out),
      translate 700ms var(--ease-out);
  }

  :global(html.road-motion .road-reveal.is-in) {
    opacity: 1;
    translate: 0 0;
  }

  /* ---- 01 hero ---- */
  .road-hero {
    padding-top: calc(var(--header-row) + clamp(2.5rem, 6vw, 6rem));
    padding-bottom: clamp(3.5rem, 7vw, 7rem);
    min-height: min(100svh, 62rem);
    display: flex;
    align-items: center;
  }

  .road-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .road-hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .road-hero__title {
    font-size: var(--text-4xl);
    line-height: 0.95;
  }

  .road-hero__lede {
    max-width: 34rem;
  }

  .road-hero__chapters ol {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line-strong);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-5);
  }

  .road-hero__chapters a {
    display: inline-flex;
    gap: 0.6rem;
    align-items: baseline;
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 550;
  }

  .road-hero__chapters a:hover {
    color: var(--heading);
  }

  .road-hero :global(.road-hero__portrait) {
    width: min(100%, 30rem);
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .road-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .road-hero :global(.road-hero__portrait) {
      justify-self: end;
      width: 100%;
      max-width: 32rem;
    }
  }

  /* ---- 02 from music school to the road ---- */
  .road-school__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .road-school__copy {
    display: grid;
    gap: var(--space-5);
  }

  .road-school__media {
    position: relative;
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }

  /* The reserved artifact overlaps the photograph's lower corner, slightly turned. */
  .road-school__media :global(.road-school__artifact) {
    position: absolute;
    left: clamp(-1rem, -2vw, -0.5rem);
    bottom: 0;
    width: clamp(7rem, 26%, 12rem);
    rotate: -3deg;
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius);
    background: var(--bg);
    padding: 6px;
  }

  @media (min-width: 64rem) {
    .road-school__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .road-school__media :global(.road-school__artifact) {
      left: -2.5rem;
    }
  }

  .road-milestones {
    list-style: none;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    column-gap: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }

  .road-milestone {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-6) var(--space-5) var(--space-5) 0;
  }

  .road-milestone__value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--heading);
  }

  .road-milestone__label {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-3);
    max-width: 22ch;
  }

  /* ---- 03 more than the drummer ---- */
  .road-operator__head {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
  }

  .road-operator__head > div {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .road-operator__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .road-groups {
    list-style: none;
    margin: clamp(3rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .road-group {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .road-group__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-lg);
    line-height: 1.1;
    color: var(--heading);
  }

  .road-group__items {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .road-group__items li {
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
  }

  /* ---- 04 the 2020 pivot ---- */
  .road-pivot__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .road-pivot__copy {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .road-pivot__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }

  .road-timeline {
    --dot: 11px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 calc(var(--dot) + 1.5rem);
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* The understated line: drawn down once as the section arrives. */
  .road-timeline::before {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 0.5px);
    top: 0.45rem;
    bottom: 0.45rem;
    width: 1px;
    background: linear-gradient(var(--line-strong), var(--accent));
    transform-origin: top;
  }

  :global(html.road-motion) .road-timeline::before {
    scale: 1 0;
    transition: scale 1400ms var(--ease-out);
  }

  :global(html.road-motion) .road-timeline.is-in::before {
    scale: 1 1;
  }

  .road-timeline__item {
    position: relative;
    display: grid;
    gap: 0.3rem;
  }

  .road-timeline__item::before {
    content: '';
    position: absolute;
    left: calc(-1 * (var(--dot) + 1.5rem));
    top: 0.3rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--line-strong);
  }

  .road-timeline__item:last-child::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .road-timeline__when {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .road-timeline__what {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--heading);
    max-width: 30ch;
  }

  /* ---- 05 where it led ---- */
  .road-led__head {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }

  .road-pairs {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .road-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }

  .road-pair__then {
    color: var(--ink-3);
    font-size: var(--text-md);
  }

  .road-pair__arrow {
    color: var(--accent);
  }

  .road-pair__now {
    color: var(--heading);
    font-size: var(--text-md);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .road-pair {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .road-pair__arrow {
      display: none;
    }
  }

  .road-led__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
