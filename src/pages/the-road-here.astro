---
/**
 * The Road Here (Phase 3A draft, October 2026; V1.7 build): John's career before
 * Web3, as one editorial page in five sections: the hero, from music school to the
 * road (with the milestones), more than the drummer (the four areas of the business
 * he ran), the 2020 pivot (a quiet timeline from the road into DeFi), and where it
 * led, back to the selected work. Then the shared Contact (as on the homepage) and
 * the footer. V1.7: no numbered eyebrows or chapter navigation; each headline
 * carries one accent phrase; at most one bold phrase a paragraph.
 *
 * Draft status: unlinked from the homepage and navigation, marked noindex and kept
 * out of the sitemap (astro.config.mjs) until John approves it.
 *
 * Words: src/data/road.json. Photographs: assets.json road-* entries, through
 * RoadFrame (a labeled placeholder until each photograph is supplied). Motion is
 * restrained: one reveal as each block comes into view, a gentle drift on the
 * photographs, and the timeline's line drawing down; all of it off with reduced
 * motion or without scripts. Privacy: the band is never named here or in metadata.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Contact from '@components/Contact.astro';
import RoadFrame from '@components/road/RoadFrame.astro';
import Icon from '@components/Icon.astro';
import road from '@data/road.json';
import { withBase } from '@lib/paths';

const { meta, hero, school, operator, pivot, led } = road;
// A headline split around its accent phrase (which must appear in it).
const accented = (headline: string, accent: string, where: string): [string, string, string] => {
  const i = headline.indexOf(accent);
  if (i < 0) throw new Error(`[road] the ${where} accent must appear in its headline`);
  return [headline.slice(0, i), accent, headline.slice(i + accent.length)];
};
// **text** is set in bold; one phrase a paragraph at most.
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
const [headLead, headAccent] = accented(hero.headline, hero.accent, 'hero');
const H = {
  school: accented(school.headline, school.accent, 'school'),
  operator: accented(operator.headline, operator.accent, 'operator'),
  pivot: accented(pivot.headline, pivot.accent, 'pivot'),
  led: accented(led.headline, led.accent, 'led'),
};
type GroupIcon = 'route' | 'pen' | 'users' | 'broadcast';
const groups = operator.groups as Array<{ title: string; items: string[]; icon: GroupIcon }>;
---

<BaseLayout title={meta.title} description={meta.description} path="/the-road-here/" noindex footerSurface="brand">
  <article class="road" aria-labelledby="road-title">
    {/* Hero */}
    <section class="road-hero" data-surface="dark" aria-labelledby="road-title">
      <div class="container road-hero__grid">
        <div class="road-hero__copy">
          <h1 id="road-title" class="display road-hero__title road-reveal">
            {headLead}<span class="road-accent">{headAccent}</span>
          </h1>
          <p class="lede road-hero__lede road-reveal">{rich(hero.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        {/* No drift: the crop keeps his face and the whole cymbal, which a drift's zoom would trim. */}
        <RoadFrame id={hero.image} class="road-hero__portrait road-reveal" priority sizes="(min-width: 64rem) 32rem, (min-width: 40rem) 30rem, 100vw" />
      </div>
    </section>

    {/* From music school to the road */}
    <section id="road-school" class="section road-school" data-surface="light" aria-labelledby="road-school-title">
      <div class="container">
        <div class="road-school__grid">
          <div class="road-school__copy">
            <h2 id="road-school-title" class="display display-lg road-reveal">{H.school[0]}<span class="road-accent">{H.school[1]}</span>{H.school[2]}</h2>
            <div class="prose road-reveal">
              {school.paragraphs.map((p) => <p>{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
            </div>
          </div>
          {/* Three pieces of real evidence (V1.7): the live performance, dominant, with the television appearance and
              the festival poster (cropped above its lower-tier names) as supporting cards. Phones: in that order. */}
          <div class="road-school__media">
            <RoadFrame id={school.image} class="road-school__live road-reveal" drift sizes="(min-width: 64rem) 34vw, (min-width: 40rem) 58vw, 100vw" />
            <RoadFrame id={school.tv} class="road-school__tv road-reveal" sizes="(min-width: 64rem) 20vw, (min-width: 40rem) 34vw, 100vw" />
            <RoadFrame id={school.festival.image} caption={school.festival.caption} class="road-school__festival road-reveal" sizes="(min-width: 64rem) 20vw, (min-width: 40rem) 34vw, 100vw" />
          </div>
        </div>
        <ul class="road-milestones" aria-label="Milestones">
          {school.milestones.map((m) => (
            <li class="road-milestone road-reveal">
              <span class="road-milestone__value">{m.value.replace(' + ', '\u00a0+ ')}</span>
              <span class="road-milestone__label">{m.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* More than the drummer */}
    <section id="road-operator" class="section road-operator" data-surface="soft" aria-labelledby="road-operator-title">
      <div class="container">
        <div class="road-operator__head">
          <div>
            <h2 id="road-operator-title" class="display display-lg road-reveal">{H.operator[0]}<span class="road-accent">{H.operator[1]}</span>{H.operator[2]}</h2>
            <p class="lede road-reveal">{rich(operator.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
          </div>
          {/* No drift: the whole kit stays in frame. */}
          <RoadFrame id={operator.image} class="road-operator__image road-reveal" sizes="(min-width: 64rem) 45vw, 100vw" />
        </div>
        <ul class="road-groups">
          {groups.map((g) => (
            <li class="road-group road-reveal">
              <span class="road-group__icon" aria-hidden="true"><Icon name={g.icon} size={18} /></span>
              <h3 class="road-group__title">{g.title}</h3>
              <ul class="road-group__items">
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* The 2020 pivot */}
    <section id="road-pivot" class="section road-pivot" data-surface="dark" aria-labelledby="road-pivot-title">
      <div class="container road-pivot__grid">
        <div class="road-pivot__copy">
          <h2 id="road-pivot-title" class="display display-lg road-reveal">{H.pivot[0]}<span class="road-accent">{H.pivot[1]}</span>{H.pivot[2]}</h2>
          <div class="prose road-reveal">
            {pivot.paragraphs.map((p) => <p>{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
          </div>
        </div>
        <ol class="road-timeline" data-road-timeline aria-label="From the road to Web3">
          {pivot.timeline.map((t) => (
            <li class="road-timeline__item road-reveal">
              <span class="road-timeline__when">{t.when}</span>
              <span class="road-timeline__what">{t.what}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Where it led */}
    <section id="road-led" class="section road-led" data-surface="light-return" aria-labelledby="road-led-title">
      <div class="container">
        <div class="road-led__head">
          <h2 id="road-led-title" class="display display-xl road-reveal">{H.led[0]}<span class="road-accent">{H.led[1]}</span>{H.led[2]}</h2>
          <p class="lede road-reveal">{rich(led.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        <ul class="road-pairs" aria-label="Then and now">
          {led.pairs.map((p) => (
            <li class="road-pair road-reveal">
              <span class="road-pair__then"><span class="sr-only">Then: </span>{p.then}</span>
              <span class="road-pair__arrow" aria-hidden="true">→</span>
              <span class="road-pair__now"><span class="sr-only">Now: </span>{p.now}</span>
            </li>
          ))}
        </ul>
        <div class="road-led__actions road-reveal">
          <a class="btn btn--primary" href={withBase(led.cta.href)}>{led.cta.label}</a>
          <a class="btn btn--secondary" href={withBase(led.secondary.href)}>{led.secondary.label}</a>
        </div>
      </div>
    </section>
  </article>

  {/* The shared Contact, exactly as the homepage sets it (V1.7). */}
  <div class="chapter" data-surface="brand">
    <Contact />
  </div>
</BaseLayout>

<script>
  // Restrained motion: each block reveals once as it comes into view; the photographs drift gently with the
  // scroll; the timeline's line draws down as the section arrives. Reduced motion, no IntersectionObserver
  // or no scripts: everything is simply shown.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLElement>('.road-reveal')];
  const timeline = document.querySelector<HTMLElement>('[data-road-timeline]');
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
    timeline?.classList.add('is-in');
  } else {
    document.documentElement.classList.add('road-motion');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));
    if (timeline) io.observe(timeline);

    const drift = [...document.querySelectorAll<HTMLElement>('[data-road-drift]')];
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const el of drift) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2); // -1 .. 1 across the screen
        el.style.setProperty('--drift', `${(-p * 3).toFixed(2)}%`);
      }
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }
</script>

<style>
  .road {
    margin-top: calc(-1 * var(--header-row));
  }

  .road-accent {
    color: var(--accent-ink);
  }

  /* Bold for factual proof and key responsibilities: one phrase a paragraph. */
  .road strong {
    font-weight: 700;
    color: var(--heading);
  }

  /* ---- reveal: a short rise and fade, once ---- */
  :global(html.road-motion .road-reveal) {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 700ms var(--ease-out),
      translate 700ms var(--ease-out);
  }

  :global(html.road-motion .road-reveal.is-in) {
    opacity: 1;
    translate: 0 0;
  }

  /* ---- hero ---- */
  .road-hero {
    padding-top: calc(var(--header-row) + clamp(2.5rem, 6vw, 6rem));
    padding-bottom: clamp(3.5rem, 7vw, 7rem);
    min-height: min(100svh, 62rem);
    display: flex;
    align-items: center;
  }

  .road-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .road-hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .road-hero__title {
    font-size: var(--text-4xl);
    line-height: 0.95;
  }

  .road-hero__lede {
    max-width: 34rem;
  }

  .road-hero :global(.road-hero__portrait) {
    width: min(100%, 30rem);
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .road-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .road-hero :global(.road-hero__portrait) {
      justify-self: end;
      width: 100%;
      max-width: 32rem;
    }
  }

  /* ---- from music school to the road ---- */
  .road-school__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .road-school__copy {
    display: grid;
    gap: var(--space-5);
  }

  /* The evidence group (V1.7): stacked on phones (live, television, festival);
     from 40rem the live performance leads, a little over 1.7 times as wide as
     the two supporting cards stacked beside it. Spacious, never a collage. */
  .road-school__media {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }

  @media (min-width: 40rem) {
    .road-school__media {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.58fr);
      align-items: start;
    }

    .road-school__media :global(.road-school__live) {
      grid-row: 1 / span 2;
    }
  }

  @media (min-width: 64rem) {
    .road-school__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .road-milestones {
    list-style: none;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 64rem) {
    .road-milestones {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* V1.7: each milestone spans two rows of the list's grid (value, then label),
     so across a row every label starts level however the values wrap. */
  .road-milestone {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: var(--space-3);
    align-content: start;
    padding: var(--space-6) var(--space-5) var(--space-5) 0;
  }

  .road-milestone__value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    /* (V1.7: a step smaller than the old one-word values, for the approved labels.) */
    font-size: clamp(1.625rem, 1.1rem + 1.4vw, 2.375rem);
    line-height: 1.02;
    color: var(--heading);
    text-wrap: balance;
    align-self: end;
  }

  .road-milestone__label {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-3);
    max-width: 22ch;
  }

  /* ---- more than the drummer ---- */
  .road-operator__head {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
  }

  .road-operator__head > div {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .road-operator__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .road-groups {
    list-style: none;
    margin: clamp(3rem, 5vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }

  /* Two by two, then four across once each card is wide enough that every
     title (the longest is "Business and relationships") holds one line, a step
     smaller there; headings and lists start level across the row (V1.7). */
  @media (min-width: 40rem) {
    .road-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 85rem) {
    .road-groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .road-group {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  /* One restrained line icon a card, in the accent, in a fine circle. */
  .road-group__icon {
    display: inline-grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    margin-bottom: var(--space-2);
    border: 1px solid var(--accent-line);
    border-radius: 50%;
    color: var(--accent);
  }

  .road-group__icon :global(svg) {
    display: block;
  }

  .road-group__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-size: var(--text-lg);
    line-height: 1.1;
    color: var(--heading);
  }

  @media (min-width: 85rem) {
    .road-group__title {
      font-size: 1.3125rem;
      white-space: nowrap;
    }
  }

  .road-group__items {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .road-group__items li {
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
  }

  /* ---- the 2020 pivot ---- */
  .road-pivot__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .road-pivot__copy {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 64rem) {
    .road-pivot__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }

  .road-timeline {
    --dot: 11px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 calc(var(--dot) + 1.5rem);
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* The understated line: drawn down once as the section arrives. */
  .road-timeline::before {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 0.5px);
    top: 0.45rem;
    bottom: 0.45rem;
    width: 1px;
    background: linear-gradient(var(--line-strong), var(--accent));
    transform-origin: top;
  }

  :global(html.road-motion) .road-timeline::before {
    scale: 1 0;
    transition: scale 1400ms var(--ease-out);
  }

  :global(html.road-motion) .road-timeline.is-in::before {
    scale: 1 1;
  }

  .road-timeline__item {
    position: relative;
    display: grid;
    gap: 0.3rem;
  }

  .road-timeline__item::before {
    content: '';
    position: absolute;
    left: calc(-1 * (var(--dot) + 1.5rem));
    top: 0.3rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--line-strong);
  }

  .road-timeline__item:last-child::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .road-timeline__when {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .road-timeline__what {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--heading);
    max-width: 30ch;
  }

  /* ---- where it led ---- */
  .road-led__head {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }

  .road-pairs {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .road-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }

  .road-pair__then {
    color: var(--ink-3);
    font-size: var(--text-md);
  }

  .road-pair__arrow {
    color: var(--accent);
  }

  .road-pair__now {
    color: var(--heading);
    font-size: var(--text-md);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .road-pair {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .road-pair__arrow {
      display: none;
    }
  }

  .road-led__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
