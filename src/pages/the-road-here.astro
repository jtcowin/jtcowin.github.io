---
/**
 * The Road Here (Phase 3A draft, October 2026; V1.7 build): John's career before
 * Web3, as one editorial page in five sections: the hero, from music school to the
 * road (the live, television and festival evidence), more than the drummer (the four areas of the business
 * he ran), the 2020 pivot (a quiet timeline from the road into DeFi), and where it
 * led, back to the selected work. Then the shared Contact (as on the homepage) and
 * the footer. V1.7: no numbered eyebrows or chapter navigation; each headline
 * carries one accent phrase; at most one bold phrase a paragraph.
 *
 * Draft status: unlinked from the homepage and navigation, marked noindex and kept
 * out of the sitemap (astro.config.mjs) until John approves it.
 *
 * Words: src/data/road.json. Photographs: assets.json road-* entries, through
 * RoadFrame (a labeled placeholder until each photograph is supplied). Motion is
 * restrained: one reveal as each block comes into view, a gentle drift on the
 * photographs, the timeline's line drawing down and then a slow pulse rising along
 * it (V1.8), lighting each milestone it passes; all of it off with reduced
 * motion or without scripts. Privacy: the band is never named here or in metadata.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Contact from '@components/Contact.astro';
import RoadFrame from '@components/road/RoadFrame.astro';
import Icon from '@components/Icon.astro';
import { Picture } from 'astro:assets';
import { getAsset, resolveImage } from '@lib/assets';
import road from '@data/road.json';
import { withBase } from '@lib/paths';

const { meta, hero, school, operator, pivot, led } = road;
// A headline split around its accent phrase (which must appear in it).
const accented = (headline: string, accent: string, where: string): [string, string, string] => {
  const i = headline.indexOf(accent);
  if (i < 0) throw new Error(`[road] the ${where} accent must appear in its headline`);
  return [headline.slice(0, i), accent, headline.slice(i + accent.length)];
};
// **text** is set in bold; one phrase a paragraph at most.
const rich = (text: string) => text.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
const [headLead, headAccent] = accented(hero.headline, hero.accent, 'hero');
const H = {
  school: accented(school.headline, school.accent, 'school'),
  operator: accented(operator.headline, operator.accent, 'operator'),
  pivot: accented(pivot.headline, pivot.accent, 'pivot'),
  led: accented(led.headline, led.accent, 'led'),
};
// The hero figure (V1.8): a transparent cutout, set like the homepage portrait rather than in a frame.
const heroEntry = getAsset(hero.image);
const heroImg = resolveImage(heroEntry);
if (!heroImg) throw new Error('[road] the hero cutout is missing');
type GroupIcon = 'route' | 'pen' | 'users' | 'broadcast';
const groups = operator.groups as Array<{ title: string; items: string[]; icon: GroupIcon }>;
---

<BaseLayout title={meta.title} description={meta.description} path="/the-road-here/" noindex footerSurface="brand">
  <article class="road" aria-labelledby="road-title">
    {/* Hero */}
    <section class="road-hero" data-surface="dark" aria-labelledby="road-title">
      <div class="container road-hero__grid">
        <div class="road-hero__copy">
          <h1 id="road-title" class="display road-hero__title road-reveal">
            {headLead}<span class="road-accent">{headAccent}</span>
          </h1>
          <p class="lede road-hero__lede road-reveal">{rich(hero.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        {/* The figure stands on the hero's lower edge, out of any frame (V1.8). */}
        <div class="road-hero__figure">
          <Picture
            src={heroImg}
            alt={heroEntry.alt}
            widths={[480, 720, 890]}
            sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 26rem, 88vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            class="road-hero__img"
          />
        </div>
      </div>
    </section>

    {/* From music school to the road (V1.9: copy left, the layered evidence right) */}
    <section id="road-school" class="section road-school" data-surface="light" aria-labelledby="road-school-title">
      <div class="container road-school__grid">
        <div class="road-school__copy">
          <h2 id="road-school-title" class="display display-lg road-reveal">{H.school[0]}<span class="road-accent">{H.school[1]}</span>{H.school[2]}</h2>
          <div class="prose road-reveal">
            {school.paragraphs.map((p) => <p>{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
          </div>
        </div>
        {/* Three pieces of real evidence: the live performance, dominant and centered in its column, with the television
            appearance and the festival poster (cropped above its lower-tier names) laid over its opposite outer edges,
            clear of John and the kit. Phones: stacked in that order, without overlap. */}
        <div class="road-stage">
          <RoadFrame id={school.image} class="road-stage__live road-reveal" drift sizes="(min-width: 56rem) 30vw, (min-width: 40rem) 26rem, 100vw" />
          <RoadFrame id={school.tv} class="road-stage__card road-stage__tv road-reveal" sizes="(min-width: 56rem) 14vw, (min-width: 40rem) 11rem, 82vw" />
          <RoadFrame id={school.festival} class="road-stage__card road-stage__festival road-reveal" sizes="(min-width: 56rem) 15vw, (min-width: 40rem) 12rem, 82vw" />
        </div>
      </div>
    </section>

    {/* More than the drummer */}
    <section id="road-operator" class="section road-operator" data-surface="soft" aria-labelledby="road-operator-title">
      <div class="container">
        <div class="road-operator__head">
          <div class="road-operator__copy">
            <h2 id="road-operator-title" class="display display-lg road-reveal">{H.operator[0]}<span class="road-accent">{H.operator[1]}</span>{H.operator[2]}</h2>
            <p class="lede road-reveal">{rich(operator.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
          </div>
          {/* No drift: the whole kit stays in frame. */}
          <RoadFrame id={operator.image} class="road-operator__image road-reveal" sizes="(min-width: 64rem) 45vw, 100vw" />
        </div>
        {/* The touring operating system (V1.9): one panel, four indexed lanes joined by a route line. Hover or focus
            brings a lane forward and lights the route up to it; every capability is always visible. */}
        <div class="road-os road-reveal">
          <ol class="road-os__lanes" data-road-os aria-label="The business behind the music">
            {groups.map((g, i) => (
              <li class="road-os__lane" tabindex="0" aria-labelledby={`road-os-${i}`} data-lane={i}>
                <span class="road-os__node" aria-hidden="true"><Icon name={g.icon} size={18} /></span>
                <div class="road-os__body">
                  <p class="road-os__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                  <h3 id={`road-os-${i}`} class="road-os__title">{g.title}</h3>
                  <ul class="road-os__items">
                    {g.items.map((it) => <li>{it}</li>)}
                  </ul>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {/* The 2020 pivot */}
    <section id="road-pivot" class="section road-pivot" data-surface="dark" aria-labelledby="road-pivot-title">
      <div class="container road-pivot__grid">
        <div class="road-pivot__copy">
          <h2 id="road-pivot-title" class="display display-lg road-reveal">{H.pivot[0]}<span class="road-accent">{H.pivot[1]}</span>{H.pivot[2]}</h2>
          <div class="prose road-reveal">
            {pivot.paragraphs.map((p) => <p>{rich(p).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>)}
          </div>
        </div>
        {/* The timeline (V1.9): a central spine, milestones alternating left and right on short branches, in order from
            top to bottom. The script steps through them one at a time, the spine filling down to the active one. */}
        <ol class="road-tl road-reveal" data-road-timeline aria-label="From the road to Web3">
          {pivot.timeline.map((t, i) => (
            <li class:list={['road-tl__item', i % 2 ? 'road-tl__item--right' : 'road-tl__item--left']} tabindex="0" data-step={i}>
              <span class="road-tl__node" aria-hidden="true"></span>
              <div class="road-tl__body">
                <span class="road-tl__when">{t.when}</span>
                <span class="road-tl__what">{t.what}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Where it led */}
    <section id="road-led" class="section road-led" data-surface="light-return" aria-labelledby="road-led-title">
      <div class="container">
        <div class="road-led__head">
          <h2 id="road-led-title" class="display display-xl road-reveal">{H.led[0]}<span class="road-accent">{H.led[1]}</span>{H.led[2]}</h2>
          <p class="lede road-reveal">{rich(led.copy).map(({ part, strong }) => (strong ? <strong>{part}</strong> : part))}</p>
        </div>
        {/* The transition track (V1.9): each music-career origin runs along its own path into the work it became. */}
        <div class="road-track road-reveal">
          <p class="road-track__labels" aria-hidden="true"><span>Then</span><span>Now</span></p>
          <ol class="road-track__rows" data-road-track aria-label="Then and now">
            {led.pairs.map((p) => (
              <li class="road-track__row" tabindex="0">
                <span class="road-track__then"><span class="sr-only">Then: </span>{p.then}</span>
                <span class="road-track__path" aria-hidden="true"><span class="road-track__line"></span></span>
                <span class="road-track__now"><span class="sr-only">Now: </span>{p.now}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="road-led__actions road-reveal">
          <a class="btn btn--primary" href={withBase(led.cta.href)}>{led.cta.label}</a>
          <a class="btn btn--secondary" href={withBase(led.secondary.href)}>{led.secondary.label}</a>
        </div>
      </div>
    </section>
  </article>

  {/* The shared Contact, exactly as the homepage sets it (V1.7). */}
  <div class="chapter" data-surface="brand">
    <Contact />
  </div>
</BaseLayout>

<script>
  // Restrained motion: each block reveals once as it comes into view and the live photograph drifts gently with the
  // scroll. V1.9 adds three components: the operating system's route lights up to the lane in focus (any motion
  // setting: it is a response, not an animation); the timeline steps through its milestones from top to bottom; the
  // transition track draws each then-to-now path in turn. Reduced motion, no IntersectionObserver or no scripts:
  // everything is simply shown, complete and static.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLElement>('.road-reveal')];
  const motion = !reduce && 'IntersectionObserver' in window;

  if (!motion) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    document.documentElement.classList.add('road-motion');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );
    items.forEach((el) => io.observe(el));

    const drift = [...document.querySelectorAll<HTMLElement>('[data-road-drift]')];
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const el of drift) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2); // -1 .. 1 across the screen
        el.style.setProperty('--drift', `${(-p * 3).toFixed(2)}%`);
      }
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }

  // ---- The touring operating system: the lane under the pointer or in focus comes forward, and the route lights
  // up from the first stop to it. Leaving the panel returns it to rest.
  const os = document.querySelector<HTMLElement>('[data-road-os]');
  if (os) {
    const lanes = [...os.querySelectorAll<HTMLElement>('.road-os__lane')];
    const setActive = (k: number | null) => {
      os.toggleAttribute('data-active', k !== null);
      lanes.forEach((l, i) => {
        l.classList.toggle('is-active', i === k);
        l.classList.toggle('is-route', k !== null && i < k);
      });
    };
    lanes.forEach((l, i) => {
      l.addEventListener('pointerenter', () => setActive(i));
      l.addEventListener('focus', () => setActive(i));
    });
    os.addEventListener('pointerleave', () => {
      if (!os.contains(document.activeElement)) setActive(null);
    });
    os.addEventListener('focusout', (e) => {
      if (!os.contains(e.relatedTarget as Node | null)) setActive(null);
    });
  }

  // ---- The timeline: one milestone at a time, top to bottom, about three seconds each; the spine fills down to the
  // active one. After the last, a short hold, a clean reset, and again, only while on screen and the tab is visible.
  // Pointer, focus or a tap activates a milestone and pauses the cycle, which resumes after the interaction ends.
  const tl = document.querySelector<HTMLElement>('[data-road-timeline]');
  if (tl && motion) {
    const steps = [...tl.querySelectorAll<HTMLElement>('.road-tl__item')];
    const HOLD = 3000;
    const LAST_HOLD = 4200;
    let active = -1;
    let timer = 0;
    let visible = false;
    let paused = false;
    tl.classList.add('is-live');

    const show = (k: number) => {
      active = k;
      steps.forEach((s, i) => {
        s.classList.toggle('is-active', i === k);
        s.classList.toggle('is-done', k >= 0 && i < k);
      });
    };
    const schedule = (ms: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(tick, ms);
    };
    function tick() {
      if (!visible || paused || document.hidden) return;
      if (active < 0) {
        show(0);
        schedule(HOLD);
      } else if (active < steps.length - 1) {
        show(active + 1);
        schedule(active === steps.length - 1 ? LAST_HOLD : HOLD);
      } else {
        // reset cleanly: the spine empties, then the first milestone again
        tl!.classList.add('is-resetting');
        show(-1);
        window.setTimeout(() => tl!.classList.remove('is-resetting'), 500);
        schedule(900);
      }
    }
    const stop = () => window.clearTimeout(timer);
    new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          visible = e.isIntersecting;
          if (visible && !paused) schedule(active < 0 ? 400 : HOLD);
          else stop();
        }
      },
      { threshold: 0.3 },
    ).observe(tl);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (visible && !paused) schedule(HOLD);
    });

    let resume = 0;
    const take = (i: number) => {
      paused = true;
      stop();
      window.clearTimeout(resume);
      show(i);
    };
    const release = (ms: number) => {
      window.clearTimeout(resume);
      resume = window.setTimeout(() => {
        paused = false;
        if (visible) schedule(HOLD);
      }, ms);
    };
    steps.forEach((s, i) => {
      s.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') take(i);
      });
      s.addEventListener('focus', () => take(i));
      s.addEventListener('click', () => {
        take(i);
        release(6000);
      });
    });
    tl.addEventListener('pointerleave', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse' && !tl.contains(document.activeElement)) release(1200);
    });
    tl.addEventListener('focusout', (e) => {
      if (!tl.contains(e.relatedTarget as Node | null)) release(1200);
    });
  }

  // ---- The transition track: as it comes into view, each pairing in turn (origin, path and destination together)
  // gains emphasis while its path draws left to right, then settles. Pointer, focus or a tap brings one pairing
  // forward and pauses the sequence.
  const track = document.querySelector<HTMLElement>('[data-road-track]');
  if (track && motion) {
    const rows = [...track.querySelectorAll<HTMLElement>('.road-track__row')];
    const STEP = 1500;
    let next = 0;
    let timer = 0;
    let paused = false;
    let started = false;
    track.classList.add('is-live');

    const run = () => {
      if (paused) return;
      rows.forEach((r, i) => {
        r.classList.toggle('is-on', i === next);
        if (i < next) r.classList.add('is-drawn');
      });
      if (next < rows.length) {
        rows[next].classList.add('is-drawn');
        next += 1;
        timer = window.setTimeout(run, STEP);
      } else {
        rows.forEach((r) => r.classList.remove('is-on'));
        track.classList.add('is-settled');
      }
    };
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some((e) => e.isIntersecting) && !started) {
          started = true;
          obs.disconnect();
          timer = window.setTimeout(run, 500);
        }
      },
      { threshold: 0.35 },
    ).observe(track);

    const focusRow = (k: number | null) => {
      rows.forEach((r, i) => r.classList.toggle('is-focus', i === k));
      track.toggleAttribute('data-focus', k !== null);
    };
    rows.forEach((r, i) => {
      const take = () => {
        paused = true;
        window.clearTimeout(timer);
        rows.forEach((x) => x.classList.remove('is-on'));
        r.classList.add('is-drawn');
        focusRow(i);
      };
      r.addEventListener('pointerenter', take);
      r.addEventListener('focus', take);
    });
    const leave = () => {
      focusRow(null);
      if (paused) {
        paused = false;
        if (started && !track.classList.contains('is-settled')) timer = window.setTimeout(run, 600);
      }
    };
    track.addEventListener('pointerleave', () => {
      if (!track.contains(document.activeElement)) leave();
    });
    track.addEventListener('focusout', (e) => {
      if (!track.contains(e.relatedTarget as Node | null)) leave();
    });
  }
</script>

<style>
  .road {
    margin-top: calc(-1 * var(--header-row));
  }

  .road-accent {
    color: var(--accent-ink);
  }

  /* Bold for factual proof and key responsibilities: one phrase a paragraph. */
  .road strong {
    font-weight: 700;
    color: var(--heading);
  }

  /* ---- reveal: a short rise and fade, once ---- */
  :global(html.road-motion .road-reveal) {
    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 700ms var(--ease-out),
      translate 700ms var(--ease-out);
  }

  :global(html.road-motion .road-reveal.is-in) {
    opacity: 1;
    translate: 0 0;
  }

  /* ---- hero ---- */
  /* The figure stands on the section's lower edge, so the hero has no bottom
     padding of its own; the copy keeps its room. */
  .road-hero {
    padding-top: calc(var(--header-row) + clamp(2.5rem, 6vw, 6rem));
    padding-bottom: 0;
    min-height: min(100svh, 62rem);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }

  .road-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    width: 100%;
  }

  .road-hero__copy {
    align-self: center;
  }

  .road-hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .road-hero__title {
    font-size: var(--text-4xl);
    line-height: 0.95;
  }

  .road-hero__lede {
    max-width: 34rem;
  }

  /* The cutout, homepage style: no frame, card or shadow. Phones and tablets:
     centered under the copy, sized so his face, the cymbal and his hands are
     whole. Desktop: anchored bottom right, as tall as the room under the
     header allows, clear of the navigation and the headline. */
  .road-hero__figure {
    justify-self: center;
    width: min(88vw, 26rem);
    line-height: 0;
  }

  .road-hero__figure :global(picture),
  .road-hero__figure :global(.road-hero__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 64rem) {
    .road-hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      min-height: calc(min(100svh, 62rem) - var(--header-row) - clamp(2.5rem, 6vw, 6rem));
    }

    .road-hero__copy {
      padding-bottom: clamp(3rem, 6vw, 6rem);
    }

    /* As tall as the frame below the header allows, rising into the hero's top
       padding (never under the navigation), so the hero is one screen. */
    .road-hero__figure {
      justify-self: end;
      width: auto;
      height: min(calc(min(100svh, 62rem) - var(--header-row) - 1.5rem), 56rem);
      aspect-ratio: 890 / 1480;
      margin-top: calc(-1 * (clamp(2.5rem, 6vw, 6rem) - 1.5rem));
    }

    .road-hero__figure :global(picture),
    .road-hero__figure :global(.road-hero__img) {
      height: 100%;
      width: auto;
    }
  }

  /* ---- from music school to the road (V1.9) ---- */
  .road-school__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .road-school__copy {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  /* Two columns while both stay readable: the copy about two fifths, the
     evidence three fifths, the copy set level with the upper middle of the
     photographs. Below 56rem: copy first, then the composition. */
  @media (min-width: 56rem) {
    .road-school__grid {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
      column-gap: clamp(2.5rem, 4.5vw, 5rem);
      align-items: start;
    }

    .road-school__copy {
      padding-top: clamp(2rem, 7vw, 6.5rem);
    }
  }

  /* The layered composition. Phones: stacked, live performance first, the two
     cards a little narrower and alternating sides, no overlap. */
  .road-stage {
    display: grid;
    gap: clamp(1.25rem, 4vw, 1.75rem);
  }

  .road-stage :global(.road-stage__card) {
    width: 82%;
    padding: 6px;
    background: var(--bg-elev);
    border-radius: calc(var(--radius) + 6px);
    box-shadow: var(--shadow-lg);
  }

  .road-stage :global(.road-stage__tv) {
    justify-self: start;
    rotate: -1.5deg;
  }

  .road-stage :global(.road-stage__festival) {
    justify-self: end;
    rotate: 1.5deg;
  }

  /* From 40rem: the live performance dominant and centered in the composition;
     the television card over its lower-left edge and the festival poster over
     its upper-right edge (empty stage darkness there), each overlapping by about
     a fifth of its width, clear of John, the kit and the riser. */
  @media (min-width: 40rem) {
    .road-stage {
      display: block;
      position: relative;
      width: min(100%, 44rem);
      margin-inline: auto;
      padding-block: clamp(0.5rem, 2vw, 1.5rem);
    }

    .road-stage :global(.road-stage__live) {
      width: 64%;
      margin-inline: auto;
    }

    .road-stage :global(.road-stage__card) {
      position: absolute;
    }

    .road-stage :global(.road-stage__tv) {
      width: 27%;
      left: 0;
      bottom: 11%;
    }

    .road-stage :global(.road-stage__festival) {
      width: 30%;
      right: 0;
      top: 8%;
    }
  }

  /* ---- more than the drummer ---- */
  .road-operator__head {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .road-operator__copy {
    display: grid;
