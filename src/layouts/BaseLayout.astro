---
import fs from 'node:fs';
import nodePath from 'node:path';
import { createHash } from 'node:crypto';
import '@styles/global.css';
import site from '@data/site.json';
import { withBase, absoluteUrl, pagePath } from '@lib/paths';
import { getAsset } from '@lib/assets';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  /** Page title without the site suffix. Omit for the homepage. */
  title?: string;
  description?: string;
  /** Site-relative path of this page, e.g. `/work/creator-campaigns/`. */
  path: string;
  /** Asset manifest id of the social preview image. */
  ogAsset?: string;
  ogType?: 'website' | 'article';
  /** Prevent indexing (used by the 404 page). */
  noindex?: boolean;
  /** Surface the footer continues, so it reads as part of the last chapter. */
  footerSurface?: string;
  /**
   * Social-share overrides (Open Graph and X) for a page whose link preview
   * should not repeat its browser title (Social Share Polish V1: the homepage,
   * from site.json's homeShare). Each falls back to the page's own value: the
   * browser title and the meta description. The site name every preview
   * carries is site.json's ogSiteName (V1.1), never the person's name.
   */
  share?: { title?: string; description?: string };
}

const {
  title,
  description = site.description,
  path,
  ogAsset = site.ogDefault,
  ogType = 'website',
  noindex = false,
  footerSurface = 'light',
  share = {},
} = Astro.props;

// The homepage uses the exact approved browser-tab string; inner pages keep the
// page name plus the site name.
const fullTitle = title ? `${title} | ${site.name}` : site.browserTitle;
// What a shared link shows can differ from the tab and the search snippet.
const shareSiteName = site.ogSiteName;
const shareTitle = share.title ?? fullTitle;
const shareDescription = share.description ?? description;
const canonical = absoluteUrl(pagePath(path), Astro.site);
const og = getAsset(ogAsset);
// Social platforms cache previews by URL, so the image URL carries a short hash
// of the file: a regenerated card gets a new URL and is fetched fresh.
function ogVersion(file: string) {
  try {
    const bytes = fs.readFileSync(nodePath.join(process.cwd(), 'public', file));
    return createHash('sha1').update(bytes).digest('hex').slice(0, 10);
  } catch {
    return null;
  }
}
const ogHash = og.file ? ogVersion(og.file) : null;
const ogImage = og.file ? `${absoluteUrl(`/${og.file}`, Astro.site)}${ogHash ? `?v=${ogHash}` : ''}` : undefined;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  url: absoluteUrl('/', Astro.site),
  knowsAbout: ['Web3 marketing', 'Positioning and messaging', 'Technical content and websites', 'Partnerships and KOL programs', 'Campaigns and distribution', 'Event production'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks that scripts run, before first paint: enhancements such as the
         Select Work stack switch on only then, so without JavaScript every
         section reads in normal flow. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f3efe8" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48 32x32 16x16" />
    <link rel="icon" href={withBase('/favicon-16.png')} type="image/png" sizes="16x16" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={shareSiteName} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={site.locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={og.alt} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={og.alt} />}

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    {/* GoatCounter (October 2026): privacy-friendly, cookie-free pageview counts for
        https://jtcowin.goatcounter.com. Every page uses this layout and every page is a full
        page load (no view transitions or in-page routing), so each visit to a page sends exactly
        one pageview. count.js skips localhost, so dev and preview builds are not counted. */}
    <script is:inline data-goatcounter="https://jtcowin.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={pagePath(path)} overlay={pagePath(path) === '/'} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer surface={footerSurface} />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: #fff;
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .skip-link:focus-visible {
    transform: none;
    outline-offset: 2px;
  }

  main:focus {
    outline: none;
  }
</style>
